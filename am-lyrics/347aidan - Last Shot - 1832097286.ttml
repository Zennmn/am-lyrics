<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Last Shot"/><amll:meta key="artists" value="VALORANT Music"/><amll:meta key="artists" value="templuv"/><amll:meta key="artists" value="347aidan"/><amll:meta key="appleMusicId" value="1832097286"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">视线被烟雾笼罩 如此朦胧</text><text for="L2">暗箭难防 但击不倒我</text><text for="L3">过去的决定造就了现在的我</text><text for="L4">万众瞩目 无法呼吸 必须阻止自己</text><text for="L5">坠落</text><text for="L6">我一直在奔跑 但过去不停地</text><text for="L7">呼唤</text><text for="L8">即使可能会</text><text for="L9">伤害我 我还是冒险一试</text><text for="L10">但我胸中的火焰持续</text><text for="L11">燃烧</text><text for="L12">我会证明我配得上这一切</text><text for="L13">深吸一口气 数到十</text><text for="L14">缓一缓 胃里感到恶心</text><text for="L15">说“我没事” 又一次撒谎</text><text for="L16">这些想法压在我的良心上</text><text for="L17">我想我厌倦了自己</text><text for="L18">太容易冲动 不需要任何帮助</text><text for="L19">听到你在议论 真可笑</text><text for="L20">我随身带着你的危险讯号</text><text for="L21">看着我穿行于火焰之中</text><text for="L22">无人能挡我</text><text for="L23">其他一切都没怎么改变</text><text for="L24">只是我拥有了更大的舞台</text><text for="L25">视线被烟雾笼罩 如此朦胧</text><text for="L26">暗箭难防 但击不倒我</text><text for="L27">过去的决定造就了现在的我</text><text for="L28">万众瞩目 无法呼吸 必须阻止自己</text><text for="L29">坠落</text><text for="L30">我一直在奔跑 但过去不停地</text><text for="L31">呼唤</text><text for="L32">即使可能会</text><text for="L33">伤害我 我还是冒险一试</text><text for="L34">但我胸中的火焰持续</text><text for="L35">燃烧</text><text for="L36">我会证明我配得上这一切</text><text for="L37">坠落 坠落</text><text for="L38">呼唤 呼唤</text><text for="L39">坠落 坠落</text><text for="L40">呼唤 呼唤</text><text for="L41">脑海中的声音不停地诉说</text><text for="L42">没有什么能阻止我</text><text for="L43">我一直活得太过谨慎<span ttm:role="x-bg">(谨慎)</span></text><text for="L44">从不想被遗忘<span ttm:role="x-bg">(遗忘)</span></text><text for="L45">现在 我必须全力以赴<span ttm:role="x-bg">(全力以赴)</span></text><text for="L46">他们都想看到我坠落<span ttm:role="x-bg">(坠落)</span></text><text for="L47">我一直沉浸在</text><text for="L48">自己的思绪中 如此漫长</text><text for="L49">我还有最后一次机会</text><text for="L50">我最好让这一击奏效</text><text for="L51">但我不会</text><text for="L52">坠落</text><text for="L53">我一直在奔跑 但过去不停地</text><text for="L54">呼唤</text><text for="L55">即使可能会</text><text for="L56">伤害我 我还是冒险一试</text><text for="L57">但我胸中的火焰持续</text><text for="L58">燃烧</text><text for="L59">我会证明我不会</text><text for="L60">坠落</text><text for="L61">我一直在奔跑 但过去不停地</text><text for="L62">呼唤</text><text for="L63">即使可能会</text><text for="L64">伤害我 我还是冒险一试</text><text for="L65">但我胸中的火焰持续</text><text for="L66">燃烧</text><text for="L67">我会证明我配得上这一切</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:59.795"><div begin="0:16.122" end="2:59.795"><p begin="0:16.122" end="0:19.472" itunes:key="L1" ttm:agent="v1"><span begin="0:16.122" end="0:16.872">Smoke</span> <span begin="0:16.872" end="0:17.012">in</span> <span begin="0:17.012" end="0:17.212">my</span> <span begin="0:17.212" end="0:17.482">vi</span><span begin="0:17.482" end="0:17.572">sion</span> <span begin="0:17.572" end="0:18.042">so</span> <span begin="0:18.042" end="0:19.472">hazy</span></p><p begin="0:19.522" end="0:22.942" itunes:key="L2" ttm:agent="v1"><span begin="0:19.522" end="0:20.222">Shots</span> <span begin="0:20.222" end="0:20.502">in</span> <span begin="0:20.502" end="0:20.522">the</span> <span begin="0:20.522" end="0:20.922">dark</span> <span begin="0:20.922" end="0:21.402">can't</span> <span begin="0:21.402" end="0:21.842">make</span> <span begin="0:21.842" end="0:22.122">me</span> <span begin="0:22.122" end="0:22.942">fall</span></p><p begin="0:22.647" end="0:26.557" itunes:key="L3" ttm:agent="v1"><s