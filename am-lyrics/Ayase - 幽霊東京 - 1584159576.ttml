<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Ayase</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">街道上璀璨的灯火</text><text for="L2">俯视着对比鲜明的我</text><text for="L3">从那栋高楼的缝隙间穿过</text><text for="L4">与点上光彩的霓虹灯混在一起</text><text for="L5">用我的时间换来这个世界</text><text for="L6">没于夜色之中</text><text for="L7">坐着末班电车回家的我</text><text for="L8">玻璃窗上映于眼中的</text><text for="L9">并不是梦中的我</text><text for="L10">感觉快要哭出声来</text><text for="L11">孑然一身迷失于黑暗之中</text><text for="L12">真是悲哀</text><text for="L13">没关系 一切都会好起来的</text><text for="L14">我曾无数次的这样想过</text><text for="L15">今天也在东京繁华景色中</text><text for="L16">显得透明的我</text><text for="L17">就像幽灵一样</text><text for="L18">逐渐习惯失去</text><text for="L19">每当回想起</text><text for="L20">那已然忘却的愿望</text><text for="L21">都会不禁潸然泪下</text><text for="L22">一定只是因为这街道</text><text for="L23">过于耀眼</text><text for="L24">苦笑着哀叹着自己的狼狈</text><text for="L25">在颓废的日子里</text><text for="L26">那一天的思念在脑海中闪现</text><text for="L27">注意之时直到清晨出现的逻辑</text><text for="L28">让我的话语乘上旋律 无论多少次</text><text for="L29">逐渐习惯失去</text><text for="L30">即便那段日子已然忘却</text><text for="L31">却依然向着前方</text><text for="L32">因为有你存在</text><text for="L33">才让我产生了这样的想法</text><text for="L34">呐</text><text for="L35">在这如此寂寥的街道</text><text for="L36">呐</text><text for="L37">街道上璀璨的灯火</text><text for="L38">俯视着对比鲜明的我</text><text for="L39">朝着那栋高楼的前方 伸出手</text><text for="L40">描摹着那一天所梦见的景色</text><text for="L41">用我的时间换来这个世界</text><text for="L42">呼唤着明天</text><text for="L43">逐渐习惯失去</text><text for="L44">可每当抱紧那份</text><text for="L45">尚存的珍贵思念</text><text for="L46">便不禁潸然泪下</text><text for="L47">一定是因为</text><text for="L48">还想在这街道上活下去啊</text><text for="L49">你也是这么想的 对吧？</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="幽霊東京"/><amll:meta key="artists" value="Ayase"/><amll:meta key="album" value="夜撫でるメノウ / 幽霊東京 - Single"/><amll:meta key="appleMusicId" value="1584159576"/></metadata></head><body><div begin="0:23.659" end="0:39.562" itunes:songPart="Verse"><p begin="0:23.659" end="0:27.215" itunes:key="L1" ttm:agent="v1"><span begin="0:23.659" end="0:24.603">燦然</span><span begin="0:24.603" end="0:25.051">と</span><span begin="0:25.051" end="0:26.067">輝く</span><span begin="0:26.067" end="0:26.627">街</span><span begin="0:26.627" end="0:26.690">の</span><span begin="0:26.690" end="0:27.215">灯り</span></p><p begin="0:27.468" end="0:31.392" itunes:key="L2" ttm:agent="v1"><span begin="0:27.468" end="0:29.437">対照的な</span><span begin="0:29.437" end="0:29.940">僕を</span><span begin="0:29.940" end="0:31.392">見下ろす</span></p><p begin="0:30.872" end="0:32.647" itunes:key="L3" ttm:agent="v1"><span begin="0:30.872" end="0:31.366">あの</span><span begin="0:31.366" end="0:31.679">ビル</span><span begin="0:31.679" end="0:31.865">の</span><span begin="0:31.865" end="0:32.189">間</span><span begin="0:32.189" end="0:32.277">を</span><span begin="0:32.277" end="0:32.647">抜けて</span></p><p begin="0:32.855" end="0:34.612" itunes:key="L4" ttm:agent="v1"><span begin="0:32.855" end="0:33.699">色付き出した</span><span begin="0:33.699" end="0:34.123">ネオン</span><span begin="0:34.123" end="0:34.168">と</span><span begin="0:34.168" end="0:34.612">混じって</span></p><p begin="0:34.665" end="0:37.520" itunes:key="L5" ttm:agent="v1"><span begin="0:34.665" end="0:34.890">僕</span><span begin="0:34.890" end="0:35.058">の</span><span begin="0:35.058" end="0:35.737">時間</span><span begin="0:35.737" end="0:35.853">と</span><span begin="0:35.853" end="0:36.054">この</span><span begin="0:36.054" end="0:36.639">世界</span><span begin="0:36.639" end="0:37.016">を</span><span begin="0:37.016" end="0:37.520">トレード</span></p><p begin="0:37.656" end="0:39.562" itunes:key="L6" ttm:agent="v1"><span begin="0:37.656" end="0:38.240">夜</span><span begin="0:38.240" end="0:38.488">に</span><span begin="0:38.488" end="0:38.852">沈</span><span begin="0:38.852" end="0:39.562">む</span></p></div><div begin="0:46.848" end="1:01.900" itunes:songPart="PreChorus"><p begin="0:46.848" end="0:50.515" itunes:key="L7" ttm:agent="v1"><span begin="0:46.848" end="0:47.840">終電</span><span begin="0:47.840" end="0:48.312">で</span><span begin="0:48.312" end="0:49.029">家路</span><span begin="0:49.029" end="0:49.291">を</span><span begin="0:49.291" end="0:50.030">辿る</span><span begin="0:50.030" end="0:50.483">僕</span><span begin="0:50.483" end="0:50.515">の</span></p><p begin="0:50.670" end="0:54.600" itunes:key="L8" ttm:agent="v1"><span begin="0:50.670" end="0:50.860">目</span><span begin="0:50.860" end="0:51.187">に</span><span begin="0:51.187" end="0:52.163">映る</span><span begin="0:52.163" end="0:53.320">ガラス窓</span><span begin="0:53.320" end="0:53.663">に</span><span begin="0:53.663" end="0:54.161">居た</span><span begin="0:54.161" end="0:54.464">の</span><span begin="0:54.464" end="0:54.600">は</span></p><p begin="0:54.539" end="0:55.951" itunes:key="L9" ttm:agent="v1"><span begin="0:54.539" end="0:55.065">夢見た</span><span begin="0:55.065" end="0:55.462">自分</span><span begin="0:55.462" end="0:55.613">じゃ</span><span begin="0:55.613" end="0:55.951">なくて</span></p><p begin="0:56.022" end="0:57.976" itunes:key="L10" ttm:agent="v1"><span begin="0:56.022" end="0:56.225">今</span><span begin="0:56.225" end="0:56.385">に</span><span begin="0:56.385" end="0:56.533">も</span><span begin="0:56.533" end="0:57.055">泣き出して</span><span begin="0:57.055" end="0:57.728">しまいそう</span><span begin="0:57.728" end="0:57.976">な</span></p><p begin="0:57.941" end="1:00.583" itunes:key="L11" ttm:agent="v1"><span begin="0:57.941" end="0:58.548">暗闇</span><span begin="0:58.548" end="0:58.677">の</span><span begin="0:58.677" end="0:59.055">中</span><span begin="0:59.055" end="0:59.388">独り</span><span begin="0:59.388" end="0:59.705">ただ</span><span begin="0:59.705" end="1:00.583">迷っている</span></p><p begin="1:00.907" end="1:01.900" itunes:key="L12" ttm:agent="v1"><span begin="1:00.907" end="1:01.900">哀しい人</span></p></div><div begin="1:02.119" end="1:37.014" itunes:songPart="Chorus"><p begin="1:02.119" end="1:05.801" itunes:key="L13" ttm:agent="v1"><span begin="1:02.119" end="1:03.615">大丈夫</span> <span begin="1:03.615" end="1:04.252">いつか</span><span begin="1:04.252" end="1:05.531">大丈夫</span><span begin="1:05.531" end="1:05.739">に</span><span begin="1:05.739" end="1:05.801">なる</span></p><p begin="1:06.153" end="1:09.675" itunes:key="L14" ttm:agent="v1"><span begin="1:06.153" end="1:06.737">なんて</span><span begin="1:06.737" end="1:07.517">思う</span><span begin="1:07.517" end="1:08.029">日々</span><span begin="1:08.029" end="1:08.161">を</span><span begin="1:08.161" end="1:08.755">幾つ</span><span begin="1:08.755" end="1:09.675">重ねた</span></p><p begin="1:10.087" end="1:11.664" itunes:key="L15" ttm:agent="v1"><span begin="1:10.087" end="1:10.519">今日</span><span begin="1:10.519" end="1:11.327">だって</span><span begin="1:11.327" end="1:11.664">独り</span></p><p begin="1:12.018" end="1:15.544" itunes:key="L16" ttm:agent="v1"><span begin="1:12.018" end="1:12.890">東京</span><span begin="1:12.890" end="1:13.330">の</span><span begin="1:13.330" end="1:14.005">景色</span><span begin="1:14.005" end="1:14.981">に透ける</span><span begin="1:14.981" end="1:15.511">僕</span><span begin="1:15.511" end="1:15.544">は</span></p><p begin="1:15.752" end="1:17.785" itunes:key="L17" ttm:agent="v1"><span begin="1:15.752" end="1:16.569">幽霊</span><span begin="1:16.569" end="1:17.449">みたい</span><span begin="1:17.449" end="1:17.785">だ</span></p><p begin="1:18.580" end="1:22.155" itunes:key="L18" ttm:agent="v1"><span begin="1:18.580" end="1:19.504">失う</span><span begin="1:19.504" end="1:20.224">こと</span><span begin="1:20.224" end="1:20.584">に</span><span begin="1:20.584" end="1:21.010">慣れて</span><span begin="1:21.011" end="1:21.393">いく</span><span begin="1:21.393" end="1:22.105">中</span><span begin="1:22.105" end="1:22.155">で</span></p><p begin="1:22.396" end="1:26.157" itunes:key="L19" ttm:agent="v1"><span begin="1:22.396" end="1:23.300">忘れて</span><span begin="1:23.300" end="1:24.351">しまった</span><span begin="1:24.351" end="1:24.629">あの</span><span begin="1:24.629" end="1:25.573">願い</span><span begin="1:25.573" end="1:26.117">さえ</span><span begin="1:26.117" end="1:26.157">も</span></p><p begin="1:26.309" end="1:28.652" itunes:key="L20" ttm:agent="v1"><span begin="1:26.309" end="1:27.908">思い出した</span><span begin="1:27.908" end="1:28.596">時</span><span begin="1:28.596" end="1:28.652">に</span></p><p begin="1:29.121" end="1:31.269" itunes:key="L21" ttm:agent="v1"><span begin="1:29.121" end="1:29.629">涙</span><span begin="1:29.629" end="1:29.911">が</span><span begin="1:29.911" end="1:30.885">落ちた</span><span begin="1:30.885" end="1:31.221">の</span><span begin="1:31.221" end="1:31.269">は</span></p><p begin="1:31.616" end="1:33.480" itunes:key="L22" ttm:agent="v1"><span begin="1:31.616" end="1:32.144">この</span><span begin="1:32.144" end="1:32.175">街</span><span begin="1:32.175" end="1:32.677">が</span><span begin="1:32.677" end="1:33.480">ただ</span></p><p begin="1:34.557" end="1:37.014" itunes:key="L23" ttm:agent="v1"><span begin="1:34.557" end="1:35.285">余り</span><span begin="1:35.285" end="1:35.668">にも</span><span begin="1:35.668" end="1:36.680">眩しい</span><span begin="1:36.680" end="1:37.014">から</span></p></div><div begin="1:52.665" end="2:06.294" itunes:songPart="Verse"><p begin="1:52.665" end="1:56.275" itunes:key="L24" ttm:agent="v1"><span begin="1:52.665" end="1:53.649">散々</span><span begin="1:53.649" end="1:53.749">だ</span><span begin="1:53.749" end="1:54.171">って</span><span begin="1:54.171" end="1:55.091">笑い</span><span begin="1:55.091" end="1:55.795">ながら</span><span begin="1:55.795" end="1:56.275">嘆く</span></p><p begin="1:56.434" end="1:58.982" itunes:key="L25" ttm:agent="v1"><span begin="1:56.434" end="1:57.998">退廃的</span><span begin="1:57.998" end="1:58.214">な</span><span begin="1:58.214" end="1:58.566">日々</span><span begin="1:58.566" end="1:58.846">の</span><span begin="1:58.846" end="1:58.982">中</span></p><p begin="1:59.399" end="2:01.657" itunes:key="L26" ttm:agent="v1"><span begin="1:59.399" end="1:59.904">あの</span><span begin="1:59.904" end="2:00.096">日</span><span begin="2:00.096" end="2:00.446">の</span><span begin="2:00.446" end="2:00.682">想</span><span begin="2:00.682" end="2:00.883">いが</span><span begin="2:00.883" end="2:01.657">フラッシュバック</span></p><p begin="2:01.793" end="2:03.663" itunes:key="L27" ttm:agent="v1"><span begin="2:01.793" end="2:02.325">気付けば</span><span begin="2:02.325" end="2:02.550">朝</span><span begin="2:02.550" end="2:02.827">まで</span><span begin="2:02.827" end="2:03.332">開く</span><span begin="2:03.332" end="2:03.663">ロジック</span></p><p begin="2:03.763" end="2:06.294" itunes:key="L28" ttm:agent="v1"><span begin="2:03.763" end="2:03.989">僕</span><span begin="2:03.989" end="2:04.149">の</span><span begin="2:04.149" end="2:04.732">言葉</span><span begin="2:04.732" end="2:05.236">を音に</span><span begin="2:05.236" end="2:05.615">乗せて</span><span begin="2:05.615" end="2:06.135">何度</span><span begin="2:06.135" end="2:06.294">でも</span></p></div><div begin="2:06.942" end="2:23.727" itunes:songPart="PreChorus"><p begin="2:06.942" end="2:10.493" itunes:key="L29" ttm:agent="v1"><span begin="2:06.942" end="2:07.894">失う</span><span begin="2:07.894" end="2:08.581">こと</span><span begin="2:08.581" end="2:08.925">に</span><span begin="2:08.925" end="2:09.529">慣れて</span><span begin="2:09.529" end="2:09.879">いく</span><span begin="2:09.879" end="2:10.493">中で</span></p><p begin="2:10.800" end="2:14.443" itunes:key="L30" ttm:agent="v1"><span begin="2:10.800" end="2:11.728">忘れて</span><span begin="2:11.728" end="2:12.779">しまった</span><span 