<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Ayase</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">街道上璀璨的灯火</text><text for="L2">俯视着对比鲜明的我</text><text for="L3">从那栋高楼的缝隙间穿过</text><text for="L4">与点上光彩的霓虹灯混在一起</text><text for="L5">用我的时间换来这个世界</text><text for="L6">没于夜色之中</text><text for="L7">坐着末班电车回家的我</text><text for="L8">玻璃窗上映于眼中的</text><text for="L9">并不是梦中的我</text><text for="L10">感觉快要哭出声来</text><text for="L11">孑然一身迷失于黑暗之中</text><text for="L12">真是悲哀</text><text for="L13">没关系 一切都会好起来的</text><text for="L14">我曾无数次的这样想过</text><text for="L15">今天也在东京繁华景色中</text><text for="L16">显得透明的我</text><text for="L17">就像幽灵一样</text><text for="L18">逐渐习惯失去</text><text for="L19">每当回想起</text><text for="L20">那已然忘却的愿望</text><text for="L21">都会不禁潸然泪下</text><text for="L22">一定只是因为这街道</text><text for="L23">过于耀眼</text><text for="L24">苦笑着哀叹着自己的狼狈</text><text for="L25">在颓废的日子里</text><text for="L26">那一天的思念在脑海中闪现</text><text for="L27">注意之时直到清晨出现的逻辑</text><text for="L28">让我的话语乘上旋律 无论多少次</text><text for="L29">逐渐习惯失去</text><text for="L30">即便那段日子已然忘却</text><text for="L31">却依然向着前方</text><text for="L32">因为有你存在</text><text for="L33">才让我产生了这样的想法</text><text for="L34">呐</text><text for="L35">在这如此寂寥的街道</text><text for="L36">呐</text><text for="L37">街道上璀璨的灯火</text><text for="L38">俯视着对比鲜明的我</text><text for="L39">朝着那栋高楼的前方 伸出手</text><text for="L40">描摹着那一天所梦见的景色</text><text for="L41">用我的时间换来这个世界</text><text for="L42">呼唤着明天</text><text for="L43">逐渐习惯失去</text><text for="L44">可每当抱紧那份</text><text for="L45">尚存的珍贵思念</text><text for="L46">便不禁潸然泪下</text><text for="L47">一定是因为</text><text for="L48">还想在这街道上活下去啊</text><text for="L49">你也是这么想的 对吧？</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:23.779" end="0:27.335" itunes:key="L1" ttm:agent="v1"><span begin="0:23.779" end="0:24.195">燦</span><span begin="0:24.195" end="0:24.723">然</span><span begin="0:24.723" end="0:25.171">と</span><span begin="0:25.171" end="0:25.884">輝</span><span begin="0:25.884" end="0:26.187">く</span><span begin="0:26.187" end="0:26.747">街</span><span begin="0:26.747" end="0:26.810">の</span><span begin="0:26.810" end="0:27.295">灯</span><span begin="0:27.295" end="0:27.335">り</span></p><p begin="0:27.588" end="0:30.688" itunes:key="L2" ttm:agent="v1"><span begin="0:27.588" end="0:28.116">対</span><span begin="0:28.116" end="0:28.556">照</span><span begin="0:28.556" end="0:29.181">的</span><span begin="0:29.181" end="0:29.196">な</span><span begin="0:29.196" end="0:29.781">僕</span><span begin="0:29.781" end="0:30.060">を</span><span begin="0:30.060" end="0:30.260">見</span><span begin="0:30.260" end="0:30.585">下</span><span begin="0:30.585" end="0:30.648">ろ</span><span begin="0:30.648" end="0:30.688">す</span></p><p begin="0:30.992" end="0:32.767" itunes:key="L3" ttm:agent="v1"><span begin="0:30.992" end="0:31.086">あ</span><span begin="0:31.086" end="0:31.486">の</span><span begin="0:31.486" end="0:31.608">ビ</span><span begin="0:31.608" end="0:31.799">ル</span><span begin="0:31.799" end="0:31.985">の</span><span begin="0:31.985" end="0:32.309">間</span><span begin="0:32.309" end="0:32.397">を</span><span begin="0:32.397" end="0:32.610">抜</span><span begin="0:32.610" end="0:32.766">け</span><span begin="0:32.766" end="0:32.767">て</span></p><p begin="0:32.975" end="0:34.732" itunes:key="L4" ttm:agent="v1"><span begin="0:32.975" end="0:33.202">色</span><span begin="0:33.202" end="0:33.370">付</span><span begin="0:33.370" end="0:33.409">き</span><span begin="0:33.409" end="0:33.459">出</span><span begin="0:33.459" end="0:33.635">し</span><span begin="0:33.635" end="0:33.819">た</span><span begin="0:33.819" end="0:33.915">ネ</span><span begin="0:33.915" end="0:34.079">オ</span><span begin="0:34.079" end="0:34.243">ン</span><span begin="0:34.243" end="0:34.288">と</span><span begin="0:34.288" end="0:34.395">混</span><span begin="0:34.395" end="0:34.563">じ</span><span begin="0:34.563" end="0:34.731">っ</span><span begin="0:34.731" end="0:34.732">て</span></p><p begin="0:34.785" end="0:37.640" itunes:key="L5" ttm:agent="v1"><span begin="0:34.785" end="0:35.010">僕</span><span begin="0:35.010" end="0:35.178">の</span><span begin="0:35.178" end="0:35.424">時</span><span begin="0:35.424" end="0:35.857">間</span><span begin="0:35.857" end="0:35.973">と</span><span begin="0:35.973" end="0:35.974">こ</span><span begin="0:35.974" end="0:36.174">の</span><span begin="0:36.174" end="0:36.350">世</span><span begin="0:36.350" end="0:36.759">界</span><span begin="0:36.759" end="0:37.136">を</span><span begin="0:37.136" end="0:37.145">ト</span><span begin="0:37.145" end="0:37.336">レ</span><span begin="0:37.337" end="0:37.528">ー</span><span begin="0:37.528" end="0:37.640">ド</span></p><p begin="0:37.776" end="0:39.682" itunes:key="L6" ttm:agent="v1"><span begin="0:37.776" end="0:38.360">夜</span><span begin="0:38.360" end="0:38.608">に</span><span begin="0:38.608" end="0:39.274">沈</span><span begin="0:39.274" end="0:39.682">む</span></p></div><div itunes:song-part="PreChorus"><p begin="0:46.968" end="0:50.635" itunes:key="L7" ttm:agent="v1"><span begin="0:46.968" end="0:47.440">終</span><span begin="0:47.440" end="0:47.960">電</span><span begin="0:47.960" end="0:48.432">で</span><span begin="0:48.432" end="0:48.915">家</span><span begin="0:48.915" end="0:49.149">路</span><span begin="0:49.149" end="0:49.411">を</span><span begin="0:49.411" end="0:49.931">辿</span><span begin="0:49.931" end="0:50.150">る</span><span begin="0:50.150" end="0:50.603">僕</span><span begin="0:50.603" end="0:50.635">の</span></p><p begin="0:50.790" end="0:54.370" itunes:key="L8" ttm:agent="v1"><span begin="0:50.790" end="0:50.980">目</span><span begin="0:50.980" end="0:51.307">に</span><span begin="0:51.307" end="0:51.835">映</span><span begin="0:51.835" end="0:52.283">る</span><span begin="0:52.283" end="0:52.492">ガ</span><span begin="0:52.492" end="0:52.803">ラ</span><span begin="0:52.803" end="0:52.847">ス</span><span begin="0:52.847" end="0:53.440">窓</span><span begin="0:53.440" end="0:53.783">に</span><span begin="0:53.783" end="0:53.833">居</span><span begin="0:53.833" end="0:54.281">た</span><span begin="0:54.281" end="0:54.355">の</span><span begin="0:54.355" end="0:54.370">は</span></p><p begin="0:54.659" end="0:56.071" itunes:key="L9" ttm:agent="v1"><span begin="0:54.659" end="0:54.865">夢</span><span begin="0:54.865" end="0:55.049">見</span><span begin="0:55.049" end="0:55.185">た</span><span begin="0:55.185" end="0:55.352">自</span><span begin="0:55.352" end="0:55.582">分</span><span begin="0:55.582" end="0:55.678">じ</span><span begin="0:55.678" end="0:55.733">ゃ</span><span begin="0:55.733" end="0:55.917">な</span><span begin="0:55.917" end="0:56.044">く</span><span begin="0:56.044" end="0:56.071">て</span></p><p begin="0:56.142" end="0:57.896" itunes:key="L10" ttm:agent="v1"><span begin="0:56.142" end="0:56.345">今</span><span begin="0:56.345" end="0:56.505">に</span><span begin="0:56.505" end="0:56.653">も</span><span begin="0:56.653" end="0:56.669">泣</span><span begin="0:56.669" end="0:56.835">き</span><span begin="0:56.835" end="0:57.013">出</span><span begin="0:57.013" end="0:57.128">し</span><span begin="0:57.128" end="0:57.175">て</span><span begin="0:57.175" end="0:57.359">し</span><span begin="0:57.359" end="0:57.543">ま</span><span begin="0:57.543" end="0:57.751">い</span><span begin="0:57.751" end="0:57.835">そ</span><span begin="0:57.835" end="0:57.848">う</span><span begin="0:57.848" end="0:57.896">な</span></p><p begin="0:58.061" end="1:00.474" itunes:key="L11" ttm:agent="v1"><span begin="0:58.061" end="0:58.259">暗</span><span begin="0:58.259" end="0:58.668">闇</span><span begin="0:58.668" end="0:58.797">の</span><span begin="0:58.797" end="0:59.175">中</span><span begin="0:59.175" end="0:59.456">独</span><span begin="0:59.456" end="0:59.508">り</span><span begin="0:59.508" end="0:59.617">た</span><span begin="0:59.617" end="0:59.825">だ</span><span begin="0:59.825" end="1:00.089">迷</span><span begin="1:00.089" end="1:00.134">っ</span><span begin="1:00.135" end="1:00.340">て</span><span begin="1:00.340" end="1:00.458">い</span><span begin="1:00.458" end="1:00.474">る</span></p><p begin="1:01.027" end="1:02.020" itunes:key="L12" ttm:agent="v1"><span begin="1:01.027" end="1:01.563">哀</span><span begin="1:01.563" end="1:01.630">し</span><span begin="1:01.630" end="1:01.962">い</span><span begin="1:01.962" end="1:02.020">人</span></p></div><div itunes:song-part="Chorus"><p begin="1:02.239" end="1:05.921" itunes:key="L13" ttm:agent="v1"><span begin="1:02.239" end="1:02.888">大</span><span begin="1:02.888" end="1:03.271">丈</span><span begin="1:03.271" end="1:03.735">夫</span> <span begin="1:03.735" end="1:03.811">い</span><span begin="1:03.811" end="1:04.051">つ</span><span begin="1:04.051" end="1:04.372">か</span><span begin="1:04.372" end="1:04.803">大</span><span begin="1:04.803" end="1:05.182">丈</span><span begin="1:05.182" end="1:05.651">夫</span><span begin="1:05.651" end="1:05.859">に</span><span begin="1:05.859" end="1:05.905">な</span><span begin="1:05.905" end="1:05.921">る</span></p><p begin="1:06.273" end="1:09.795" itunes:key="L14" ttm:agent="v1"><span begin="1:06.273" end="1:06.409">な</span><span begin="1:06.409" end="1:06.545">ん</span><span begin="1:06.545" end="1:06.857">て</span><span begin="1:06.857" end="1:07.245">思</span><span begin="1:07.245" end="1:07.637">う</span><span begin="1:07.637" end="1:07.756">日</span><span begin="1:07.756" end="1:08.149">々</span><span begin="1:08.149" end="1:08.281">を</span><span begin="1:08.281" end="1:08.857">幾</span><span begin="