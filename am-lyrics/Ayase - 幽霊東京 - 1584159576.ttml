<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Yurei Tokyo"/><amll:meta key="artists" value="Ayase"/><amll:meta key="album" value="Yorunaderu Menou / Yurei Tokyo - Single"/><amll:meta key="isrc" value="JPP302101633"/><amll:meta key="appleMusicId" value="1584159576"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">灿然闪耀的城市灯火</text><text for="L2">俯瞰着与之截然相反的我</text><text for="L3">穿梭在那一座座高楼之间</text><text for="L4">染上斑斓色彩</text><text for="L5">与霓虹灯影交融</text><text for="L6">将我的时间</text><text for="L7">与这个世界相交换</text><text for="L8">沉入夜色之中</text><text for="L9">乘着末班电车踏上归途的我</text><text for="L10">映入眼帘的车窗玻璃上</text><text for="L11">倒映出的身影</text><text for="L12">并非曾怀抱梦想的自己</text><text for="L13">而是仿佛下一秒就会</text><text for="L14">痛哭出声</text><text for="L15">在黑暗之中孑然一身</text><text for="L16">仅仅在迷茫徘徊的</text><text for="L17">悲伤之人</text><text for="L18">没事的</text><text for="L19">总有一天会好起来的</text><text for="L20">怀抱这般念头的日子</text><text for="L21">究竟度过了多少</text><text for="L22">今天也依然孤身一人</text><text for="L23">身影融透在东京街景里的我</text><text for="L24">宛如幽灵一般</text><text for="L25">在逐渐习惯失去的过程里</text><text for="L26">早已彻底遗忘的</text><text for="L27">就连当年的心愿也是</text><text for="L28">当再次回想起来时</text><text for="L29">眼泪之所以会滑落</text><text for="L30">只因这座城市</text><text for="L31">实在是太过耀眼</text><text for="L32">苦笑着哀叹一切糟糕透顶</text><text for="L33">在日复一日颓靡的日常里</text><text for="L34">那一天的思绪</text><text for="L35">骤然闪回脑海</text><text for="L36">回过神时已至清晨</text><text for="L37">打开编曲工程</text><text for="L38">将我的心声寄托于旋律</text><text for="L39">无论多少次</text><text for="L40">在逐渐习惯失去的过程里</text><text for="L41">早已彻底遗忘的</text><text for="L42">就连那些过往岁月也是</text><text for="L43">即使如此仍想走向前方</text><text for="L44">之所以还能这般期许</text><text for="L45">都是因为有你存在</text><text for="L46">呐 在这样寂寞的城市里</text><text for="L47">呐</text><text for="L48">灿然闪耀的城市灯火</text><text for="L49">俯瞰着与之截然相反的我的那座</text><text for="L50">高楼顶端</text><text for="L51">伸出双手</text><text for="L52">追寻那一天曾梦想过的</text><text for="L53">描摹那片光景</text><text for="L54">将我的时间</text><text for="L55">与这个世界相交换</text><text for="L56">呼唤明日到来</text><text for="L57">在逐渐习惯失去的过程里</text><text for="L58">却始终未曾舍弃的</text><text for="L59">那份珍贵的心意</text><text for="L60">紧紧拥入怀中时</text><text for="L61">眼泪悄然滑落的缘由</text><text for="L62">是因为在这座城市里</text><text for="L63">我依然渴望活下去</text><text for="L64">你也是这样想的吧</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:25.572"><div begin="0:23.596" end="3:25.572"><p begin="0:23.596" end="0:27.576" itunes:key="L1" ttm:agent="v1"><span begin="0:23.596" end="0:24.196">燦</span><span begin="0:24.196" end="0:24.676">然</span><span begin="0:24.676" end="0:24.946">と</span><span begin="0:25.156" end="0:25.846">輝</span><span begin="0:25.846" end="0:26.146">く</span><span begin="0:26.146" end="0:26.646">街</span><span begin="0:26.646" end="0:26.876">の</span><span begin="0:26.876" end="0:27.376">灯</span><span begin="0:27.376" end="0:27.576">り</span></p><p begin="0:27.576" end="0:30.916" itunes:key="L2" ttm:agent="v1"><span begin="0:27.576" end="0:28.026">対</span><span begin="0:28.026" end="0:28.556">照</span><span begin="0:28.556" end="0:29.066">的</span><span begin="0:29.066" end="0:29.286">な</span><span begin="0:29.286" end="0:29.806">僕</span><span begin="0:29.806" end="0:29.986">を</span><span begin="0:29.986" end="0:30.266">見</span><span begin="0:30.266" end="0:30.516">下</span><span begin="0:30.516" end="0:30.676">ろ</span><span begin="0:30.676" end="0:30.916">す</span></p><p begin="0:31.035" end="0:32.945" itunes:key="L3" ttm:agent="v1"><span begin="0:31.035" end="0:31.255">あ</span><span begin="0:31.255" end="0:31.485">の</span><span begin="0:31.485" end="0:31.635">ビ</span><span begin="0:31.635" end="0:31.865">ルの</span><span begin="0:31.865" end="0:32.215">間</span><span begin="0:32.215" end="0:32.325">を</span><span begin="0:32.325" end="0:32.425">抜</span><span begin="0:32.425" end="0:32.615">け</span><span begin="0:32.615" end="0:32.945">て</span></p><p begin="0:32.928" end="0:33.768" itunes:key="L4" ttm:agent="v1"><span begin="0:32.928" end="0:33.148">色</span><span begin="0:33.148" end="0:33.258">付</span><span begin="0:33.258" end="0:33.398">き</span><span begin="0:33.398" end="0:33.508">出</span><span begin="0:33.508" end="0:33.628">し</span><span begin="0:33.628" end="0:33.768">た</span></p><p begin="0:33.767" end="0:34.867" itunes:key="L5" ttm:agent="v1"><span begin="0:33.767" end="0:33.927">ネ</span><span begin="0:33.927" end="0:34.117">オン</span><span begin="0:34.117" end="0:34.237">と</span><span begin="0:34.237" end="0:34.367">混</span><span begin="0:34.367" end="0:34.577">じっ</span><span begin="0:34.577" end="0:34.867">て</span></p><p begin="0:34.867" end="0:35.877" itunes:key="L6" ttm:agent="v1"><span begin="0:34.867" end="0:35.087">僕</span><span begin="0:35.087" end="0:35.197">の</span><span begin="0:35.197" end="0:35.307">時</span><span begin="0:35.307" end="0:35.687">間</span><span begin="0:35.687" end="0:35.877">と</span></p><p begin="0:35.880" end="0:37.490" itunes:key="L7" ttm:agent="v1"><span begin="0:35.880" end="0:36.060">こ</span><span begin="0:36.060" end="0:36.270">の世</span><span begin="0:36.270" end="0:36.670">界</span><span begin="0:36.670" end="0:36.810">を</span><span begin="0:36.810" end="0:37.050">ト</span><span begin="0:37.050" end="0:37.290">レー</span><span begin="0:37.290" end="0:37.490">ド</span></p><p begin="0:37.743" end="0:39.613" itunes:key="L8" ttm:agent="v1"><span begin="0:37.743" end="0:38.233">夜</span><span begin="0:38.233" end="0:38.393">に</span><span begin="0:38.393" end="0:38.903">沈</span><span begin="0:38.903" end="0:39.613">む</span></p><p begin="0:46.741" end="0:50.751" itunes:key="L9" ttm:agent="v1"><span begin="0:46.741" end="0:47.431">終</span><span begin="0:47.431" end="0:47.931">電</span><span begin="0:47.931" end="0:48.161">で</span><span begin="0:48.431" end="0:48.801">家</span><span begin="0:48.801" end="0:49.141">路</span><span begin="0:49.141" end="0:49.271">を</span><span begin="0:49.271" end="0:49.881">辿</span><span begin="0:49.881" end="0:50.111">る</span><span begin="0:50.111" end="0:50.591">僕</span><span begin="0:50.591" end="0:50.751">の</span></p><p begin="0:50.746" end="0:53.806" itunes:key="L10" ttm:agent="v1"><span begin="0:50.746" end="0:51.096">目</span><span begin="0:51.096" end="0:51.336">に</span><span begin="0:51.336" end="0:51.816">映</span><span begin="0:51.816" end="0:51.996">る</span><span begin="0:52.236" end="0:52.626">ガラ</span><span begin="0:52.626" end="0:53.006">ス</span><span begin="0:53.006" end="0:53.396">窓</span><span begin="0:53.396" end="0:53.806">に</span></p><p begin="0:53.806" end="0:54.686" itunes:key="L11" ttm:agent="v1"><span begin="0:53.806" end="0:53.926">居</span><span begin="0:53.926" end="0:54.166">た</span><span begin="0:54.166" end="0:54.456">の</span><span begin="0:54.456" end="0:54.686">は</span></p><p begin="0:54.696" end="0:56.176" itunes:key="L12" ttm:agent="v1"><span begin="0:54.696" end="0:54.946">夢</span><span begin="0:54.946" end="0:55.046">見</span><span begin="0:55.046" end="0:55.176">た</span><span begin="0:55.176" end="0:55.306">自</span><span begin="0:55.306" end="0:55.536">分</span><span begin="0:55.536" end="0:55.676">じゃ</span><span begin="0:55.676" end="0:55.896">なく</span><span begin="0:55.896" end="0:56.176">て</span></p><p begin="0:56.168" end="0:57.198" itunes:key="L13" ttm:agent="v1"><span begin="0:56.168" end="0:56.388">今</span><span begin="0:56.388" end="0:56.488">に</span><span begin="0:56.488" end="0:56.618">も</span><span begin="0:56.618" end="0:56.738">泣</span><span begin="0:56.738" end="0:56.958">き出</span><span begin="0:56.958" end="0:57.098">し</span><span begin="0:57.098" end="0:57.198">て</span></p><p begin="0:57.199" end="0:58.019" itunes:key="L14" ttm:agent="v1"><span begin="0:57.199" end="0:57.329">し</span><span begin="0:57.329" end="0:57.539">まい</span><span begin="0:57.539" end="0:57.859">そう</span><span begin="0:57.859" end="0:58.019">な</span></p><p begin="0:58.021" end="0:59.511" itunes:key="L15" ttm:agent="v1"><span begin="0:58.021" end="0:58.311">暗</span><span begin="0:58.311" end="0:58.561">闇</span><span begin="0:58.561" end="0:58.761">の</span><span begin="0:58.761" end="0:59.121">中</span><span begin="0:59.121" end="0:59.411">独</span><span begin="0:59.411" end="0:59.511">り</span></p><p begin="0:59.519" end="1:00.589" itunes:key="L16" ttm:agent="v1"><span begin="0:59.519" end="0:59.659">た</span><span begin="0:59.659" end="0:59.779">だ</span><span begin="0:59.779" end="1:00.129">迷っ</span><span begin="1:00.129" end="1:00.299">て</span><span begin="1:00.299" end="1:00.399">い</span><span begin="1:00.399" end="1:00.589">る</span></p><p begin="1:00.947" end="1:02.447" itunes:key="L17" ttm:agent="v1"><span begin="1:00.947" end="1:01.357">哀</span><span begin="1:01.357" end="1:01.927">しい</span><span begin="1:01.927" end="1:02.447">人</span></p><p begin="1:02.441" end="1:03.381" itunes:key="L18" ttm:agent="v1"><span begin="1:02.441" end="1:02.791">大</span><span begin="1:02.791" end="1:03.161">丈</span><span begin="1:03.161" end="1:03.381">夫</span></p><p begin="1:03.684" end="1:06.094" itunes:key="L19" ttm:agent="v1"><span begin="1:03.684" end="1:03.804">い</span><span begin="1:03.804" end="1:04.094">つ</span><span begin="1:04.094" end="1:04.284">か</span><span begin="1:04.284" end="1:04.704">大</span><span begin="1:04.704" end="1:05.084">丈</span><span begin="1:05.084" end="1:05.334">夫</span><span begin="1:05.564" end="1:05.724">に</span><span begin="1:05.724" end="1:05.974">な</span><span begin="1:05.974" end="1:06.094">る</span></p><p begin="1