<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="SENKOUHANABI (feat. LILAS IKUTA)"/><amll:meta key="artists" value="CHIAKI SATO"/><amll:meta key="album" value="SENKOUHANABI (feat. LILAS IKUTA) - Single"/><amll:meta key="isrc" value="JPB602302334"/><amll:meta key="appleMusicId" value="1690015442"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration><text for="L1">omatsurisawagi</text><text for="L2">bokura uiteru ne</text><text for="L3">ukiashidatsu yoru</text><text for="L4">tokenai aisu tabeyou</text><text for="L5">tsuide no furi shite shi no go no</text><text for="L6">kogitsuketa chiisana gishiki</text><text for="L7">kyou no koto wa wasuretakunai na</text><text for="L8">firumu maite yo</text><text for="L9">kirakira to kagayaite aa</text><text for="L10">fukurande afureochita</text><text for="L11">kono natsu o owarasenaide hora</text><text for="L12">mou ikkai hi o tsukeyou</text><text for="L15">me to kuchi mitete</text><text for="L16">gomen kiite nakatta</text><text for="L17">nani no hanashi dakke?</text><text for="L18">amerikaano de yurushite</text><text for="L19">arukooru wa iranai kara</text><text for="L20">ongaku demo kikou yo kimi no</text><text for="L21">suki na kyoku o imasugu oshiete</text><text for="L22">oboetoku kara</text><text for="L23">yurayura to yurameite aa</text><text for="L24">kasanatte hajiketonda</text><text for="L25">kono netsu ga sameteku mae ni hora</text><text for="L26">saikou no natsu ni shiyou</text><text for="L27">kirakira to kagayaite</text><text for="L28">yurayura to yurameite</text><text for="L29">butchake sa kimi no koto aa</text><text for="L30">zutto mae kara mite itanda</text><text for="L31">hitonatsu de owarasenaide saa</text><text for="L32">nankai mo hi o tsukeyou</text><text for="L33">kirakira to kagayaite aa</text><text for="L34">fukurande afureochita</text><text for="L35">kono natsu o owarasenaide hora</text><text for="L36">mou ikkai hi o tsukeyou</text></transliteration></transliterations><songwriters><songwriter>CHIAKI SATO</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">祭典喧闹</text><text for="L2">我们好像有些格格不入呢</text><text for="L3">心绪浮动的夜晚</text><text for="L4">来吃不会融化的冰淇淋吧</text><text for="L5">假装只是顺路 又东拉西扯</text><text for="L6">才好不容易促成这小小仪式</text><text for="L7">今天的事真不想忘记啊</text><text for="L8">替我卷好胶片吧</text><text for="L9">闪闪发亮啊</text><text for="L10">渐渐膨胀 满溢而落</text><text for="L11">别让这个夏天结束啊 你看</text><text for="L12">让我们再点一次火吧</text><text for="L13">Oh</text><text for="L14">Oh</text><text for="L15">看着你的眼睛和嘴唇</text><text for="L16">抱歉 我刚才没听见</text><text for="L17">刚刚说到哪儿了？</text><text for="L18">请你喝杯美式就原谅我吧</text><text for="L19">酒就不必喝了</text><text for="L20">不如听听音乐吧 你的</text><text for="L21">喜欢的歌现在就告诉我</text><text for="L22">我会记在心上</text><text for="L23">轻轻摇曳啊</text><text for="L24">交叠着迸散开来</text><text for="L25">趁这份热意消退之前 来吧</text><text for="L26">共度最美好的夏天</text><text for="L27">闪闪发亮</text><text for="L28">轻轻摇曳</text><text for="L29">说实话啊 对于你</text><text for="L30">我从很久以前就一直注视着</text><text for="L31">别让一切只停在这个夏天 来吧</text><text for="L32">让我们一次次点亮火光</text><text for="L33">闪闪发亮啊</text><text for="L34">渐渐膨胀 满溢而落</text><text for="L35">别让这个夏天结束啊 你看</text><text for="L36">让我们再点一次火吧</text><text for="L37">Oh</text><text for="L38">Oh</text><text for="L39">Oh</text><text for="L40">Oh</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:13.880"><div begin="0:17.746" end="3:13.880"><p begin="0:17.746" end="0:19.876" itunes:key="L1" ttm:age