<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Just the Same"/><amll:meta key="artists" value="Charlotte Lawrence"/><amll:meta key="album" value="Just the Same - Single"/><amll:meta key="isrc" value="QM24S1705865"/><amll:meta key="appleMusicId" value="1555187732"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Charlotte Lawrence</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">对你稍稍生了倦意</text><text for="L2">又因你泛起几分落寞</text><text for="L3">微醺迷离 快抽离我的神思</text><text for="L4">因我满心满眼全都是你</text><text for="L5">心底涌起一丝懊恼</text><text for="L6">只想与你共赴沉迷</text><text for="L7">不想辜负寸缕光阴</text><text for="L8">不愿轻言道别</text><text for="L9">思绪在翻涌 心潮在澎湃</text><text for="L10">身体也有感觉 却无法拒绝 怎么也说不出口</text><text for="L11">你玩弄我的心智 戏弄我的真心</text><text for="L12">撩拨我的骨血 却难以割舍 怎么也放不下</text><text for="L13">我恨极了你</text><text for="L14">却依旧深陷爱意</text><text for="L15">你将我的心生生撕裂</text><text for="L16">手法却精妙绝伦</text><text for="L17">是何等病态扭曲</text><text for="L18">我竟沉沦于你的把戏</text><text for="L19">可我情不自禁</text><text for="L20">依旧如初爱着你</text><text for="L21">深情一如往昔</text><text for="L22">初心从未稍改</text><text for="L23">为你渐生痴狂</text><text for="L24">只是枯坐在此候你归来</text><text for="L25">心绪略显低落 索性出门游荡</text><text for="L26">不愿独守空房没有你</text><text for="L27">万千歉意涌上心头</text><text for="L28">终究还是奔向了你</text><text for="L29">夜已深沉</text><text for="L30">我绝不说再见</text><text for="L31">神魂在游走 情感在翻涌</text><text for="L32">周身都在共鸣 却无法拒绝 无法退却分毫</text><text for="L33">你操弄着我的神思 玩弄我的深情</text><text for="L34">掌控着我的每一寸呼吸 却斩不断羁绊 无法放手</text><text for="L35">我恨透了你</text><text for="L36">却依旧执迷深爱</text><text for="L37">你将我剜心剔骨</text><text for="L38">分寸却恰到好处</text><text for="L39">何其荒诞病态</text><text for="L40">甘心在局中沉浮</text><text for="L41">可我无力抗拒</text><text for="L42">依然无可救药爱着你</text><text for="L43">炽烈未减半分</text><text for="L44">深爱始终如一</text><text for="L45">纵然痛彻依然爱你</text><text for="L46">此心矢志不渝</text><text for="L47">我真真切切恨你</text><text for="L48">却始终无法停止爱你</text><text for="L49">你将我心房击碎</text><text for="L50">每次都正中要害</text><text for="L51">如此疯狂扭曲</text><text for="L52">任由你掌控主宰</text><text for="L53">但我难以自拔</text><text for="L54">满心满眼仍是你</text><text for="L55">我真的恨透了你</text><text for="L56">爱意却如期而至</text><text for="L57">你撕裂我的胸膛</text><text for="L58">姿态却无可挑剔</text><text for="L59">纠缠得这般病态</text><text for="L60">甘愿陪你走到结局</text><text for="L61">根本无从挣脱</text><text for="L62">唯有爱你如初</text><text for="L63">爱意永不褪色</text><text for="L64">爱你至死靡它</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:30.714"><div begin="0:01.854" end="3:30.714"><p begin="0:01.854" end="0:04.164" itunes:key="L1" ttm:agent="v1"><span begin="0:01.854" end="0:02.094">Just</span> <span begin="0:02.094" end="0:02.164">a</span> <span begin="0:02.164" end="0:02.544">little</span> <span begin="0:02.544" end="0:02.794">bit</span> <span begin="0:02.794" end="0:03.544">tired</span> <span begin="0:03.544" end="0:03.854">of</span> <span begin="0:03.854" end="0:04.164">you</span></p><p begin="0:04.474" end="0:06.754" itunes:key="L2" ttm:agent="v1"><span begin="0:04.474" end="0:04.694">Just</span> <span begin="0:04.694" end="0:04.774">a</span> <span begin="0:04.774" end="0:05.124">little</span> <span begin="0:05.124" end="0:05.434">bit</span> <span begin="0:05.434" end="0:05.904">lone</span><span begin="0:05.904" end="0:06.034">ly</span> <span begin="0:06.034" end="0:06.404">for</span> <span begin="0:06.404" end="0:06.754">you</span></p><p begin="0:07.074" end="0:09.694" itunes:key="L3" ttm:agent="v1"><span begin="0:07.074" end="0:07.304">Just</span> <span begin="0:07.304" en