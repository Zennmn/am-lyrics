<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Viva La Vida"/><amll:meta key="artists" value="Coldplay"/><amll:meta key="album" value="Viva La Vida or Death and All His Friends"/><amll:meta key="isrc" value="GBAYE1600217"/><amll:meta key="appleMusicId" value="1122773680"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Chris Martin, Guy Berryman, Jonny Buckland &amp; Will Champion</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我曾君临天下</text><text for="L2">一声令下便能翻江倒海</text><text for="L3">如今清晨却形单影只</text><text for="L4">清扫着昔日属于我的长街</text><text for="L5">我曾掷下命运的骰子</text><text for="L6">眼见宿敌眼中写满惊恐</text><text for="L7">静听万民高声呼喊</text><text for="L8">旧王已死新王万岁</text><text for="L9">前一刻我权柄在握</text><text for="L10">转瞬间高墙便将我紧紧封锁</text><text for="L11">才惊觉我的万仞宫阙</text><text for="L12">竟尽数筑于盐柱沙砾之上</text><text for="L13">我听见圣城钟声悠扬回荡</text><text for="L14">罗马骑兵颂歌高亢唱响</text><text for="L15">愿做我的明镜利剑与坚盾</text><text for="L16">愿作远赴异域的传道信徒</text><text for="L17">不知究竟是何缘故</text><text for="L18">自你离去之后</text><text for="L19">世间便再无半句真言</text><text for="L20">而那正是我主宰天下的岁月</text><text for="L21">狂暴的烈风呼啸而至</text><text for="L22">吹开大门让我得以进入</text><text for="L23">窗棂碎裂战鼓轰鸣</text><text for="L24">世人不敢相信我蜕变后的模样</text><text for="L25">起义的人群翘首以盼</text><text for="L26">要将我的头颅盛在银盘之上</text><text for="L27">不过是一根孤线提着的木偶</text><text for="L28">又有谁当真渴望加冕为王</text><text for="L29">我听见圣城钟声鸣响</text><text for="L30">罗马骑兵的合唱声响起</text><text for="L31">做我的明镜利剑与盾牌</text><text for="L32">做我远赴异乡的传道者</text><text for="L33">不知因何缘由</text><text for="L34">深知圣彼得绝不会呼唤我的名字</text><text for="L35">耳畔再无半句真言</text><text for="L36">可那正是我统御天下的昔日</text><text for="L37">噢 噢 噢 噢 噢 噢</text><text for="L38">噢 噢 噢 噢 噢 噢</text><text for="L39">噢 噢 噢 噢 噢 噢</text><text for="L40">噢 噢 噢 噢 噢 噢</text><text for="L41">噢 噢 噢 噢 噢 噢</text><text for="L42">细听圣城钟声回荡 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(噢 噢 噢 噢 噢 噢)</span></text><text for="L43">罗马铁骑的合唱声震四方 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(噢 噢 噢 噢 噢 噢)</span></text><text for="L44">化作明镜与盾剑 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(噢 噢 噢 噢 噢 噢)</span></text><text for="L45">任布道使者远涉异邦 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(噢 噢 噢 噢 噢 噢)</span></text><text for="L46">茫然不知其故 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(噢 噢 噢 噢 噢 噢)</span></text><text for="L47">我知圣彼得永不会召我入天堂之门</text><text for="L48">身畔未曾听闻坦诚之言</text><text for="L49">可那正是我统御世界的岁月</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:42.125"><div begin="0:12.741" end="3:42.125"><p begin="0:12.741" end="0:16.514" itunes:key="L1" ttm:agent="v1"><span begin="0:12.741" end="0:13.055">I</span> <span begin="0:13.055" end="0:13.455">used</span> <span begin="0:13.455" end="0:13.909">to</span> <span begin="0:13.909" end="0:15.173">rule</span> <span begin="0:15.173" end="0:15.490">the</span> <span begin="0:15.490" end="0:16.514">world</span></p><p begin="0:16.674" end="0:19.298" itunes:key="L2" ttm:agent="v1"><span begin="0:16.674" end="0:17.124">Seas</span> <span begin="0:17.124" end="0:17.391">would</span> <span begin="0:17.391" end="0:17.842">rise</span> <span begin="0:17.842" end="0:18.090">when</span> <span begin="0:18.090" end="0:18.324">I</span> <span begin="0:18.324" end="0:18.708">gave</span> <span begin="0:18.708" end="0:18.940">the</span> <span begin="0:18.940" end="0:19.298">word</span></p><p begin="0:19.298" end="0:23.356" itunes:key="L3" ttm:agent="v1"><span begin="0:19.298" end="0:19.546">Now</span> <span begin="0:19.546" end="0:19.762">in</span> <span begin="0:19.762" end="0:19.978">the</span> <span begin="0:19.978" end="0:20.396">morning,</span> <span begin="0:20.396" end="0:20.828">I</span> <span begin="0:20.828" end="0:22.130">sleep</span> <span begin="0:22.130" end="0:23.356">alone</span></p><p begin="0:23.575" end="0:27.181" itunes:key="L4" ttm:agent="v1"><span begin="0:23.575" end="0:24.010">Sweep</span> <span begin="0:24.010" end="0:24.225">the</span> <span begin="0:24.225" end="0:24.776">streets</span> <span begin="0:24.776" end="0:25.209">I</span> <span begin="0:25.209" end="0:25.659">used</span> <span begin="0:25.659" end="0:25.943">to</span> <span begin="0:25.943" end="0:27.181">own</span></p><p begin="0:40.584" end="0:44.283" itunes:key="L5" ttm:agent="v1"><span begin="0:40.584" end="0:40.899">I</span> <span begin="0:40.899" end="0:41.299">used</span> <span begin="0:41.299" end="0:41.733">to</span> <span begin="0:41.733" end="0:43.016">roll</span> <span begin="0:43.016" end="0:43.315">the</span> <span begin="0:43.315" end="0:44.283">dice</span></p><p begin="0:44.566" end="0:47.593" itunes:key="L6" ttm:agent="v1"><span begin="0:44.566" end="0:45.016">Feel</span> <span begin="0:45.016" end="0:45.264">the</span> <span begin="0:45.264" end="0:45.680">fear</span> <span begin="0:45.680" end="0:45.915">in</span> <span begin="0:45.915" end="0:46.166">my</span> <span begin="0:46.166" end="0:46.731">enemy's</span> <span begin="0:46.731" end="0:47.593">eyes</span></p><p begin="0:47.782" end="0:51.267" itunes:key="L7" ttm:agent="v1"><span begin="0:47.782" end="0:48.297">Listen</span> <span begin="0:48.297" end="0:48.531">as</span> <span begin="0:48.531" end="0:48.747">the</span> <span begin="0:48.747" end="0:49.763">crowd</span> <span begin="0:49.763" end="0:50.163">would</span> <span begin="0:50.163" end="0:51.267">sing</span></p><p begin="0:51.670" end="0:54.504" itunes:key="L8" ttm:agent="v1"><span begin="0:51.670" end="0:51.920">Now</span> <span begin="0:51.920" end="0:52.171">the</span> <span begin="0:52.171" end="0:52.371">old</span> <span begin="0:52.371" end="0:52.587">king</span> <span begin="0:52.587" end="0:52.822">is</span> <span begin="0:52.822" end="0:53.392">dead,</span> <span begin="0:53.392" end="0:53.587">long</span> <span begin="0:53.587" end="0:53.787">live</span> <span begin="0:53.787" end="0:54.038">the</span> <span begin="0:54.038" end="0:54.504">king</span></p><p begin="0:54.504" end="0:58.219" itunes:key="L9" ttm:agent="v1"><span begin="0:54.504" end="0:54.752">One</span> <span begin="0:54.752" end="0:55.187">minute,</span> <span begin="0:55.187" end="0:55.580">I</span> <span begin="0:55.580" end="0:56.936">held</span> <span begin="0:56.936" end="0:57.203">the</span> <span begin="0:57.203" end="0:58.219">key</span></p><p begin="0:58.458" end="1:01.101" itunes:key="L10" ttm:agent="v1"><span begin="0:58.458" end="0:58.890">Next,</span> <span begin="0:58.890" end="0:59.140">the</span> <span begin="0:59.140" end="0:59.772">walls</span> <span begin="0:59.772" end="1:00.007">were</span> <span begin="1:00.007" end="1:00.439">closed</span> <span begin="1:00.439" end="1:00.874">on</span> <span begin="1:00.874" end="1:01.101">me</span></p><p begin="1:01.106" end="1:05.136" itunes:key="L11" ttm:agent="v1"><span begin="1:01.106" end="1:01.338">And</span> <span begin="1:01.338" end="1:01.554">I</span> <span begin="1:01.554" end="1:02.173">discovered</span> <span begin="1:02.173" end="1:02.405">that</span> <span begin="1:02.405" end="1:02.640">my</span> <span begin="1:02.640" end="1:03.580">ca</span><span begin="1:03.580" end="1:04.106">stles</span> <span begin="1:04.106" end="1:05.136">stand</span></p><p begin="1:05.379" end="1:08.969" itunes:key="L12" ttm:agent="v1"><span begin="1:05.379" end="1:06.046">Upon</span> <span begin="1:06.046" end="1:06.513">pillars</span> <span begin="1:06.513" end="1:06.779">of</span> <span begin="1:06.779" end="1:07.198">salt</span> <span begin="1:07.198" end="1:07.481">and</span> <span begin="1:07.481" end="1:07.846">pillars</span> <span begin="1:07.846" end="1:08.046">of</span> <span begin="1:08.046" end="1:08.969">sand</span></p><p begin="1:09.276" end="1:12.680" itunes:key="L13" ttm:agent="v1"><span begin="1:09.276" end="1:09.526">I</span> <span begin="1:09.526" end="1:09.961">hear</span> <span begin="1:09.961" end="1:10.616">Jeru</span><span begin="1:10.616" end="1:11.083">salem</span> <span begin="1:11.083" end="1:11.721">bells</span> <span begin="1:11.721" end="1:11.956">are</span> <span begin="1:11.956" end="1:12.390">ring</span><span begin="1:12.390" end="1:12.680">ing</span></p><p begin="1:12.992" end="1:16.241" itunes:key="L14" ttm:agent="v1"><span begin="1:12.992" end="1:13.485">Ro</span><span begin="1:13.485" end="1:13.870">man</span> <span begin="1:13.870" end="1:14.490">cavalry</span> <span begin="1:14.490" end="1:15.236">choirs</span> <span begin="1:15.236" end="1:15.468">are</span> <span begin="1:15.468" end="1:16.241">singing</span></p><p begin="1:16.480" end="1:19.711" itunes:key="L15" ttm:agent="v1"><span begin="1:16.480" end="1:16.913">Be</span> <span begin="1:16.913" end="1:17.345">my</span> <span begin="1:17.345" end="1:17.813">mirror,</span> <span begin="1:17.813" end="1:18.021">my</span> <span begin="1:18.021" end="1:18.646">sword</span> <span begin="1:18.646" end="1:18.889">and</span> <span begin="1:18.889" end="1:19.711">shield</span></p><p begin="1:19.783" end="1:23.132" itunes:key="L16" ttm:agent="v1"><span begin="1:19.783" end="1:20.050">My</span> <span begin="1:20.050" end="1:20.452">mission</span><span begin="1:20.452" end="1:20.786">ar</span><span begin="1:20.786" end="1:21.066">ies</span> <span begin="1:21.066" end="1:21.263">in</span> <span begin="1:21.263" end="1:21.464">a</span> <span begin="1:21.464" end="1:21.873">for</span><span begin="1:21.873" end="1:22.367">eign</span> <span begin="1:22.367" end="1:23.132">field</span></p><p begin="1:23.379" end="1:26.551" itunes:key="L17" ttm:agent="v1"><span begin="1:23.379" end="1:23.829">For</span> <span begin="1:23.829" end="1:24.261">some</span> <span begin="1:24.261" end="1:24.795">reason</span> <span begin="1:24.795" end="1:24.996">I</span> <span begin="1:24.996" end="1:25.437">can't</span> <span begin="1:25.437" end="1:26.551">explain</span></p><p begin="1:26.931" end="1:29.279" itunes:key="L18" ttm:agent="v1"><span begin="1:26.931" end="1:27.381">Once</span> <span begin="1:27.381" end="1:27.831">you'd</span> <span begin="1:27.831" end="1:28.246">gone,</span> <span begin="1:28.246" end="1:28.495">there</span> <span begin="1:28.495" end="1:28.713">was</span> <span begin="1:28.713" end="1:29.279">never</span></p><p begin="1:29.448" end="1:33.076" itunes:key="L19" ttm:agent="v1"><span begin="1:29.448" end="1:29.927">Never</span> <span begin="1:29.927" end="1:30.177">an</span> <span begin="1:30.177" end="1:31.445">ho</span><span begin="1:31.445" end="1:31.877">nest</span> <span begin="1:31.877" end="1:33.076">word</span></p><p begin="1:33.250" end="1:36.896" itunes:key="L20" ttm:agent="v1"><span begin="1:33.250" end="1:33.502">And</span> <span begin="1:33.502" end="1:33.735">that</span> <span begin="1:33.735" end="1:33.935">was</span> <span begin="1:33.935" end="1:34.152">when</span> <span begin="1:34.152" end="1:34.765">I</span> <span begin="1:34.765" end="1:35.183">ruled</span> <span begin="1:35.183" end="1:35.485">the</span> <span begin="1:35.485" end="1:36.896">world</span></p><p begin="1:49.761" end="1:53.740" itunes:key="L21" ttm:agent="v1"><span begin="1:49.761" end="1:50.000">It</span> <span begin="1:50.000" end="1:50.236">was</span> <span begin="1:50.236" end="1:50.471">a</span> <span begin="1:50.471" end="1:50.871">wicked</span> <span begin="1:50.871" end="1:51.103">and</span> <span begin="1:51.103" end="1:52.785">wild</span> <span begin="1:52.78