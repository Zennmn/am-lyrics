<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Take Me Hand"/><amll:meta key="artists" value="DAISHI DANCE"/><amll:meta key="artists" value="Cécile Corbel"/><amll:meta key="album" value="Take Me Hand"/><amll:meta key="isrc" value="FRX452024549"/><amll:meta key="appleMusicId" value="1503322249"/><amll:meta key="ttmlAuthorGithub" value="37899975"/><amll:meta key="ttmlAuthorGithubLogin" value="WorldSansha"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">在我的梦中 我感受到你的光芒</text><text for="L2">我感受到爱意再次萌芽</text><text for="L3">那晚月光下的萤火虫</text><text for="L4">就像冉冉升起的星辰</text><text for="L5">记得我爱上你的那一天</text><text for="L6">亲爱的 请不要让我心碎</text><text for="L7">此刻请牵起我的手</text><text for="L8">紧紧依偎我身旁</text><text for="L9">成为我的爱人吧</text><text for="L10">请不要离我而去</text><text for="L11">此刻闭上双眼</text><text for="L12">你将会看见</text><text for="L13">有一朵绚丽的彩虹</text><text for="L14">只属于你我</text><text for="L15">当我苏醒 你的脸庞映入眼帘</text><text for="L16">我感受到爱意再次萌芽</text><text for="L17">樱花纷飞</text><text for="L18">飞鸟掠过天际</text><text for="L19">你可见那朝阳</text><text for="L20">此刻正照耀着田野</text><text for="L21">它是否也照亮了你的心房</text><text for="L22">此刻请牵起我的手</text><text for="L23">紧紧依偎我身旁</text><text for="L24">成为我的爱人吧</text><text for="L25">请不要离我而去</text><text for="L26">现在闭上双眼</text><text for="L27">你就会看见</text><text for="L28">有一朵绚丽的彩虹</text><text for="L29">只属于你我</text><text for="L30">我每夜都梦见你</text><text for="L31">因为我的脑海只有你</text><text for="L32">你会成为我生命中的陌生人还是挚友</text><text for="L33">亲爱的 请不要让我心碎</text><text for="L34">现在就握住我的手</text><text for="L35">紧紧靠近我</text><text for="L36">成为我的爱人</text><text for="L37">不要放开我</text><text for="L38">现在闭上双眼</text><text for="L39">你就会看见</text><text for="L40">有一朵绚丽的彩虹</text><text for="L41">只属于你我</text><text for="L42">现在就握住我的手</text><text for="L43">紧紧靠近我</text><text for="L44">成为我的爱人</text><text for="L45">不要离开我</text><text for="L46">现在闭上双眼</text><text for="L47">你就会看见</text><text for="L48">有一朵绚丽的彩虹</text><text for="L49">只属于你我</text><text for="L50">亲爱的 现在就握住我的手</text><text for="L51">此刻请牵起我的手</text><text for="L52">紧紧依偎我身旁</text><text for="L53">你能否紧紧靠近我</text><text for="L54">成为我的爱人</text><text for="L55">不要离我而去</text><text for="L56">你能否成为我的爱人</text><text for="L57">此刻闭上双眼</text><text for="L58">你就会看见</text><text for="L59">请不要放开我</text><text for="L60">有一朵绚丽的彩虹</text><text for="L61">只属于你我</text></translation></translations><songwriters><songwriter>DAISHI DANCE &amp; CORBEL CECILE MARIE HELENE</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:15.148"><div begin="0:59.667" end="4:15.148"><p begin="0:59.667" end="1:03.330" itunes:key="L1" ttm:agent="v1"><span begin="0:59.667" end="1:00.088">In</span> <span begin="1:00.088" end="1:00.529">my</span> <span begin="1:00.529" end="1:01.266">dreams,</span> <span begin="1:01.489" end="1:01.928">I</span> <span begin="1:01.928" end="1:02.378">feel</span> <span begin="1:02.378" end="1:02.881">your</span> <span begin="1:02.881" end="1:03.330">light</span></p><p begin="1:03.330" end="1:06.618" itunes:key="L2" ttm:agent="v1"><span begin="1:03.330" end="1:03.765">I</span> <span begin="1:03.765" end="1:04.249">feel</span> <span begin="1:04.249" end="1:04.719">lo</span><span begin="1:04.719" end="1:04.958">ve is</span> <span begin="1:04.958" end="1:05.673">born</span> <span begin="1:05.673" end="1:06.618">again</span></p><p begin="1:07.092" end="1:10.590" itunes:key="L3" ttm:agent="v1"><span begin="1:07.092" end="1:07.999">Fire</span><span begin="1:07.999" end="1:08.713">flies</span> <span begin="1:08.961" end="1:09.445">in</span> <span begin="1:09.445" end="1:09.650">the</span> <span be