<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Galdive</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">想知道为什么</text><text for="L2">这所有的情感</text><text for="L3">这一直把我拉近于你</text><text for="L4">想知道为什么</text><text for="L5">这所有的情感</text><text for="L6">这一直把我拉近于你</text><text for="L7">我们真的被困在这个思想空间里了吗？</text><text for="L8">是吗，是吗？</text><text for="L9">你打算摆脱这阴霾吗</text><text for="L10">和我一起逃走</text><text for="L11">告诉我你想去哪里</text><text for="L12">Oh告诉我</text><text for="L13">任何地方，除了这里的任何地方</text><text for="L14">只要告诉我你所想</text><text for="L15">想知道为什么我们情感联系在一起？</text><text for="L16">乞求和杀戮的爱情都在虚拟世界里</text><text for="L17">被这云彩所迷住</text><text for="L18">我想知道为什么这些感觉都是错觉</text><text for="L19">如果我真的有感觉的话</text><text for="L20">我仍然不相信</text><text for="L21">你打算怎么结束这段感情</text><text for="L22">经过这么多追赶</text><text for="L23">说出你看到的，你想到的，你真正需要的</text><text for="L24">你脑袋里所有的</text><text for="L25">任何地方，除了这里的任何地方</text><text for="L26">只要告诉我你所想</text><text for="L27">想知道为什么我们情感联系在一起？</text><text for="L28">乞求和杀戮的爱情都在虚拟世界里</text><text for="L29">被这云彩所迷住</text><text for="L30">我想知道为什么这些感觉都是错觉</text><text for="L31">这一直把我拉近于你</text><text for="L32">想知道为什么</text><text for="L33">这所有的情感</text><text for="L34">这一直把我拉近于你</text><text for="L35">想知道为什么</text><text for="L36">这一直把我拉近于你</text><text for="L37">想知道为什么</text><text for="L38">这一直把我拉近于你</text><text for="L39">Wonder why</text><text for="L40">想知道为什么我们情感联系在一起？</text><text for="L41">乞求和杀戮的爱情都在虚拟世界里</text><text for="L42">被这云彩所迷住</text><text for="L43">我想知道为什么这些感觉都是错觉</text><text for="L44">我们真的被困在这个思想空间里了吗？</text><text for="L45">是吗，是吗？</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:00.420" end="0:03.240" itunes:key="L1" ttm:agent="v1"><span begin="0:00.420" end="0:01.200">Wonder</span> <span begin="0:01.200" end="0:03.240">why</span></p><p begin="0:03.240" end="0:07.260" itunes:key="L2" ttm:agent="v1"><span begin="0:03.240" end="0:04.580">All</span> <span begin="0:04.580" end="0:05.920">this</span> <span begin="0:05.920" end="0:07.260">feeling</span></p><p begin="0:07.260" end="0:09.120" itunes:key="L3" ttm:agent="v1"><span begin="0:07.260" end="0:07.525">It</span> <span begin="0:07.525" end="0:07.790">keeps</span> <span begin="0:07.790" end="0:08.055">pulling</span> <span begin="0:08.055" end="0:08.320">in</span> <span begin="0:08.320" end="0:08.585">myself</span> <span begin="0:08.585" end="0:08.850">to</span> <span begin="0:08.850" end="0:09.120">you</span></p><p begin="0:13.230" end="0:16.260" itunes:key="L4" ttm:agent="v1"><span begin="0:13.230" end="0:13.920">Wonder</span> <span begin="0:13.920" end="0:16.260">why</span></p><p begin="0:16.440" end="0:19.200" itunes:key="L5" ttm:agent="v1"><span begin="0:16.440" end="0:16.770">All</span> <span begin="0:16.770" end="0:17.160">this</span> <span begin="0:17.160" end="0:19.200">feeling</span></p><p begin="0:19.620" end="0:27.540" itunes:key="L6" ttm:agent="v1"><span begin="0:19.620" end="0:19.950">It</span> <span begin="0:19.950" end="0:21.150">keeps</span> <span begin="0:21.150" end="0:21.690">pulling</span> <span begin="0:21.690" end="0:21.960">in</span> <span begin="0:21.960" end="0:23.250">myself</span> <span begin="0:23.250" end="0:23.310">to</span> <span begin="0:23.310" end="0:24.060">you</span><span ttm:role="x-bg" begin="0:24.060" end="0:27.540"><span begin="0:26.010" end="0:26.760">Wonder</span> <span begin="0:26.760" end="0:27.210">why</span></span></p></div><div itunes:song-part="Chorus"><p begin="0:27.540" end="0:30.810" itunes:key="L7" ttm:ag