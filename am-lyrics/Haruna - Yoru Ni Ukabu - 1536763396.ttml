<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Yoru Ni Ukabu"/><amll:meta key="artists" value="Haruna"/><amll:meta key="album" value="Yoru Ni Ukabu - Single"/><amll:meta key="isrc" value="JPG102000972"/><amll:meta key="appleMusicId" value="1536763396"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Haruna</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">总有一天会如愿以偿</text><text for="L2">怀着心愿将今天轻轻合上</text><text for="L3">寻求一份安宁</text><text for="L4">曾经落泪都怪那一夜的月色</text><text for="L5">曾做过一场梦 那是一场长梦</text><text for="L6">却迟迟无法醒来</text><text for="L7">曾那样温柔 也曾那样严厉</text><text for="L8">我想起了那个人</text><text for="L9">无论走到哪里都不曾改变</text><text for="L10">仰望那片染成灰色的天空</text><text for="L11">说着「都无所谓了」</text><text for="L12">那般叹息都怪我自己 Ah ah</text><text for="L13">梦已消逝 那是一场淡淡的梦</text><text for="L14">有时真想舍弃一切</text><text for="L15">曾满溢着 曾闪耀着</text><text for="L16">如今艳羡着那段时光</text><text for="L17">曾身在梦中 那是一场漫长的梦</text><text for="L18">一路悠悠摇荡 随波流转至今</text><text for="L19">在一次次循环往复之间</text><text for="L20">一遍又一遍 无论多少遍</text><text for="L21">梦是旅途 也是生存之道</text><text for="L22">至今依然无法放弃</text><text for="L23">让它浮于夜色 若能将它点亮</text><text for="L24">我会一直一直坚信下去</text><text for="L25">静静地再一次入梦</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:05.4