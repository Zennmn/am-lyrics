<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Burn Out"/><amll:meta key="artists" value="Imagine Dragons"/><amll:meta key="album" value="Origins (Deluxe Edition)"/><amll:meta key="isrc" value="USUM71816169"/><amll:meta key="appleMusicId" value="1437949221"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">隐忍能走的路终有穷尽</text><text for="L2">浴血方可跋涉到更远方</text><text for="L3">苦痛只会让一颗心坚硬如铁</text><text for="L4">飘摇在暴烈的风雨之中</text><text for="L5">纯真无邪的模样如此动人</text><text for="L6">能否替我将它装匣珍藏</text><text for="L7">留予我吗</text><text for="L8">赐予我力量 赐予我安宁</text><text for="L9">茫茫人世可有人愿听我倾诉</text><text for="L10">不过是又一场倾盆狂雨 切莫被它轻易击垮</text><text for="L11">跌至谷底便唯有向上 点燃你体内所有的光芒</text><text for="L12">别燃尽成灰 别弃我而去</text><text for="L13">别就此熄灭 别离我而去</text><text for="L14">悲伤本与我为敌</text><text for="L15">我怕岁月待它过于温和</text><text for="L16">伴我身旁走过了漫漫经年</text><text for="L17">如今倒仿佛与它熟稔如故</text><text for="L18">幸福的光芒如此令人神往</text><text for="L19">可否为我将它细细封存</text><text for="L20">赠予我吗</text><text for="L21">祈求赐我力量 予我宁静</text><text for="L22">天地之间可有人愿听我的声音</text><text for="L23">不过又是一场漫天骤雨 莫让它将你彻底吞噬</text><text for="L24">既已触底便唯有奋起 点亮你灵魂深处的所有火光</text><text for="L25">莫燃尽所有 别弃我而去</text><text for="L26">别熄灭微芒 别离开我</text><text for="L27">不过是一场倾盆大雨 不过是一场暴烈风雨</text><text for="L28">不过又是一场瓢泼狂雨 绝别向它俯首认输</text><text for="L29">跌落尘埃后唯有凌空而起 点燃你胸中全部的光芒</text><text for="L30">我不想放开你的手 我绝不愿放手</text><text for="L31">别燃尽心火 莫离我而去</text><text for="L32">我舍不得让你离开 我不想松开手</text><text for="L33">别就此熄灭 别弃我而去</text></translation></translations><songwriters><songwriter>Dan Reynolds</songwriter><songwriter>Wayne Sermon</songwriter><songwriter>Ben McKee &amp; Daniel Platzman</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:22.458"><div begin="0:40.621" end="4:22.458"><p begin="0:40.621" end="0:44.891" itunes:key="L1" ttm:agent="v1"><span begin="0:40.621" end="0:40.991">Pa</span><span begin="0:40.991" end="0:41.651">tience</span> <span begin="0:41.651" end="0:42.081">on</span><span begin="0:42.081" end="0:42.371">ly</span> <span begin="0:42.371" end="0:42.961">gets</span> <span begin="0:42.961" end="0:43.221">you</span> <span begin="0:43.221" end="0:43.851">so</span> <span begin="0:44.101" end="0:44.891">far</span></p><p begin="0:45.071" end="0:47.501" itunes:key="L2" ttm:agent="v1"><span begin="0:45.071" end="0:45.751">Blood</span> <span begin="0:45.751" end="0:45.941">will</span> <span begin="0:45.941" end="0:46.331">get</span> <span begin="0:46.331" end="0:46.741">you</span> <span begin="0:46.741" end="0:47.341">fur</span><span begin="0:47.341" end="0:47.501">ther</span></p><p begin="0:47.817" end="0:52.017" itunes:key="L3" ttm:agent="v1"><span begin="0:47.817" end="0:48.267">Pain</span> <span begin="0:48.267" end="0:48.797">will</span> <span begin="0:48.797" end="0:49.167">on</span><span begin="0:49.167" end="0:49.407">ly</span> <span begin="0:49.407" end="0:50.047">make</span> <span begin="0:50.047" end="0:50.377">your</span> <span begin="0:50.377" end="0:50.997">heart</span> <span begin="0:51.257" end="0:52.017">hard</span></p><p begin="0:52.208" end="0:54.598" itunes:key="L4" ttm:agent="v1"><span begin="0:52.208" end="0:52.898">Tossed</span> <span begin="0:52.898" end="0:53.038">in</span> <span begin="0:53.038" end="0:53.658">fur</span><span begin="0:53.658" end="0:53.838">i</span><span begin="0:53.838" end="0:54.008">ous</span> <span begin="0:54.008" end="0:54.438">wea</span><span begin="0:54.438" end="0:54.598">ther</span></p><p begin="0:54.984" end="0:59.044" itunes:key="L5" ttm:agent="v1"><span begin="0:54.984" end="0:55.414">In</span><span begin="0:55.414" end="0:55.544">no</span><span begin="0:55.544" end="0:56.304">cence</span> <span begin="0:56.304" end="0:56.594">is</span> <span begin="0:56.594" end="0:57.164">beau</span><span begin="0:57.164" end="0:57.314">ti</span><span begin="0:57.314" end="0:57.914">ful</span> <span begin="0:57.914" end="0:58.244">to</span> <span begin="0:58.244" end="0:59.044">see</span></p><p begin="0:59.375" end="1:02.715" itunes:key="L6" ttm:agent="v1"><span begin="0:59.375" end="0:59.975">Won't</span> <span begin="0:59.975" end="1:00.195">you</span> <span begin="1:00.195" end="1:00.785">box</span> <span begin="1:00.785" end="1:01.195">it</span> <span begin="1:01.195" end="1:01.425">up</span> <span begin="1:01.425" end="1:01.945">for</span> <span begin="1:01.945" end="1:02.715">me?</span></p><p begin="1:04.493" end="1:08.133" itunes:key="L7" ttm:agent="v1"><span begin="1:04.493" end="1:05.463">For</span> <span begin="1:05.463" end="1:08.133">me?</span></p><p begin="1:09.842" end="1:14.442" itunes:key="L8" ttm:agent="v2"><span begin="1:09.842" end="1:10.002">Oh,</span> <span begin="1:10.002" end="1:10.242">give</span> <span begin="1:10.242" end="1:10.372">me</span> <span begin="1:10.372" end="1:11.522">strength</span> <span begin="1:11.522" end="1:11.732">and</span> <span begin="1:11.732" end="1:11.982">give</span> <span begin="1:11.982" end="1:12.142">me</span> <span begin="1:12.142" end="1:14.442">peace</span></p><p begin="1:16.963" end="1:22.663" itunes:key="L9" ttm:agent="v2"><span begin="1:16.963" end="1:17.173">Does</span> <span begin="1:17.173" end="1:17.493">any</span><span begin="1:17.493" end="1:17.823">one</span> <span begin="1:17.823" end="1:18.133">out</span> <span begin="1:18.133" end="1:18.593">there</span> <span begin="1:18.593" end="1:18.933">want</span> <span begin="1:18.933" end="1:19.763">to</span> <span begin="1:19.843" end="1:21.063">hear</span> <span begin="1:21.063" end="1:22.663">me?</span></p><p begin="1:22.637" end="1:27.013" itunes:key="L10" ttm:ag