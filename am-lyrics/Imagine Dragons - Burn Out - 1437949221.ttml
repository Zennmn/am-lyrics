<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Burn Out"/><amll:meta key="artists" value="Imagine Dragons"/><amll:meta key="album" value="Origins (Deluxe Edition)"/><amll:meta key="isrc" value="USUM71816169"/><amll:meta key="appleMusicId" value="1437949221"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Dan Reynolds</songwriter><songwriter>Wayne Sermon</songwriter><songwriter>Ben McKee &amp; Daniel Platzman</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">隐忍能走的路终有穷尽</text><text for="L2">浴血方可跋涉到更远方</text><text for="L3">苦痛只会让一颗心坚硬如铁</text><text for="L4">飘摇在暴烈的风雨之中</text><text for="L5">纯真无邪的模样如此动人</text><text for="L6">能否替我将它装匣珍藏</text><text for="L7">留予我吗</text><text for="L8">赐予我力量 赐予我安宁</text><text for="L9">茫茫人世可有人愿听我倾诉</text><text for="L10">不过是又一场倾盆狂雨 切莫被它轻易击垮</text><text for="L11">跌至谷底便唯有向上 点燃你体内所有的光芒</text><text for="L12">别燃尽成灰 别弃我而去</text><text for="L13">别就此熄灭 别离我而去</text><text for="L14">悲伤本与我为敌</text><text for="L15">我怕岁月待它过于温和</text><text for="L16">伴我身旁走过了漫漫经年</text><text for="L17">如今倒仿佛与它熟稔如故</text><text for="L18">幸福的光芒如此令人神往</text><text for="L19">可否为我将它细细封存</text><text for="L20">赠予我吗</text><text for="L21">祈求赐我力量 予我宁静</text><text for="L22">天地之间可有人愿听我的声音</text><text for="L23">不过又是一场漫天骤雨 莫让它将你彻底吞噬</text><text for="L24">既已触底便唯有奋起 点亮你灵魂深处的所有火光</text><text for="L25">莫燃尽所有 别弃我而去</text><text for="L26">别熄灭微芒 别离开我</text><text for="L27">不过是一场倾盆大雨 不过是一场暴烈风雨</text><text for="L28">不过又是一场瓢泼狂雨 绝别向它俯首认输</text><text for="L29">跌落尘埃后唯有凌空而起 点燃你胸中全部的光芒</text><text for="L30">我不想放开你的手 我绝不愿放手</text><text for="L31">别燃尽心火 莫离我而去</text><text for="L32">我舍不得让你离开 我不想松开手</text><text for="L33">别就此熄灭 别弃我而去</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:22.478"><div begin="0:40.641" end="4:22.478"><p begin="0:40.641" end="0:44.911" itunes:key="L1" ttm:agent="v1"><span begin="0:40.641" end="0:41.011">Pa</span><span begin="0:41.011" end="0:41.671">tience</span> <span begin="0:41.671" end="0:42.101">on</span><span begin="0:42.101" end="0:42.391">ly</span> <span begin="0:42.391" end="0:42.981">gets</span> <span begin="0:42.981" end="0:43.241">you</span> <span begin="0:43.241" end="0:43.871">so</span> <span begin="0:44.121" end="0:44.911">far</span></p><p begin="0:45.091" end="0:47.521" itunes:key="L2" ttm:agent="v1"><span begin="0:45.091" end="0:45.771">Blood</span> <span begin="0:45.771" end="0:45.961">will</span> <span begin="0:45.961" end="0:46.351">get</span> <span begin="0:46.351" end="0:46.761">you</span> <span begin="0:46.761" end="0:47.361">fur</span><span begin="0:47.361" end="0:47.521">ther</span></p><p begin="0:47.837" end="0:52.037" itunes:key="L3" ttm:agent="v1"><span begin="0:47.837" end="0:48.287">Pain</span> <span begin="0:48.287" end="0:48.817">will</span> <span begin="0:48.817" end="0:49.187">on</span><span begin="0:49.187" end="0:49.427">ly</span> <span begin="0:49.427" end="0:50.067">make</span> <span begin="0:50.067" end="0:50.397">your</span> <span begin="0:50.397" end="0:51.017">heart</span> <span begin="0:51.277" end="0:52.037">hard</span></p><p begin="0:52.228" end="0:54.618" itunes:key="L4" ttm:agent="v1"><span begin="0:52.228" end="0:52.918">Tossed</span> <span begin="0:52.918" end="0:53.058">in</span> <span begin="0:53.058" end="0:53.678">fur</span><span begin="0:53.678" end="0:53.858">i</span><span begin="0:53.858" end="0:54.028">ous</span> <span begin="0:54.028" end="0:54.458">wea</span><span begin="0:54.458" end="0:54.618">ther</span></p><p begin="0:55.004" end="0:59.064" itunes:key="L5" ttm:agent="v1"><span begin="0:55.004" end="0:55.434">In</span><span begin="0:55.434" end="0:55.564">no</span><span begin="0:55.564" end="0:56.324">cence</span> <span begin="0:56.324" end="0:56.614">is</span> <span begin="0:56.614" end="0:57.184">beau</span><span begin="0:57.184" end="0:57.334">ti</span><span begin="0:57.334" end="0:57.934">ful</span> <span begin="0:57.934" end="0:58.264">to</span> <span begin="0:58.264" end="0:59.064">see</span></p><p begin="0:59.395" end="1:02.735" itunes:key="L6" ttm:agent="v1"><span begin="0:59.395" end="0:59.995">Won't</span> <span begin="0:59.995" end="1:00.215">you</span> <span begin="1:00.215" end="1:00.805">box</span> <span begin="1:00.805" end="1:01.215">it</span> <span begin="1:01.215" end="1:01.445">up</span> <span begin="1:01.445" end="1:01.965">for</span> <span begin="1:01.965" end="1:02.735">me?</span></p><p begin="1:04.513" end="1:08.153" itunes:key="L7" ttm:agent="v1"><span begin="1:04.513" end="1:05.483">For</span> <span begin="1:05.483" end="1:08.153">me?</span></p><p begin="1:09.862" end="1:14.462" itunes:key="L8" ttm:agent="v2"><span begin="1:09.862" end="1:10.022">Oh,</span> <span begin="1:10.022" end="1:10.262">give</span> <span begin="1:10.262" end="1:10.392">me</span> <span begin="1:10.392" end="1:11.542">strength</span> <span begin="1:11.542" end="1:11.752">and</span> <span begin="1:11.752" end="1:12.002">give</span> <span begin="1:12.002" end="1:12.162">me</span> <span begin="1:12.162" end="1:14.462">peace</span></p><p begin="1:16.983" end="1:22.683" itunes:key="L9" ttm:agent="v2"><span begin="1:16.983" end="1:17.193">Does</span> <span begin="1:17.193" end="1:17.513">any</span><span begin="1:17.513" end="1:17.843">one</span> <span begin="1:17.843" end="1:18.153">out</span> <span begin="1:18.153" end="1:18.613">there</span> <span begin="1:18.613" end="1:18.953">want</span> <span begin="1:18.953" end="1:19.783">to</span> <span begin="1:19.863" end="1:21.083">hear</span> <span begin="1:21.083" end="1:22.683">me?</span></p><p begi