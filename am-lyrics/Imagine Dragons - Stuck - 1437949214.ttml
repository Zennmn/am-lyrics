<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>A. Grant</songwriter><songwriter>Alex da Kid</songwriter><songwriter>Ben McKee</songwriter><songwriter>Dan Reynolds</songwriter><songwriter>Daniel Platzman</songwriter><songwriter>Jayson Dezuzio</songwriter><songwriter>Wayne Sermon</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">即使时光匆匆 也带不走我对你的爱意</text><text for="L2">是的 不论过去多久 我还是依旧依恋着你 你</text><text for="L3">我感到恐惧 不希望灵魂淡出我的身体</text><text for="L4">像是误入了歧途 意识飘忽于半梦半醒之间</text><text for="L5">身上被鲜红的血沾染 不知如何开口 已然是行尸走肉</text><text for="L6">我感觉自己像是被坟墓所禁锢</text><text for="L7">你是悦耳的笑 你是鲜活的生命 你是充满生气的聚会</text><text for="L8">你是充沛的勇气 我脆弱不堪 而你如同军队势不可挡</text><text for="L9">你是忠诚 你是世间的真实 而我只有无尽的歉意</text><text for="L10">我感觉所有的美好都汇聚于你一人</text><text for="L11">你是我的唯一 你是我挚爱的唯一</text><text for="L12">现在一切言语行动都已经覆水难收</text><text for="L13">你是我的唯一 你是我挚爱的唯一</text><text for="L14">现在我在努力试着抛下过去的自己</text><text for="L15">即使时光匆匆 也带不走我对你的爱意</text><text for="L16">是的 不论过去多久 我还是依旧依恋着你 你</text><text for="L17">为何你要离我而去 为何你要离开 留下我孤单的背影</text><text for="L18">你难道不知道与我而言 你便是温馨的港湾 是我的唯一</text><text for="L19">现在你去了哪里 现在你去了哪里 现在你去了哪里 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(你如今身在何方 你如今身在何方 你如今身在何方)</span></text><text for="L20">求你 回到我身边吧</text><text for="L21">你是我的唯一 你是我挚爱的唯一</text><text for="L22">现在一切言语行动都已经覆水难收</text><text for="L23">你是我的唯一 你是我挚爱的唯一</text><text for="L24">现在我在努力试着抛下过去的自己</text><text for="L25">即使时光匆匆 也带不走我对你的爱意</text><text for="L26">不论过去多久 我还是依旧依恋着你 你</text><text for="L27">即使时光匆匆 也带不走我对你的爱意</text><text for="L28">是的 不论过去多久</text><text for="L29">我还是依旧依恋着你 钟情于你 只有你</text><text for="L30">Oh</text><text for="L31">Oh</text><text for="L32">即使时光匆匆 不论过去多久</text><text for="L33">Woah</text><text for="L34">即使时光匆匆 也带不走我对你的爱恋</text><text for="L35">不论过去多久 我还是依旧依恋着你 你</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Stuck"/><amll:meta key="artists" value="Imagine Dragons"/><amll:meta key="album" value="Origins (Deluxe Edition)"/><amll:meta key="isrc" value="USUM71816166"/><amll:meta key="appleMusicId" value="1437949214"/></metadata></head><body><div begin="0:00.180" end="3:03.832"><p begin="0:00.180" end="0:05.580" itunes:key="L1" ttm:agent="v1"><span begin="0:00.180" end="0:00.810">Time</span> <span begin="0:00.810" end="0:01.290">goes</span> <span begin="0:01.290" end="0:01.890">by</span> <span begin="0:01.890" end="0:02.040">and</span> <span begin="0:02.040" end="0:03.000">still</span> <span begin="0:03.000" end="0:03.390">I'm</span> <span begin="0:03.390" end="0:03.960">stuck</span> <span begin="0:03.960" end="0:04.230">on</span> <span begin="0:04.230" end="0:05.580">you</span></p><p begin="0:08.250" end="0:17.430" itunes:key="L2" ttm:agent="v1"><span begin="0:08.250" end="0:08.490">Yeah,</span> <span begin="0:08.490" end="0:09.120">time</span> <span begin="0:09.120" end="0:09.630">goes</span> <span begin="0:09.630" end="0:10.230">by</span> <span begin="0:10.230" end="0:10.350">and</span> <span begin="0:10.350" end="0:11.310">still</span> <span begin="0:11.310" end="0:11.700">I'm</span> <span begin="0:11.700" end="0:12.300">stuck</span> <span begin="0:12.300" end="0:12.540">on</span> <span begin="0:12.540" end="0:13.050">you,</span> <span begin="0:13.140" end="0:14.400">ooh,</span> <span begin="0:14.550" end="0:15.030">you,</span> <span begin="0:15.120" end="0:17.430">ooh</span></p><p begin="0:17.460" end="0:21.570" itunes:key="L3" ttm:agent="v1"><span begin="0:17.460" end="0:17.670">I</span> <span begin="0:17.670" end="0:17.910">been</span> <span begin="0:17.910" end="0:18.510">afraid,</span> <span begin="0:18.510" end="0:18.690">don't</span> <span begin="0:18.690" end="0:19.020">wanna</span> <span begin="0:19.020" end="0:19.650">fade</span> <span begin="0:19.650" end="0:19.800">out</span> <span begin="0:19.800" end="0:19.890">of</span> <span begin="0:19.890" end="0:20.070">my</span> <span begin="0:20.070" end="0:21.570">body</span></p><p begin="0:21.600" end="0:25.380" itunes:key="L4" ttm:agent="v1"><span begin="0:21.600" end="0:21.810">I</span> <span begin="0:21.810" end="0:22.080">been</span> <span begin="0:22.080" end="0:22.680">astray,</span> <span begin="0:22.680" end="0:23.130">barely</span> <span begin="0:23.130" end="0:23.700">awake,</span> <span begin="0:23.700" end="0:24.150">floating</span> <span begin="0:24.150" end="0:24.630">above</span> <span begin="0:24.630" end="0:25.380">me</span></p><p begin="0:25.410" end="0:29.280" itunes:key="L5" ttm:agent="v1"><span begin="0:25.410" end="0:26.250">Covered</span> <span begin="0:26.250" end="0:26.370">in</span> <span begin="0:26.370" end="0:26.850">red,</span> <span begin="0:26.850" end="0:27.030">what</span> <span begin="0:27.030" end="0:27.240">can</span> <span begin="0:27.240" end="0:27.330">I</span> <span begin="0:27.330" end="0:27.870">say?</span> <span begin="0:27.900" end="0:28.080">I've</span> <span begin="0:28.080" end="0:28.290">been</span> <span begin="0:28.290" end="0:28.380">a</span> <span begin="0:28.380" end="0:29.280">zombie</span></p><p begin="0:29.310" end="0:33.690" itunes:key="L6" ttm:agent="v1"><span begin="0:29.310" end="0:29.460">I'm</span> <span begin="0:29.460" end="0:30.540">feeling</span> <span begin="0:30.540" end="0:30.930">like</span> <span begin="0:30.930" end="0:31.110">I've</span> <span begin="0:31.110" end="0:31.380">been</span> <span begin="0:31.380" end="0:31.980">locked</span> <span begin="0:31.980" end="0:32.189">in</span> <span begin="0:32.189" end="0:32.400">a</span> <span begin="0:32.400" end="0:33.690">grave</span></p><p begin="0:34.080" end="0:37.638" itunes:key="L7" ttm:agent="v1"><span begin="0:34.080" end="0:34.350">You</span> <span begin="0:34.350" end="0:34.500">were</span> <span begin="0:34.500" end="0:34.650">the</span> <span begin="0:34.650" end="0:35.220">laugh,</span> <span begin="0:35.220" end="0:35.340">you</span> <span begin="0:35.340" end="0:35.520">were</span> <span begin="0:35.520" end="0:35.670">the</span> <span begin="0:35.670" end="0:36.270">life,</span> <span begin="0:36.270" end="0:36.390">you</span> <span begin="0:36.390" end="0:36.570">were</span> <span begin="0:36.570" end="0:36.720">the</span> <span begin="0:36.720" end="0:37.638">party</span></p><p begin="0:38.280" end="0:42.090" itunes:key="L8" ttm:agent="v1"><span begin="0:38.280" end="0:38.520">You</span> <span begin="0:38.520" end="0:38.670">were</span> <span begin="0:38.670" end="0:38.820">the</span> <span begin="0:38.820" end="0:39.420">brave,</span> <span begin="0:39.420" end="0:39.540">I</span> <span begin="0:39.540" end="0:39.780">was</span> <span begin="0:39.780" end="0:39.870">the</span> <span begin="0:39.870" end="0:40.470">weak,</span> <span begin="0:40.470" end="0:40.590">you</span> <span begin="0:40.590" end="0:40.740">were</span> <span begin="0:40.740" end="0:41.040">the</span> <span begin="0:41.040" end="0:42.090">army</span></p><p begin="0:42.450" end="0:45.930" itunes:key="L9" ttm:agent="v1"><span begin="0:42.450" end="0:42.690">You</span> <span begin="0:42.690" end="0:42.840">were</span> <span begin="0:42.840" end="0:42.990">the</span> <span begin="0:42.990" end="0:43.560">faith,</span> <span begin="0:43.560" end="0:43.710">you</span> <span begin="0:43.710" end="0:43.860">were</span> <span begin="0:43.860" end="0:44.010">the</span> <span begin="0:44.010" end="0:44.610">truth,</span> <span begin="0:44.610" end="0:44.730">I</span> <span begin="0:44.730" end="0:44.970">was</span> <span begin="0:44.970" end="0:45.030">the</span> <span begin="0:45.030" end="0:45.930">sorry</span></p><p begin="0:45.960" end="0:49.290" itunes:key="L10" ttm:agent="v1"><span begin="0:45.960" end="0:46.140">I'm</span> <span begin="0:46.140" end="0:47.250">feeling</span> <span begin="0:47.250" end="0:47.640">like</span> <span begin="0:47.640" end="0:47.850">you've</span> <span begin="0:47.850" end="0:48.060">been</span> <span begin="0:48.060" end="0:48.870">taking</span> <span begin="0:48.870" end="0:49.290">away</span></p><p begin="0:49.290" end="0:53.250" itunes:key="L11" ttm:agent="v1"><span begin="0:49.290" end="0:49.590">You</span> <span begin="0:49.590" end="0:49.920">were</span> <span begin="0:49.920" end="0:50.340">my</span> <span begin="0:50.340" end="0:51.270">one,</span> <span begin="0:51.300" end="0:51.690">you</span> <span begin="0:51.690" end="0:52.020">were</span> <span begin="0:52.020" end="0:52.440">my</span> <span begin="0:52.440" end="0:53.250">one</span></p><p begin="0:53.250" end="0:57.540" itunes:key="L12" ttm:agent="v1"><span begin="0:53.250" end="0:53.520">When</span> <span begin="0:53.520" end="0:53.820">all</span> <span begin="0:53.820" end="0:54.240">has</span> <span begin="0:54.240" end="0:54.510">been</span> <span begin="0:54.510" end="0:55.500">said,</span> <span begin="0:55.590" end="0:55.950">all</span> <span begin="0:55.950" end="0:56.310">has</span> <span begin="0:56.310" end="0:56.640">been</span> <span begin="0:56.640" end="0:57.540">done</span></p><p begin="0:57.570" end="1:01.680" itunes:key="L13" ttm:agent="v1"><span begin="0:57.570" end="0:57.960">You</span> <span begin="0:57.960" end="0:58.290">were</span> <span begin="0:58.290" end="0:58.680">my</span> <span begin="0:58.680" end="0:59.610">one,</span> <span begin="0:59.640" end="1:00.060">you</span> <span begin="1:00.060" end="1:00.390">were</span> <span begin="1:00.390" end="1:00.810">my</span> <span begin="1:00.810" end="1:01.680">one</span></p><p begin="1:01.710" end="1:06.822" itunes:key="L14" ttm:agent="v1"><span begin="1:01.710" end="1:02.190">Now</span> <span begin="1:02.190" end="1:02.550">I</span> <span begin="1:02.550" end="1:02.850">am</span> <span begin="1:02.850" end="1:03.840">left</span> <span begin="1:03.840" end="1:04.680">reaching</span> <span begin="1:04.680" end="1:05.400">above</span> <span begin="1:05.400" end="1:06.030">me,</span> <span begin="1:06.030" end="1:06.564">oh,</span> <span begin="1:06.564" end="1:06.822">oh</span></p><p begin="1:06.990" end="1:15.371" itunes:key="L15" ttm:agent="v1"><span begin="1:06.990" end="1:07.530">Time</span> <span begin="1:07.530" end="1:08.070">goes</span> <span begin="1:08.070" end="1:08.730">by</span> <span begin="1:08.730" end="1:08.820">and</span> <span begin="1:08.820" end="1:09.750">still</span> <span begin="1:09.750" end="1:10.140">I'm</span> <span begin="1:10.140" end="1:10.800">stuck</span> <span begin="1:10.800" end="1:11.040">on</span> <span begin="1:11.040" end="1:11.580">you,</span> <span begin="1:11.610" end="1:12.840">ooh,</span> <span begin="1:12.960" end="1:13.655">you,</span> <span begin="1:13.655" end="1:14.615">ooh</span><span ttm:role="x-bg" begin="1:14.430" end="1:15.371"><span begin="1:14.430" end="1:14.968">(Woah-</span><span begin="1:14.968" end="1:15.371">oh)</span></span></p><p begin="1:15.360" end="1:23.597" itunes:key="L16" ttm:agent="v1"><span begin="1:15.360" end="1:15.900">Time</span> <span begin="1:15.900" end="1:16.410">goes</span> <span begin="1:16.410" end="1:17.010">by</span> <span begin="1:17.010" end="1:17.130">and</span> <span begin="1:17.130" end="1:18.090">still</span> <span begin="1:18.090" end="1:18.480">I'm</span> <span begin="1:18.480" end="1:19.170">stuck</span> <span begin="1:19.170" end="1:19.380">on</span> <span begin="1:19.380" end="1:19.920">you,</span> <span begin="1:19.950" end="1:21.210">ooh,</span> <span begin="1:21.300" end="1:21.935">you,</span> <span begin="1:21.935" end="1:23.004">ooh</span><span ttm:role="x-bg" begin="1:22.767" end="1:23.597"><span begin="1:22.767" end="1:23.247">(Woah-</span><