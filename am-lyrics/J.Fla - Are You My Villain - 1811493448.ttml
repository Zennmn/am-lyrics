.690" end="0:38.670" itunes:key="L10" ttm:agent="v1"><span begin="0:36.690" end="0:37.110">Feeling</span> <span begin="0:37.110" end="0:37.410">like</span> <span begin="0:37.410" end="0:37.500">I</span> <span begin="0:37.500" end="0:37.860">can't</span> <span begin="0:37.860" end="0:38.250">let</span> <span begin="0:38.250" end="0:38.670">go</span></p><p begin="0:38.700" end="0:40.530" itunes:key="L11" ttm:agent="v1"><span begin="0:38.700" end="0:39.360">Can't</span> <span begin="0:39.360" end="0:39.780">let</span> <span begin="0:39.780" end="0:40.530">go</span></p><p begin="0:40.770" end="0:42.420" itunes:key="L12" ttm:agent="v1"><span begin="0:40.770" end="0:41.070">See</span> <span begin="0:41.070" end="0:41.340">you</span> <span begin="0:41.340" end="0:41.490">on</span> <span begin="0:41.490" end="0:41.760">the</span> <span begin="0:41.760" end="0:42.030">other</span> <span begin="0:42.030" end="0:42.420">end</span></p><p begin="0:42.420" end="0:44.760" itunes:key="L13" ttm:agent="v1"><span begin="0:42.420" end="0:42.660">But</span> <span begin="0:42.660" end="0:42.750">I</span> <span begin="0:42.750" end="0:43.080">don't</span> <span begin="0:43.080" end="0:43.350">know</span> <span begin="0:43.350" end="0:43.500">what</span> <span begin="0:43.500" end="0:43.890">lies</span> <span begin="0:43.890" end="0:44.760">below</span></p><p begin="0:45.000" end="0:47.400" itunes:key="L14" ttm:agent="v1"><span begin="0:45.000" end="0:45.420">Lies</span> <span begin="0:45.420" end="0:47.400">below</span></p></div><div itunes:song-part="Chorus"><p begin="0:48.900" end="0:53.040" itunes:key="L15" ttm:agent="v1"><span begin="0:48.900" end="0:49.140">Are</span> <span begin="0:49.140" end="0:49.290">you</span> <span begin="0:49.290" end="0:49.440">my</span> <span begin="0:49.440" end="0:50.010">hero</span> <span begin="0:50.010" end="0:50.070">or</span> <span begin="0:50.070" end="0:50.220">my</span> <span begin="0:50.220" end="0:53.040">villain</span></p><p begin="0:54.900" en