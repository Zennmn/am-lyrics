<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Anne-Marie</songwriter><songwriter>Marshmello</songwriter><songwriter>Nat Dunn</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">你说你真的爱我 我说你清醒一点</text><text for="L2">我们的关系最多不过朋友</text><text for="L3">你不是我的爱人 更像是我的哥哥</text><text for="L4">我们自十岁左右便认识彼此 是的</text><text for="L5">别把友情与爱情混淆 你的所作所为</text><text for="L6">只会让我有意与你保持距离 就这样</text><text for="L7">当你说你爱我的时候 真的让我抓狂不知所措</text><text for="L8">啧 你又来了</text><text for="L9">不要用你那暧昧不清的眼神看着我</text><text for="L10">你知道这样我们免不了一场争吵</text><text for="L11">跟你讲道理是行不通的 我已经礼貌忍耐地足够</text><text for="L12">我至少跟你说了一 二 三 四 五 六千次了吧</text><text for="L13">我说的还不够清楚吗</text><text for="L14">你还不明白吗</text><text for="L15">要我一字一句重复给你听吗</text><text for="L16">我 们 只 是 朋 友</text><text for="L17">我说的还不够清楚吗</text><text for="L18">你还不明白吗</text><text for="L19">要我一字一句重复给你听吗</text><text for="L20">我 们 只 是 朋 友</text><text for="L21">你有点羞耻心吗 你看起有点失去理智</text><text for="L22">忽然出现在我的家门口</text><text for="L23">拜托 现在是凌晨两点 外面还下着倾盆大雨</text><text for="L24">要我像之前一样把你赶走吗</text><text for="L25">别把友情与爱情混淆 你的所作所为</text><text for="L26">只会让我有意与你保持距离</text><text for="L27">你有点羞耻心吗 你看起有点失去理智</text><text for="L28">啧 你又来了</text><text for="L29">不要用你那暧昧不清的眼神看着我</text><text for="L30">你知道这样我们免不了一场争吵</text><text for="L31">别再找你的借口 我已经礼貌忍耐地足够</text><text for="L32">我至少跟你说了一 二 三 四 五 六千次了吧</text><text for="L33">我说的还不够清楚吗</text><text for="L34">你还不明白吗</text><text for="L35">要我一字一句重复给你听吗</text><text for="L36">我 们 只 是 朋 友</text><text for="L37">我说的还不够清楚吗</text><text for="L38">你还不明白吗</text><text for="L39">要我一字一句重复给你听吗</text><text for="L40">我 们 只 是 朋 友</text><text for="L41">我 们 只 是 朋 友</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="FRIENDS"/><amll:meta key="artists" value="J.Fla"/><amll:meta key="album" value="FRIENDS - Single"/><amll:meta key="appleMusicId" value="1808885814"/><amll:meta key="isrc" value="UKG8V1801452"/></metadata></head><body><div begin="0:10.640" end="2:12.717"><p begin="0:10.640" end="0:13.310" itunes:key="L1" ttm:agent="v1"><span begin="0:10.640" end="0:11.030">You</span> <span begin="0:11.030" end="0:11.300">say</span> <span begin="0:11.300" end="0:11.480">you</span> <span begin="0:11.480" end="0:11.810">love</span> <span begin="0:11.810" end="0:12.050">me,</span> <span begin="0:12.110" end="0:12.260">I</span> <span begin="0:12.260" end="0:12.560">say</span> <span begin="0:12.560" end="0:12.710">you</span> <span begin="0:12.710" end="0:13.310">crazy</span></p><p begin="0:13.310" end="0:15.470" itunes:key="L2" ttm:agent="v1"><span begin="0:13.310" end="0:13.580">We're</span> <span begin="0:13.580" end="0:14.000">nothing</span> <span begin="0:14.000" end="0:14.300">more</span> <span begin="0:14.300" end="0:14.570">than</span> <span begin="0:14.570" end="0:15.470">friends</span></p><p begin="0:15.710" end="0:18.290" itunes:key="L3" ttm:agent="v1"><span begin="0:15.710" end="0:16.070">You're</span> <span begin="0:16.070" end="0:16.340">not</span> <span begin="0:16.340" end="0:16.490">my</span> <span begin="0:16.490" end="0:17.060">lover,</span> <span begin="0:17.060" end="0:17.360">more</span> <span begin="0:17.360" end="0:17.690">like</span> <span begin="0:17.690" end="0:17.750">a</span> <span begin="0:17.750" end="0:18.290">brother</span></p><p begin="0:18.290" end="0:20.900" itunes:key="L4" ttm:agent="v1"><span begin="0:18.290" end="0:18.440">I</span> <span begin="0:18.440" end="0:18.740">known</span> <span begin="0:18.740" end="0:18.920">you</span> <span begin="0:18.920" end="0:19.220">since</span> <span begin="0:19.220" end="0:19.460">we</span> <span begin="0:19.460" end="0:19.610">were</span> <span begin="0:19.610" end="0:19.970">like</span> <span begin="0:19.970" end="0:20.480">ten,</span> <span begin="0:20.510" end="0:20.900">yeah</span></p><p begin="0:20.900" end="0:23.228" itunes:key="L5" ttm:agent="v1"><span begin="0:20.900" end="0:21.230">Don't</span> <span begin="0:21.230" end="0:21.500">mess</span> <span begin="0:21.500" end="0:21.680">it</span> <span begin="0:21.680" end="0:22.100">up,</span> <span begin="0:22.100" end="0:22.520">talking</span> <span begin="0:22.520" end="0:22.940">that</span> <span begin="0:22.940" end="0:23.228">****</span></p><p begin="0:23.420" end="0:25.640" itunes:key="L6" ttm:agent="v1"><span begin="0:23.420" end="0:23.750">Only</span> <span begin="0:23.750" end="0:24.020">gonna</span> <span begin="0:24.020" end="0:24.380">push</span> <span begin="0:24.380" end="0:24.590">me</span> <span begin="0:24.590" end="0:24.950">away,</span> <span begin="0:24.950" end="0:25.430">that's</span> <span begin="0:25.430" end="0:25.640">it!</span></p><p begin="0:25.640" end="0:28.520" itunes:key="L7" ttm:agent="v1"><span begin="0:25.640" end="0:25.850">When</span> <span begin="0:25.850" end="0:26.090">you</span> <span begin="0:26.090" end="0:26.450">say</span> <span begin="0:26.450" end="0:26.600">you</span> <span begin="0:26.600" end="0:26.930">love</span> <span begin="0:26.930" end="0:27.200">me,</span> <span begin="0:27.200" end="0:27.500">that</span> <span begin="0:27.500" end="0:27.710">make</span> <span begin="0:27.710" end="0:27.860">me</span> <span begin="0:27.860" end="0:28.520">crazy</span></p><p begin="0:28.520" end="0:30.230" itunes:key="L8" ttm:agent="v1"><span begin="0:28.520" end="0:28.760">Here</span> <span begin="0:28.760" end="0:29.120">we</span> <span begin="0:29.120" end="0:29.450">go</span> <span begin="0:29.450" end="0:30.230">again</span></p><p begin="0:30.320" end="0:34.880" itunes:key="L9" ttm:agent="v1"><span begin="0:30.320" end=