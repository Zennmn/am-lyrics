<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Havana"/><amll:meta key="artists" value="J.Fla"/><amll:meta key="album" value="Havana - Single"/><amll:meta key="isrc" value="UKG8V1800007"/><amll:meta key="appleMusicId" value="1808886161"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ali Tamposi</songwriter><songwriter>Andrew Watt</songwriter><songwriter>Brian D Lee</songwriter><songwriter>Brittany Tali Hazzard</songwriter><songwriter>Camila Cabello</songwriter><songwriter>Frank Dukes</songwriter><songwriter>Jeffrey Williams</songwriter><songwriter>Louis Bell</songwriter><songwriter>Pharrell L Williams</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">哈瓦那 哦 呐 呐</text><text for="L2">我的半颗心留在哈瓦那 哦 呐 呐</text><text for="L3">他带我回到东亚特兰大 呐 呐 呐</text><text for="L4">哦 我的心还在哈瓦那</text><text for="L5">他的举手投足别有韵味</text><text for="L6">哈瓦那 哦 呐 呐</text><text for="L7">他走近时没有随口问声你好吗</text><text for="L8">他说能与他相伴的姑娘有许多</text><text for="L9">只消一瞬便像与他相识了一生</text><text for="L10">爸爸却说他骨子里带着几分坏</text><text for="L11">他让我情不自禁地轻叹</text><text for="L12">Ooh</text><text for="L13">初见他时我便已明了</text><text for="L14">离开他时我已爱上他</text><text for="L15">他让我情不自禁地轻叹</text><text for="L16">Ooh</text><text for="L17">可我终究得告诉他</text><text for="L18">我必须离开</text><text for="L19">Ooh, nah, nah, nah, nah, nah</text><text for="L20">哈瓦那 哦 呐 呐</text><text for="L21">我的半颗心留在哈瓦那 哦 呐 呐</text><text for="L22">他带我回到东亚特兰大 呐 呐 呐</text><text for="L23">哦 我的心还在哈瓦那</text><text for="L24">我的心留在哈瓦那</text><text for="L25">哈瓦那 哦 呐 呐</text><text for="L26">Ooh</text><text for="L27">初见他时我便已明了</text><text for="L28">离开他时我已爱上他</text><text for="L29">他让我情不自禁地轻叹</text><text for="L30">Ooh</text><text for="L31">可我终究得告诉他</text><text for="L32">我必须离开</text><text for="L33">Ooh, nah, nah, nah, nah, nah</text><text for="L34">哈瓦那 哦 呐 呐</text><text for="L35">我的半颗心留在哈瓦那 哦 呐 呐</text><text for="L36">他带我回到东亚特兰大 呐 呐 呐</text><text for="L37">哦 我的心还在哈瓦那</text><text for="L38">我的心留在哈瓦那</text><text for="L39">哈瓦那 哦 呐 呐</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:08.779"><div begin="0:09.145" end="2:08.779"><p begin="0:09.145" end="0:11.055" itunes:key="L1" ttm:agent="v1"><span begin="0:09.145" end="0:09.435">Ha</span><span begin="0:09.435" end="0:09.785">va</span><span begin="0:09.785" end="0:10.125">na,</span> <span begin="0:10.125" end="0:10.305">ooh,</span> <span begin="0:10.305" end="0:10.585">nah,</span> <span begin="0:10.585" end="0:11.055">nah</span></p><p begin="0:11.905" end="0:15.625" itunes:key="L2" ttm:agent="v1"><span begin="0:11.905" end="0:12.365">Half</span> <span begin="0:12.365" end="0:12.565">of</span> <span begin="0:12.565" end="0:12.875">my</span> <span begin="0:12.875" end="0:13.235">heart</span> <span begin="0:13.235" end="0:13.525">is</span> <span begin="0:13.525" end="0:13.735">in</span> <span begin="0:13.735" end="0:13.965">Ha</span><span begin="0:13.965" end="0:14.335">va</span><span begin="0:14.335" end="0:14.665">na,</span> <span begin="0:14.665" end="0:14.885">ooh,</span> <span begin="0:14.885" end="0:15.145">nah,</span> <span begin="0:15.145" end="0:15.625">nah</span></p><p begin="0:16.566" end="0:20.166" itunes:key="L3" ttm:agent="v1"><span begin="0:16.566" end="0:16.836">He</span> <span begin="0:16.836" end="0:17.176">took</span> <span begin="0:17.176" end="0:17.396">me</span> <span begin="0:17.396" end="0:17.756">back</span> <span begin="0:17.756" end="0:18.086">to</span> <span begin="0:18.086" end="0:18.386