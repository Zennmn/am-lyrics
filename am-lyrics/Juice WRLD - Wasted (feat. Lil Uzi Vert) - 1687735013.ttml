<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name>Juice WRLD</ttm:name></ttm:agent><ttm:agent type="other" xml:id="v1000"><ttm:name>Juice WRLD &amp; Lil Uzi Vert</ttm:name></ttm:agent><ttm:agent type="other" xml:id="v2"><ttm:name>Lil Uzi Vert</ttm:name></ttm:agent><ttm:agent type="other" xml:id="v2000"><ttm:name>Producer Tag</ttm:name></ttm:agent><amll:meta key="musicName" value="Wasted (feat. Lil Uzi Vert)"/><amll:meta key="artists" value="Juice WRLD"/><amll:meta key="album" value="Goodbye &amp; Good Riddance (5 Year Anniversary Edition) [Deluxe]"/><amll:meta key="isrc" value="USUG11800948"/><amll:meta key="appleMusicId" value="1687735013"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Jarad Higgins</songwriter><songwriter>Chris Barnett</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">CB操刀编曲</text><text for="L2">醉生梦死 GTA式的爱 姑娘们烂醉如泥</text><text for="L3">恍惚迷离 服下这些药 只觉自己彻底废掉</text><text for="L4">麻木失神 唯有彻底迷醉 才能把她逐出脑海</text><text for="L5">虚度光阴 当我彻底沉沦 便把所有时光荒废</text><text for="L6">颓唐迷醉 如GTA般的爱 女孩们尽数醉倒</text><text for="L7">彻底废掉 沉溺在这些药里 我感到已然沦丧</text><text for="L8">沉沦麻醉 唯有神志恍惚 才得以将她彻底忘却</text><text for="L9">蹉跎岁月 一旦陷入迷醉 便将全部年华挥霍</text><text for="L10">彻底沦陷</text><text for="L11">她在我的地下室里吸食可卡因</text><text for="L12">我是她的医生 却也渐渐耗尽了耐心</text><text for="L13">她对我说 她正试着贴近撒旦</text><text for="L14">每当她身处迷幻矩阵 便会同他低语交谈</text><text for="L15">该死 她为何竟这般邪魅入魔</text><text for="L16">她似美杜莎 又带着几分宝嘉康蒂的风韵</text><text for="L17">她准是在我的药里偷偷下了料</text><text for="L18">因为每次我们在一起 我都会不省人事</text><text for="L19">等等 且让我说句实话</text><text for="L20">我分明看见她把止痛药片掺进我的大麻里</text><text for="L21">一路猛抽到双目翻白 宛若《凶兆》般诡谲</text><text for="L22">对她而言不过是又一场葬礼 该死</text><text for="L23">坠落毁灭 GTA式的爱 女孩们尽数醉倒</text><text for="L24">彻底废掉 我服下这些药 只觉自身已然残破</text><text for="L25">麻醉自我 唯有神志迷离 才将她暂且忘怀</text><text for="L26">虚度时光 每当我陷入沉沦 便把光阴尽数浪费</text><text for="L27">醉生梦死 GTA般的爱 姑娘们烂醉如泥</text><text for="L28">颓靡不振 药效蔓延全身 我只觉彻底沦丧</text><text for="L29">醉到失神 唯有陷入麻木 才能够将她抹去心头</text><text for="L30">荒废度日 一旦醉得不省人事 便将所有光阴蹉跎</text><text for="L31">彻底废掉</text><text for="L32">她在我的地下室里吸食可卡因</text><text for="L33">我是她的医生 可我也快耗尽耐心</text><text for="L34">她告诉我 她想离撒旦更近一些</text><text for="L35">当她置身虚幻矩阵 总在与他低声交谈</text><text for="L36">摇滚巨星 这便是我们的做派 这帮小子根本招架不住</text><text for="L37">满眼嫉恨 却仍想着窃取我们的腔调律动</text><text for="L38">绝不平庸 疾驰飙车时驾驭着全新法拉利</text><text for="L39">拿去吧 让你帮我卷根草 但千万别在里面加料</text><text for="L40">你苦苦追逐的不过是个掉价的女人</text><text for="L41">身旁伴着异域辣妹 她可是位征服女王</text><text for="L42">我爱那个女孩 也确实迷恋她的曼妙身段</text><text for="L43">我不要钞票 我只想要莫莉</text><text for="L44">那是她当年住在山谷区时常挂在嘴边的话</text><text for="L45">小子 我是你老子 哈库纳玛塔塔</text><text for="L46">我让那姑娘低头献上全部缠绵</text><text for="L47">我满头脏辫天然长成 你还得掏钱找人编扎</text><text for="L48">从身后热烈驰骋 双腿几乎绷直锁死</text><text for="L49">让那翘臀如按摩浴缸般翻涌 我喂了那女孩弗拉卡</text><text for="L50">我吞下蓝帽致幻菇 不断激荡着我的脉轮</text><text for="L51">颈链镶满玫瑰金 毫无半点廉价铜色</text><text for="L52">额头正中纹着刺青 宛若降世神通</text><text for="L53">这便是为何我骑乘阿帕一路驰骋</text><text for="L54">醉生梦死 GTA式的爱 女孩们尽数醉倒</text><text for="L55">迷离恍惚 服下这些药 我只觉已然废掉</text><text for="L56">沉沦麻醉 唯有陷入迷醉 才把她逐出脑海</text><text for="L57">虚度光阴 当我神志不清 便把所有时光荒废</text><text for="L58">彻底沉沦 GTA般的爱 姑娘们烂醉如泥</text><text for="L59">Yeah</text><text for="L60">颓唐废掉 吞下这些药 我感到魂不守舍</text><text for="L61">忘情买醉 唯有彻底麻木 才得以将她忘却</text><text for="L62">蹉跎时光 一旦陷入沉沦 便将全部年华挥霍</text><text for="L63">就此沉沦</text><text for="L64">她在我的地下室里吸食可卡因 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(在我的地下室里)</span></text><text for="L65">我是她的医生 却也快要耗尽耐心 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(耗尽了耐心)</span></text><text for="L66">她曾对我说 她正试图靠近撒旦 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(撒旦)</span></text><text for="L67">身陷迷幻矩阵之时 她便同他喃喃对话</text><text for="L68">我紧闭双眼 祈愿这一切并非虚幻假象</text><text for="L69">她却不知 她所有的心魔都盘踞在我体内</text><text for="L70">我不知道 我真的不懂</text><text for="L71">不知她近来究竟沉迷于何物 我茫然无绪</text><text for="L72">我一口口啜饮着这浓稠紫水</text><text for="L73">如今看我斟满 孤身独握这一杯 身旁再无友人</text><text for="L74">我犹如一扇敞开的门 本可以不放她踏入</text><text for="L75">她未曾带走我的心 却拿走了我的药剂</text><text for="L76">至少总算有人咽下 我最厌恶白白浪费</text><text for="L77">醉生梦死 GTA式的爱 姑娘们尽数烂醉</text><text for="L78">迷离恍惚 服下这些药 我只觉彻底废掉</text><text for="L79">沉沦麻醉 唯有神志恍惚 才能把她逐出心头</text><text for="L80">虚度光阴 当我彻底迷醉 便将所有时光荒废</text><text for="L81">一败涂地 GTA般的爱 女孩们醉得彻底</text><text for="L82">彻底废掉 借药物麻痹 我只觉浑身沦丧</text><text for="L83">醉到失神 唯有陷入迷离 才能够将她彻底忘怀</text><text for="L84">荒废年华 一旦醉生梦死 便把所有光阴耗尽</text><text for="L85">彻底沉沦 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(沉沦 沉沦 沉沦)</span></text></translation></translations></iTunesMetadata></metadata></head><body dur="4:15.243"><div begin="0:06.874" end="4:15.243"><p begin="0:06.874" end="0:07.912" itunes:key="L1" ttm:agent="v2000"><span begin="0:06.874" end="0:07.074">C</span><span begin="0:07.074" end="0:07.224">B</span> <span begin="0:07.224" end="0:07.349">on</span> <span begin="0:07.349" end="0:07.497">the</span> <span begin="0:07.497" end="0:07.912">beat</span></p><p begin="0:13.475" end="0:16.700" itunes:key="L2" ttm:agent="v1"><span begin="0:13.475" end="0:13.700">Wa</span><span begin="0:13.700" end="0:14.080">sted,</span> <span begin="0:14.250" end="0:14.440">G</span><span begin="0:14.440" end="0:14.665">T</span><span begin="0:14.665" end="0:14.955">A</span> <span begin="0:14.955" end="0:15.520">love,</span> <span begin="0:15.520" end="0:15.939">bitches</span> <span b