<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">“好的 乐意效劳”</text><text for="L2">“随时为您做好准备”</text><text for="L3">“好的 小的明白”</text><text for="L4">“一定谨遵您的吩咐”</text><text for="L5">遇事总是会伸出援手</text><text for="L6">让人以为是正义化身</text><text for="L7">不情不愿地生活至今</text><text for="L8">对顽固之人竖起盾牌</text><text for="L9">“好的 乐意效劳 随时为您做好准备”</text><text for="L10">“只要是我做得到的</text><text for="L11">一定竭尽全力”</text><text for="L12">试着迈出一步后</text><text for="L13">便想起了烦心事</text><text for="L14">奏响地狱的序曲吧</text><text for="L15">・・・</text><text for="L16">再试着迈出一步后</text><text for="L17">便想起了烦心事</text><text for="L18">让倾诉心声的3〜6音节响彻吧</text><text for="L19">「・・・ーーー・・・」</text><text for="L20">竭尽全力舞动起来</text><text for="L21">舞动吧</text><text for="L22">竭尽全力舞动起来</text><text for="L23">再大声一些</text><text for="L24">竭尽全力舞动起来</text><text for="L25">舞动吧</text><text for="L26">竭尽全力舞动起来</text><text for="L27">再大声一些</text><text for="L28">习惯那病态的城市迈步吧</text><text for="L29">隐藏自我 笑对他人的意见吧</text><text for="L30">将正义超人的包袱统统抛之脑后</text><text for="L31">让倾诉心声的3〜6音节响彻吧</text><text for="L32">・・・ーーー・・・</text><text for="L33">就算心怀愤怒</text><text for="L34">你的温柔软弱仍会胜出</text><text for="L35">A先生，请拯救这场游戏</text><text for="L36">得到拯救的是我心里的另一个我</text><text for="L37">试着迈出一步后</text><text for="L38">便想起了烦心事</text><text for="L39">奏响地狱的序曲吧</text><text for="L40">・・・</text><text for="L41">再试着迈出一步后</text><text for="L42">便想起了烦心事</text><text for="L43">让倾诉心声的3〜6音节响彻吧</text><text for="L44">在分岔路口随心所欲地闯一番吧 总说着交给我吧才是一种自私</text><text for="L45">来吧 奏响哈库那玛塔塔的音符吧</text><text for="L46">「・・・ーーー・・・」</text><text for="L47">竭尽全力舞动起来</text><text for="L48">舞动吧</text><text for="L49">竭尽全力舞动起来</text><text for="L50">再大声一些</text><text for="L51">竭尽全力舞动起来</text><text for="L52">舞动吧</text><text for="L53">竭尽全力舞动起来</text><text for="L54">再大声一些</text><text for="L55">习惯那病态的城市迈步吧</text><text for="L56">隐藏自我 笑对他人的意见吧</text><text for="L57">将正义超人的包袱统统抛之脑后</text><text for="L58">让倾诉心声的3〜6音节响彻吧</text><text for="L59">・・・ーーー・・・</text><text for="L60">“好的 乐意效劳 随时为您做好准备”</text><text for="L61">“只要是我做得到的 一定竭尽全力”</text><text for="L62">“好的 小的明白 一定谨遵您的吩咐”</text><text for="L63">让倾诉心声的3〜6音节响彻吧</text><text for="L64">・・・ーーー・・・</text></translation></translations><songwriters><songwriter>GRP</songwriter><songwriter>Kocchi No Kento</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="Hai Yorokonde"/><amll:meta key="artists" value="Kocchi No Kento"/><amll:meta key="album" value="Hai Yorokonde - Single"/><amll:meta key="appleMusicId" value="1745488818"/></metadata></head><body><div begin="0:08.069" end="0:47.803" itunes:songPart="Verse"><p begin="0:08.069" end="0:10.099" itunes:key="L1" ttm:agent="v1"><span begin="0:08.069" end="0:08.505">「はい</span><span begin="0:08.505" end="0:09.341">喜ん</span><span begin="0:09.341" end="0:10.099">で」</span></p><p begin="0:11.134" end="0:13.224" itunes:key="L2" ttm:agent="v1"><span begin="0:11.134" end="0:11.766">「あなた</span><span begin="0:11.766" end="0:12.455">方の</span><span begin="0:12.455" end="0:12.633">た</span><span begin="0:12.633" end="0:13.224">め」</span></p><p begin="0:14.622" end="0:16.571" itunes:key="L3" ttm:agent="v1"><span begin="0:14.622" end="0:15.032">「はい</span><span begin="0:15.032" end="0:15.819">謹ん</span><span begin="0:15.819" end="0:16.571">で」</span></p><p begin="0:17.662" end="0:21.211" itunes:key="L4" ttm:agent="v1"><span begin="0:17.662" end="0:18.277">「あなた</span><span begin="0:18.277" end="0:18.896">方の</span><span begin="0:18.896" end="0:19.617">ため</span><span begin="0:20.192" end="0:21.211">に」</span></p><p begin="0:21.221" 