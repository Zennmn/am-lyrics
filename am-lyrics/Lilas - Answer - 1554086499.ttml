<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Answer"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="Answer - Single"/><amll:meta key="appleMusicId" value="1554086499"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">究竟还要漫步到何方</text><text for="L2">凝视镜中映出的自己</text><text for="L3">寻觅不到答案 那颗残缺的心</text><text for="L4">此刻只想紧紧拥入怀中</text><text for="L5">蜷缩身子泪水滑落的长夜</text><text for="L6">孤独让我渐渐成长</text><text for="L7">纵使怨恨过笨拙又不争气的自己</text><text for="L8">在流转的岁月里 依然渴望心怀梦想</text><text for="L9">朝阳初升 追寻终有一日的微光</text><text for="L10">那是伸手仍触碰不及的远方</text><text for="L11">唯愿盘踞心底深处的怯懦</text><text for="L12">不再侵蚀我跳动的心房</text><text for="L13">此刻便将束缚一一解开</text><text for="L14">日渐堆积教人难以承受的期许</text><text for="L15">正将我的本心悄然超越</text><text for="L16">脱口而出的那句没关系</text><text for="L17">不过是强掩心绪的面具</text><text for="L18">原来自己这般胆怯</text><text for="L19">韶华渐逝 行囊却愈发沉重</text><text for="L20">宛如被倒转的沙漏</text><text for="L21">即便能让逝去的时光重来一遍</text><text for="L22">我也定会再次选择这条路向前</text><text for="L23">阖上双眸确认过的那份心意</text><text for="L24">正乘着顺风加速疾驰</text><text for="L25">哪怕偶尔也会踉跄跌撞</text><text for="L26">也请别再畏惧犯下过错</text><text for="L27">我会迈步向前</text><text for="L28">亲手引来的未来蓝图</text><text for="L29">由我亲自执笔重新描画</text><text for="L30">为了不被无形的声音剥夺吞没</text><text for="L31">留下我立足于此的证明</text><text for="L32">将心中构想的光阴层层叠印</text><text for="L33">回首望去已有无数道终点线</text><text for="L34">那是一路跨越的证明</text><text for="L35">就这样还要走到何方</text><text for="L36">镜中映出的我轻轻点头应答</text><text for="L37">保持未完成的模样也无妨 寻觅缺失的残片</text><text for="L38">重新编织往后的每一个日夜</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:58.926"><div begin="0:02.144" end="3:58.926"><p begin="0:02.144" end="0:08.074" itunes:key="L1" ttm:agent="v1"><span begin="0:02.144" end="0:02.564">こ</span><span begin="0:02.564" end="0:02.764">の</span><span begin="0:02.764" end="0:02.964">ま</span><span begin="0:02.964" end="0:03.444">ま</span><span begin="0:03.694" end="0:04.024">ど</span><span begin="0:04.024" end="0:04.304">こ</span><span begin="0:04.304" end="0:04.514">ま</span><span begin="0:04.514" end="0:04.954">で</span> <span begin="0:05.134" end="0:05.634">歩</span><span begin="0:05.634" end="0:05.794">い</span><span begin="0:05.794" end="0:06.344">て</span><span begin="0:06.344" end="0:06.514">い</span><span begin="0:06.514" end="0:07.364">くん</span><span begin="0:07.364" end="0:07.744">だ</span><span begin="0:07.744" end="0:08.074">ろう</span></p><p begin="0:08.234" end="0:13.334" itunes:key="L2" ttm:agent="v1"><span begin="0:08.234" end="0:08.794">鏡</span><span begin="0:08.794" end="0:09.044">に</span><span begin="0:09.044" end="0:09.294">う</span><span begin="0:09.294" end="0:09.604">つ</span><span begin="0:09.604" end="0:10.024">る</span><span begin="0:10.024" end="0:10.304">自</span><span begin="0:10.304" end="0:11.114">分</span><span begin="0:11.114" end="0:11.624">を</span><span begin="0:11.624" end="0:11.764">見</span><span begin="0:11.764" end="0:12.174">つ</span><span begin="0:12.174" end="0:12.324">め</span><span begin="0:12.324" end="0:13.334">て</span></p><p begin="0:14.131" end="0:20.231" itunes:key="L3" ttm:agent="v1"><span begin="0:14.131" end="0:14.831">答</span><span begin="0:14.831" end="0:15.011">え</span><span begin="0:15.011" end="0:15.531">は</span><span begin="0:15.531" end="0:15.691">見</span><span begin="0:15.691" end="0:16.041">つ</span><span begin="0:16.041" end="0:16.331">か</span><span begin="0:16.331" end="0:16.481">ら</span><span begin="0:16.481" end="0:16.981">ない</span> <span begin="0:17.261" end="0:17.521">ま</span><span begin="0:17.521" end="0:17.761">だ</span