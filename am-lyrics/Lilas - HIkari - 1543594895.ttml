<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="HIkari"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="ヒカリ - Single"/><amll:meta key="isrc" value="JPP302000705"/><amll:meta key="appleMusicId" value="1543594895"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">忽然忆起那一刻</text><text for="L2">你曾毫无保留对我倾诉</text><text for="L3">那份独自珍藏已久的梦想</text><text for="L4">你按捺着微微颤抖的双手</text><text for="L5">若能与你相伴走到天涯海角</text><text for="L6">一同分担欢欣与不安</text><text for="L7">在那些悄然累积的岁月里</text><text for="L8">你也始终守候在我身旁</text><text for="L9">为了不让你在远方独自落泪</text><text for="L10">我愿化作微光照亮你前行的脚下</text><text for="L11">就顺着你认定的步伐向前吧</text><text for="L12">别害怕 迈步向前吧</text><text for="L13">我们仰望的定是同一片天空</text><text for="L14">晚霞仿佛定格成了永恒</text><text for="L15">假装忘记了时间</text><text for="L16">夕阳西下长谈至夜色渐浓的归途</text><text for="L17">一次次目送电车驶过</text><text for="L18">回过神来已模糊在远方</text><text for="L19">我向你的背影伸出双手</text><text for="L20">将那段险些淡忘的约定</text><text for="L21">再次细细编织重拾</text><text for="L22">你的笑靥依然如旧</text><text for="L23">稚嫩的眉眼与说话的习惯都未曾改变</text><text for="L24">我一直等着你 抱歉我来迟了</text><text for="L25">那一天勾勒出的我们</text><text for="L26">此刻终于在这里交汇相逢</text><text for="L27">飞奔过银杏林道的清晨</text><text for="L28">依偎并肩的两个身影</text><text for="L29">毫无凭据却坚信不疑的安慰</text><text for="L30">偷偷溜上天台仰望的天空</text><text for="L31">畅聊直至天明的那些梦想</text><text for="L32">必定都能紧紧相连</text><text for="L33">当你初次向我诉说梦想的那一刻</text><text for="L34">清澈直率的目光深深打动了我的心</text><text for="L35">毫无疑问 旅程正是从那天开始启程</text><text for="L36">属于我们两人无可替代的物语</text><text for="L37">坚信着只要是我们一定能做到</text><text for="L38">那些纯真地为彼此喝彩的日子一路相伴相系</text><text for="L39">心怀着想要再次相遇的强烈期盼</text><text for="L40">已然成真的梦想 后续也要与你一同实现</text></translation></translations><songwriters><songwriter>Lilas</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:45.910"><div begin="0:01.347" end="3:45.910"><p begin="0:01.347" end="0:05.547" itunes:key="L1" ttm:agent="v1"><span begin="0:01.347" end="0:01.797">ふ</span><span begin="0:01.797" end="0:02.467">と</span><span begin="0:02.857" end="0:03.267">思</span><span begin="0:03.267" end="0:03.717">い</span><span begin="0:03.717" end="0:04.127">出</span><span begin="0:04.127" end="0:04.287">し</span><span begin="0:04.287" end="0:05.147">たん</span><span begin="0:05.147" end="0:05.547">だ</span></p><p begin="0:05.967" end="0:11.667" itunes:key="L2" ttm:agent="v1"><span begin="0:05.967" end="0:06.417">君</span><span begin="0:06.417" end="0:06.827">は</span><span begin="0:07.427" end="0:07.827">ちゃん</span><span begin="0:07.827" end="0:08.467">と</span><span begin="0:09.567" end="0:09.977">話</span><span begin="0:09.977" end="0:10.117">し</span><span begin="0:10.117" end="0:10.277">て</span><span begin="0:10.277" end="0:10.697">く</span><span begin="0:10.697" end="0:10.847">れ</span><span begin="0:10.847" end="0:11.667">た</span></p><p begin="0:13.425" end="0:19.075" itunes:key="L3" ttm:agent="v1"><span begin="0:13.425" end="0:13.785">ずっ</span><span begin="0:13.785" end="0:14.845">と</span><span begin="0:14.845" end="0:15.945">一人</span><span begin="0:16.335" end="0:16.855">温</span><span begin="0:16.855" end="0:17.045">め</span><span begin="0:17.045" end="0:17.215">て</span><span begin="0:17.215" end="0:17.625">た</span><span begin="0:17.625" end="0:18.155">夢</span><span begin="0:18.155" end="0:19.075">を</span></p><p begin="0:19.451" end="0:23.701" itunes:key="L4" ttm:agent="v1"><span begin="0:19.451" end="0:19.911">震</span><span begin="0:19.911" end="0:20.131">え</span><span begin="0:20.131" end="0:20.541">る</span><span begin="0:20.541" end="0:20.861">手</span><span begin="0:20.861" end="0:21.301">を</span><span begin="0:21.431" end