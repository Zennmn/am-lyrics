<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="In Bloom"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="Laugh"/><amll:meta key="appleMusicId" value="1857886416"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lilas Ikuta</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">悠然摇曳</text><text for="L2">簌簌飘落</text><text for="L3">万千颜色尽斑斓</text><text for="L4">竞相烂漫盛开</text><text for="L5">遥忆故里花街景</text><text for="L6">在此方苍穹下</text><text for="L7">只因一场始料未及的巧合</text><text for="L8">辗转来到了这方天地</text><text for="L9">曾是遥不可及之处</text><text for="L10">那一座金碧辉煌的舞台</text><text for="L11">令人怦然惊叹</text><text for="L12">方知世间竟有如此绚烂的光景</text><text for="L13">面对你百般刁难的要求</text><text for="L14">每一次抽丝剥茧去应对</text><text for="L15">抛出让人拍案称绝的</text><text for="L16">出人意料的破局之法</text><text for="L17">在穿透重重迷雾的前方</text><text for="L18">总有未曾见过的风光在等候</text><text for="L19">千奇百怪的离奇谜团</text><text for="L20">每当接二连三纷至沓来</text><text for="L21">任凭机关再巧妙</text><text for="L22">我也定能将其彻底揭穿</text><text for="L23">纵有再棘手的难题</text><text for="L24">不过是障眼法与暗藏玄机</text><text for="L25">些许代价何足挂齿</text><text for="L26">真相终将被我探寻探明</text><text for="L27">啊 在此间亲身触碰到的</text><text for="L28">是人世间真切的悲喜哀乐</text><text for="L29">凡此种种点点滴滴</text><text for="L30">都在心底泛起阵阵涟漪</text><text for="L31">美得教人屏息凝神</text><text for="L32">如此明艳鲜活的世界就在眼前</text><text for="L33">迎接着你递来的重重考卷</text><text for="L34">在逐一解开谜题的朝夕里</text><text for="L35">总能给出令人惊叹的</text><text for="L36">异想天开的绝妙解答</text><text for="L37">一步步跋涉所至之处</text><text for="L38">将与蜕变新生的自己相遇</text><text for="L39">昔日从不曾敢设想</text><text for="L40">未知的韶华正悄然盛绽</text><text for="L41">这般纷扰的岁月似乎也不错呢</text><text for="L42">随风轻摇曳</text><text for="L43">翩跹自纷飞</text><text for="L44">时而远离</text><text for="L45">时而相互依偎</text><text for="L46">任由轻柔微风拂动衣袂</text><text for="L47">在幽幽月夜下翩然起舞</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:58.479"><div begin="0:00.679" end="2:58.479"><p begin="0:00.679" end="0:01.731" itunes:key="L1" ttm:agent="v1"><span begin="0:00.679" end="0:00.999">ゆら</span><span begin="0:01.137" end="0:01.731">ゆらり</span></p><p begin="0:01.896" end="0:02.899" itunes:key="L2" ttm:agent="v1"><span begin="0:01.896" end="0:02.224">はら</span><span begin="0:02.379" end="0:02.899">はらり</span></p><p begin="0:03.757" end="0:04.931" itunes:key="L3" ttm:agent="v1"><span begin="0:03.757" end="0:04.061">色</span><span begin="0:04.195" end="0:04.931">とりどり</span></p><p begin="0:05.112" end="0:06.131" itunes:key="L4" ttm:agent="v1"><span begin="0:05.112" end="0:05.547">乱れ</span><span begin="0:05.759" end="0:06.131">咲き</span></p><p begin="0:07.096" end="0:09.264" itunes:key="L5" ttm:agent="v1"><span begin="0:07.096" end="0:07.640">花の</span><span begin="0:07.782" end="0:08.205">街</span><span begin="0:08.320" end="0:08.753">思い</span><span begin="0:08.911" end="0:09.264">出す</span></p><p begin="0:09.512" end="0:11.979" itunes:key="L6" ttm:agent="v1"><span begin="0:09.512" end="0:09.816">この</span><span begin="0:09.975" end="0:11.469">空</span><span begin="0:11.542" end="0:11.979">から</span></p><p begin="0:19.909" end="0:22.443" itunes:key="L7" ttm:agent="v1"><span begin="0:19.909" end="0:20.186">ひょん</span><span begin="0:20.491" end="0:20.933">な</span><span begin="0:20.963" end="0:21.637">出来事</span><span begin="0:21.767" end="0:21.965">か</span><span begin="0:22.224" end="0:22.443">ら</span></p><p begin="0:22.909" end="0:25.227" itunes:key="L8" ttm:agent="v1"><span begin="0:22.909" end="0:23.184">やっ</span><span begin="0:23.296" end="0:23.810">てきた</span><span begin="0:23.948" end="0:24.216">この</span><span begin="0:24.348" end="0:24.669">場所</span><span begin="0:24.890" end="0:25.227">は</span></p><p begin="0:26.293" end="0:28.421" itunes:key="L9" ttm:agent="v1"><span begin="0:26.293" end="0:26.853">遥か</span><span begin="0:26.969" end="0:27.335">遠く</span><span begin="0:27.532" end="0:28.421">にあった</span></p><p begin="0:28.704" end="0:31.512" itunes:key="L10" ttm:agent="v1"><span begin="0:28.704" end="0:29.088">煌</span><span begin="0:29.368" end="0:29.917">び</span><span begin="0:29.917" end="0:30.156">や</span><span begin="0:30.156" end="0:30.653">かな</span><span begin="0:30.790" end="0:30.950">舞</span><span begin="0:30.950" end="0:31.512">台</span></p><p begin="0:32.715" end="0:34.275" itunes:key="L11" ttm:agent="v1"><span begin="0:32.715" end="0:32.986">ハっ</span><span begin="0:33.277" end="0:34.275">とするほど</span></p><p begin="0:34.422" end="0:38.648" itunes:key="L12" ttm:agent="v1"><span begin="0:34.422" end="0:34.931">鮮や</span><span begin="0:34.931" end="0:35.466">か</span><span begin="0:35.466" end="0:35.591">な</span><span begin="0:35.591" end="0:35.736">世</span><span begin="0:35.736" end="0:36.501">界</span><span begin="0:36.501" end="0:36.651">が</span><span begin="0:37.124" end="0:38.041">あるんだと</span><span begin="0:38.041" end="0:38.648">知った</span></p><p begin="0:38.705" end="0:41.155" itunes:key="L13" ttm:agent="v1"><span begin="0:38.705" end="0:38.893">あ</span><span begin="0:38.893" end="0:39.864">なたの</span><span begin="0:39.864" end="0:40.116">無理</span><span begin="0:40.164" end="0:40.972">難題</span><span begin="0:40.972" end="0:41.155">に</span></p><p begin="0:41.355" end="0:44.289" itunes:key="L14" ttm:agent="v1"><span begin="0:41.355" end="0:42.192">応えていく</span><span begin="0:42.528" end="0:43.767">その度</span><span begin="0:43.767" end="0:44.289">に</span></p><p begin="0:45.489" end="0:47.448" itunes:key="L15" ttm:agent="v1"><span begin="0:45.489" end="0:45.825">あっ</span><span begin="0:46.050" end="0:46.782">と言わせる</span><span begin="0:46.782" end="0:47.448">ような</span></p><p begin="0:47.482" end="0:51.515" itunes:key="L16" ttm:agent="v1"><span begin="0:47.482" end="0:47.671">奇</span><span begin="0:47.671" end="0:49.506">想天外</span><span begin="0:49.698" end="0:50.736">な答え合わ</span><span begin="0:50.736" end="0:51.515">せで</span></p><p begin="0:51.715" end="0:54.132" itunes:key="L17" ttm:agent="v1"><span begin="0:51.715" end="0:52.247">辿</span><span begin="0:52.247" end="0:52.443">り</span><span begin="0:52.461" end="0:52.888">着いた</span><span begin="0:52.924" end="0:53.229">その</span><span begin="0:53.329" end="0:54.132">先に</span></p><p begin="0:54.366" end="0:58.547" itunes:key="L18" ttm:agent="v1"><span begin="0:54.366" end="0:54.842">新</span><span begin="0:54.842" end="0:55.527">しい</span><span begin="0:55.527" end="0:55.708">景</span><span begin="0:55.708" end="0:56.511">色</span><span begin="0:56.511" end="0:56.681">が</span><span begin="0:56.844" end="0:57.409">待って</span><span begin="0:57.768" end="0:58.222">いるん</span><span begin="0:58.349" end="0:58.547">だ</span></p><p begin="1:04.699" end="1:06.966" itunes:key="L19" ttm:agent="v1"><span begin="1:04.699" end="1:05.848">摩訶不思議な</span><span begin="1:05.848" end="1:06.575">ミステ</span><span begin="1:06.575" end="1:06.966">リー</span></p><p begin="1:07.648" end="1:10.198" itunes:key="L20" ttm:agent="v1"><span begin="1:07.648" end="1:09.072">次から次に</span><span begin="1:09.072" end="1:10.198">起こるたび</span></p><p begin="1:11.131" end="1:13.315" itunes:key="L21" ttm:agent="v1"><span begin="1:11.131" end="1:12.355">巧妙な</span><span begin="1:12.372" end="1:13.315">からくりも</span></p><p begin="1:13.499" end="1:16.064" itunes:key="L22" ttm:agent="v1"><span begin="1:13.499" end="1:14.254">暴いて</span><span begin="1:14.294" end="1:14.489">み</span><span begin="1:14.580" end="1:15.309">せ</span><span begin="1:15.309" end="1:16.064">ましょう</span></p><p begin="1:17.464" end="1:20.032" itunes:key="L23" ttm:agent="v1"><span begin="1:17.464" end="1:17.837">どん</span><span begin="1:18.058" end="1:19.296">な難題</span><span begin="1:19.394" end="1:19.605">で</span><span begin="1:19.714" end="1:20.032">も</span></p><p begin="1:20.515" end="1:22.782" itunes:key="L24" ttm:agent="v1"><span begin="1:20.515" end="1:20.992">種や</span><span begin="1:21.116" end="1:21.806">仕掛けは</span><span begin="1:21.929" end="1:22.371">あるん</span><span begin="1:22.532" end="1:22.782">だ</span></p><p begin="1:23.920" end="1:25.998" itunes:key="L25" ttm:agent="v1"><span begin="1:23.920" end="1:25.098">副作用は</span><span begin="1:25.098" end="1:25.416">気に</span><span begin="1:25.464" end="1:25.998">しない</span></p><p begin="1:26.314" end="1:33.747" itunes:key="L26" ttm:agent="v1"><span begin="1:26.314" end="1:27.532">必</span><span begin="1:27.532" end="1:28.013">ずや</span><span begin="1:28.066" end="1:28.672">導</span><span begin="1:28.878" end="1:29.218">き</span><span begin="1:29.286" end="1:29.624">出す</span><span begin="1:29.698" end="1:30.069">か</span><span begin="1:30.069" end="1:33.747">ら</span></p><p begin="1:47.891" end="1:50.056" itunes:key="L27" ttm:agent="v1"><span begin="1:47.891" end="1:48.194">あぁ</span><span begin="1:48.465" end="1:49.438">この場所で</span><span begin="1:49.453" end="1:50.056">触れた</span></p><p begin="1:50.057" end="1:53.989" itunes:key="L28" ttm:agent="v1"><span begin="1:50.057" end="1:50.710">人の</span><span begin="1:50.710" end="1:51.442">哀</span><span begin="1:51.442" end="1:51.830">しみ</span><span begin="1:52.203" end="1:53.261">や喜び</span><span begin="1:53.261" end="1:53.989">がある</span></p><p begin="1:54.141" end="1:56.507" itunes:key="L29" ttm:agent="v1"><span begin="1:54.141" end="1:54.472">その</span><span begin="1:54.728" end="1:55.422">ひとつ</span><span begin="1:55.422" end="1:56.507">ひとつが</span></p><p begin="1:56.744" end="2:01.063" itunes:key="L30" ttm:agent="v1"><span begin="1:56.744" end="1:57.557">心を</span><span begin="1:57.767" end="1:58.584">震</span><span begin="1:58.584" end="1:58.957">わせ</span><span begin="1:58.957" end="2:01.063">る</span></p><p begin="2:02.301" end="2:03.811" itunes:key="L31" ttm:agent="v1"><span begin="2:02.301" end="2:02.573">ハッ</span><span begin="2:02.878" end="2:03.811">としちゃうほど</span></p><p begin="2:03.919" end="2:08.290" itunes:key="L32" ttm:agent="v1"><span begin="2:03.919" end="2:04.460">鮮や</span><span begin="2:04.460" end="2:05.046">か</span><span begin="2:05.046" end="2:05.357">な世</span><span begin="2:05.357" end="2:06.162">界</span><span begin="2:06.162" end="2:06.345">が</span><span begin="2:06.703" end="2:07.423">ここに</span><span begin="2:07.504" end="2:08.290">あるんだ</span></p><p begin="2:08.364" end="2:10.814" itunes:key="L33" ttm:agent="v1"><span begin="2:08.364" end="2:08.552">あ</span><span begin="2:08.552" end="2:09.481">なたの</span><span begin="2:09.523" end="2:09.775">無理</span><span begin="2:09.823" end="2:10.631">難題</span><span begin="2:10.631" end="2:10.814">に</span></p><p begin="2:10.937" end="2:13.863" itunes:key="L34" ttm:agent="v1"><span begin="2:10.937" end="2:11.870">応えていく</span><span begin="2:12.041" end="2:13.863">毎日に</span></p><p begin="2:15.103" end="2:17.062" itunes:key="L35" ttm:agent="v1"><span begin="2:15.103" end="2:15.439">あっ</span><span begin="2:15.664" end="2:16.396">と言わせる</span><span begin="2:16.396" end="2:17.062">ような</span></p><p begin="2:17.129" end="2:21.162" itunes:key="L36" ttm:agent="v1"><span begin="2:17.129" end="2:17.318">奇</span><span begin="2:17.318" end="2:19.153">想天外</span><span begin="2:19.345" end="2:20.383">な答え合わ</span><span begin="2:20.383" end="2:21.162">せで</span></p><p begin="2:21.329" end="2:23.746" itunes:key="L37" ttm:agent="v1"><span begin="2:21.329" end="2:21.861">辿</span><span begin="2:21.861" end="2:22.057">り</span><span begin="2:22.075" end="2:22.502">着いた</span><span begin="2:22.538" end="2:22.843">その</span><span begin="2:22.943" end="2:23.746">先に</span></p><p begin="2:23.927" end="2:28.164" itunes:key="L38" ttm:agent="v1"><span begin="2:23.927" end="2:24.532">新</span><span begin="2:24.532" end="2:25.194">しい</span><span begin="2:25.194" end="2:26.147">私</span><span begin="2:26.147" end="2:26.338">が</span><span begin="2:26.581" end="2:27.111">待って</span><span begin="2:27.281" end="2:27.831">いるん</span><span begin="2:27.960" end="2:28.164">だ</span></p><p begin="2:29.097" end="2:34.004" itunes:key="L39" ttm:agent="v1"><span begin="2:29.097" end="2:29.419">あ</span><span begin="2:29.419" end="2:30.126">の</span><span begin="2:30.487" end="2:31.053">頃</span><span begin="2:31.053" end="2:31.750">は</span><span begin="2:32.130" end="2:32.891">想像</span><span begin="2:32.891" end="2:34.004">もしていない</span></p><p begin="2:34.137" end="2:36.556" itunes:key="L40" ttm:agent="v1"><span begin="2:34.137" end="2:34.366">未</span><span begin="2:34.366" end="2:34.963">来が</span><span begin="2:35.017" end="2:35.257">咲き</span><span begin="2:35.377" end="2:35.804">始め</span><span begin="2:36.130" end="2:36.556">ている</span></p><p begin="2:36.721" end="2:40.988" itunes:key="L41" ttm:agent="v1"><span begin="2:36.721" end="2:37.296">こんな</span><span begin="2:37.296" end="2:37.926">日</span><span begin="2:37.926" end="2:38.118">々</span><span begin="2:38.118" end="2:38.605">も</span><span begin="2:38.605" end="2:39.182">悪</span><span begin="2:39.337" end="2:40.044">くは</span><span begin="2:40.150" end="2:40.988">ないかな</span></p><p begin="2:47.140" end="2:48.192" itunes:key="L42" ttm:agent="v1"><span begin="2:47.140" end="2:47.460">ゆら</span><span begin="2:47.598" end="2:48.192">ゆらり</span></p><p begin="2:48.303" end="2:49.319" itunes:key="L43" ttm:agent="v1"><span begin="2:48.303" end="2:48.610">ひら</span><span begin="2:48.748" end="2:49.319">ひらり</span></p><p begin="2:50.329" end="2:51.263" itunes:key="L44" ttm:agent="v1"><span begin="2:50.329" end="2:51.263">離れては</span></p><p begin="2:51.545" end="2:52.580" itunes:key="L45" ttm:agent="v1"><span begin="2:51.545" end="2:52.580">寄り添って</span></p><p begin="2:53.545" end="2:55.681" itunes:key="L46" ttm:agent="v1"><span begin="2:53.545" end="2:54.067">そよぐ</span><span begin="2:54.067" end="2:54.599">風に</span><span begin="2:54.599" end="2:55.047">身を</span><span begin="2:55.047" end="2:55.681">任せ</span></p><p begin="2:55.963" end="2:58.479" itunes:key="L47" ttm:agent="v1"><span begin="2:55.963" end="2:56.363">幽</span><span begin="2:56.424" end="2:57.067">夜</span><span begin="2:57.572" end="2:57.918">に</span><span begin="2:57.918" end="2:58.479">舞う</span></p></div></body></tt>