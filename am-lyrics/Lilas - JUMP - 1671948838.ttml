<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="JUMP"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="Sketch"/><amll:meta key="isrc" value="JPP302200716"/><amll:meta key="appleMusicId" value="1671948838"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lilas</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">纷乱的心跳</text><text for="L2">宛若潜行的魔物</text><text for="L3">拜托了 请听从我的呼唤</text><text for="L4">愿数秒后的未来里</text><text for="L5">能绽开释怀的笑容</text><text for="L6">一次次在心底默念 相信自己</text><text for="L7">呐喊与目光经久不息</text><text for="L8">正汇聚成翻涌的漩涡</text><text for="L9">我奔跑着纵身跃入风暴中央</text><text for="L10">若是心生迟疑</text><text for="L11">就再也无法振翅高飞</text><text for="L12">绝不回望身后</text><text for="L13">目光只锁定前方</text><text for="L14">倾尽所有的自己</text><text for="L15">事与愿违时之所以潸然泪下</text><text for="L16">是因为心知不能就此结束</text><text for="L17">跨越阻碍后心手相连的梦想</text><text for="L18">无论天涯海角都在将我呼唤</text><text for="L19">面对远高过身躯的重重壁垒</text><text for="L20">难以逾越</text><text for="L21">一次次不由自主地呆立在原地</text><text for="L22">想象那个成功跃过的自己</text><text for="L23">一遍遍在心中描绘</text><text for="L24">一点点重新拾起自信的碎片</text><text for="L25">肩负起多少期许</text><text for="L26">脚步便增添几分沉重</text><text for="L27">可这份重量越是沉甸甸</text><text for="L28">我就愈发顶天立地 变得坚强</text><text for="L29">挣脱束缚 尽情释放</text><text for="L30">若能让曾经厌恶的紧张也成为助力</text><text for="L31">奇迹也定能在此刻诞生</text><text for="L32">这绝非我一人独揽的幻梦</text><text for="L33">由无数双手接续传递</text><text for="L34">如雨落下的声援化作光亮</text><text for="L35">照亮我奔赴的前方</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:14.131"><div begin="0:20.381" end="3:14.131"><p begin="0:20.381" end="0:25.001" itunes:key="L1" ttm:agent="v1"><span begin="0:20.381" end="0:21.111">乱</span><span begin="0:21.111" end="0:21.261">れ</span><span begin="0:21.261" end="0:21.771">て</span><span begin="0:21.771" end="0:22.181">る鼓</span><span begin="0:22.181" end="0:22.761">動</span><span begin="0:22.761" end="0:23.091">は</span><span begin="0:23.091" end="0:24.391">ま</span><span begin="0:24.391" end="0:24.501">る</span><span begin="0:24.501" end="0:25.001">で</span></p><p begin="0:25.391" end="0:28.241" itunes:key="L2" ttm:agent="v1"><span begin="0:25.391" end="0:25.521">魔</span><span begin="0:25.521" end="0:25.961">物</span><span begin="0:25.961" end="0:26.381">の</span><span begin="0:26.381" end="0:27.761">よう</span><span begin="0:27.761" end="0:28.241">だ</span></p><p begin="0:29.434" end="0:33.104" itunes:key="L3" ttm:agent="v1"><span begin="0:29.434" end="0:29.984">言う</span><span begin="0:29.984" end="0:30.184">こ</span><span begin="0:30.184" end="0:30.614">と</span><span begin="0:30.614" end="0:30.934">聞</span><span begin="0:30.934" end="0:31.044">い</span><span begin="0:31.044" end="0:31.434">て</span><span begin="0:31.434" end="0:31.874">く</span><span begin="0:31.874" end="0:32.194">れ</span><span begin="0:32.194" end="0:32.624">どう</span><span begin="0:32.624" end="0:33.104">か</span></p><p begin="0:33.112" end="0:37.822" itunes:key="L4" ttm:agent="v1"><span begin="0:33.112" end="0:34.042">数</span><span begin="0:34.042" end="0:34.832">秒</span><span begin="0:34.832" end="0:35.512">先</span><span begin="0:35.512" end="0:35.682">の</span><span begin="0:35.682" end="0:36.102">未</span><span begin="0:36.102" end="0:37.352">来</span><span begin="0:37.352" end="0:37.822">で</span></p><p begin="0:38.368" end="0:41.288" itunes:key="L5" ttm:agent="v1"><span begin="0:38.368" end="0:38.968">笑っ</span><span begin="0:38.968" end="0:39.198">て</span><span begin="0:39.198" end="0:39.328">い</span><span begin="0:39.328" end="0:40.438">ま</span><span begin=