<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Midnight Talk"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="Sketch"/><amll:meta key="isrc" value="JPP302300070"/><amll:meta key="appleMusicId" value="1671948834"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lilas</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">不知怎的难以成眠</text><text for="L2">若你此刻也怀着同样的心绪</text><text for="L3">午夜谈心就此开启</text><text for="L4">今天都做了些什么呢</text><text for="L5">想听你一件一件慢慢道来</text><text for="L6">在这间唯有你我且月色倾洒的屋子里</text><text for="L7">此刻先别在意之后的事</text><text for="L8">来聊聊只属于彼此的秘密吧</text><text for="L9">把所有烦心事全都倾诉出来</text><text for="L10">就任由它们消融在夜的海浪里</text><text for="L11">陪在我身边笑到厌倦为止吧</text><text for="L12">若能像这样与你共度漫漫长夜</text><text for="L13">无论黑夜还有多长我都甘之如饴</text><text for="L14">直到拂晓前都将心毫无保留地托付给彼此吧</text><text for="L15">不知不觉间困意便会悄然来临</text><text for="L16">亲爱的 愿你做个温柔的梦</text><text for="L17">依然毫无倦意</text><text for="L18">若你也深陷在同样的忧思里</text><text for="L19">不如一同出门散散步吧</text><text for="L20">去便利店买支冰淇淋</text><text for="L21">烦扰难题暂且搁下</text><text for="L22">牵起手吧</text><text for="L23">照亮夜路的街灯</text><text for="L24">宛如落下的聚光灯</text><text for="L25">归途之中踏着彼此相同的节拍吧</text><text for="L26">随心哼唱起心爱的那首歌谣</text><text for="L27">仿佛电影里的一幕剪影</text><text for="L28">在天亮之前尽情嬉闹欢笑吧</text><text for="L29">困倦的哈欠不久便会悄然而至</text><text for="L30">如同彼此的默契约定</text><text for="L31">先一步沉沉睡去的你</text><text for="L32">那长长的睫毛与温热的手心</text><text for="L33">还有如孩童般纯真的睡颜</text><text for="L34">在凝望着你的这样的夜里</text><text for="L35">我会一直珍爱</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:15.608"><div begin="0:19.707" end="3:15.608"><p begin="0:19.707" end="0:21.517" itunes:key="L1" ttm:agent="v1"><span begin="0:19.707" end="0:20.047">なん</span><span begin="0:20.047" end="0:20.307">だ</span><span begin="0:20.307" end="0:20.447">か</span><span begin="0:20.447" end="0:20.587">寝</span><span begin="0:20.587" end="0:20.807">付</span><span begin="0:20.807" end="0:21.227">け</span><span begin="0:21.227" end="0:21.517">ない</span></p><p begin="0:21.517" end="0:24.067" itunes:key="L2" ttm:agent="v1"><span begin="0:21.517" end="0:21.967">君</span><span begin="0:21.967" end="0:22.207">も</span><span begin="0:22.207" end="0:22.637">同</span><span begin="0:22.637" end="0:22.767">じ</span><span begin="0:22.767" end="0:22.927">気</span><span begin="0:22.927" end="0:23.107">持</span><span begin="0:23.107" end="0:23.427">ち</span><span begin="0:23.427" end="0:23.847">な</span><span begin="0:23.847" end="0:24.067">ら</span></p><p begin="0:24.067" end="0:27.057" itunes:key="L3" ttm:agent="v1"><span begin="0:24.067" end="0:24.557">始</span><span begin="0:24.557" end="0:24.997">ま</span><span begin="0:24.997" end="0:25.157">る</span><span begin="0:25.157" end="0:25.757">mid</span><span begin="0:25.807" end="0:26.097">night</span> <span begin="0:26.097" end="0:26.567">tal</span><span begin="0:26.567" end="0:27.057">king</span></p><p begin="0:29.001" end="0:30.801" itunes:key="L4" ttm:agent="v1"><span begin="0:29.001" end="0:29.331">今日</span><span begin="0:29.331" end="0:29.591">は</span><span begin="0:29.591" end="0:29.851">何</span><span begin="0:29.851" end="0:30.081">し</span><span begin="0:30.081" end="0:30.531">た</span><span begin="0:30.531" end="0:30.801">の？</span></p><p begin="0:30.948" end="0:34.142" itunes:key="L5" ttm:agent="v1"><span begin="0:30.948" end="0:31.348">君</span><span begin="0:31.348" end="0:31.478">の</span><span begin="0:31.478" end="0:32.058">話</span><span begin="0:32.058" end="0:32.208">ひ</span><span begin="0:32.208" end="0:32.428">と</sp