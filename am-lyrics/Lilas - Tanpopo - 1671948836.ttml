<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Tanpopo"/><amll:meta key="artists" value="Lilas"/><amll:meta key="album" value="Sketch"/><amll:meta key="isrc" value="JPP302200839"/><amll:meta key="appleMusicId" value="1671948836"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lilas</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">并非出自本愿</text><text for="L2">却降生于此地</text><text for="L3">蓦然惊觉 双手之中</text><text for="L4">早已溢满强加寄托的理想</text><text for="L5">在日复一日的潜移默化中</text><text for="L6">膨胀而起的虚像</text><text for="L7">将我塑造雕琢</text><text for="L8">成了真假莫辨的赝品</text><text for="L9">仍想怀抱信任</text><text for="L10">被束缚的心如此呐喊</text><text for="L11">于迷惘彷徨中祈求</text><text for="L12">这无尽的循环</text><text for="L13">挣脱那荒唐无谓的规条</text><text for="L14">若能抛下过往所有</text><text for="L15">坦诚相向相视而笑</text><text for="L16">若有那么一天</text><text for="L17">奢求能得回报</text><text for="L18">渴求能获救赎</text><text for="L19">我绝非以此相求</text><text for="L20">只愿你能真切回望我一眼</text><text for="L21">对这颗无声枯萎的心</text><text for="L22">视若无睹</text><text for="L23">循环往复何其无休</text><text for="L24">早已不堪承受</text><text for="L25">这般重蹈覆辙</text><text for="L26">深匿阴影中的无声交战</text><text for="L27">永无得见天日之时</text><text for="L28">历经一切终能留存之物</text><text for="L29">是纵然伤痕累累</text><text for="L30">依然守护并牵念的一切</text><text for="L31">愿心化作繁花</text><text for="L32">终如蒲公英绒羽般乘风飞散</text><text for="L33">系紧彼此 莫令爱意断绝</text><text for="L34">随清风起舞</text><text for="L35">无论迢迢千里</text><text for="L36">直到宿命彼岸</text><text for="L37">自摇曳飘落的那片土地上</text><text for="L38">我相信会萌芽绽放 向四方蔓延</text><text for="L39">若能将心意连绵寄向未来</text><text for="L40">降生于世的意义</text><text for="L41">如今的我已能释怀接纳</text><text for="L42">展翼振翅高飞吧</text><text for="L43">就此不再放弃</text><text for="L44">无论是这无尽的重蹈覆辙</text><text for="L45">亦或是荒谬陈规 尽数撕碎抛却</text><text for="L46">若人人都能同样地</text><text for="L47">彼此宽恕 彼此相爱</text><text for="L48">心怀那般光景翘首以盼</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:09.278"><div begin="0:00.738" end="3:09.278"><p begin="0:00.738" end="0:02.538" itunes:key="L1" ttm:agent="v1"><span begin="0:00.738" end="0:01.248">望ん</span><span begin="0:01.248" end="0:01.628">だ訳</span><span begin="0:01.628" end="0:01.818">で</span><span begin="0:01.818" end="0:02.028">は</span><span begin="0:02.028" end="0:02.288">な</span><span begin="0:02.318" end="0:02.538">く</span></p><p begin="0:02.548" end="0:04.168" itunes:key="L2" ttm:agent="v1"><span begin="0:02.548" end="0:02.918">此処</span><span begin="0:02.918" end="0:03.078">に</span><span begin="0:03.078" end="0:03.188">生</span><span begin="0:03.188" end="0:03.318">ま</span><span begin="0:03.318" end="0:03.508">れ</span><span begin="0:03.528" end="0:03.778">落ち</span><span begin="0:03.778" end="0:04.168">て</span></p><p begin="0:05.245" end="0:07.065" itunes:key="L3" ttm:agent="v1"><span begin="0:05.245" end="0:05.415">気</span><span begin="0:05.415" end="0:05.525">付</span><span begin="0:05.525" end="0:05.725">け</span><span begin="0:05.725" end="0:05.855">ば</span><span begin="0:05.855" end="0:06.075">両</span><span begin="0:06.075" end="0:06.325">手</span><span begin="0:06.325" end="0:06.535">一</span><span begin="0:06.535" end="0:06.845">杯</span><span begin="0:06.845" end="0:07.065">が</span></p><p begin="0:07.069" end="0:09.489" itunes:key="L4" ttm:agent="v1"><span begin="0:07.069" end="0:07.379">託</span><span begin="0:07.379" end="0:07.539">さ</span><span begin="0:07.539" end="0:07.669">れ</span><span begin="0:07.669" end="0:07.799">た</span><span begin="0:07.799" end="0:07.909">理</span><span begin="0:07.909" end="0:08.259">想</span><span begin="0:08.259" end="0:08.589">で</