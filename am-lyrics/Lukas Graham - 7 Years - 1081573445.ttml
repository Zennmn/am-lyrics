<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Christopher Brown</songwriter><songwriter>David LaBrel</songwriter><songwriter>Lukas Forchhammer</songwriter><songwriter>Morten Pilegaard</songwriter><songwriter>Morten Ristorp</songwriter><songwriter>Stefan Forrest</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">那年我七岁 妈妈对我说</text><text for="L2">去交些朋友吧 不然会孤单</text><text for="L3">那年我七岁</text><text for="L4">世界很大很大 我们却以为自己更大</text><text for="L5">我们彼此逼着对方突破极限 也因此更快长大</text><text for="L6">十一岁时就抽起大麻 喝下灼喉的烈酒</text><text for="L7">手头从来不宽裕 便盼着挣到安稳的收入</text><text for="L8">那年我十一岁 爸爸对我说</text><text for="L9">将来找个妻子相伴吧 才不至于孤单</text><text for="L10">那年我十一岁</text><text for="L11">我也一直怀着梦想 就像当年的父亲一样</text><text for="L12">于是我开始写歌 也开始写下一个个故事</text><text for="L13">可所谓的荣光 总让我觉得索然无味</text><text for="L14">因为唯有我深爱的人 才真正懂得我</text><text for="L15">二十岁那年 我的故事终于有人听见</text><text for="L16">在黎明到来之前 日子仍旧寂寞</text><text for="L17">那年我二十岁</text><text for="L18">我眼里只有目标 不信自己会失败</text><text for="L19">因为我知道 再微小的声音也能唱出一番天地</text><text for="L20">还有些兄弟在我身旁 至少他们愿意支持我</text><text for="L21">若离去之前无缘相见 但愿将来还能重逢</text><text for="L22">二十岁那年 我的故事终于有人听见</text><text for="L23">我把眼前看见的一切 都写进了歌里</text><text for="L24">那年我二十岁</text><text for="L25">转眼我们就要三十岁 我们的歌早已卖向世界</text><text for="L26">我们走遍世界各地 脚步却仍未停歇</text><text for="L27">转眼我们就要三十岁</text><text for="L28">我仍在学着理解人生 爱人也为我们带来了孩子</text><text for="L29">我可以把歌唱给他们听 把故事慢慢讲给他们听</text><text for="L30">大多数老友仍在身旁 也有人还在追逐荣光</text><text for="L31">有些兄弟却被我留在身后 至今想来仍觉亏欠</text><text for="L32">转眼我也将年满六十 父亲却永远停在六十一岁</text><text for="L33">记住走过的路 往后的日子才会更好</text><text for="L34">我曾写过一封信 让一个人欣喜不已</text><text for="L35">只盼孩子们每月能来看我一两回</text><text for="L36">待我到了六十岁 会不会觉得世间冷清</text><text for="L37">还是会有许多孩子相伴 暖着我的心</text><text for="L38">终有一天我会六十岁</text><text for="L39">待我到了六十岁 会不会觉得世间冷清</text><text for="L40">还是会有许多孩子相伴 暖着我的心</text><text for="L41">终有一天我会六十岁</text><text for="L42">那年我七岁 妈妈对我说</text><text for="L43">去交些朋友吧 不然会孤单</text><text for="L44">那年我七岁</text><text for="L45">那年我七岁</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="7 Years"/><amll:meta key="artists" value="Lukas Graham"/><amll:meta key="album" value="Lukas Graham"/><amll:meta key="qqMusicId" value="000IvjwO1NYczE"/><amll:meta key="appleMusicId" value="1081573445"/></metadata></head><body><div begin="0:20.310" end="0:30.972" itunes:songPart="Chorus"><p begin="0:20.310" end="0:24.733" itunes:key="L1" ttm:agent="v1"><span begin="0:20.310" end="0:20.910">Once,</span> <span begin="0:20.910" end="0:21.099">I</span> <span begin="0:21.099" end="0:21.318">was</span> <span begin="0:21.318" end="0:21.830">seven</span> <span begin="0:21.830" end="0:22.416">years</span> <span begin="0:22.416" end="0:22.815">old,</span> <span begin="0:22.815" end="0:23.179">my</span> <span begin="0:23.345" end="0:23.895">mama</span> <span begin="0:23.895" end="0:24.295">told</span> <span begin="0:24.295" end="0:24.733">me</span></p><p begin="0:24.818" end="0:28.329" itunes:key="L2" ttm:agent="v1"><span begin="0:24.818" end="0:25.201">"Go</span> <span begin="0:25.276" end="0:25.583">make</span> <span begin="0:25.583" end="0:26.065">yourself</span> <span begin="0:26.065" end="0:26.297">some</span> <span begin="0:26.297" end="0:26.615">friends,</span> <span begin="0:26.615" end="0:26.799">or</span> <span begin="0:26.799" end="0:27.097">you'll</span> <span begin="0:27.097" end="0:27.348">be</span> <span begin="0:27.348" end="0:28.329">lonely"</span></p><p begin="0:28.331" end="0:30.972" itunes:key="L3" ttm:agent="v1"><span begin="0:28.331" end="0:28.848">Once,</span> <span begin="0:28.848" end="0:29.115">I</span> <span begin="0:29.115" end="0:29.331">was</span> <span begin="0:29.331" end="0:29.950">seven</span> <span begin="0:29.950" end="0:30.448">years</span> <span begin="0:30.448" end="0:30.972">old</span></p></div><div begin="0:36.598" end="0:52.377" itunes:songPart="Verse"><p begin="0:36.598" end="0:40.524" itunes:key="L4" ttm:agent="v1"><span begin="0:36.598" end="0:36.859">It</span> <span begin="0:36.859" end="0:37.129">was</span> <span begin="0:37.129" end="0:37.363">a</span> <span begin="0:37.363" end="0:37.761">big,</span> <span begin="0:37.761" end="0:38.129">big</span> <span begin="0:38.129" end="0:38.627">world,</span> <span begin="0:38.627" end="0:38.945">but</span> <span begin="0:38.945" end="0:39.262">we</span> <span begin="0:39.262" end="0:39.510">thought</span> <span begin="0:39.510" end="0:39.745">we</span> <span begin="0:39.745" end="0:39.961">were</span> <span begin="0:39.961" end="0:40.524">bigger</span></p><p begin="0:40.843" end="0:44.592" itunes:key="L5" ttm:agent="v1"><span begin="0:40.843" end="0:41.147">Pushing</span> <span begin="0:41.147" end="0:41.342">each</span> <span begin="0:41.342" end="0:41.843">other</span> <span begin="0:41.843" end="0:42.075">to</span> <span begin="0:42.075" end="0:42.358">the</span> <span begin="0:42.358" end="0:42.843">limits,</span> <span begin="0:42.843" end="0:43.059">we</span> <span begin="0:43.059" end="0:43.310">were</span> <span begin="0:43.310" end="0:43.910">learning</span> <span begin="0:43.910" end="0:44.592">quicker</span></p><p begin="0:44.789" end="0:48.547" itunes:key="L6" ttm:agent="v1"><span begin="0:44.789" end="0:45.157">By</span> <span begin="0:45.157" end="0:45.802">eleven,</span> <span begin="0:45.802" end="0:46.336">smoking</span> <span begin="0:46.336" end="0:46.586">herb</span> <span begin="0:46.586" end="0:46.837">and</span> <span begin="0:46.837" end="0:47.336">drinking</span> <span begin="0:47.336" end="0:47.920">burning</span> <span begin="0:47.920" end="0:48.547">liquor</span></p><p begin="0:48.829" end="0:52.377" itunes:key="L7" ttm:agent="v1"><span begin="0:48.829" end="0:49.274">Never</span> <span begin="0:49.274" end="0:49.581">rich,</span> <span begin="0:49.581" end="0:49.781">so</span> <span begin="0:49.781" end="0:50.080">we</span> <span begin="0:50.080" end="0:50.280">were</span> <span begin="0:50.280" end="0:50.565">out</span> <span begin="0:50.565" end="0:50.781">to</span> <span begin="0:50.781" end="0:51.114">make</span> <span begin="0:51.114" end="0:51.314">that</span> <span begin="0:51.314" end="0:51.925">steady</span> <span begin="0:51.925" end="0:52.377">figure</span></p></div><div begin="0:52.398" end="1:02.783" itunes:songPart="Chorus"><p begin="0:52.398" end="0:56.772" itunes:key="L8" ttm:agent="v1"><span begin="0:52.398" end="0:52.742">Once,</span> <span begin="0:52.742" end="0:52.953">I</span> <span begin="0:52.953" end="0:53.204">was</span> <span begin="0:53.204" end="0:53.953">eleven</span> <span begin="0:53.953" end="0:54.388">years</span> <span begin="0:54.388" end="0:54.870">old,</span> <span begin="0:54.870" end="0:55.178">my</span> <span begin="0:55.321" end="0:55.854">daddy</span> <span begin="0:55.854" end="0:56.220">told</span> <span begin="0:56.220" end="0:56.772">me</span></p><p begin="0:56.841" end="1:00.243" itunes:key="L9" ttm:agent="v1"><span begin="0:56.841" end="0:57.244">"Go</span> <span begin="0:57.324" end="0:57.695">get</span> <span begin="0:57.695" end="0:58.228">yourself</span> <span begin="0:58.228" end="0:58.412">a</span> <span begin="0:58.412" end="0:58.663">wife</span> <span begin="0:58.663" end="0:58.847">or</span> <span begin="0:58.847" end="0:59.113">you'll</span> <span begin="0:59.113" end="0:59.313">be</span> <span begin="0:59.313" end="1:00.243">lonely"</span></p><p begin="1:00.355" end="1:02.783" itunes:key="L10" ttm:agent="v1"><span begin="1:00.355" end="1:00.744">Once,</span> <span begin="1:00.744" end="1:00.923">I</span> <span begin="1:00.923" end="1:01.208">was</span> <span begin="1:01.208" end="1:01.934">eleven</span> <span begin="1:01.934" end="1:02.419">years</span> <span begin="1:02.419" end="1:02.783">old</span></p></div><div begin="1:08.625" end="1:24.327" itunes:songPart="Verse"><p begin="1:08.625" end="1:12.425" itunes:key="L11" ttm:agent="v1"><span begin="1:08.625" end="1:08.851">I</span> <span begin="1:08.851" end="1:09.334">always</span> <span begin="1:09.334" end="1:09.718">had</span> <span begin="1:09.718" end="1:10.134">that</span> <span begin="1:10.134" end="1:10.620">dream</span> <span begin="1:10.620" end="1:10.928">like</span> <span begin="1:11.036" end="1:11.220">my</span> <span begin="1:11.220" end="1:11.636">daddy</span> <span begin="1:11.636" end="1:12.001">before</span> <span begin="1:12.001" end="1:12.425">me</span></p><p begin="1:12.611" end="1:16.544" itunes:key="L12" ttm:agent="v1"><span begin="1:12.611" end="1:12.943">So</span> <span begin="1:13.162" end="1:13.312">I</span> <span begin="1:13.312" end="1:13.814">started</span> <span begin="1:13.814" end="1:14.248">writing</span> <span begin="1:14.248" end="1:14.547">songs,</span> <span begin="1:14.547" end="1:14.798">I</span> <span begin="1:14.798" end="1:15.326">started</span> <span begin="1:15.326" end="1:15.803">writing</span> <span begin="1:15.803" end="1:16.544">stories</span></p><p begin="1:16.629" end="1:20.439" itunes:key="L13" ttm:agent="v1"><span begin="1:16.629" end="1:17.168">Something</span> <span begin="1:17.168" end="1:17.645">about</span> <span begin="1:17.645" end="1:17.880">that</span> <span begin="1:17.880" end="1:18.523">glory</span> <span begin="1:18.691" end="1:18.933">just</span> <span begin="1:18.933" end="1:19.365">always</span> <span begin="1:19.365" end="1:19.683">seemed</span> <span begin="1:19.683" end="1:19.867">to</span> <span begin="1:19.867" end="1:20.133">bore</span> <span begin="1:20.133" end="1:20.439">me</span></p><p begin="1:20.618" end="1:24.327" itunes:key="L14" ttm:agent="v1"><span begin="1:20.618" end="1:20.879">'Cause</span> <span begin="1:20.879" end="1:21.258">only</span> <span begin="1:21.258" end="1:21.559">those</span> <span begin="1:21.559" end="1:21.810">I</span> <span begin="1:21.810" end="1:22.293">really</span> <span begin="1:22.293" end="1:22.575">love</span> <span begin="1:22.575" end="1:22.842">will</span> <span begin="1:22.842" end="1:23.386">ever</span> <span begin="1:23.386" end="1:23.801">really</span> <span begin="1:23.801" end="1:24.059">know</span> <span begin="1:24.059" end="1:24.327">me</span></p></div><div begin="1:24.380" end="1:34.992" itunes:songPart="Chorus"><p begin="1:24.380" end="1:28.896" itunes:key="L15" ttm:agent="v1"><span begin="1:24.380" end="1:24.900">Once,</span> <span begin="1:24.900" end="1:25.122">I</span> <span begin="1:25.122" end="1:25.372">was</span> <span begin="1:25.372" end="1:25.940">twenty</span> <span begin="1:25.940" end="1:26.439">years</span> <span begin="1:26.439" end="1:26.906">old,</span> <span begin="1:26.906" end="1:27.258">my</span> <span begin="1:27.320" end="1:27.973">story</span> <span begin="1:27.973" end="1:28.373">got</span> <span begin="1:28.373" end="1:28.896">told</span></p><p begin="1:29.108" end="1:32.295" itunes:key="L16" ttm:agent="v1"><span begin="1:29.108" end="1:29.649">Before</span> <span begin="1:29.649" end="1:29.820">the</span> <span begin="1:29.820" end="1:30.284">morning</span> <span begin="1:30.284" end="1:30.583">sun,</span> <span begin="1:30.583" end="1:30.785">when</span> <span begin="1:30.785" end="1:31.100">life</span> <span begin="1:31.100" end="1:31.316">was</span> <span begin="1:31.316" end="1:32.295">lonely</span></p><p begin="1:32.334" end="1:34.992" itunes:key="L17" ttm:agent="v1"><span begin="1:32.334" end="1:32.866">Once,</span> <span begin="1:32.866" end="1:33.132">I</span> <span begin="1:33.132" end="1:33.348">was</span> <span begin="1:33.348" end="1:33.932">twenty</span> <span begin="1:33.932" end="1:34.434">years</span> <span be