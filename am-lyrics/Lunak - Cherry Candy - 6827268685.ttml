<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Cherry Candy"/><amll:meta key="artists" value="Lunak"/><amll:meta key="album" value="Cherry Candy - Single"/><amll:meta key="isrc" value="QNSM12607447"/><amll:meta key="appleMusicId" value="6827268685"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lunak</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">乐声美得连恶魔也会落泪</text><text for="L2">惹得我一阵眩晕</text><text for="L3">双唇甜似樱桃糖</text><text for="L4">每一个吻都让我沉迷</text><text for="L5">还有你那懂我的模样</text><text for="L6">你如甜意骤然涌上心头</text><text for="L7">酥麻的感觉仿佛触电</text><text for="L8">这小小的心动冒着气泡</text><text for="L9">引我迷失在诱惑之间</text><text for="L10">甜蜜盈满心间 仿佛终于有了名分</text><text for="L11">在蒙着雾气的窗上</text><text for="L12">我描画着你我名字的首字母</text><text for="L13">沉醉于每一次亲吻</text><text for="L14">还有你对我的那份懂得</text><text for="L15">让我晕晕乎乎</text><text for="L16">双唇甜似樱桃糖</text><text for="L17">唇上尽是樱桃糖的甜</text><text for="L18">尝过爱的滋味 任谁也无法取代</text><text for="L19">若有一天它褪去</text><text for="L20">我不知道该如何面对</text><text for="L21">从不曾停下来看一眼标签上的警告</text><text for="L22">再浅尝一口你的滋味 我的心便乱了节拍</text><text for="L23">乐声如此动人 连恶魔也会落泪</text><text for="L24">甜意盈满心间 仿佛终于有了名分</text><text for="L25">在雾气氤氲的窗上</text><text for="L26">我描画着你我名字的首字母</text><text for="L27">每一次亲吻都让我着迷</text><text for="L28">还有你那懂我的模样</text><text for="L29">惹得我一阵眩晕</text><text for="L30">双唇甜似樱桃糖</text><text for="L31">唇上尽是樱桃糖的甜</text><text for="L32">双唇甜似樱桃糖</text></translation><