<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="zh-Hans" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="isahini"/><amll:meta key="artists" value="LÜCY"/><amll:meta key="album" value="LÜCY"/><amll:meta key="isrc" value="TWAE32201733"/><amll:meta key="appleMusicId" value="1628728907"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">现在可以笑吗</text><text for="L2">好啊</text><text for="L3">是啊 我正赶来 嘴里不停哼着歌</text><text for="L4">面朝荒野 把我的船装满</text><text for="L5">不曾忘记如何活得快乐</text><text for="L6">双手渐冷 脑海却满载思绪</text><text for="L7">有那么多事要做</text><text for="L8">有那么多风景要看</text><text for="L9">所以来一场公路旅行又何妨</text><text for="L10">不出发就永远不会知道</text><text for="L11">欸想家了没</text><text for="L12">门口的树有没有枯萎</text><text for="L13">要回来了没</text><text for="L14">山里的路不会有抢匪</text><text for="L15">向着那个叫家的地方走去</text><text for="L16">朝着那个叫家的地方走去</text><text for="L17">我正走向那个叫家的地方</text><text for="L18">回家</text><text for="L19">坐在门口前喝外婆做的小米酒</text><text for="L20">她酿得够久了</text><text for="L21">到底那么辛苦 你有没有开心啦</text><text for="L22">此刻</text><text for="L23">孩子</text><text for="L24">请听山脉传来的话语</text><text for="L25">当太阳西下</text><text for="L26">此刻</text><text for="L27">孩子</text><text for="L28">面对生命节奏里的</text><text for="L29">每一次停顿</text><text for="L30">是啊 我正赶来 嘴里不停哼着歌</text><text for="L31">面朝荒野 把我的船装满</text><text for="L32">不曾忘记如何活得快乐</text><text for="L33">双手渐冷 脑海却满载思绪</text><text for="L34">还有那么多事要做</text><text for="L35">还有那么多风景要看</text><text for="L36">所以来一场公路旅行又何妨</text><text for="L37">不出发就永远不会知道</text><text for="L38">火不能让她熄灭</text><text for="L39">这个夜晚才不会结束</text><text for="L40">跟着音乐找回家的路</text><text for="L41">火不能让他熄灭</text><text for="L42">这个夜晚没有人想睡</text><text for="L43">时间 宝贵</text><text for="L44">向着那个叫家的地方走去</text><text for="L45">朝着那个叫家的地方走去</text><text for="L46">我正走向那个叫家的地方</text><text for="L47">回家</text><text for="L48">坐在门口前喝外婆做的小米酒</text><text for="L49">她酿得够久了</text><text for="L50">到底那么辛苦 你有没有开心啦</text><text for="L51">此刻</text><text for="L52">孩子</text><text for="L53">请听山脉传来的话语</text><text for="L54">当太阳西下</text><text for="L55">此刻</text><text for="L56">孩子</text><text for="L57">面对生命节奏里的</text><text for="L58">每一次停顿</text></translation></translations><songwriters><songwriter>LÜCY</songwriter><songwriter>Déjà Fu</songwriter></songwriters><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="zh-Latn-pinyin" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.310" end="0:00.500">xian </span><span begin="0:00.500" end="0:00.740">zai ke yi </span><span begin="0:00.740" end="0:01.130">xiao </span><span begin="0:01.130" end="0:01.450">ma</span></text><text for="L2"><span begin="0:01.740" end="0:02.155">hao a</span></text><text for="L3"><span begin="0:12.899" end="0:13.209">But</span> <span begin="0:13.209" end="0:13.669">yes</span> <span begin="0:13.669" end="0:13.879">I'm</span> <span begin="0:13.879" end="0:14.199">com</span><span begin="0:14.199" end="0:14.339">ing</span> <span begin="0:14.339" end="0:14.489">and</span> <span begin="0:14.489" end="0:14.629">I</span> <span begin="0:14.629" end="0:14.869">don't</span> <span begin="0:14.869" end="0:15.249">stop</span> <span begin="0:15.249" end="0:15.549">humm</span><span begin="0:15.549" end="0:15.829">ing</span></text><text for="L4"><span begin="0:15.829" end="0:16.309">Face</span> <span begin="0:16.309" end="0:16.469">to</span> <span begin="0:16.469" end="0:16.649">the</span> <span begin="0:16.649" end="0:17.039">wild</span> <span