<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2000"/><amll:meta key="musicName" value="Abu Dhabi"/><amll:meta key="artists" value="MIKOLAS"/><amll:meta key="album" value="Abu Dhabi - Single"/><amll:meta key="isrc" value="DEA811900067"/><amll:meta key="appleMusicId" value="1449581370"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>MIKOLAS</songwriter><songwriter>Jenson Vaughan</songwriter><songwriter>Sarah Raba</songwriter><songwriter>Christophe Vitorino De Almeida</songwriter><songwriter>Walid Benmerieme</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">Woo</text><text for="L2">我是 Miki</text><text for="L3">喔 她这般迷人教我失了分寸</text><text for="L4">总贪恋依偎在你身畔 怎么亲近都不够</text><text for="L5">喔 告诉我你此刻想做些什么</text><text for="L6">你令我浑身炽热 凌空胜过云端热气球</text><text for="L7">此刻我们就能这般 尽情随心</text><text for="L8">她也能这般摇曳 旋出风情</text><text for="L9">与我共赴这一局 浪漫轮盘</text><text for="L10">现在就让我们这般 默契相随</text><text for="L11">共谱一曲二重奏 声声相和</text><text for="L12">你我便主宰全场 尽显锋芒</text><text for="L13">君王与王后</text><text for="L14">你若心仪这般 我便如你所愿</text><text for="L15">弹指之间 便能轻松成真</text><text for="L16">你若偏爱如此 我早已尽数备妥</text><text for="L17">只消一个响指 万事皆可成全</text><text for="L18">说走就走 你想去向何方 我皆带你前往</text><text for="L19">挑一处异域风情 宝贝 今夜我们便能抵达</text><text for="L20">阿布扎比</text><text for="L21">整片世界 尽握你我掌心</text><text for="L22">转动地球仪 任它飞旋 看指尖最终停落何地</text><text for="L23">敞篷座驾中 我们细数点点星光</text><text for="L24">夜幕降临前 车顶上还不是真正的繁星</text><text for="L25">此刻我们就能这般 肆意遨游</text><text for="L26">看她舞步曼妙 旋动流光</text><text for="L27">来和我共转轮盘 赌一程欢愉</text><text for="L28">现在就让我们如此 乘兴相随</text><text for="L29">共唱一曲二重唱 默契相投</text><text for="L30">你我便能掌控全场 尽兴而行</text><text for="L31">天生王与后</text><text for="L32">你要这般浪漫 我便如数呈上</text><text for="L33">指尖轻弹 一切即刻成真</text><text for="L34">只要你心有所愿 我便尽能做到</text><text for="L35">弹指一挥 万般精彩尽现</text><text for="L36">随时都能启程 你心仪何处 我便带你前往</text><text for="L37">选一处异域胜地 宝贝 今晚我们如约抵达</text><text for="L38">阿布扎比</text><text for="L39">来吧 与我并肩驰骋</text><text for="L40">随我凌风飞翔</text><text for="L41">若你心许 便与我彻夜相依</text><text for="L42">与我同乘纵行</text><text for="L43">与我同频共振</text><text for="L44">若你情愿 便随我彻夜轻舞</text><text for="L45">来吧 与我并驾齐驱</text><text for="L46">陪我展翼高飞</text><text for="L47">若你愿意 便与我长夜相偎</text><text for="L48">快来 与我同行此程</text><text for="L49">伴我御风翱翔</text><text for="L50">宝贝 只要你心之所向</text><text for="L51">你既向往如此 我便倾力相赴</text><text for="L52">轻轻一弹响指 瞬间便可达成</text><text for="L53">你所盼的模样 我皆为你实现</text><text for="L54">弹指一响 一切皆可成全</text><text for="L55">天涯咫尺 你欲往何方 我皆伴你同行</text><text for="L56">择一处异域胜境 宝贝 今夜我们便将抵达</text><text for="L57">阿布扎比</text><text for="L58">阿布扎比</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:26.628"><div begin="0:05.631" end="2:26.628"><p begin="0:05.631" end="0:06.182" itunes:key="L1" ttm:agent="v1"><span begin="0:05.631" end="0:06.182">Woo</span></p><p begin="0:08.361" end="0:08.851" itunes:key="L2" ttm:agent="v1"><span begin="0:08.361" end="0:08.501">It's</span> <span begin="0:08.501" end="0:08.851">Miki</span></p><p begin="0:09.346" end="0:11.242" itunes:key="L3" ttm:agent="v1"><span begin="0:09.346" end="0:09.892">Ooh,</span> <span begin="0:09.932" end="0:10.212">mama</span> <span begin="0:10.212" end="0:10.392">got</span> <span begin="0:10.392" end="0:10.552">me</span> <span begin="0:10.552" end="0:10.762">act</span> <span begin="0:10.762" end="0:10.922">a</span> <span begin="0:10.922" end="0:11.242">fool</span></p><p begin="0:11.242" end="0:13.436" itunes:key="L4" ttm:agent="v1"><spa