8.276">き</span><span begin="0:58.276" end="0:58.606">た</span><span begin="0:58.606" end="0:59.036">け</span><span begin="0:59.036" end="1:00.806">ど</span></p><p begin="1:01.482" end="1:06.622" itunes:key="L7" ttm:agent="v1"><span begin="1:01.482" end="1:01.872">君</span><span begin="1:01.872" end="1:02.012">が</span><span begin="1:02.012" end="1:02.452">く</span><span begin="1:02.452" end="1:02.592">れ</span><span begin="1:02.592" end="1:03.302">た</span> <span begin="1:03.602" end="1:03.852">まっ</span><span begin="1:03.852" end="1:04.152">す</span><span begin="1:04.152" end="1:04.282">ぐ</span><span begin="1:04.282" end="1:04.752">な</span><span begin="1:04.752" end="1:05.502">思</span><span begin="1:05.502" end="1:05.622">い</span><span begin="1:05.622" end="1:06.622">が</span></p><p begin="1:07.002" end="1:12.712" itunes:key="L8" ttm:agent="v1"><span begin="1:07.002" end="1:07.132">向</span><span begin="1:07.132" end="1:07.412">き</span><span begin="1:07.412" end="1:07.742">合っ</span><span begin="1:07.742" end="1:07.892">て</span><span begin="1:07.892" end="1:08.232">く</span><span begin="1:08.502" end="1:09.242">勇</span><span begin="1:09.242" end="1:09.522">気</span><span begin="1:09.522" end="1:10.002">を</span><span begin="1:10.002" end="1:10.412">く</span><span begin="1:10.412" end="1:10.922">れ</span><span begin="1:10.922" end="1:11.562">たん</span><span begin="1:11.562" end="1:12.712">だ</span></p><p begin="1:13.012" end="1:17.222" itunes:key="L9" ttm:agent="v1"><span begin="1:13.012" end="1:13.462">MY</span> <span begin="1:13.462" end="1:14.252">Boo</span> <span begin="1:14.582" end="1:14.742">ど</span><span begin="1:14.742" end="1:15.022">こ</span><span begin="1:15.022" end="1:15.162">へ</span><span begin="1:15.162" end="1:15.362">も</span><span begin="1:15.362" end="1:15.482">行</span><span begin="1:15.482" end="1:15.662">か</span><span begin="1:15.662" end="1:15.922">な</span><span begin="1:15.922" end="1:16.082">い</span><span begin="1:16.082" end="1:17.222">で</span></p><p begin="1:17.606" end="1:20.306" itunes:key="L10" ttm:agent="v1"><span begin="1:17.606" end="1:17.986">誰</span><span begin="1:17.986" end="1:18.186">に</span><span begin="1:18.186" end="1:18.346">も</span><span begin="1:18.346" end="1:18.576">触</span><span begin="1:18.576" end="1:18.716">れ</span><span begin="1:18.716" end="1:19.106">ない</span><span begin="1:19.106" end="1:20.306">で</span></p><p begin="1:20.529" end="1:25.059" itunes:key="L11" ttm:agent="v1"><span begin="1:20.529" end="1:21.049">私</span><span begin="1:21.049" end="1:21.289">が</span><span begin="1:21.289" end="1:21.429">い</span><span begin="1:21.429" end="1:21.549">る</span><span begin="1:21.549" end="1:21.799">か</span><span begin="1:21.799" end="1:23.079">ら</span> <span begin="1:23.669" end="1:24.289">隣</span><span begin="1:24.289" end="1:24.449">い</span><span begin="1:24.449" end="1:24.579">る</span><span begin="1:24.579" end="1:24.809">か</span><span begin="1:24.809" end="1:25.059">ら</span></p><p begin="1:25.051" end="1:27.771" itunes:key="L12" ttm:agent="v1"><span begin="1:25.051" end="1:25.581">ねぇ</span> <span begin="1:25.581" end="1:25.981">Boo</span> <span begin="1:26.371" end="1:26.691">I'm</span> <span begin="1:26.691" end="1:27.021">so</span> <span begin="1:27.021" end="1:27.411">ha</span><span begin="1:27.411" end="1:27.771">ppy</span></p><p begin="1:28.049" end="1:30.909" itunes:key="L13" ttm:agent="v1"><span begin="1:28.049" end="1:28.439">君</span><span begin="1:28.439" end="1:28.579">の</span><span begin="1:28.579" end="1:28.839">た</span><span begin="1:28.839" end="1:29.019">め</span><span begin="1:29.019" end="1:29.209">な</span><span begin="1:29.209" end="1:29.399">ら</span> <span begin="1:29.399" end="1:29.549">I</span> <span begin="1:29.549" end="1:29.769">can</span> <span begin="1:29.769" end="1:29.959">be</span> <span begin="1:29.959" end="1:30.119">your</span> <span begin="1:30.119" end="1:30.609">Jas</span><span begin="1:30.609" end="1:30.909">mine</span></p><p begin="1:31.104" end="1:35.504" itunes:key="L14" ttm:agent="v1"><span begin="1:31.104" end="1:31.284">照</span><span begin="1:31.284" end="1:31.424">れ</span><span begin="1:31.424" end="1:31.604">く</span><span begin="1:31.604" end="1:31.864">さ</span><span begin="1:31.864" end="1:31.994">く</span><span begin="1:31.994" end="1:32.394">て</span> <span begin="1:32.654" end="1:32.964">いつ</span><span begin="1:32.964" end="1:33.204">も</span><span begin="1:33.204" end="1:33.374">言</span><span begin="1:33.374" end="1:33.504">え</span><span begin="1:33.504" end="1:33.754">な</span><span begin="1:33.754" end="1:33.894">い</span><span begin="1:33.894" end="1:34.324">け</span><span begin="1:34.324" end="1:34.614">ど</span><span begin="1:34.614" end="1:35.504">さ</span></p><p begin="1:35.960" end="1:39.330" itunes:key="L15" ttm:agent="v1"><span begin="1:35.960" end="1:36.590">愛</span><span begin="1:36.590" end="1:37.020">し</span><span begin="1:37.020" end="1:37.450">て</span><span begin="1:37.450" end="1:39.330">る</span></p><p begin="1:50.091" end="1:52.571" itunes:key="L16" ttm:agent="v1"><span begin="1:50.091" end="1:50.221">「バ</span><span begin="1:50.221" end="1:50.441">ス</span><span begin="1:50.441" end="1:50.841">一</span><span begin="1:50.841" end="1:50.981">つ</span><span begin="1:50.981" end="1:51.271">見</span><span begin="1:51.271" end="1:51.801">送</span><span begin="1:51.801" end="1:52.141">ろう</span><span begin="1:52.141" end="1:52.571">よ」</span></p><p begin="1:53.106" end="1:55.616" itunes:key="L17" ttm:agent="v1"><span begin="1:53.106" end="1:53.486">遠</span><span begin="1:53.486" end="1:53.896">回</span><span begin="1:53.896" end="1:54.096">りし</span><span begin="1:54.096" end="1:54.216">て</span><span begin="1:54.216" end="1:54.986">帰っ</span><span begin="1:54.986" end="1:55.156">て</span><span begin="1:55.156" end="1:55.616">も</span></p><p begin="1:56.149" end="1:59.379" itunes:key="L18" ttm:agent="v1"><span begin="1:56.149" end="1:56.259">ポ</span><span begin="1:56.259" end="1:56.629">ケッ</span><span begin="1:56.629" end="