<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Ex Nihilo"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="artists" value="MIREI"/><amll:meta key="artists" value="當山 みれい"/><amll:meta key="artists" value="当山真玲"/><amll:meta key="artists" value="當山みれい"/><amll:meta key="artists" value="当山美玲"/><amll:meta key="album" value="Honkai: Star Rail - Let There Be Laughter (Part 3) [Original Game Soundtrack]"/><amll:meta key="album" value="崩坏:星穹铁道 - 神说要有笑(下篇) (游戏《崩坏:星穹铁道》原声音乐)"/><amll:meta key="album" value="崩壞:星穹鐵道 - 神說要有笑(下篇) (遊戲《崩壞:星穹鐵道》原聲音樂)"/><amll:meta key="album" value="崩壊:スターレイル - 神は言った「笑いあれ」と(下) (Original Game Soundtrack)"/><amll:meta key="album" value="붕괴: 스타레일 - 신이 이르시되, 웃음이 있으라(하편) [Original Game Soundtrack]"/><amll:meta key="isrc" value="DGA052668715"/><amll:meta key="isrc" value="DGA052668811"/><amll:meta key="isrc" value="DGA052668763"/><amll:meta key="isrc" value="DGA052669419"/><amll:meta key="isrc" value="DGA052668667"/><amll:meta key="appleMusicId" value="6832523356"/><amll:meta key="appleMusicId" value="6832518117"/><amll:meta key="appleMusicId" value="6832522242"/><amll:meta key="appleMusicId" value="6832522628"/><amll:meta key="appleMusicId" value="6832522502"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">我在火光中醒来</text><text for="L2">寂静的世界正需要多一点光亮</text><text for="L3">我伸手采撷一簇绚色</text><text for="L4">将阴影一一涂抹 直到黑暗化作纯白</text><text for="L5">烘焙一场甜美幻梦</text><text for="L6">洒落漫天糖霜 让沉重的世界改换模样</text><text for="L7">我们尽情活在此刻</text><text for="L8">仿佛明天永远永远不会到来</text><text for="L9">Ba ee ya ee ba ba ee ya ee</text><text for="L10">Ba ee ya ee yeah~</text><text for="L11">Ba ee ya ee ba ba ee ya ee</text><text for="L12">Ba ee ya~</text><text for="L13">是时候点亮这一切！</text><text for="L14">哪怕今夜整个世界坍塌 我们也不在乎</text><text for="L15">只愿在天穹之外尽情忘我</text><text for="L16">让乐声更响 迎接奇迹降临</text><text for="L17">我们将永远活下去 这片银河如此璀璨</text><text for="L18">Oh~oh~</text><text for="L19">Oh~yeah~yeah</text><text for="L20">我们向暮色施下咒语</text><text for="L21">拉开天鹅绒的帷幕 唤起一段段传奇</text><text for="L22">我们沉醉在欢愉之中</text><text for="L23">仿佛明天永远永远不会到来</text><text for="L24">Ba ee ya ee ba ba ee ya ee</text><text for="L25">Ba ee ya ee yeah~</text><text for="L26">Ba ee ya ee ba ba ee ya ee</text><text for="L27">Ba ee ya~</text><text for="L28">是时候点亮这一切！</text><text for="L29">举手投足间 奇妙化作流光</text><text for="L30">牵起我的手 赋予木偶生命</text><text for="L31">让群星在夜空中碰撞迸碎</text><text for="L32">愿所有欢愉长存 永不消逝</text><text for="L33">Oh~oh~</text><text for="L34">欢愉永不落幕</text><text for="L35">哪怕今夜整个世界坍塌 我们也不在乎</text><text for="L36">只愿在天穹之外尽情忘我</text><text for="L37">让乐声更响 迎接奇迹降临</text><text for="L38">我们将永远活下去 这片银河如此璀璨</text><text for="L39">举手投足间 奇妙化作流光</text><text for="L40">牵起我的手 赋予木偶生命</text><text for="L41">让群星在夜空中碰撞迸碎</text><text for="L42">愿所有欢愉长存 永不消逝</text></translation></translations><songwriters><songwriter>温菁</songwriter><songwriter>Ruby Qu</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:16.052"><div begin="0:23.214" end="3:16.052"><p begin="0:23.214" end="0:25.154" itunes:key="L1" ttm:agent="v1"><span begin="0:23.214" end="0:23.404">I</span> <span begin="0:23.404" end="0:23.644">woke</span> <span begin="0:23.644" end="0:23.784">up</span> <span begin="0:23.784" end="0:24.264">to</span> <span begin="0:24.264" end="0:24.394">the</span> <span begin="0:24.394" end="0:24.908">fi</span><span begin="0:24.908" end="0:25.154">re</span></p><p begin="0:25.154" end="0:30.076" itunes:key="L2" ttm:agent="v1"><span begin="0:25.154" end="0:25.304">A</span> <span begin="0:25.304" 