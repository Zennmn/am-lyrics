<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Goodbye My Love"/><amll:meta key="artists" value="MIREI"/><amll:meta key="appleMusicId" value="1538281341"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">最后相见那天 你写给我的信</text><text for="L2">被我塞进了包包的最深处</text><text for="L3">两人的合照 还留在旧手机里</text><text for="L4">熟悉的景色 流逝着 渐渐远去</text><text for="L5">为了追寻 那渺茫未定的梦想</text><text for="L6">把所有的一切 全都舍弃</text><text for="L7">像个傻瓜一样的我</text><text for="L8">求你无论如何 都要原谅我</text><text for="L9">再见了 我最爱的人</text><text for="L10">直到来日重逢的那天</text><text for="L11">我已经下定决心不再哭泣</text><text for="L12">其实一直都是 我最爱的人</text><text for="L13">先别回头 至少现在</text><text for="L14">再见 我的爱</text><text for="L15">你常常买给我的</text><text for="L16">那甜得过头的奶茶</text><text for="L17">每天都会经过的车站站台</text><text for="L18">如今都已再难触及</text><text for="L19">即便如此也无所谓</text><text for="L20">那些美好的回忆</text><text for="L21">我会好好收起 好好珍藏在心底</text><text for="L22">就算彼此相隔遥远</text><text for="L23">我也会一直祈愿你幸福</text><text for="L24">相爱的真正意义</text><text for="L25">如今我才终于懂得</text><text for="L26">谢谢你 我最爱的人</text><text for="L27">以往每次与你相见</text><text for="L28">你总是只把笑容留给我</text><text for="L29">独一无二 我最爱的人</text><text for="L30">先别将我遗忘 至少现在</text><text for="L31">再见了 我的爱</text><text for="L32">其实直到现在 只要有你在身边</text><text for="L33">我本就什么都不害怕</text><text for="L34">可要重回那段时光 如今还为时尚早</text><text for="L35">曾经忘却时间 畅谈着的</text><text for="L36">属于彼此那耀眼的未来</text><text for="L37">在真正实现之前 直到那一天的到来</text><text for="L38">就暂且在这一小段时间里</text><text for="L39">说声再见吧 我最爱的人</text><text for="L40">直到有朝一日能够再相见</text><text for="L41">因为我依然决心不再哭泣</text><text for="L42">其实你依旧是 我最爱的人</text><text for="L43">先不要回头 现在还不行</text><text for="L44">再见 我的爱</text><text for="L45">还是要谢谢你 我最爱的人</text><text for="L46">从前每次相聚的时刻</text><text for="L47">你总是只把笑容留给我</text><text for="L48">唯一那个 我最爱的人 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(我绝不会哭泣)</span></text><text for="L49">先别将我遗忘 至少现在</text><text for="L50">再见了 我的爱</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:41.933"><div begin="0:03.555" end="3:41.933"><p begin="0:03.555" end="0:09.595" itunes:key="L1" ttm:agent="v1"><span begin="0:03.555" end="0:03.995">最</span><span begin="0:03.995" end="0:04.195">後</span><span begin="0:04.195" end="0:04.465">に</span><span begin="0:04.465" end="0:04.845">会っ</span><span begin="0:04.845" end="0:05.015">た</span><span begin="0:05.015" end="0:06.185">日</span> <span begin="0:07.085" end="0:07.385">く</span><span begin="0:07.385" end="0:07.525">れ</span><span begin="0:07.525" end="0:07.745">た</span><span begin="0:07.745" end="0:07.965">手</span><span begin="0:07.965" end="0:08.455">紙</span><span begin="0:08.455" end="0:09.595">は</span></p><p begin="0:10.285" end="0:14.725" itunes:key="L2" ttm:agent="v1"><span begin="0:10.285" end="0:10.465">カ</span><span begin="0:10.465" end="0:10.945">バン</span><span begin="0:10.945" end="0:11.165">の</span><span begin="0:11.165" end="0:11.855">奥</span><span begin="0:11.855" end="0:12.395">に</span> <span begin="0:12.885" end="0:12.985">押</span><span begin="0:12.985" end="0:13.205">し</span><span begin="0:13.205" end="0:14.325">込ん</span><span begin="0:14.325" end="0:14.725">だ</span></p><p begin="0:17.068" end="0:23.228" itunes:key="L3" ttm:agent="v1"><span begin="0:17.068" end="0:17.698">二人</span><span begin="0:17.698" end="0:17.858">の</span><span begin="0:17.858" end="0:18.068">写</span><span begin="0:18.068" end="0:18.568">真</span><span begin="0:18.568" end="0:19.518">は</span> <span begin="0:20.368" end="0:20.908">古</span><span begin="0:20.908" end="0:21.038">い</span><span begin="0:21.038" end="0:21.458">携</span><span begin="0:21.458" end="0:21.908">帯</span><span begin="0:21.908" end="0:22.158">の</span><span begin="0:22.158" end="0:23.228">中</span></p><p begin="0:23.783" end="0:29.983" itunes:key="L4" ttm:agent="v1"><span begin="0:23.783" end="0:23.953">見</span><span begin="0:23.953" end="0:24.253">慣</span><span begin="0:24.253" end="0:24.393">れ</span><span begin="0:24.393" end="0:24.613">た</span><span begin="0:24.613" end="0:24.803">景</span><span begin="0:24.803" end="0:25.263">色</span><span begin="0:25.263" end="0:25.913">が</span> <span begin="0:26.363" end="0:26.793">流</span><span begin="0:26.793" end="0:26.923">れ</span><span begin="0:26.923" end="0:27.453">て</span> <span begin="0:28.033" end="0:28.473">流</span><span begin="0:28.473" end="0:28.603">れ</span><span begin="0:28.603" end="0:29.373">て</span><span begin="0:29.373" end="0:29.983">く</span></p><p begin="0:30.983" end="0:34.163" itunes:key="L5" ttm:agent="v1"><span begin="0:30.983" end="0:31.163">不</span><span begin="0:31.163" end="0:31.593">確</span><span begin="0:31.593" end="0:32.073">か</span><span begin="0:32.073" end="0:32.293">な</span> <span begin="0:32.643" end="0:33.153">夢</span><span begin="0:33.153" end="0:33.383">追</span><span begin="0:33.383" end="0:33.533">い</span><span begin="0:33.533" end="0:33.733">か</span><span begin="0:33.733" end="0:33.973">け</span><span begin="0:33.973" end="0:34.163">て</span></p><p begin="0:34.409" end="0:37.549" itunes:key="L6" ttm:agent="v1"><span begin="0:34.409" end="0:34.999">何</span><span begin="0:34.999" end="0:35.429">か</span><span begin="0:35.429" end="0:35.669">も</span> <span begin="0:35.979" end="0:36.519">全</span><span begin="0:36.519" end="0:36.639">部</span><span begin="0:36.639" end="0:36.909">捨</span><span begin="0:36.909" end="0:37.099">て</span><span begin="0:37.099" end="0:37.549">て</span></p><p begin="0:37.803" end="0:40.933" itunes:key="L7" ttm:agent="v1"><span begin="0:37.803" end="0:37.943">バ</span><span begin="0:37.943" end="0:38.193">カ</span><span begin="0:38.193" end="0:38.373">み</span><span begin="0:38.373" end="0:38.753">た</span><span begin="0:38.753" end="0:39.073">いな</span> <span begin="0:39.463" end="0:40.043">私</span><span begin="0:40.043" end="0:40.293">の</span><span begin="0:40.293" end="0:40.493">こ</span><span begin="0:40.493" end="0:40.763">と</span><span begin="0:40.763" end="0:40.933">を</span></p><p begin="0:40.928" end="0:44.218" itunes:key="L8" ttm:agent="v1"><span begin="0:40.928" end="0:41.738">どう</span><span begin="0:41.738" end="0:42.188">か</span><span begin="0:42.188" end="0:42.958">許</span><span begin="0:42.958" end="0:43.378">し</span><span begin="0:43.378" end="0:43.858">て</span><span begin="0:43.858" end="0:44.218">よ</span></p><p begin="0:44.222" end="0:50.772" itunes:key="L9" ttm:agent="v1"><span begin="0:44.222" end="0:44.802">さ</span><span begin="0:44.802" end="0:45.522">よう</span><span begin="0:45.522" end="0:46.832">な</span><span begin="0:46.832" end="0:47.362">ら</span> <span begin="0:47.722" end="0:48.092">大</span><span begin="0:48.092" end="0:48.502">好</span><span begin="0:48.502" end="0:48.892">き</span><span begin="0:48.892" end="0:50.112">な</span><span begin="0:50.112" end="0:50.772">人</span></p><p begin="0:51.137" end="0:54.377" itunes:key="L10" ttm:agent="v1"><span begin="0:51.137" end="0:51.267">い</span><span begin="0:51.267" end="0:51.487">つ</span><span begin="0:51.487" end="0:51.917">か</span><span begin="0:52.167" end="0:52.427">会</span><span begin="0:52.427" end="0:52.577">え</span><span begin="0:52.577" end="0:53.067">る</span><span begin="0:53.527" end="0:53.817">日</span><span begin="0:53.817" end="0:54.037">ま</span><span begin="0:54.037" end="0:54.377">で</span></p><p begin="0:54.380" end="0:57.650" itunes:key="L11" ttm:agent="v1"><span begin="0:54.380" end="0:54.630">泣</span><span begin="0:54.630" end="0:54.830">か</span><span begin="0:54.830" end="0:55.490">ないっ</span><span begin="0:55.490" end="0:55.680">て</span