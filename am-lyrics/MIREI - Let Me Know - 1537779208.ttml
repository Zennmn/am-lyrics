<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">为什么偏偏来和我搭话呢</text><text for="L2">为什么偏偏是我</text><text for="L3">酒杯与谈笑</text><text for="L4">明明身边还有这么多</text><text for="L5">「休息日都怎么过呢」</text><text for="L6">「电影吗 我也很喜欢啊」</text><text for="L7">本该再简单不过的问题</text><text for="L8">我却怎么也找不到答案</text><text for="L9">看着我吧</text><text for="L10">可还别靠过来</text><text for="L11">也不是完全没有期待</text><text for="L12">我还说不清</text><text for="L13">可还是想听你说</text><text for="L14">想听你亲口</text><text for="L15">说一句「可爱」</text><text for="L16">想再多了解你一点</text><text for="L17">却不想让你看见我的心动</text><text for="L18">偏偏只有你的心意我看不清</text><text for="L19">心跳却越来越响</text><text for="L20">亲爱的 告诉我好吗</text><text for="L21">也许我想要的只是</text><text for="L22">你那一句「可爱」</text><text for="L23">你忽然一言不发</text><text for="L24">就坐到了我的身旁</text><text for="L25">害我连唇妆都不敢补</text><text for="L26">连刘海都无暇整理</text><text for="L27">「没有男朋友吗 单身多久了」</text><text for="L28">「你喜欢什么样的人呢」</text><text for="L29">再这样在意你下去</text><text for="L30">可就真的不妙了</text><text for="L31">看着我吧</text><text for="L32">可还别靠过来</text><text for="L33">仿佛整颗心都会被你看穿</text><text for="L34">我还说不清</text><text for="L35">可还是想听你说</text><text for="L36">想听你亲口</text><text for="L37">说一句「可爱」</text><text for="L38">想再多了解你一点</text><text for="L39">却不想让你看见我的心动</text><text for="L40">偏偏只有你的心意我看不清</text><text for="L41">心跳却越来越响</text><text for="L42">亲爱的 把你的心意告诉我吧</text><text for="L43">我真的想听见</text><text for="L44">你说一句「可爱」</text><text for="L45">「差不多该到时间了呢」</text><text for="L46">「之后打算怎么办 要回去了吗」</text><text for="L47">如果此刻就在这里说再见</text><text for="L48">我们是不是就不会再见了</text><text for="L49">看着我吧</text><text for="L50">可还别靠过来</text><text for="L51">这份心意早已抢先一步</text><text for="L52">我已经压不住了</text><text for="L53">其实我早就</text><text for="L54">想不顾一切说出口</text><text for="L55">说我还想再见你</text><text for="L56">我想再多了解你</text><text for="L57">却还是不想让你看见我的心动</text><text for="L58">偏偏只有你的心意我看不清</text><text for="L59">心跳已经越来越响</text><text for="L60">亲爱的 这次就告诉我吧</text><text for="L61">我想亲耳听见</text><text for="L62">你说一句「可爱」</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Let Me Know"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="PLAYLIST - EP"/><amll:meta key="appleMusicId" value="1537779208"/></metadata></head><body><div begin="0:18.288" end="3:30.157"><p begin="0:18.288" end="0:23.342" itunes:key="L1" ttm:agent="v1"><span begin="0:18.288" end="0:19.036">どう</span><span begin="0:19.718" end="0:20.678">して</span> <span begin="0:21.000" end="0:21.540">声</span><span begin="0:21.540" end="0:22.273">かけて</span><span begin="0:22.273" end="0:23.042">くる</span><span begin="0:23.042" end="0:23.342">の？</span></p><p begin="0:24.056" end="0:26.106" itunes:key="L2" ttm:agent="v1"><span begin="0:24.056" end="0:24.184">な</span><span begin="0:24.184" end="0:24.304">ん</span><span begin="0:24.304" end="0:24.556">で</span><span begin="0:24.556" end="0:25.156">私</span><span begin="0:25.297" end="0:25.806">な</span><span begin="0:25.806" end="0:26.106">の</span></p><p begin="0:26.166" end="0:30.005" itunes:key="L3" ttm:agent="v1"><span begin="0:26.166" end="0:26.287">グ</span><span begin="0:26.287" end="0:26.887">ラ</span><span begin="0:27.729" end="0:28.069">ス</span><span begin="0:28.069" end="0:28.669">も</span><span begin="0:28.992" end="0:29.532">会</span><span begin="0:29.532" end="0:29.765">話</span><span begin="0:29.765" end="0:30.005">も</span></p><p begin="0:30.005" end="0:34.018" itunes:key="L4" ttm:agent="v1"><span begin="0:30.005" end="0:30.301">こ</span><span begin="0:30.301" end="0:30.666">ん</span><span begin="0:30.666" end=