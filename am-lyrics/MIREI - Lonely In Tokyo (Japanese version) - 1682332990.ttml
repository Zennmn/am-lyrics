<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">孤身在东京</text><text for="L2">无论身在何处 身边有谁陪伴</text><text for="L3">依然好寂寞</text><text for="L4">孤身在东京</text><text for="L5">无处可归 也无处可去</text><text for="L6">真的好累啊</text><text for="L7">头痛欲裂 全都要怪</text><text for="L8">散落一桌的空罐</text><text for="L9">强撑着精神 剥出药片吞下</text><text for="L10">昨夜的画面不断闪回 总是重蹈同样的覆辙</text><text for="L11">嘟 嘟 嘟 “醒着吗 出来玩吧”</text><text for="L12">明明也没那么熟吧</text><text for="L13">反正闲着无聊 总比一个人待着强</text><text for="L14">索性什么都不去想</text><text for="L15">我们都是东京的孤独灵魂</text><text for="L16">无论身在何处 身边有谁陪伴</text><text for="L17">依然好寂寞</text><text for="L18">孤身在东京</text><text for="L19">无处可归 也无处可去</text><text for="L20">真的好累啊</text><text for="L21">快拍里的“密友动态”</text><text for="L22">明明说今天很忙 没法见面</text><text for="L23">说是男朋友 却满嘴谎话</text><text for="L24">从不守约 唯独那张脸我超喜欢</text><text for="L25">嘟 嘟 嘟 响到你肯接为止</text><text for="L26">一起回家吧</text><text for="L27">所谓的爱 早就寻不见踪影</text><text for="L28">也许从一开始 就根本不曾懂得</text><text for="L29">我们都是东京的孤独灵魂</text><text for="L30">无论身在何处 身边有谁陪伴</text><text for="L31">依然好寂寞</text><text for="L32">孤身在东京</text><text for="L33">无处可归 也无处可去</text><text for="L34">真的好累啊</text><text for="L35">即使与这么多人彼此相连</text><text for="L36">即使消息提示音响个不停</text><text for="L37">人人孑然一身 汇成一群孤独的人</text><text for="L38">既然想要遗忘 那便什么都别去记起</text><text for="L39">我们都是东京的孤独灵魂</text><text for="L40">无论身在何处 身边有谁陪伴</text><text for="L41">依然好寂寞</text><text for="L42">孤身在东京</text><text for="L43">无处可归 也无处可去</text><text for="L44">真的好累啊</text><text for="L45">孤身在东京</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Lonely In Tokyo (Japanese version)"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="Lonely In Tokyo (JPN)"/><amll:meta key="appleMusicId" value="1682332990"/><amll:meta key="isrc" value="JPU902301535"/></metadata></head><body><div begin="0:02.595" end="2:58.525"><p begin="0:02.595" end="0:04.585" itunes:key="L1" ttm:agent="v1"><span begin="0:02.595" end="0:03.145">Lone</span><span begin="0:03.145" end="0:03.625">ly</span> <span begin="0:03.625" end="0:03.805">in</span> <span begin="0:03.805" end="0:04.585">Tokyo</span></p><p begin="0:05.045" end="0:09.265" itunes:key="L2" ttm:agent="v1"><span begin="0:05.045" end="0:05.415">ど</span><span begin="0:05.415" end="0:05.925">こ</span><span begin="0:05.925" end="0:06.265">に</span><span begin="0:06.265" end="0:06.715">いて</span><span begin="0:06.715" end="0:06.915">も</span> <span begin="0:07.335" end="0:08.225">誰</span><span begin="0:08.225" end="0:08.615">と</span><span begin="0:08.615" end="0:09.055">いて</span><span begin="0:09.055" end="0:09.265">も</span></p><p begin="0:10.385" end="0:11.745" itunes:key="L3" ttm:agent="v1"><span begin="0:10.385" end="0:11.265">寂しい</span><span begin="0:11.265" end="0:11.745">の</span></p><p begin="0:12.075" end="0:13.935" itunes:key="L4" ttm:agent="v1"><span begin="0:12.075" end="0:12.555">Lone</span><span begin="0:12.555" end="0:13.015">ly</span> <span begin="0:13.015" end="0:13.205">in</span> <span begin="0:13.205" end="0:13.935">Tokyo</span></p><p begin="0:14.385" end="0:18.795" itunes:key="L5" ttm:agent="v1"><span begin="0:14.385" end="0:15.335">帰</span><span begin="0:15.335" end="0:15.535">る</span><span begin="0:15.535" end="0:16.075">場所</span><span begin="0:16.075" end="0:16.315">も</span> <span begin="0:16.785" end="0:17.125">行</span><span begin="0:17.125" end="0:17.605">き</span><span begin="0:17.605" end="0:18.235">先</span><span begin="0:18.235" end="0:18.445">も</span><span begin="0:18.445" end="0:18.795">ない</span></p><p begin="0:19.255" end="0:20.835" itunes:key="L6" ttm:agent="v1"><span begin="0:19.255" end="0:19.735">疲</span><span begin="0:19.735" end="0:19.935">れ</span><span begin="0:19.935" end="0:20.275">た</span><span begin="0:20.275" end="0:20.835">よ</span></p><p begin="0:20.835" end="0:25.675" itunes:key="L7" ttm:agent="v1"><span begin="0:20.835" end="0:23.135">痛い</span><span begin="0:23.695" end="0:24.645">頭</span><span begin="0:24.645" end="0:24.905">は</span><span begin="0:24.905" end="0:25.675">全部</span></p><p begin="0:25.975" end="0:30.115" itunes:key="L8" ttm:agent="v1"><span begin="0:25.975" end="0:26.295">テー</span><span begin="0:26.295" end="0:26.445">ブ</span><span begin="0:26.445" end="0:26.705">ルに</span><span begin="0:26.705" end="0:27.015">散</span><span begin="0:27.015" end="0:27.265">ら</span><span begin="0:27.265" end="0:28.125">ばった</span> <span begin="0:28.585" end="0:28.815">空</span><span begin="0:28.815" end="0:28.965">き</span><span begin="0:28.965" end="0:29.385">缶</span><span begin="0:29.385" end="0:29.585">の</span><span begin="0:29.585" end="0:30.115">せい</span></p><p begin="0:30.115" end="0:34.878" itunes:key="L9" ttm:agent="v1"><span begin="0:30.115" end="0:30.585">Stay</span> <span begin="0:30.585" end="0:30.955">on</span> <span begin="0:30.955" end="0:32.375">it</span> <span begin="0:32.935" end="0:33.195">押し</span><span begin="0:33.195" end="0:33.385">出</span><span begin="0:33.385" end="0:33.505">し</span><span begin="0:33.505" end="0:33.715">て</span><span begin="0:33.715" end="0:34.035">飲</span><span begin="0:34.035" end="0:34.275">む</span><span begin="0:34.275" end="0:34.878">pills</span></p><p begin="0:35.535" end="0:39.985" itunes:key="L10" ttm:agent="v1"><span begin="0:35.535" end="0:36.095">昨日の</span><span begin="0:36.095" end="0:36.195">フ</span><span begin="0:36.195" end="0:36.375">ラッ</span><span begin="0:36.375" end="0:36.665">シュ</span><span begin="0:36.665" end="0:37.165">バッ</span><span begin="0:37.165" end="0:37.435">ク</span> <span begin="0:37.899" end="0:38.2