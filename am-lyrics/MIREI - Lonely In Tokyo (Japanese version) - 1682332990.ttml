<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="source"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="Lonely In Tokyo (JPN)"/><amll:meta key="isrc" value="JPU902301535"/><amll:meta key="appleMusicId" value="1682332990"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">孤身在东京</text><text for="L2">无论身在何处 身边有谁相伴</text><text for="L3">心底还是好寂寞</text><text for="L4">孤独在东京</text><text for="L5">没有能回的家 也没有想去的地方</text><text for="L6">真的好累啊</text><text for="L7">头痛欲裂 这一切</text><text for="L8">全怪桌上散落的那些空易拉罐</text><text for="L9">硬撑着 挤出药片吞下去<span ttm:role="x-bg">(吞下药片)</span></text><text for="L10">昨夜的记忆不断闪回 总是搞砸得如出一辙<span ttm:role="x-bg">(幕幕闪回)</span></text><text for="L11">Beep beep beep「醒着吗？现在出来玩吧」</text><text for="L12">明明我们也没那么熟吧？<span ttm:role="x-bg">(根本没那么要好)</span></text><text for="L13">反正闲着也是闲着 总比一个人呆着强</text><text for="L14">这样就什么都不用再去想<span ttm:role="x-bg">(我什么都不愿去想)</span></text><text for="L15">我们都孤身在东京<span ttm:role="x-bg">(东京)</span></text><text for="L16">无论置身哪里 身边是谁相伴<span ttm:role="x-bg">(无论在哪)</span></text><text for="L17">依然感到寂寞</text><text for="L18">孤独在这座东京</text><text for="L19">没有归宿 也不知该去向何方<span ttm:role="x-bg">(落脚之处)</span></text><text for="L20">心力交瘁啊</text><text for="L21">限时动态里的「亲密好友」<span ttm:role="x-bg">(那条动态)</span></text><text for="L22">明明说了今天太忙 根本见不了面才对</text><text for="L23">虽说是男朋友 却总是在撒谎<span ttm:role="x-bg">(大骗子)</span></text><text for="L24">承诺从不兑现 唯独那张脸我超喜欢<span ttm:role="x-bg">(大笨蛋 还是好爱你)</span></text><text for="L25">Beep beep beep 响到你接听为止</text><text for="L26">跟我一起回家吧<span ttm:role="x-bg">(回家吧)</span></text><text for="L27">所谓的爱 早就已经迷失不见</text><text for="L28">或许打从一开始 就从未真正懂过</text><text for="L29">我们在东京如此孤独</text><text for="L30">无论身在何方 身边有谁为伴</text><text for="L31">终究满心孤寂</text><text for="L32">寂寞在东京<span ttm:role="x-bg">(在这东京)</span></text><text for="L33">无处可归 亦没有落脚的方向<span ttm:role="x-bg">(归宿何在)</span></text><text for="L34">真的疲倦了</text><text for="L35">纵使与这么多人 产生着交集<span ttm:role="x-bg">(哪怕彼此相连)</span></text><text for="L36">纵然手机通知 如此响个不停</text><text for="L37">大家全都是孤身一人 不过是孤独之人的聚集<span ttm:role="x-bg">(形单影只 聚成群)</span></text><text for="L38">若是想要忘掉 那就什么都别记在心上</text><text for="L39">我们在这座东京孤独伶仃</text><text for="L40">无论去往何处 与谁待在一块<span ttm:role="x-bg">(啊)</span></text><text for="L41">依旧挥不去寂寞</text><text for="L42">游荡在孤独的东京<span ttm:role="x-bg">(这片东京)</span></text><text for="L43">回不去归宿 亦不知该前往何方<span ttm:role="x-bg">(那容身之所)</span></text><text for="L44">实在撑不住了</text><text for="L45">独处于这片东京</text></translation></translations><songwriters><songwriter>Mirei Toyama</songwriter><songwriter>Samuel Morris Zornow &amp; Zak Adams Leever</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="2:58.527"><div begin="0:02.626" end="2:58.527"><p begin="0:02.626" end="0:04.616" itunes:key="L1" ttm:agent="v1"><span begin="0:02.626" end="0:03.186">Lone</span><span begin="0:03.186" end="0:03.646">ly</span> <span begin="0:03.646" end="0:03.836">in</span> <span begin="0:03.836" end="0:04.616">Tokyo</span></p><p begin="0:05.076" end="0:09.296" itunes:key="L2" ttm:agent="v1"><span begin="0:05.076" end="0:05.446">ど</span><span begin="0:05.446" end="0:05.956">こ</span><span begin="0:05.956" end="0:06.296">に</span><span begin="0:06.296" end="0:06.456">い</span><span begin="0:06.456" end="0:06.736">て</span><span begin="0:06.736" end="0:06.936">も</span> <span begin="0:07.366" end="0:08.256">誰</span><span begin="0:08.256" end="0:08.636">と</span><span begin="0:08.636" end="0:08.806">い</span><span begin="0:08.806" end="0:09.076">て</span><span begin="0:09.076" end="0:09.296">も</span></p><p begin="0:10.417" end="0:11.777" itunes:key="L3" ttm:agent="v1"><span begin="0:10.417" end="0:11.297">寂しい</span><span begin="0:11.297" end="0:11.777">の</span></p><p begin="0:12.098" end="0:13.968" itunes:key="L4" ttm:agent="v1"><span begin="0:12.098" end="0:12.578">Lone</span><span begin="0:12.578" end="0:13.038">ly</span> <span begin="0:13.038" end="0:13.228">in</span> <span begin="0:13.228" end="0:13.968">Tokyo</span></p><p begin="0:14.409" end="0:18.819" itunes:key="L5" ttm:agent="v1"><span begin="0:14.409" end="0:15.359">帰</span><span begin="0:15.359" end="0:15.559">る</span><span begin="0:15.559" end="0:16.099">場所</span><span begin="0:16.099" end="0:16.349">も</span> <span begin="0:16.859" end="0:17.159">行</span><span begin="0:17.159" end="0:17.629">き</span><span begin="0:17.629" end="0:18.259">先</span><span begin="0:18.259" end="0:18.469">も</span><span begin="0:18.469" end="0:18.819">ない</span></p><p begin="0:19.276" end="0:20.866" itunes:key="L6" ttm:agent="v1"><span begin="0:19.276" end="0:19.766">疲</span><span begin="0:19.766" end="0:19.956">れ</span><span begin="0:19.956" end="0:20.286">た</span><span begin="0:20.286" end="0:20.866">よ</span></p><p begin="0:20.857" end="0:25.707" itunes:key="L7" ttm:agent="v1"><span begin="0:20.857" end="0:23.147">痛い</span><span begin="0:23.727" end="0:24.677">頭</span><span begin="0:24.677" end="0:24.927">は</span><span begin="0:24.927" end="0:25.707">全部</span></p><p begin="0:26.001" end="0:30.121" itunes:key="L8" ttm:agent="v1"><span begin="0:26.001" end="0:26.321">テー</span><span begin="0:26.321" end="0:26.461">ブ</span><span begin="0:26.461" end="0:26.631">ル</span><span begin="0:26.631" end="0:26.731">に</span><span begin="0:26.731" end="0:27.041">散</span><span begin="0:27.041" end="0:27.291">ら</span><span begin="0:27.291" end="0:27.731">ば</span><span begin="0:27.731" end="0:28.161">った</span> <span begin="0:28.601" end="0:28.841">空</span><span begin="0:28.841" end="0:28.981">き</span><span begin="0:28.981" end="0:29.421">缶</span><span begin="0:29.421" end="0:29.611">の</span><span begin="0:29.611" end="0:30.121">せい</span></p><p begin="0:30.117" end="0:35.507" itunes:key="L9" ttm:agent="v1"><span begin="0:30.117" end="0:30.617">Stay</span> <span begin="0:30.617" end="0:30.977">on</span> <span begin="0:30.977" end="0:32.387">it</span> <span begin="0:32.967" end="0:33.077">押</span><span begin="0:33.077" end="0:33.217">し</span><span begin="0:33.217" end="0:33.407">出</span><span begin="0:33.407" end="0:33.527">し</span><span begin="0:33.527" end="0:33.737">て</span><span begin="0:33.737" end="0:34.057">飲</span><span begin="0:34.057" end="0:34.297">む</span><span begin="0:34.297" end="0:35.027">pills</span><span ttm:role="x-bg"><span begin="0:35.027" end="0:35.507">(Pill)</span></span></p><p begin="0:35.504" end="0:40.014" itunes:key="L10" ttm:agent="v1"><span begin="0:35.504" end="0:36.034">昨日</span><span begin="0:36.034" end="0:36.224">のフ</span><span begin="0:36.224" end="0:36.404">ラッ</span><span begin="0:36.404" end="0:36.694">シュ</span><span begin="0:36.694" end="0:37.184">バッ</span><span begin="0:37.184" end="0:37.424">ク</span> <span begin="0:37.824" end="0:37.974">い</span><span begin="0:37.974" end="0:38.084">つ</span><span begin="0:38.084" end="0:38.254">も</span><span begin="0:38.254" end="0:38.824">同じ</span><span begin="0:38.824" end="0:39.094">や</span><span begin="0:39.094" end="0:39.494">ら</span><span begin="0:39.494" end="0:39.794">か</span><span begin="0:39.794" end="0:40.014">し</span><span ttm:role="x-bg"><span begin="0:37.471" end="0:37.922">(Flash</span><span begin="0:37.922" end="0:38.352">back)</span></span></p><p begin="0:40.283" end="0:44.913" itunes:key="L11" ttm:agent="v1"><span begin="0:40.283" end="0:40.573">Beep</span> <span begin="0:40.573" end="0:40.873">beep</span> <span begin="0:40.873" end="0:41.203">beep</span><span begin="0:41.203" end="0:41.383">「起</span><span begin="0:41.383" end="0:41.653">き</span><span begin="0:41.653" end="0:41.973">て</span><span begin="0:41.973" end="0:42.673">る？</span><span begin="0:42.673" end="0:43.153">今</span><span begin="0:43.153" end="0:43.463">か</span><span begin="0:43.463" end="0:43.803">ら</span><span begin="0:43.803" end="0:43.953">あ</span><span begin="0:43.953" end="0:44.243">そ</span><span begin="0:44.243" end="0:44.913">ぼ」</span></p><p begin="0:45.187" end="0:49.957" itunes:key="L12" ttm:agent="v1"><span begin="0:45.187" end="0:45.487">そ</span><span begin="0:45.487" end="0:45.787">んな</span><span begin="0:45.787" end="0:46.427">仲</span><span begin="0:46.427" end="0:46.607">で</span><span begin="0:46.607" end="0:46.727">も</span><span begin="0:46.727" end="0:46.947">な</span><span begin="0:46.947" end="0:47.047">い</span><span begin="0:47.047" end="0:47.197">け</span><span begin="0:47.197" end="0:47.587">ど？</span><span ttm:role="x-bg"><span begin="0:47.600" end="0:47.909">(We're</span> <span begin="0:47.909" end="0:48.211">not</span> <span begin="0:48.211" end="0:48.429">that</span> <span begin="0:48.429" end="0:49.200">close)</span></span></p><p begin="0:49.510" end="0:54.424" itunes:key="L13" ttm:agent="v1"><span begin="0:49.510" end="0:50.164">どう</span><span begin="0:50.164" end="0:50.494">せ</span><span begin="0:50.494" end="0:51.034">暇</span><span begin="0:51.034" end="0:51.224">だ</span><span begin="0:51.224" end="0:51.954">し</span> <span begin="0:51.954" end="0:52.874">一人</span><span begin="0:52.874" end="0:53.184">よ</span><span begin="0:53.184" end="0:53.364">り</span><span begin="0:53.364" end="0:53.574">ま</span><span begin="0:53.574" end="0:54.424">し</span></p><p begin="0:54.867" end="0:57.972" itunes:key="L14" ttm:agent="v1"><span begin="0:54.867" end="0:55.687">考</span><span begin="0:55.687" end="0:56.344">えなくて</span><span begin="0:56.344" end="0:56.572">い</span><span begin="0:56.572" end="0:57.972">い</span><span ttm:role="x-bg"><span begin="0:57.007" end="0:57.177">(I</span> <span begin="0:57.177" end="0:57.307">don't</span> <span begin="0:57.307" end="0:57.517">wan</span><span begin="0:57.517" end="0:57.637">na</span> <span begin="0:57.637" end="0:58.327">think</span> <span begin="0:58.327" end="0:58.652">about</span> <span begin="0:58.652" end="0:58.965">it)</span></span></p><p begin="0:58.467" end="1:01.687" itunes:key="L15" ttm:agent="v1"><span begin="0:58.467" end="0:58.777">We</span> <span begin="0:58.777" end="0:59.027">are</span> <span begin="0:59.027" end="0:59.497">Lone</span><span begin="0:59.497" end="0:59.927">ly</span> <span begin="0:59.927" end="1:00.127">in</span> <span begin="1:00.127" end="1:01.687">Tokyo</span><span ttm:role="x-bg"><span begin="1:00.834" end="1:01.503">(Tokyo)</span></span></p><p begin="1:01.064" end="1:05.534" itunes:key="L16" ttm:agent="v1"><span begin="1:01.064" end="1:01.784">ど</span><span begin="1:01.784" end="1:02.214">こ</span><span begin="1:02.214" end="1:02.554">に</span><span begin="1:02.554" end="1:02.734">い</span><span begin="1:02.734" end="1:02.994">て</span><span begin="1:02.994" end="1:03.054">も</span> <span begin="1:03.724" end="1:04.504">誰</span><span begin="1:04.504" end="1:04.904">と</span><span begin="1:04.904" end="1:05.074">い</span><span begin="1:05.074" end="1:05.344">て</span><span begin="1:05.344" end="1:05.534">も</span><span ttm:role="x-bg"><span begin="1:03.184" end="1:03.364">(い</span><span begin="1:03.364" end="1:03.524">て</span><span begin="1:03.524" end="1:03.869">も)</span></span></p><p begin="1:06.671" end="1:08.061" itunes:key="L17" ttm:agent="v1"><span begin="1:06.671" end="1:07.551">寂しい</span><span begin="1:07.551" end="1:08.061">の</span></p><p begin="1:08.333" end="1:10.325" itunes:key="L18" ttm:agent="v1"><span begin="1:08.333" end="1:08.853">Lone</span><span begin="1:08.853" end="1:09.313">ly</span> <span begin="1:09.313" end="1:09.503">in</span> <span begin="1:09.503" end="1:10.325">Tokyo</span></p><p begin="1:10.693" end="1:14.983" itunes:key="L19" ttm:agent="v1"><span begin="1:10.693" end="1:11.633">帰</span><span begin="1:11.633" end="1:11.833">る</span><span begin="1:11.833" end="1:12.383">場所</span><span begin="1:12.383" end="