<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="^^"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="^^ - Single"/><amll:meta key="isrc" value="JPU902204892"/><amll:meta key="appleMusicId" value="1661512334"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>MIREI, Ryota Saito &amp; Nobuaki Tanaka</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">发出的「早安」还未显示已读</text><text for="L2">昨天也是直到回过神来</text><text for="L3">才发现我们一直通着电话 直到无话可说</text><text for="L4">听不到你安睡的呼吸 我就无法入眠</text><text for="L5">对不起啊 明明你今天还要上班</text><text for="L6">刚才说的那场聚会</text><text for="L7">你去也不是不可以</text><text for="L8">不过我联系你的时候 你随时都能接吧</text><text for="L9">即使有定位 我也不愿怀疑</text><text for="L10">怀疑你总对我说的「只有你」</text><text for="L11">我的一半是由对你的喜欢组成的</text><text for="L12">你的一半也盛满了对我的喜欢吧？</text><text for="L13">无论何时 无论身在何处</text><text for="L14">我们两个人都是一体的吧 亲爱的</text><text for="L15">所有的快乐 欢喜 舒畅与幸福</text><text for="L16">所有的苦闷 寂寞 悲伤 疼痛与煎熬</text><text for="L17">无论何时 不管是什么</text><text for="L18">我们都能一起分享分担吧？</text><text for="L19">两个人一直在一起</text><text for="L20">如果要上传我们相伴那天的照片</text><text for="L21">哪怕只有指尖也好 把我拍进去吧</text><text for="L22">发了同一张照片 好像在暗示我们的关系</text><text for="L23">收到的回应和点赞 都让我看看吧</text><text for="L24">前些天和你互相关注的那个头像可爱的女孩</text><text for="L25">她的账号上锁了呢 下次给我看看吧</text><text for="L26">因为不只是你 你的朋友们</text><text for="L27">我也想一直相信他们所有人</text><text for="L28">我的一半是由对你的喜欢组成的</text><text for="L29">你的一半也盛满了对我的喜欢吧？</text><text for="L30">不论何时 不论身在何处</text><text for="L31">我们两个人都是一体的吧 亲爱的</text><text for="L32">那些快乐 欢喜 舒畅与幸福</text><text for="L33">还有苦闷 寂寞 悲伤 疼痛与煎熬</text><text for="L34">无论何时 无论发生什么</text><text for="L35">我们都能一起分享分担吧？</text><text for="L36">两个人一直在一起</text><text for="L37">沿着你的关注列表一路看下去</text><text for="L38">那些厌恶自己而不断哭泣的夜晚</text><text for="L39">你什么也没说 只是将我抱紧</text><text for="L40">明明只有在你的怀里 我才能安心</text><text for="L41">哪怕一秒钟也不愿与你分离</text><text for="L42">想一直沉醉在爱里 这样的心情还是第一次</text><text for="L43">你的幸福 我的幸福</text><text for="L44">只有我们彼此才能给予</text><text for="L45">所有的快乐 欢喜 舒畅与幸福</text><text for="L46">所有的苦闷 寂寞 悲伤 疼痛与煎熬</text><text for="L47">无论何时 不管是什么</text><text for="L48">我们都能一起分享分担吧？</text><text for="L49">两个人永远在一起</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:58.245"><div begin="0:10.673" end="3:58.245"><p begin="0:10.673" end="0:12.933" itunes:key="L1" ttm:agent="v1"><span begin="0:10.673" end="0:10.953">「おは</span><span begin="0:10.953" end="0:11.283">よう」</span><span begin="0:11.283" end="0:11.613">の既</span><span begin="0:11.613" end="0:12.053">読つ</span><span begin="0:12.053" end="0:12.393">か</span><span begin="0:12.393" end="0:12.933">ない</span></p><p begin="0:13.293" end="0:15.553" itunes:key="L2" ttm:agent="v1"><span begin="0:13.293" end="0:13.813">昨日</span><span begin="0:13.813" end="0:14.133">も気</span><span begin="0:14.133" end="0:14.323">づ</span><span begin="0:14.323" end="0:14.483">い</span><span begin="0:14.483" end="0:14.793">た</span><span begin="0:14.793" end="0:15.553">ら</span></p><p begin="0:15.856" end="0:20.536" itunes:key="L3" ttm:agent="v1"><span begin="0:15.856" end="0:16.176">会</span><span begin="0:16.176" end="0:16.456">話がな</span><span begin="0:16.456" end="0:16.666">く</span><span begin="0:16.666" end="0:16.826">な</span><span begin="0:16.826" end="0:17.006">る</span><span begin="0:17.006" end="0:17.426">ま</span><span begin="0:17.426" end="0:17.706">で</span> <span begin="0:18.056" end="0:18.676">電</span><span begin="0:18.676" end="0:18.976">話</span><span begin="0:18.976" end="0:19.226">し</span><span begin="0:19.226" end="0:19.636">て</span><span begin="0:19.636" end="0:19.976">た</span><span begin="0:19.976" end="0:20.536">ね</span></p><p begin="0:20.883" end="0:26.243" itunes:key="L4" ttm:agent="v1"><span begin="0:20.883" end="0:21.543">君</span><span begin="0:21.543" end="0:21.773">の</span><span begin="0:21.773" end="0:22.223">寝</span><span begin="0:22.223" end="0:22.753">息</span><span begin="0:22.753" end="0:23.023">聞</span><span begin="0:23.023" end="0:23.723">く</span><span begin="0:23.723" end="0:23.953">ま</span><span begin="0:23.953" end="0:24.403">で</span> <span begin="0:24.723" end="0:25.033">寝</span><span begin="0:25.033" end="0:25.183">れ</span><span begin="0:25.183" end="0:25.843">な</span><span begin="0:25.843" end="0:26.243">いの</span></p><p begin="0:26.585" end="0:30.345" itunes:key="L5" ttm:agent="v1"><span begin="0:26.585" end="0:27.245">ごめん</span><span begin="0:27.245" end="0:27.695">ね</span> <span begin="0:28.035" end="0:28.325">今日</span><span begin="0:28.325" end="0:28.645">も仕</span><span begin="0:28.645" end="0:29.065">事な</span><span begin="0:29.065" end="0:29.425">の</span><span begin="0:29.425" end="0:30.345">に</span></p><p begin="0:30.863" end="0:33.083" itunes:key="L6" ttm:agent="v1"><span begin="0:30.863" end="0:31.193">さっ</span><span begin="0:31.193" end="0:31.383">き</span><span begin="0:31.383" end="0:31.633">言って</span><span begin="0:31.633" end="0:31.953">た飲</span><span begin="0:31.953" end="0:32.193">み</span><span begin="0:32.193" end="0:33.083">会</span></p><p begin="0:33.586" end="0:35.796" itunes:key="L7" ttm:agent="v1"><span begin="0:33.586" end="0:33.806">行っ</span><span begin="0:33.806" end="0:34.016">て</span><span begin="0:34.016" end="0:34.346">きて</span><span begin="0:34.346" end="0:34.526">も</span><span begin="0:34.526" end="0:34.736">いい</span><span begin="0:34.736" end="0:35.136">け</span><span begin="0:35.136" end="0:35.796">ど</span></p><p begin="0:36.098" end="0:40.758" itunes:key="L8" ttm:agent="v1"><span begin="0:36.098" end="0:36.548">私</span><span begin="0:36.548" end="0:36.898">から</span><span begin="0:36.898" end="0:37.338">の連</span><span begin="0:37.338" end="0:37.998">絡</span> <span begin="0:37.998" end="0:38.148">い</span><span begin="0:38.148" end="0:38.608">つ</span><span begin="0:38.608" end="0:38.848">で</span><span begin="0:38.848" end="0:39.248">も</span><span begin="0:39.248" end="0:39.518">出</span><span begin="0:39.518" end="0:39.888">れ</span><span begin="0:39.888" end="0:40.188">るよ</span><span begin="0:40.188" end="0:40.758">ね</span></p><p begin="0:41.142" end="0:47.962" itunes:key="L9" ttm:agent="v1"><span begin="0:41.142" end="0:41.402">位</span><span begin="0:41.402" end="0:41.712">置</span><span begin="0:41.712" end="0:42.362">情</span><span begin="0:42.362" end="0:43.012">報</span><span begin="0:43.012" end="0:43.392">が</span><span begin="0:43.392" end="0:43.892">あっ</span><span begin="0:43.932" end="0:44.152">て</span><span begin="0:44.152" end="0:44.632">も</span> <span begin="0:44.962" end="0:46.072">疑</span><span begin="0:46.072" end="0:46.462">いた</span><span begin="0:46.462" end="0:46.742">く</span><span begin="0:46.812" end="0:47.322">な</span><span begin="0:47.322" end="0:47.472">い</span><span begin="0:47.472" end="0:47.962">の</span></p><p begin="0:48.274" end="0:50.594" itunes:key="L10" ttm:agent="v1"><span begin="0:48.274" end="0:48.564">いつ</span><span begin="0:48.564" end="0:48.894">もく</span><span begin="0:48.894" end="0:49.044">れ</span><span begin="0:49.044" end="0:49.194">る「</span><span begin="0:49.194" end="0:49.604">君だ</span><span begin="0:49.604" end="0:50.324">け」</span><span begin="0:50.324" end="0:50.594">を</span></p><p begin="0:50.928" end="0:55.308" itunes:key="L11" ttm:agent="v1"><span begin="0:50.928" end="0:51.528">私</span><span begin="0:51.528" end="0:51.828">の</span><span begin="0:51.828" end="0:52.198">半</span><span begin="0:52.198" end="0:52.638">分は</span><span begin="0:52.638" end="0:53.158">君</span><span begin="0:53.158" end="0:53.378">への</span><span begin="0:53.378" end="0:53.748">好</span><span begin="0:53.748" end="0:54.068">きで</span><span begin="0:54.068" end="0:54.258">出</span><span begin="0:54.258" end="0:54.668">来てい</span><span begin="0:54.668" end="0:55.308">て</span></p><p begin="0:55.646" end="1:00.166" itunes:key="L12" ttm:agent="v1"><span begin="0:55.646" end="0:55.976">君</span><span begin="0:55.976" end="0:56.276">の</span><span begin="0:56.276" end="0:56.626">半</span><span begin="0:56.626" end="0:56.926">分</span><span begin="0:56.926" end="0:57.096">も</span><span begin="0:57.096" end="0:57.726">私</span><span begin="0:57.726" end="0:58.156">の好</span><span begin="0:58.156" end="0:58.476">きで</span><span begin="0:58.476" end="0:58.786">出</span><span begin="0:58.786" end="0:58.976">来</span><span begin="0:58.976" end="0:59.146">て</span><span begin="0:59.146" end="0:59.356">る</span><span begin="0:59.356" end="0:59.776">よ</span><span begin="0:59.776" end="1:00.166">ね？</span></p><p begin="1:00.441" end="1:05.451" itunes:key="L13" ttm:agent="v1"><span begin="1:00.441" end="1:00.591">い</span><span begin="1:00.591" end="1:01.291">つ</span><span begin="1:01.291" end="1:01.981">だっ</span><span begin="1:01.981" end="1:02.611">て</span> <span begin="1:02.901" end="1:03.121">ど</span><span begin="1:03.121" end="1:03.801">こ</span><span begin="1:03.801" end="1:04.411">にい</span><span begin="1:04.411" end="1:05.071">たっ</span><span begin="1:05.071" end="1:05.451">て</span></p><p begin="1:05.769" end="1:10.914" itunes:key="L14" ttm:agent="v1"><span begin="1:05.769" end="1:06.349">私</span><span begin="1:06.349" end="1:06.549">た</span><span begin="1:06.549" end="1:06.709">ち</span><span begin="1:06.709" end="1:06.999">は</span><span begin="1:06.999" end="1:07.639">二人</span><span begin="1:07.639" end="1:07.839">で</span><span begin="1:07.839" end="1:08.239">一</span><span begin="1:08.239" end="1:08.509">つ</span><span begin="1:08.509" end="1:08.949">だ</span><span begin="1:08.949" end="1:09.179">よ</span><span begin="1:09.179" end="1:09.554">ね</span> <span begin="1:09.554" end="1:10.084">dar</span><span begin="1:10.084" end="1:10.914">ling</span></p><p begin="1:11.106" end="1:15.536" itunes:key="L15" ttm:agent="v1"><span begin="1:11.106" end="1:11.586">楽</span><span begin="1:11.586" end="1:11.806">し</span><span begin="1:11.806" end="1:12.096">い</span> <span begin="1:12.096" end="1:12.326">嬉</span><span begin="1:12.326" end="1:12.676">しい</span> <span begin="1:12.676" end="1:12.886">気</span><span begin="1:12.886" end="1:13.316">持ちいい</span> <span begin="1:13.316" end="1:13.926">幸</span><span begin="1:13.926" end="1:14.276">せは</span><span begin="1:14.276" end="1:14.516">もう</span><span begin="1:14.516" end="1:14.946">全</span><span begin="1:14.946" end="1:15.536">部</span></p><p begin="1:15.857" end="1:20.347" itunes:key="L16" ttm:agent="v1"><span begin="1:15.857" end="1:16.147">苦</span><span begin="1:16.147" end="1:16.457">しい</span> <span begin="1:16.457" end="1:16.777">寂</span><span begin="1:16.777" end="1:17.107">しい</span> <span begin="1:17.107" end="1:17.407">悲</span><span begin="1:17.407" end="1:17.827">しい</span> <span begin="1:17.827" end="1:18.137">痛</span><span begin="1:18.137" end="1:18.307">い</span> <span begin="1:18.307" end="1:18.747">辛</span><span begin="1:18.747" end="1:18.987">い</span><span begin="1:18.987" end="1:19.297">こと</span><span begin="1:19.297" end="1:19.587">さえ</span><span begin="1:19.587" end="1:19.987">全</span><span begin="1:19.987" end="1:20.347">部</span></p><p begin="1:20.646" end="1:25.656" itunes:key="L17" ttm:agent="v1"><span begin="1:20.646" end="1:20.806">い</span><span begin="1:20.806" end="1:21.486">つ</span><span begin="1:21.486" end="1:22.176">だっ</span><span begin="1:22.176" end="1:22.846">て</span> <span begin="1:23.106" end="1:23.456">どん</span><span begin="1:23.456" end="1:23.986">な</span><span begin="1:23.986" end="1:24.376">こ</span><span begin="1:24.376" end="1:24.656">と</span><span begin="1:24.656" end="1:25.286">だっ</span><span begin="1:25.286" end="1:25.656">て</span></p><p begin="1:25.989" end="1:29.169" itunes:key="L18" ttm:agent="v1">