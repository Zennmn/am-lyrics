<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="iyaiiya"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="still"/><amll:meta key="isrc" value="JPU902002643"/><amll:meta key="appleMusicId" value="1555193624"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">在干嘛呢</text><text for="L2">怎么啦</text><text for="L3">哪怕只聊十分钟 也抽不出空吗</text><text for="L4">出什么事了吗</text><text for="L5">没有 倒也没什么特别的事</text><text for="L6">只是想听听你的声音 哪怕片刻也好</text><text for="L7">这样啊 可我今天实在好困</text><text for="L8">抱歉啦</text><text for="L9">知道啦 也是没办法的事呢</text><text for="L10">那就晚安咯</text><text for="L11">若把这当作委曲求全</text><text for="L12">算是我太任性吗</text><text for="L13">头像里浅笑嫣然的你</text><text for="L14">如今目光却仿佛再不曾与我相交</text><text for="L15">曾经是怎样呢 又是如何做到</text><text for="L16">我们曾怎样彼此凝望呢</text><text for="L17">明明只想赌气发一句「讨厌你」</text><text for="L18">输入法可别自作多情转成了「好喜欢」</text><text for="L19">别再将「生生世世」与「永不分离」</text><text for="L20">拼凑在一起</text><text for="L21">明明反反复复删改了无数遍</text><text for="L22">屏幕上却依旧打出那些言不由衷的字句</text><text for="L23">我到底想让你怎么做呢</text><text for="L24">我也不明白 算了 随它去吧<span ttm:role="x-bg">(随它去吧)</span></text><text for="L25">这样下去 根本什么也不会改变吧</text><text for="L26">明知会落空 却还在暗暗期盼着什么吧</text><text for="L27">你在忙什么呢</text><text for="L28">怎么突然找我</text><text for="L29">哪怕就聊十分钟 陪我说说话好吗</text><text for="L30">明早我还得早起赶时间</text><text for="L31">聊着聊着可能会不小心睡着</text><text for="L32">这样也没关系吗</text><text for="L33">每当你困倦的话音渐渐化作轻柔吐息</text><text for="L34">便能真切感到你实实在在地伴在身旁</text><text for="L35">就算那只是一场梦也好</text><text for="L36">那句哽在喉头的「好想见你」</text><text for="L37">你听来会不会觉得难受</text><text for="L38">不如干脆 这辈子</text><text for="L39">都不要再说出口为好吧</text><text for="L40">多想狠下心发一句「恨透你了」</text><text for="L41">可千万别下意识换成了「最喜欢你」</text><text for="L42">莫再将「一生一世」和「长相厮守」</text><text for="L43">别再把它们并排写下</text><text for="L44">一次次在对话框里打了又删</text><text for="L45">翻来覆去发送的却总是同一番话</text><text for="L46">可我究竟想让你做些什么呢</text><text for="L47">早就想不透了 哎 罢了<span ttm:role="x-bg">(罢了)</span></text><text for="L48">到头来 一切依旧毫无起色吧</text><text for="L49">注定要失望 却依然无可救药地期待着吧</text><text for="L50">越是顺着心意走</text><text for="L51">心中描绘的理想就越渐行渐远</text><text for="L52">多希望能再贴近彼此一点</text><text for="L53">哪怕认真地彼此说着「不是这样」</text><text for="L54">就连这些也快要忘记了啊</text><text for="L55">心底叫嚣着想发一句「别再理我」</text><text for="L56">求你别擅自联想成「不能没有你」</text><text for="L57">不要把「地久天长」与「执手同行」</text><text for="L58">连缀成句</text><text for="L59">哪怕敲敲打打重写过千百回</text><text for="L60">脱口而出的还是那些话</text><text for="L61">我究竟还想让你做什么呢</text><text for="L62">谁知道呢 算啦 没所谓了<span ttm:role="x-bg">(无所谓了)</span></text><text for="L63">照这样 终究什么都无法挽回吧</text><text for="L64">明明知道期待会落空 却还是在期待着什么呢</text></translation></translations><songwriters><songwriter>Ryota Saito &amp; Nobuaki Tanaka</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:12.151"><div begin="0:13.682" end="4:12.151"><p begin="0:13.682" end="0:15.122" itunes:key="L1" ttm:agent="v1"><span begin="0:13.682" end="0:13.962">ねぇ</span><span begin="0:13.962" end="0:14.412">何</span><span begin="0:14.412" end="0:14.602">し</span><span begin="0:14.602" end="0:14.872">て</span><span begin="0:14.872" end="0:15.122">る？</span></p><p begin="0:15.132" end="0:16.712" itunes:key="L2" ttm:agent="v1"><span begin="0:15.132" end="0:15.782">どう</span><span begin="0:15.782" end="0:16.041">し</span><span begin="0:16.041" end="0:16.372">た</span><span begin="0:16.512" end="0:16.712">の？</span></p><p begin="0:16.939" end="0:19.679" itunes:key="L3" ttm:agent="v1"><span begin="0:16.939" end="0:17.179">10</span><span begin="0:17.329" end="0:17.769">分</span><span begin="0:17.769" end="0:17.879">だ</span><span begin="0:17.879" end="0:18.169">け</span><span begin="0:18.169" end="0:18.309">で</span><span begin="0:18.309" end="0:18.549">も</span> <span begin="0:18.549" end="0:19.119">話</span><span begin="0:19.119" end="0:19.389">せ</span><span begin="0:19.389" end="0:19.679">ない？</span></p><p begin="0:20.010" end="0:21.960" itunes:key="L4" ttm:agent="v1"><span begin="0:20.010" end="0:20.590">何</span><span begin="0:20.600" end="0:21.500">があっ</span><span begin="0:21.500" end="0:21.680">た</span><span begin="0:21.680" end="0:21.960">の？</span></p><p begin="0:22.404" end="0:24.404" itunes:key="L5" ttm:agent="v1"><span begin="0:22.404" end="0:22.544">い</span><span begin="0:22.544" end="0:22.744">や</span><span begin="0:22.744" end="0:23.194">特</span><span begin="0:23.194" end="0:23.324">に</span><span begin="0:23.324" end="0:23.624">なん</span><span begin="0:23.624" end="0:23.784">も</span><span begin="0:23.784" end="0:24.044">ない</span><span begin="0:24.044" end="0:24.214">け</span><span begin="0:24.214" end="0:24.404">ど</span></p><p begin="0:24.564" end="0:27.144" itunes:key="L6" ttm:agent="v1"><span begin="0:24.564" end="0:24.814">ちょっ</span><span begin="0:24.814" end="0:25.014">と</span><span begin="0:25.014" end="0:25.244">だ</span><span begin="0:25.244" end="0:25.434">け</span><span begin="0:25.434" end="0:25.694">で</span><span begin="0:25.694" end="0:25.824">も</span><span begin="0:25.824" end="0:26.074">声</span><span begin="0:26.074" end="0:26.504">聞き</span><span begin="0:26.504" end="0:26.644">た</span><span begin="0:26.644" end="0:26.904">く</span><span begin="0:26.904" end="0:27.144">て</span></p><p begin="0:27.432" end="0:29.562" itunes:key="L7" ttm:agent="v1"><span begin="0:27.432" end="0:27.772">そっ</span><span begin="0:27.772" end="0:27.932">か</span><span begin="0:27.932" end="0:28.182">で</span><span begin="0:28.182" end="0:28.332">も</span><span begin="0:28.332" end="0:28.622">今日</span><span begin="0:28.622" end="0:28.752">は</span><span begin="0:28.752" end="0:29.012">もう</span><span begin="0:29.012" end="0:29.462">眠いん</span><span begin="0:29.462" end="0:29.562">だ</span></p><p begin="0:29.562" end="0:30.462" itunes:key="L8" ttm:agent="v1"><span begin="0:29.562" end="0:29.862">ご</span><span begin="0:29.862" end="0:30.282">めん</span><span begin="0:30.282" end="0:30.462">ね</span></p><p begin="0:30.694" end="0:32.054" itunes:key="L9" ttm:agent="v1"><span begin="0:30.694" end="0:30.794">わ</span><span begin="0:30.794" end="0:31.094">かっ</span><span begin="0:31.094" end="0:31.214">た</span><span begin="0:31.214" end="0:31.524">しょう</span><span begin="0:31.524" end="0:31.644">が</span><span begin="0:31.644" end="0:31.914">ない</span><span begin="0:31.914" end="0:32.054">ね</span></p><p begin="0:32.057" end="0:33.957" itunes:key="L10" ttm:agent="v1"><span begin="0:32.057" end="0:32.487">じゃあお</span><span begin="0:32.487" end="0:32.937">休</span><span begin="0:32.937" end="0:33.187">み</span><span begin="0:33.187" end="0:33.617">だ</span><span begin="0:33.617" end="0:33.957">ね</span></p><p begin="0:34.850" end="0:37.500" itunes:key="L11" ttm:agent="v1"><span begin="0:34.850" end="0:35.010">こ</span><span begin="0:35.010" end="0:35.320">れ</span><span begin="0:35.320" end="0:35.420">を</span><span begin="0:35.420" end="0:36.110">我慢っ</span><span begin="0:36.110" end="0:36.220">て</span><span begin="0:36.220" end="0:36.520">感</span><span begin="0:36.520" end="0:36.680">じ</span><span begin="0:36.680" end="0:36.920">る</span><span begin="0:36.920" end="0:37.090">の</span><span begin="0:37.090" end="0:37.500">は</span></p><p begin="0:37.500" end="0:39.700" itunes:key="L12" ttm:agent="v1"><span begin="0:37.500" end="0:37.730">ワ</span><span begin="0:37.730" end="0:38.150">ガ</span><span begin="0:38.150" end="0:38.560">マ</span><span begin="0:38.560" end="0:39.700">マ？</span></p><p begin="0:40.491" end="0:43.761" itunes:key="L13" ttm:agent="v1"><span begin="0:40.491" end="0:40.881">ア</span><span begin="0:40.881" end="0:41.031">イ</span><span begin="0:41.031" end="0:41.471">コン</span><span begin="0:41.471" end="0:41.661">の</span><span begin="0:41.661" end="0:42.111">中</span><span begin="0:42.111" end="0:42.341">で</span><span begin="0:42.341" end="0:42.741">笑っ</span><span begin="0:42.741" end="0:42.951">て</span><span begin="0:42.951" end="0:43.131">る</span><span begin="0:43.331" end="0:43.471">キ</span><span begin="0:43.471" end="0:43.621">ミ</span><span begin="0:43.621" end="0:43.761">と</span></p><p begin="0:43.763" end="0:46.643" itunes:key="L14" ttm:agent="v1"><span begin="0:43.763" end="0:44.013">前</span><span begin="0:44.013" end="0:44.173">よ</span><span begin="0:44.173" end="0:44.293">り</span><span begin="0:44.293" end="0:44.443">目</span><span begin="0:44.443" end="0:44.703">が合</span><span begin="0:44.703" end="0:44.863">わ</span><span begin="0:44.863" end="0:44.993">な</span><span begin="0:44.993" end="0:45.263">く</span><span begin="0:45.263" end="0:45.683">なっ</span><span begin="0:45.683" end="0:45.833">た</span><span begin="0:45.833" end="0:46.053">み</span><span begin="0:46.053" end="0:46.323">た</span><span begin="0:46.323" end="0:46.643">い</span></p><p begin="0:47.059" end="0:49.359" itunes:key="L15" ttm:agent="v1"><span begin="0:47.059" end="0:47.519">どう</span><span begin="0:47.519" end="0:47.769">だ</span><span begin="0:47.769" end="0:47.869">っ</span><span begin="0:47.869" end="0:48.129">け</span> <span begin="0:48.359" end="0:48.759">どう</span><span begin="0:48.759" end="0:49.089">やっ</span><span begin="0:49.089" end="0:49.359">て</span></p><p begin="0:49.615" end="0:52.795" itunes:key="L16" ttm:agent="v1"><span begin="0:49.615" end="0:49.805">見</span><span begin="0:49.805" end="0:49.975">つ</span><span begin="0:49.975" end="0:50.305">め</span><span begin="0:50.305" end="0:50.465">合</span><span begin="0:50.465" end="0:50.805">え</span><span begin="0:50.805" end="0:51.035">て</span><span begin="0:51.035" end="0:51.305">た</span><span begin="0:51.305" end="0:51.525">ん</span><span begin="0:51.525" end="0:51.875">だ</span><span begin="0:51.875" end="0:52.795">ろう？</span></p><p begin="0:53.318" end="0:56.298" itunes:key="L17" ttm:agent="v1"><span begin="0:53.318" end="0:54.158">「大嫌い」っ</span><span begin="0:54.158" end="0:54.418">て</span><span begin="0:54.418" end="0:54.888">送</span><span begin="0:54.888" end="0:55.108">り</span><span begin="0:55.108" end="0:55.718">た</span><span begin="0:55.718" end="0:55.828">い</span><span begin="0:55.828" end="0:56.118">か</span><span begin="0:56.118" end="0:56.298">ら</span></p><p begin="0:56.656" end="0:59.676" itunes:key="L18" ttm:agent="v1"><span begin="0:56.656" end="0:57.086">「大好</span><span begin="0:57.086" end="0:57.346">き」っ</span><span begin="0:57.346" end="0:57.486">て</span><span begin="0:57.486" end="0:58.276">変換</span><span begin="0:58.276" end="0:58.526">し</span><span begin="0:58.526" end="0:59.456">ない</span><span begin="0:59.456" end="0:59.676">で</span></p><p begin="0:59.950" end="1:02.980" itunes:key="L19" ttm:agent="v1"><span begin="0:59.950" end="1:00.230">「ず</span><span begin="1:00.230" end="1:00.330">っ</span><span begin="1:00.330" end="1:00.770">と</span><span begin="1:00.770" end="1:01.520">ずっ</span><span begin="1:01.520" end="1:01.970">と」「</span><span begin="1:01.970" end="1:02.740">一緒」っ</span><span begin="1:02.740" end="1:02.980">て</span></p><p begin="1:03.216" end="1:06.316" itunes:key="L20" ttm:agent="v1"><span begin="1:03.216" end="1:03.836">並</span><span begin="1:04.026" end="1:04.416">べ</span><span begin="1:04.416" end="1:04.666">な</span><span begin="1:04.886" end="1:05.416">い</span><span begin="1:05.416" end="1:06.316">で</span></p><p begin="1:06.577" end="1:09.667" itunes:key="L21" ttm:agent="v1"><span begin="1:06.577" end="1:07.057">何</span><span begin="1:07.057" end="1:07.357">回</span><span begin="1:07.357" end="1:07.647">も打</span><span begin="1:07.647" end="1:07.897">ち</span><span begin="1:07.897" end="1:08.397">直</span><span begin="1:08.397" end="1:08.577">し</span><span begin="1:08.577" end="1:09.027">て