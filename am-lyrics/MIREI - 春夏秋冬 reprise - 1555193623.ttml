0.244">で</span><span begin="0:20.244" end="0:20.654">遊</span><span begin="0:20.654" end="0:20.844">ぶ</span><span begin="0:20.844" end="0:21.274">夏</span></p><p begin="0:21.539" end="0:24.699" itunes:key="L5" ttm:agent="v1"><span begin="0:21.539" end="0:21.839">秋</span><span begin="0:21.839" end="0:22.219">色</span><span begin="0:22.219" end="0:22.319">に</span><span begin="0:22.319" end="0:22.629">染</span><span begin="0:22.629" end="0:22.819">ま</span><span begin="0:22.819" end="0:23.059">る</span><span begin="0:23.059" end="0:23.159">い</span><span begin="0:23.159" end="0:23.459">ちょう</span><span begin="0:23.459" end="0:23.839">並</span><span begin="0:23.839" end="0:24.109">木</span><span begin="0:24.109" end="0:24.459">歩</span><span begin="0:24.459" end="0:24.699">き</span></p><p begin="0:24.918" end="0:27.568" itunes:key="L6" ttm:agent="v1"><span begin="0:24.918" end="0:25.138">銀</span><span begin="0:25.138" end="0:25.308">世</span><span begin="0:25.308" end="0:25.608">界</span><span begin="0:25.608" end="0:25.788">ツ</span><span begin="0:25.788" end="0:25.998">リー</span><span begin="0:25.998" end="0:26.108">の</span><span begin="0:26.108" end="0:26.498">下</span><span begin="0:26.498" end="0:26.838">笑</span><span begin="0:26.838" end="0:26.958">い</span><span begin="0:26.958" end="0:27.128">あ</span><span begin="0:27.128" end="0:27.568">い</span></p><p begin="0:27.811" end="0:35.231" itunes:key="L7" ttm:agent="v1"><span begin="0:27.811" end="0:28.131">嬉</span><span begin="0:28.131" end="0:28.551">しい</span><span begin="0:28.551" end="0:28.731">日</span><span begin="0:28.731" end="0:29.221">も</span><span begin="0:29.451" end="0:29.821">悔</span><span begin="0:29.821" end="0:30.251">しい</span><span begin="0:30.251" end="0:30.421">日</span><span begin="0:30.421" end="0:30.911">も</span> <span begin="0:31.131" end="0:31.341">そ</span><span begin="0:31.341" end="0:31.651">ば</span><span begin="0:31.651" end="0:31.771">で</span><span begin="0:31.771" end="0:32.441">話</span><span begin="0:32.441" end="0:32.861">聞い</span><span begin="0:32.861" end="0:33.001">て</span><span begin="0:33.001" end="0:33.441">たい</span><span begin="0:33.441" end="0:33.881">か</span><span begin="0:33.881" end="0:35.231">ら</span></p><p begin="0:35.661" end="0:41.691" itunes:key="L8" ttm:agent="v1"><span begin="0:35.661" end="0:35.801">い</span><span begin="0:35.801" end="0:36.051">つ</span><span begin="0:36.051" end="0:36.311">ま</span><span begin="0:36.311" end="0:36.481">で</span><span begin="0:36.481" end="0:36.811">も</span><span begin="0:36.811" end="0:36.931">あ</span><span begin="0:36.931" end="0:37.091">な</span><span begin="0:37.091" end="0:37.521">た</span><span begin="0:37.521" end="0:37.761">と</span><span begin="0:37.761" end="0:38.131">ずっ</span><span begin="0:38.131" end="0:38.591">と</span><span begin="0:38.931" end="0:39.361">いた</span><span begin="0:39.361" end="0:39.481">い</span><span begin="0:39.481" end="0:39.651">の</span> <span begin="0:39.651" end="0:40.131">春</span><span begin="0:40.131" end="0:40.281">夏</span><span begin="0:40.281" end="0:40.701">秋</span><span begin="0:40.701" end="0:41.691">冬</span></p><p begin="0:42.024" end="0:45.454" itunes:key="L9" ttm:agent="v1"><span begin="0:42.024" end="0:42.294">今</span><span begin="0:42.294" end="0:42.874">年</span><span begin="0:43.184" end="0:43.284">の</span><span begin="0:43.284" end="0:43.814">春</span><span begin="0:43.814" end="0:44.034">は</span><span begin="0:44.034" end="0:44.164">ど</span><span begin="0:44.164" end="0:44.494">こ</span><span begin="0:44.494" end="0:44.614">に行</span><span begin="0:44.614" end="0:45.064">こう</span><span begin="0:45.064" end="0:45.454">か？</span></p><p begin="0:45.449" end="0:48.999" itunes:key="L10" ttm:agent="v1"><span begin="0:45.449" end="0:45.749">今</span><span begin="0:45.749" end="0:46.339">年</span><span begin="0:46.629" end="0:46.739">の</span><span begin="0:46.739" end="0:47.259">夏</span><span begin="0:47.259" end="0:47.479">は</span><span begin="0:47.479" end="0:47.609">ど</span><span be