<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">那一夜尽是借口 事后才拼凑成形</text><text for="L2">在日常生活的缝隙里若隐若现</text><text for="L3">你总是对身旁所有人展露微笑</text><text for="L4">那副心满意足的模样真让人讨厌</text><text for="L5">让伪装的心思悄然露出</text><text for="L6">自顾自做着一厢情愿的美梦</text><text for="L7">寒风凛冽吹过额前碎发微扬</text><text for="L8">毫无意义的落吻毫无温存的示意</text><text for="L9">早已看透这段叫人难以招架的恋情</text><text for="L10">明知如此仍循着蜜香诱引落入罗网</text><text for="L11">我只是一只蝶</text><text for="L12">任由不凋的爱意流转 终究一点点融化</text><text for="L13">在酸楚的时光中仍向你伸出手</text><text for="L14">就这样始终无法振翅起舞</text><text for="L15">残缺的太阳渐渐被阴影吞没</text><text for="L16">紧紧抓住那句曾在你眼底闪光的话语</text><text for="L17">长久以来你都含混游移暧昧不清</text><text for="L18">沉溺于一再重复的虚妄温存里</text><text for="L19">盘根错节的谎言再也无法拆解</text><text for="L20">我正一点一点沉沦下去</text><text for="L21">仍在追逐那被烟尘蒙住的憧憬</text><text for="L22">始终割舍不下的心意</text><text for="L23">沿着幽暗长路继续前行</text><text for="L24">多余的话语在心头越积越多</text><text for="L25">心口深处如同快要碎裂崩塌</text><text for="L26">膨胀的心意压得人几乎无法呼吸</text><text for="L27">明明早就知道这段恋情难以招架</text><text for="L28">仍抵挡不住蜜香的诱惑再次自投罗网</text><text for="L29">我仍是那只蝶</text><text for="L30">不凋的爱意仍在流转 终究融化殆尽</text><text for="L31">在苦涩的时光里依然一次次向你伸手</text><text for="L32">即使依旧无法翩跹起舞</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="source"/><amll:meta key="musicName" value="Kuenai"/><amll:meta key="artists" value="MIREI"/><amll:meta key="album" value="Kuenai - Single"/><amll:meta key="appleMusicId" value="1593531390"/><amll:meta key="isrc" value="JPU902104029"/></metadata></head><body><div begin="0:17.920" end="3:36.320"><p begin="0:17.920" end="0:24.730" itunes:key="L1" ttm:agent="v1"><span begin="0:17.920" end="0:19.370">言い訳を</span><span begin="0:19.370" end="0:20.370">並べ</span><span begin="0:20.370" end="0:20.760">た</span> <span begin="0:22.220" end="0:23.650">後付けの</span><span begin="0:23.650" end="0:24.440">夜</span><span begin="0:24.440" end="0:24.730">が</span></p><p begin="0:25.030" end="0:32.780" itunes:key="L2" ttm:agent="v1"><span begin="0:25.030" end="0:27.420">生活の</span><span begin="0:27.420" end="0:28.920">隙間で</span> <span begin="0:30.130" end="0:30.690">見え</span><span begin="0:30.690" end="0:31.680">隠れ</span><span begin="0:31.680" end="0:32.390">して</span><span begin="0:32.390" end="0:32.560">い</span><span begin="0:32.560" end="0:32.780">る</span></p><p begin="0:33.060" end="0:36.130" itunes:key="L3" ttm:agent="v1"><span begin="0:33.060" end="0:33.740">いつだって</span><span begin="0:33.740" end="0:34.750">みんなに</span><span begin="0:34.750" end="0:35.780">微笑ん</span><span begin="0:35.780" end="0:36.130">で</span></p><p begin="0:36.980" end="0:40.870" itunes:key="L4" ttm:agent="v1"><span begin="0:36.980" end="0:38.800">満足気な</span><span begin="0:39.100" end="0:39.760">貴方が</span><span begin="0:39.760" end="0:40.660">嫌</span><span begin="0:40.660" end="0:40.870">い</span></p><p begin="0:41.110" end="0:44.180" itunes:key="L5" ttm:agent="v1"><span begin="0:41.110" end="0:41.790">偽った</span><span begin="0:41.790" end="0:42.810">心を</span><span begin="0:42.810" end="0:43.810">覗かせ</span><span begin="0:43.810" end="0:44.180">て</span></p><p begin="0:45.000" end="0:48.930" itunes:key="L6" ttm:agent="v1"><span begin="0:45.000" end="0:46.870">都合のいい</span><span begin="0:47.080" end="0:47.600">夢を</span><span begin="0:47.600" end="0:48.320">みて</span><span begin="0:48.320" end="0:48.670">る</span><span begin="0:48.670" end="0:48.930">の</span></p><p begin="0:49.300" end="0:57.010" itunes:key="L7" ttm:agent="v1"><span begin="0:49.300" end="0:51.210">冷たい</span><span begin="0:51.210" end="0:52.430">風が</span><span begin="0:52.430" end="0:52.950">吹き</span> <span begin="0:53.370" end="0:55.660">前髪が</span><span begin="0:55.660" end="0:56.680">揺れて</span><span begin="0:56.680" end="0:56.750">い</span><span begin="0:56.750" end="0:57.010">る</span></p><p begin="0:57.510" end="1:04.960" itunes:key="L8" ttm:agent="v1"><span begin="0:57.510" end="0:58.940">意味のない</span><span begin="0:58.940" end="1:00.520">口付け</span> <span begin="1:01.070" end="1:03.070">温度のない</span><span begin="1:03.590" end="1:04.430">合</span><span begin="1:04.430" end="1:04.960">図</span></p><p begin="1:05.460" end="1:11.500" itunes:key="L9" ttm:agent="v1"><span begin="1:05.460" end="1:07.430">食えない</span><span begin="1:07.780" end="1:09.060">恋だと</span><span begin="1:09.510" end="1:10.870">気付いて</span><span begin="1:10.870" end="1:11.500">る</span></p><p begin="1:11.730" end="1:16.880" itunes:key="L10" ttm:agent="v1"><span begin="1:11.730" end="1:13.120">それなのに</span><span begin="1:13.360" end="1:13.810">蜜の</span><span begin="1:13.810" end="1:14.630">香りに</span><span begin="1:14.820" end="1:15.810">誘われて</span><span begin="1:15.810" end="1:16.530">捕ま</span><span begin="1:16.530" end="1:16.880">る</span></p><p begin="1:16.880" end="1:19.970" itunes:key="L11" ttm:agent="v1"><span begin="1:16.880" end="1:18.500">私は</span><span begin="1:18.500" end="1:19.970">蝶</span></p><p begin="1:21.600" end="1:29.260" itunes:key="L12" ttm:agent="v1"><span begin="1:21.600" end="1:23.560">枯れない</span><span begin="1:24.020" end="1:25.140">愛を</span><span begin="1:25.620" end="1:27.720">巡らせて</span> <span begin="1:27.960" end="1:28.680">溶けて</span><span begin="1:28.680" end="1:28.970">いっ</span><span begin="1:28.970" end="1:29.260">た</span></p><p begin="1:29.430" end="1:36.170" itunes:key="L13" ttm:agent="v1"><span begin="1:29.430" end="1:30.210">切ない</span><span begin="1:30.210" end="1:30.800">時の</span><span begin="1:31.000" end="1:31.560">中で</span><span begin="1:31.560" end="1:32.470">貴方に</span><span begin="1:32.470" end="1:33.000">手を</span><span begin="1:33.000" end="1:34.790">伸ばして</span><span begin="1:34.790" end="1:34.980">い</span><span begin="1:34.980" end="1:36.170">く</span></p><p begin="1:36.660" end="1:38.990" itunes:key="L14" ttm:agent="v1"><span begin="1:36.660" end="1:38.060">舞えない</span><span begin="1:38.060" end="1:38.700">まま</span><span begin="1:38.700" end="1:38.990">で</span></p><p begin="1:41.780" end="1:49.390" itunes:key="L15" ttm:agent="v1"><span begin="1:41.780" end="1:44.050">欠けていく</span><span begin="1:44.050" end="1:45.540">太陽</span> <span begin="1:46.850" end="1:47.790">影に</span><span begin="1:47.790" end="1:48.960">飲まれて</span><span begin="1:48.960" end="1:49.110">い</span><span begin="1:49.110" end="1:49.390">く</span></p><p begin="1:49.932" end="1:57.460" itunes:key="L16" ttm:agent="v1"><span begin="1:49.932" end="1:51.220">瞳の</span><span begin="1:51.220" end="1:52.130">奥で</span><span begin="1:52.130" end="1:53.630">光った</span> <span begin="1:54.900" end="1:56.060">言葉に</span><span begin="1:56.060" end="1:57.150">縋</span><span begin="1:57.150" end="1:57.460">って</span></p><p begin="1:57.660" end="2:00.830" itunes:key="L17" ttm:agent="v1"><span begin="1:57.660" end="1:58.530">もうずっと</span><span begin="1:58.530" end="1:59.700">曖昧な</span><span begin="1:59.700" end="2:00.440">態度</span><span begin="2:00.440" end="2:00.830">で</span></p><p begin="2:01.710" end="2:05.550" itunes:key="L18" ttm:agent="v1"><span begin="2:01.710" end="2:03.500">繰り返しの</span><span begin="2:03.820" end="2:04.460">甘さに</span><span begin="2:04.460" end="2:05.330">浸</span><span begin="2:05.330" end="2:05.550">る</span></p><p begin="2:05.790" end="2:08.890" itunes:key="L19" ttm:agent="v1"><span begin="2:05.790" end="2:06.600">絡まった</span><span begin="2:06.600" end="2:07.130">嘘が</span><span begin="2:07.290" end="2:08.500">解けなく</span><span begin="2:08.500" end="2:08.890">て</span></p><p begin="2:09.650" end="2:13.620" itunes:key="L20" ttm:agent="v1"><span begin="2:09.650" end="2:11.580">沈んでいく</span><span begin="2:11.860" end="2:12.670">私が</span><span begin="2:12.670" end="2:13.350">いる</span><span begin="2:13.350" end="2:13.620">の</span></p><p begin="2:13.900" end="2:21.690" itunes:key="L21" ttm:agent="v1"><span begin="2:13.900" end="2:16.100">煤けた</span><span begin="2:16.100" end="2:17.720">憧れを</span><span begin="2:18.240" end="2:20.010">追いかけ</span><span begin="2:20.010" end="2:21.400">続けて</span><span begin="2:21.400" end="2:21.470">い</span><span begin="2:21.470" end="2:21.690">る</span></p><p begin="2:22.030" end="2:25.220" itunes:key="L22" ttm:agent="v1"><span begin="2:22.030" end="2:24.120">捨て切れない</span><span begin="2:24.120" end="2:25.000">想</span><span begin="2:25.000" end="2:25.220">い</span></p><p begin="2:25.640" end="2:33.960" itunes:key="L23" ttm:agent="v1"><span begin="2:25.640" end="2:26.890">暗い</span><span begin="2:26.890" end="2:27.800">道を</span><span begin="2:28.080" end="2:29.690">進ん</span><span begin="2:29.690" end="2:33.960">で</span></p><p begin="2:46.270" end="2:52.320" itunes:key="L24" ttm:agent="v1"><span begin="2:46.270" end="2:48.260">いらない</span><span begin="2:48.600" end="2:49.930">言葉が</span><span begin="2:50.320" end="2:51.540">溜まって</span><span begin="2:51.540" end="2:51.650">い</span><span begin="2:51.650" end="2:52.320">く</span></p><p begin="2:52.660" end="2:55.490" itunes:key="L25" ttm:agent="v1"><span begin="2:52.660" end="2:53.360">胸の</span><span begin="2:53.360" end="2:53.950">奥</span> <span begin="2:54.170" end="2:55.180">壊れそうな</span><span begin="2:55.180" end="2:55.490">程</span></p><p begin="2:55.710" end="3:04.858" itunes:key="L26" ttm:agent="v1"><span begin="2:55.710" end="2:56.670">膨らんだ</span><span begin="2:56.670" end="2:57.780">気持ちに</span><span begin="2:57.780" end="2:58.710">息が</span><span begin="2:58.990" end="3:00.440">出来な</span><span begin="3:00.440" end="3:01.520">いで</span><span begin="3:01.520" end="3:02.000">い</span><span begin="3:02.000" end="3:04.858">る</span></p><p begin="3:02.490" end="3:08.480" itunes:key="L27" ttm:agent="v1"><span begin="3:02.490" end="3:04.400">食えない</span><span begin="3:04.760" end="3:06.040">恋だと</span><span begin="3:06.480" end="3:07.850">気付いて</span><span begin="3:07.850" end="3:08.480">る</span></p><p begin="3:08.700" end="3:13.860" itunes:key="L28" ttm:agent="v1"><span begin="3:08.700" end="3:10.100">それなのに</span><span begin="3:10.330" end="3:10.780">蜜の</span><span begin="3:10.780" end="3:11.610">香りに</span><span begin="3:11.800" end="3:12.790">誘われて</span><span begin="3:12.790" end="3:13.510">捕ま</span><span begin="3:13.510" end="3:13.860">る</span></p><p begin="3:13.860" end="3:16.950" itunes:key="L29" ttm:agent="v1"><span begin="3:13.860" end="3:15.480">私は</span><span begin="3:15.480" end="3:16.950">蝶</span></p><p begin="3:18.590" end="3:26.230" itunes:key="L30" ttm:agent="v1"><span begin="3:18.590" end="3:20.570">枯れない</span><span begin="3:21.020" end="3:22.120">愛を</span><span begin="3:22.590" end="3:24.680">巡らせて</span> <span begin="3:24.930" end="3:25.740">溶けて</span><span begin="3:25.740" end="3:25.960">いっ</span><span begin="3:25.960" end="3:26.230">た</span></p><p begin="3:26.420" end="3:33.180" itunes:key="L31" ttm:agent="v1"><span begin="3:26.420" end="3:27.170">切ない</span><span begin="3:27.170" end="3:27.770">時の</span><span begin="3:27.980" end="3:28.550">中で</span><span begin="3:28.550" end="3:29.430">貴方に</span><span begin="3:29.430" end="3:29.970">手を</span><span begin="3:29.970" end="3:31.720">伸ばして</span><span begin="3:31.720" end="3:31.930">い</span><span begin="3:31.930" end="3:33.180">く</span></p><p begin="3:33.670" end="3:36.320" itunes:key="L32" ttm:agent="v1"><span begin="3:33.670" end="3:34.980">舞えない</span><span begin="3:34.980" end="3:35.640">まま</span><span begin="3:35.640" end="3:35.890">で</span><span begin="3:36.090" end="3:36.320">も</span></p></div></body></tt>