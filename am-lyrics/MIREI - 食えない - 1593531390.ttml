<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">辩解无数话语后的夜晚</text><text for="L2">在生活的间隙中若隐若现</text><text for="L3">讨厌何时都向大家微笑着</text><text for="L4">一副满足欣喜样子的你</text><text for="L5">显露那虚伪的心</text><text for="L6">做着取悦自己的梦</text><text for="L7">凛冽的寒风吹动着刘海</text><text for="L8">没有意义的接吻 没有温度的讯号</text><text for="L9">即使察觉到这是如此狡猾的恋爱</text><text for="L10">却仍因蜜的香甜陷入牢笼</text><text for="L11">我就是那翩翩之蝶</text><text for="L12">环绕着那份永不枯萎的爱 慢慢融化</text><text for="L13">于悲痛之际向你伸出双手</text><text for="L14">如此这般 再也无法舞动</text><text for="L15">被残缺之阳夺取身影</text><text for="L16">在眼眸深处紧紧拥住希望的话语</text><text for="L17">总是用着暧昧的态度</text><text for="L18">沉浸在反反复复的甜蜜之中</text><text for="L19">谎言缠绕 无法脱身</text><text for="L20">只有那个在渐渐下沉的我啊</text><text for="L21">继续追逐着昏暗渺小的憧憬</text><text for="L22">无法舍弃的思念</text><text for="L23">在黑暗的道路上继续前进</text><text for="L24">积攒了太多太多无用之词</text><text for="L25">内心深处早已到达崩溃边缘</text><text for="L26">渐渐膨胀的心情让我喘不过气</text><text for="L27">即使察觉到这是如此狡猾的恋爱</text><text for="L28">却仍因蜜的香甜陷入牢笼</text><text for="L29">我就是那翩翩之蝶</text><text for="L30">环绕着那份永不枯萎的爱 慢慢融化</text><text for="L31">于悲痛之际向你伸出双手</text><text for="L32">即使如此这般 再也无法舞动</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:17.750" end="0:24.750" itunes:key="L1" ttm:agent="v1"><span begin="0:17.750" end="0:18.040">言</span><span begin="0:18.040" end="0:18.330">い</span><span begin="0:18.330" end="0:19.120">訳</span><span begin="0:19.120" end="0:19.320">を</span><span begin="0:19.320" end="0:19.980">並</span><span begin="0:19.980" end="0:20.330">べ</span><span begin="0:20.330" end="0:22.030">た</span> <span begin="0:22.030" end="0:22.540">後</span><span begin="0:22.540" end="0:23.010">付</span><span begin="0:23.010" end="0:23.350">け</span><span begin="0:23.350" end="0:23.570">の</span><span begin="0:23.570" end="0:24.390">夜</span><span begin="0:24.390" end="0:24.750">が</span></p><p begin="0:24.900" end="0:32.760" itunes:key="L2" ttm:agent="v1"><span begin="0:24.900" end="0:26.340">生</span><span begin="0:26.340" end="0:27.170">活</span><span begin="0:27.170" end="0:27.370">の</span><span begin="0:27.370" end="0:27.990">隙</span><span begin="0:27.990" end="0:28.450">間</span><span begin="0:28.450" end="0:30.010">で</span> <span begin="0:30.010" end="0:30.500">見</span><span begin="0:30.500" end="0:30.660">え</span><span begin="0:30.660" end="0:31.450">隠</span><span begin="0:31.450" end="0:31.630">れ</span><span begin="0:31.630" end="0:32.090">し</span><span begin="0:32.090" end="0:32.210">て</span><span begin="0:32.210" end="0:32.510">い</span><span begin="0:32.510" end="0:32.760">る</span></p><p begin="0:32.910" end="0:36.200" itunes:key="L3" ttm:agent="v1"><span begin="0:32.910" end="0:33.080">い</span><span begin="0:33.080" end="0:33.240">つ</span><span begin="0:33.240" end="0:33.410">だ</span><span begin="0:33.410" end="0:33.470">っ</span><span begin="0:33.470" end="0:33.670">て</span><span begin="0:33.670" end="0:33.970">み</span><span begin="0:33.970" end="0:34.120">ん</span><span begin="0:34.120" end="0:34.470">な</span><span begin="0:34.470" end="0:34.750">に</span><span begin="0:34.750" end="0:34.830">微</span><span begin="0:34.830" end="0:35.160">笑</span><span begin="0:35.160" end="0:35.750">ん</span><span begin="0:35.750" end="0:36.200">で</span></p><p begin="0:36.850" end="0:40.840" itunes:key="L4" ttm:agent="v1"><span begin="0:36.850" end="0:37.490">満</span><span begin="0:37.490" end="0:38.070">足</span><span begin="0:38.070" end="0:38.500">気</span><span begin="0:38.500" end="0:39.020">な</span><span begin="0:39.020" end="0:39.140">貴</span><span begin="0:39.140" end="0:39.510">方</span><span begin="0:39.510" end="0:39.700">が</span><span begin="0:39.700" end="0:40.400">嫌</span><span begin="0:40.400" end="0:40.840">い</span></p><p begin="0:40.980" end="0:44.140" itunes:key="L5" ttm:agent="v1"><span begin="0:40.980" end="0:41.450">偽</span><span begin="0:41.450" end="0:41.540">っ</span><span begin="0:41.540" end="0:41.740">た</span><span begin="0:41.740" end="0:42.560">心</span><span begin="0:42.560" end="0:42.740">を</span><span begin="0:42.740" end="0:43.150">覗</span><span begin="0:43.150" end="0:43.490">か</span><span begin="0:43.490" end="0:43.770">せ</span><span begin="0:43.770" end="0:44.140">て</span></p><p begin="0:44.900" end="0:48.970" itunes:key="L6" ttm:agent="v1"><span begin="0:44.900" end="0:45.270">都</span><span begin="0:45.270" end="0:45.810">合</span><span begin="0:45.810" end="0:46.160">の</span><span begin="0:46.160" end="0:46.350">い</span><span begin="0:46.350" end="0:46.970">い</span><span begin="0:46.970" end="0:47.370">夢</span><span begin="0:47.370" end="0:47.540">を</span><span begin="0:47.540" end="0:47.850">み</span><span begin="0:47.850" end="0:48.250">て</span><span begin="0:48.250" end="0:48.610">る</span><span begin="0:48.610" end="0:48.970">の</span></p><p begin="0:49.220" end="0:56.980" itunes:key="L7" ttm:agent="v1"><span begin="0:49.220" end="0:50.290">冷</span><span begin="0:50.290" end="0:50.870">た</span><span begin="0:50.870" end="0:51.200">い</span><span begin="0:51.200" end="0:52.130">風</span><span begin="0:52.130" end="0:52.370">が</span><span begin="0:52.370" end="0:52.630">吹</span><span begin="0:52.630" end="0:53.250">き</span> <span begin="0:53.250" end="0:54.410">前</span><span begin="0:54.410" end="0:55.280">髪</span><span begin="0:55.280" end="0:55.560">が</span><span begin="0:55.560" end="0:56.190">揺</span><span begin="0:56.190" end="0:56.400">れ</span><span begin="0:56.400" end="0:56.640">て</span><spa