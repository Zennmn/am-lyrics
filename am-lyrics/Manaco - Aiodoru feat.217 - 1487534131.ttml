<span begin="0:23.097" end="0:23.477">i de</span></text><text for="L6"><span begin="0:23.737" end="0:24.017">oto</span><span begin="0:24.017" end="0:24.817">gi</span><span begin="0:24.817" end="0:25.727">banashi </span><span begin="0:25.727" end="0:25.957">ja </span><span begin="0:25.957" end="0:26.177">na</span><span begin="0:26.177" end="0:26.337">i </span><span begin="0:26.337" end="0:26.767">no</span></text><text for="L7"><span begin="0:26.942" end="0:27.342">me i</span><span begin="0:27.342" end="0:27.729">ku ap pu </span><span begin="0:27.729" end="0:28.092">O</span><span begin="0:28.092" end="0:28.402">K</span> <span begin="0:28.402" end="0:29.012">kane </span><span begin="0:29.012" end="0:29.362">ga </span><span begin="0:29.362" end="0:29.742">na</span><span begin="0:29.742" end="0:30.252">ru </span><span begin="0:30.662" end="0:31.122">kaku</span><span begin="0:31.122" end="0:31.412">go </span><span begin="0:31.412" end="0:31.702">shi</span><span begin="0:31.702" end="0:32.182">te</span></text><text for="L8"><span begin="0:32.613" end="0:32.803">odo</span><span begin="0:32.803" end="0:32.993">ri</span><span begin="0:32.993" end="0:33.103">ma</span><span begin="0:33.103" end="0:33.453">shou</span></text><text for="L9"><span begin="0:33.600" end="0:33.890">Do</span> <span begin="0:33.890" end="0:34.230">you</span> <span begin="0:34.230" end="0:34.660">love</span> <span begin="0:34.660" end="0:34.840">me?</span> <span begin="0:34.840" end="0:35.210">nee </span><span begin="0:35.210" end="0:35.520">Tell</span> <span begin="0:35.520" end="0:35.870">me</span> <span begin="0:35.870" end="0:36.300">Ba</span><span begin="0:36.300" end="0:36.890">by</span> <span begin="0:36.890" end="0:37.270">ba</span><span begin="0:37.270" end="0:37.730">ra </span><span begin="0:37.730" end="0:38.010">no </span><span begin="0:38.010" end="0:38.780">hana </span><span begin="0:38.780" end="0:39.290">o </span><span begin="0:39.500" end="0:39.810">so</span><span begin="0:39.810" end="0:39.960">me</span><span begin="0:39.960" end="0:40.220">te</span></text><text for="L10"><span begin="0:40.213" end="0:40.493">Do</span> <span begin="0:40.493" end="0:40.853">you</span> <span begin="0:40.853" end="0:41.283">love</span> <span begin="0:41.283" end="0:41.453">me?</span> <span begin="0:41.453" end="0:41.843">nee </span><span begin="0:41.843" end="0:42.193">Give</span> <span begin="0:42.193" end="0:42.503">me</span> <span begin="0:42.503" end="0:42.913">Ba</span><span begin="0:42.913" end="0:43.543">by</span> <span begin="0:43.733" end="0:43.903">ki </span><span begin="0:43.903" end="0:44.283">ga </span><span begin="0:44.283" end="0:44.633">su</span><span begin="0:44.633" end="0:44.973">mu </span><span begin="0:44.973" end="0:45.173">ma</span><span begin="0:45.173" end="0:46.233">de</span></text><text for="L11"><span begin="0:46.229" end="0:46.479">o</span><span begin="0:46.479" end="0:46.599">i</span><span begin="0:46.599" end="0:46.789">ka</span><span begin="0:46.789" end="0:47.089">ke</span><span begin="0:47.089" end="0:47.399">ru </span><span begin="0:47.629" end="0:48.679">futari </span><span begin="0:48.679" end="0:49.139">kasa</span><span begin="0:49.139" end="0:49.539">nat</span><span begin="0:49.539" end="0:49.729">te </span><span begin="0:49.729" end="0:49.979">mo </span><span begin="0:49.979" end="0:50.109">to</span><span begin="0:50.109" end="0:50.389">ke</span><span begin="0:50.389" end="0:50.639">na</span><span begin="0:50.639" end="0:50.939">i ma</span><span begin="0:50.939" end="0:51.519">hou </span><span begin="0:51.519" end="0:52.119">o </span><span ttm:role="x-bg"><span begin="0:51.653" end="0:52.323">(tona</span><span begin="0:52.323" end="0:52.536">e</span><span begin="0:52.536" end="0:53.294">te)</span></span></text><text for="L12"><span begin="0:52.961" end="0:54.094">scroll </span><span begin="0:54.094" end="0:54.734">naga</span><span begin="0:54.734" end="0:54.894">re</span><span begin="0:54.894" end="0:55.124">te </span><span begin="0:55.124" end="0:55.364">i</span><span begin="0:55.364" end="0:55.804">ru </span><span begin="0:55.804" end="0:56.124">ai </span><span begin="0:56.124" end="0:56.784">ja </span><span begin="0:57.004" end="0:57.154">mi</span><span begin="0:57.154" end="0:57.534">ta</span><span begin="0:57.534" end="0:57.894">sa</span><span begin="0:57.894" end="0:58.174">re</span><span begin="0:58.174" end="0:58.424">ta</span><span begin="0:58.424" end="0:59.564">ri </span><span begin="0:59.564" end="0:59.864">shi</span><span begin="0:59.864" end="1:00.624">nai</span></text><text for="L13"><span begin="1:06.684" end="1:07.564">tsukan</span><span begin="1:07.564" end="1:07.814">da </span><span begin="1:07.814" end="1:08.124">te </span><span begin="1:08.124" end="1:08.602">de </span><span ttm:role="x-bg"><span begin="1:08.444" end="1:08.924">(Yeah</span> <span begin="1:08.924" end="1:09.474">Trust</span> <span begin="1:09.474" end="1:10.074">me)</span></span></text><text for="L14"><span begin="1:10.044" end="1:10.434">kan</span><span begin="1:10.434" end="1:10.654">ji</span><span begin="1:10.654" end="1:10.804">ru </span><span begin="1:10.804" end="1:11.174">ko</span><span begin="1:11.174" end="1:12.234">dou </span><span ttm:role="x-bg"><span begin="1:11.753" end="1:12.063">(Sto</span><span begin="1:12.063" end="1:12.323">ry</span><span begin="1:12.323" end="1:12.433">no </span><span begin="1:12.433" end="1:12.693">shu</span><span begin="1:12.693" end="1:13.133">yaku </span><span begin="1:13.133" end="1:13.623">wa…)</span></span></text><text for="L15"><span begin="1:13.126" end="1:14.126">futari</span><span begin="1:14.126" end="1:14.496">ki</span><span begin="1:14.496" end="1:14.726">ri </span><span begin="1:14.726" end="1:15.426">no </span><span ttm:role="x-bg"><span begin="1:15.152" end="1:15.662">(Everybody</span> <span begin="1:15.662" end="1:16.202">deserves</span> <span begin="1:16.202" end="1:17.262">true</span> <span begin="1:17.262" end="1:17.602">love)</span></span></tex