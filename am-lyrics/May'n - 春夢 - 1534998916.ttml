<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">May'n</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">粲然盛开的樱花纷飞飘落时</text><text for="L2">你也随之吟唱</text><text for="L3">在这片樱色的思念尽头</text><text for="L4">让人情不自禁</text><text for="L5">为之沉溺</text><text for="L6">却倍感孤独</text><text for="L7">仿佛要喷涌而出</text><text for="L8">对你的怜爱之情</text><text for="L9">超越时空 变得具象化</text><text for="L10">我也不禁沉沦</text><text for="L11">成千上万次</text><text for="L12">你的发丝随风飘扬</text><text for="L13">成千上万次</text><text for="L14">你都不曾为我等候</text><text for="L15">从地平线太阳升起的地方又会开始新的一天</text><text for="L16">就此约定吧</text><text for="L17">似乎就要失去你</text><text for="L18">让我无比悲伤</text><text for="L19">明明就要将心意传达</text><text for="L20">却最终还是分开了</text><text for="L21">都成为了沉没于海底的宝物</text><text for="L22">成千上万次</text><text for="L23">听到你的声音</text><text for="L24">成千上万次</text><text for="L25">想要走进你的视线</text><text for="L26">如果今夜就要结束 那么就在明天</text><text for="L27">将今天无数次的重复</text><text for="L28">成千上万次</text><text for="L29">想要触碰你的手指</text><text for="L30">成千上万次</text><text for="L31">想要依偎着你的肩膀</text><text for="L32">在平行线的现在也迎来了新的一天</text><text for="L33">无数次地开始新的一天</text><text for="L34">回旋的春之梦</text><text for="L35">请不要让我独自醒来</text><text for="L36">春风的孤独尽头</text><text for="L37">是无尽的寂寥</text><text for="L38">眼前是樱花粲然盛放</text><text for="L39">耳边是你轻声吟唱</text><text for="L40">漫天飞舞的樱花</text><text for="L41">属于你的春天就此开始</text><text for="L42">再见了</text><text for="L43">今夜也多亏了你</text><text for="L44">这大概是最后一次了吧</text><text for="L45">是多么的开心</text><text for="L46">多么的欢乐</text><text for="L47">你也展颜欢笑了吧</text><text for="L48">而我差不多要就此前行了</text><text for="L49">下次再会吧</text><text for="L50">我依旧等待春天</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:08.420" end="0:14.450" itunes:key="L1" ttm:agent="v1"><span begin="0:08.420" end="0:09.120">誉</span><span begin="0:09.120" end="0:09.330">れ</span><span begin="0:09.330" end="0:10.190">誉</span><span begin="0:10.190" end="0:10.820">れ</span><span begin="0:10.820" end="0:10.970">と</span><span begin="0:10.970" end="0:11.290">咲</span><span begin="0:11.290" end="0:11.560">く</span><span begin="0:11.560" end="0:12.380">花</span><span begin="0:12.380" end="0:13.040">散</span><span begin="0:13.040" end="0:13.320">る</span><span begin="0:13.320" end="0:13.880">頃</span><span begin="0:13.880" end="0:14.450">に</span></p><p begin="0:14.480" end="0:16.670" itunes:key="L2" ttm:agent="v1"><span begin="0:14.480" end="0:14.710">貴</span><span begin="0:14.710" end="0:15.330">方</span><span begin="0:15.330" end="0:15.680">が</span><span begin="0:15.680" end="0:16.230">歌</span><span begin="0:16.230" end="0:16.670">う</span></p><p begin="0:17.450" end="0:22.000" itunes:key="L3" ttm:agent="v1"><span begin="0:17.450" end="0:18.440">桜</span><span begin="0:18.440" end="0:19.840">色</span><span begin="0:19.840" end="0:19.870">、</span><span begin="0:19.870" end="0:20.150">想</span><span begin="0:20.150" end="0:20.430">い</span><span begin="0:20.430" end="0:20.630">の</span><span begin="0:20.630" end="0:20.930">果</span><span begin="0:20.930" end="0:21.460">て</span><span begin="0:21.460" end="0:22.000">に</span></p><p begin="0:22.050" end="0:25.890" itunes:key="L4" ttm:agent="v1"><span begin="0:22.050" end="0:22.690">息</span><span begin="0:22.690" end="0:22.920">は</span><span begin="0:22.920" end="0:23.510">も</span><span begin="0:23.510" end="0:23.840">つ</span><span begin="0:23.840" end="0:24.690">れ</span><span begin="0:24.690" end="0:24.780">て</span><span begin="0:24.780" end="0:25.320">い</span><span begin="0:25.320" end="0:25.540">っ</span><span begin="0:25.540" end="0:25.890">た</span></p><p begin="0:26.620" end="0:28.630" itunes:key="L5" ttm:agent="v1"><span begin="0:26.620" end="0:27.210">溺</span><span begin="0:27.210" end="0:27.420">れ</span><span begin="0:27.420" end="0:27.550">そ</span><span begin="0:27.550" end="0:27.900">う</span><span begin="0:27.900" end="0:28.190">だ</span><span begin="0:28.190" end="0:28.360">っ</span><span begin="0:28.360" end="0:28.630">た</span></p><p begin="0:28.790" end="0:30.980" itunes:key="L6" ttm:agent="v1"><span begin="0:28.790" end="0:29.380">寂</span><span begin="0:29.380" end="0:29.730">し</span><span begin="0:29.730" end="0:30.010">か</span><span begin="0:30.010" end="0:30.170">っ</span><span begin="0:30.170" end="0:30.450">た</span><span begin="0:30.450" end="0:30.630">ん</span><span begin="0:30.630" end="0:30.980">だ</span></p><p begin="0:31.130" end="0:33.130" itunes:key="L7" ttm:agent="v1"><span begin="0:31.130" end="0:31.720">溢</span><span begin="0:31.720" end="0:31.950">れ</span><span begin="0:31.950" end="0:32.090">そ</span><span begin="0:32.090" end="0:32.440">う</span><span begin="0:32.440" end="0:32.700">だ</span><span begin="0:32.700" end="0:32.880">っ</span><span begin="0:32.880" end="0:33.130">た</span></p><p begin="0:33.420" end="0:35.430" itunes:key="L8" ttm:agent="v1"><span begin="0:33.420" end="0:33.900">愛</span><span begin="0:33.900" end="0:34.280">し</span><span begin="0:34.280" end="0:34.600">か</span><span begin="0:34.600" end="0:34.730">っ</span><span begin="0:34.730" end="0:34.990">た</span><span begin="0:34.990" end="0:35.130">ん</span><span begin="0:35.130" end="0:35.430">だ</span></p><p begin="0:35.650" end="0:39.930" itunes:key="L9" ttm:agent="v1"><span begin="0:35.650" end="0:36.280">時</span><span begin="0:36.280" end="0:36.860">を</span><span begin="0:36.860" end="0:37.190">超</span><span begin="0:37.190" end="0:37.390">え</span><span begin="0:37.390" end="0:37.990">て</span><span begin="0:37.990" end="0:39.120">形</span><span begin="0:39.120" end="0:39.380">と</span><span begin="0:39.380" end="0:39.660">な</span><span begin="0:39.660" end="0:39.930">り</span></p><p begin="0:40.170" end="0:43.460" itunes:key="L10" ttm:agent="v1"><span begin="0:40.170" end="0:41.540">私</span><span begin="0:41.540" end="0:41.810">は</span><span begin="0:41.810" end="0:42.960">沈</span><span begin="0:42.960" end="0:43.460">む</span></p></div><div itunes:song-part="PreChorus"><p begin="0:45.530" end="0:47.860" itunes:key="L11" ttm:agent="v1"><span begin="0:45.530" end="0:45.900">何</span><span begin="0:45.900" end="0:46.180">千</span><span begin="0:46.180" end="0:46.460">何</span><span begin="0:46.460" end="0:46.740">万</span><span begin="0:46.740" end="0:47.030">回</span><span begin="0:47.030" end="0:47.210">だ</span><span begin="0:47.210" end="0:47.330">っ</span><span begin="0:47.330" end="0:47.860">て</span></p><p begin="0:47.890" end="0:49.840" itunes:key="L12" ttm:agent="v1"><span begin="0:47.890" end="0:48.070">貴</span><span begin="0:48.070" end="0:48.320">方</span><span begin="0:48.320" end="0:48.460">の</span><span begin="0:48.460" end="0:48.740">髪</span><span begin="0:48.740" end="0:48.890">が</span><span begin="0:48.890" end="0:49.040">揺</span><span begin="0:49.040" end="0:49.190">れ</span><span begin="0:49.190" end="0:49.290">て</span><span begin="0:49.290" end="0:49.460">る</span><span begin="0:49.460" end="0:49.570">ん</span><span begin="0:49.570" end="0:49.840">だ</span></p><p begin="0:50.050" end="0:52.400" itunes:key="L13" ttm:agent="v1"><span begin="0:50.050" end="0:50.430">何</span><span begin="0:50.430" end="0:50.700">千</span><span begin="0:50.700" end="0:50.980">何</span><span begin="0:50.980" end="0:51.250">万</span><span begin="0:51.250" end="0:51.550">回</span><span begin="0:51.550" end="0:51.720">だ</span><span begin="0:51.720" end="0:51.830">っ</span><span begin="0:51.830" end="0:52.400">て</span></p><p begin="0:52.430" end="0:54.520" itunes:key="L14" ttm:agent="v1"><span begin="0:52.430" end="0:52.600">貴</span><span begin="0:52.600" end="0:52.790">方</span><span begin="0:52.790" end="0:52.980">は</span><span begin="0:52.980" end="0:53.190">待</span><span begin="0:53.190" end="0:53.250">っ</span><span begin="0:53.250" end="0:53.360">て</span><span begin="0:53.360" end="0:53.570">や</span><span begin="0:53.570" end="0:53.700">く</span><span begin="0:53.700" end="0:53.830">れ</span><span begin="0:53.830" end="0:54.040">な</span><span begin="0:54.040" end="0:54.150">い</span><span begin="0:54.150" end="0:54.520">や</span></p><p begin="0:54.580" end="0:58.400" itunes:key="L15" ttm:agent="v1"><span begin="0:54.580" end="0:54.920">水</span><span begin="0:54.920" end="0:55.190">平</span><span begin="0:55.190" end="0:55.540">線</span><span begin="0:55.540" end="0:55.860">の</span><span begin="0:55.860" end="0:56.400">上</span><span begin="0:56.400" end="0:56.670">か</span><span begin="0:56.670" end="0:56.880">ら</span><span begin="0:56.880" end="0:57.230">ま</span><span begin="0:57.230" end="0:57.590">た</span><span begin="0:57.590" end="0:57.710">明</span><span begin="0:57.710" end="0:58.400">日</span></p><p begin="0:58.570" end="1:03.610" itunes:key="L16" ttm:agent="v1"><span begin="0:58.570" end="0:59.090">え</span><span begin="0:59.090" end="0:59.160">え</span><span begin="0:59.160" end="0:59.860">約</span><span begin="0:59.860" end="1:01.300">束</span><span begin="1:01.300" end="1:03.610">よ</span></p></div><div itunes:song-part="Verse"><p begin="1:11.930" end="1:13.960" itunes:key="L17" ttm:agent="v1"><span begin="1:11.930" end="1:12.180">失</span><span begin="1:12.180" end="1:12.400">く</span><span begin="1:12.400" end="1:12.720">し</span><span begin="1:12.720" end="1:12.840">そ</span><span begin="1:12.840" end="1:13.190">う</span><span begin="1:13.190" end="1:13.450">だ</span><span begin="1:13.450" end="1:13.640">っ</span><span begin="1:13.640" end="1:13.960">た</span></p><p begin="1:14.140" end="1:16.200" itunes:key="L18" ttm:agent="v1"><span begin="1:14.140" end="1:14.660">悲</span><span begin="1:14.660" end="1:15.010">