<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Michita</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">在这座桥的另一端</text><text for="L2">若是喜悦便代表夏日的来临</text><text for="L3">便能在微风的轻拂中感受到痛楚</text><text for="L4">此刻可以尽情哭泣</text><text for="L5">为我落泪吧</text><text for="L6">可时光终究在流逝</text><text for="L7">痛楚一次次地</text><text for="L8">将我的心就此撕裂开来</text><text for="L9">希望新增的羽翼以及遗失的希望</text><text for="L10">都能在未来成就与众不同的我</text><text for="L11">背负孤独 然后自己将心灵上了锁</text><text for="L12">我因有所失去对得到心有畏惧</text><text for="L13">追循滴落的声音</text><text for="L14">因为其中有我最为真挚的笑容</text><text for="L15">唯有这才是我的向往</text><text for="L16">在这座桥的另一端</text><text for="L17">若是喜悦便代表夏日的来临</text><text for="L18">便能在微风的轻拂中感受到痛楚</text><text for="L19">此刻可以尽情哭泣</text><text for="L20">为我落泪吧</text><text for="L21">思念所珍爱的人</text><text for="L22">为衰老死亡的到来而哭泣</text><text for="L23">可以因为寂寞而哭泣</text><text for="L24">可以因为喜悦而哭泣</text><text for="L25">我会为了我自己而哭泣</text><text for="L26">滴落的泪水对未来倾诉</text><text for="L27">满溢的思念让花朵绚烂绽放</text><text for="L28">展开羽翼直至那天到来</text><text for="L29">待到暴风雨结束肆虐那天</text><text for="L30">在这座桥的另一端</text><text for="L31">若是喜悦便代表夏日的来临</text><text for="L32">便能在微风的轻拂中感受到痛楚</text><text for="L33">此刻可以尽情哭泣</text><text for="L34">为我落泪吧</text><text for="L35">在这座桥的另一端</text><text for="L36">若是喜悦便代表夏日的来临</text><text for="L37">全都是为了我</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Cry For Me (feat. Ami)"/><amll:meta key="artists" value="Michita"/><amll:meta key="album" value="Cry For Me (feat. Ami) - Single"/><amll:meta key="appleMusicId" value="675919330"/><amll:meta key="appleMusicId" value="1795032540"/><amll:meta key="isrc" value="FR2X42529225"/></metadata></head><body><div begin="0:43.369" end="3:55.490"><p begin="0:43.369" end="0:48.608" itunes:key="L1" ttm:agent="v1"><span begin="0:43.369" end="0:44.017">この</span><span begin="0:44.017" end="0:44.729">橋</span><span begin="0:44.729" end="0:46.049">の</span><span begin="0:46.049" end="0:46.737">向</span><span begin="0:46.737" end="0:47.425">こう</span><span begin="0:47.425" end="0:48.608">に</span></p><p begin="0:48.608" end="0:53.821" itunes:key="L2" ttm:agent="v1"><span begin="0:48.608" end="0:49.600">喜</span><span begin="0:49.600" end="0:49.992">び</span><span begin="0:49.992" end="0:50.640">が</span> <span begin="0:50.640" end="0:51.200">あ</span> <span begin="0:51.200" end="0:52.208">なつの</span><span begin="0:52.208" end="0:52.712">な</span><span begin="0:52.712" end="0:53.136">ら</span> <span begin="0:53.136" end="0:53.821">あ</span></p><p begin="0:53.917" end="0:58.741" itunes:key="L3" ttm:agent="v1"><span begin="0:53.917" end="0:56.493">風縁</span> <span begin="0:56.493" end="0:57.149">痛み</span><span begin="0:57.149" end="0:57.341">は</span><span begin="0:57.341" end="0:57.629">感</span><span begin="0:57.629" end="0:57.845">じ</span><span begin="0:57.845" end="0:58.741">て</span></p><p begin="0:59.049" end="1:02.337" itunes:key="L4" ttm:agent="v1"><span begin="0:59.049" end="0:59.921">今</span><span begin="0:59.921" end="1:00.321">は</span><span begin="1:00.321" end="1:00.746">泣い</span><span begin="1:00.746" end="1:01.065">て</span><span begin="1:01.065" end="1:01.433">も</span><span begin="1:01.433" end="1:02.337">いい</span></p><p begin="1:02.337" end="1:04.298" itunes:key="L5" ttm:agent="v1"><span begin="1:02.337" end="1:02.737">Cry</span> <span begin="1:02.737" end="1:03.131">for</span> <span begin="1:03.131" end="1:04.298">me</span></p><p begin="1:04.298" end="1:06.943" itunes:key="L6" ttm:agent="v2"><span begin="1:04.298" en