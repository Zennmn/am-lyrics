<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">松原みき</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.300"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">（给你 是的 我的爱都给你）</text><text for="L2">（是的 我的爱都给你 给你 都给你）</text><text for="L3">我就是我 你就是你</text><text for="L4">仿佛昨夜听你这样说过</text><text for="L5">灰色夹克上 我一眼便认出了</text><text for="L6">那抹咖啡渍</text><text for="L7">还是一点没变呢</text><text for="L8">当橱窗映出我们两人</text><text for="L9">留在我身边吧</text><text for="L10">叩响午夜之门</text><text for="L11">那个哭着求你别走的季节 如今</text><text for="L12">又浮现在眼前</text><text for="L13">陪着我吧</text><text for="L14">念着那句说惯了的话</text><text for="L15">怀抱着属于两人的时光 至今未曾忘却</text><text for="L16">仍珍藏在心</text><text for="L17">恋与爱并不是一回事</text><text for="L18">仿佛昨夜你曾这样对我说</text><text for="L19">第二个冬天来临 你的心也渐渐远去</text><text for="L20">每每回首 总觉得你依然在那里</text><text for="L21">留在我身边吧</text><text for="L22">叩响午夜之门</text><text for="L23">那个让心里空了一块的季节 如今</text><text for="L24">又浮现在眼前</text><text for="L25">陪陪我吧</text><text for="L26">只为排遣寂寞</text><text for="L27">唱针落在唱片上 同一段旋律一遍遍回响</text><text for="L28">留在我身边吧</text><text for="L29">叩响午夜之门</text><text for="L30">那个哭着求你别走的季节 如今</text><text for="L31">又浮现在眼前</text><text for="L32">陪着我吧</text><text for="L33">念着那句说惯了的话</text><text for="L34">怀抱着属于两人的时光 至今未曾忘却</text><text for="L35">仍在心底温存</text><text for="L36">留在我身边吧</text><text for="L37">叩响午夜之门</text><text for="L38">那个哭着求你别走的季节 如今</text><text for="L39">又浮现在眼前</text><text for="L40">陪着我吧</text><text for="L41">念着那句说惯了的话</text><text for="L42">怀抱着属于两人的时光 至今未曾忘却</text><text for="L43">仍在心底温存</text><text for="L44">留在我身边吧</text><text for="L45">叩响午夜之门</text><text for="L46">那个哭着求你别走的季节 如今</text><text for="L47">（又浮现在眼前）</text><text for="L48">（留在我身边）</text></translation></translations><songwriters><songwriter>林哲司</songwriter><songwriter>三浦徳子</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="5:11.720"><div begin="0.323" end="18.979" itunes:songPart="Intro"><p begin="0.323" end="7.153" itunes:key="L1" ttm:agent="v1"><span begin="0.323" end="0.768">(To</span> <span begin="0.768" end="2.678">you,</span> <span begin="2.886" end="3.476">yes</span> <span begin="3.476" end="3.833">my</span> <span begin="3.833" end="4.553">love</span> <span begin="4.553" end="4.841">to</span> <span begin="4.841" end="7.153">you)</span></p><p begin="7.259" end="18.979" itunes:key="L2" ttm:agent="v1"><span begin="7.259" end="7.915">(Yes</span> <span begin="7.915" end="8.331">my</span> <span begin="8.331" end="8.954">love</span> <span begin="8.954" end="9.340">to</span> <span begin="9.340" end="11.602">you,</span> <span begin="11.602" end="13.522">you,</span> <span begin="13.739" end="13.948">to</span> <span begin="13.948" end="18.979">you)</span></p></div><div begin="23.188" end="38.037" itunes:songPart="Verse"><p begin="23.188" end="29.442" itunes:key="L3" ttm:agent="v1"><span begin="23.188" end="23.838">私</span><span begin="23.838" end="24.334">は</span><span begin="24.334" end="25.093">私</span> <span begin="25.342" end="25.608">貴</span><span begin="25.608" end="26.081">方</span><span begin="26.081" end="26.482">は</span><span begin="26.482" end="26.754">貴</span><span begin="26.754" end="27.247">方</span><span begin="27.247" end="29.442">と</span></p><p begin="32.045" end="38.037" itunes:key="L4" ttm:agent="v1"><span begin="32.045" end="32.750">昨夜</span><span begin="32.750" end="33.372">言っ</span><span begin="33.372" end="33.622">て</span><span begin="33.622" end="34.098">た</span> <span begin="34.242" end="34.944">そんな</span><span begin="34.944" end="36.120">気もする</span><span begin="36.120" end="38.037">わ</span></p></div><div begin="40.804" end="1:00.038" itunes:songPart="Verse"><p begin="40.804" end="46.595" itunes:key="L5" ttm:agent="v1"><span begin="40.804" end="41.944">グレイの</span><span begin="41.944" end="43.198">ジャケット</span><span begin="43.198" end="44.399">に</span><span begin="44.399" end="44.882">見</span><span begin="44.882" end="45.761">覚えが</span><span begin="45.761" end="46.025">あ</span><span begin="46.025" end="46.595">る</span></p><p begin="46.604" end="49.582" itunes:key="L6" ttm:agent="v1"><span begin="46.604" end="47.233">コー</span><span begin="47.233" end="47.993">ヒーの</span><span begin="47.993" end="48.370">し</span><span begin="48.370" end="49.582">み</span></p><p begin="49.738" end="53.338" itunes:key="L7" ttm:agent="v1"><span begin="49.738" end="50.298">相</span><span begin="50.298" end="51.629">変らずな</span><span begin="51.629" end="52.082">の</span><span begin="52.082" end="53.338">ね</span></p><p begin="53.348" end="1:00.038" itunes:key="L8" ttm:agent="v1"><span begin="53.348" end="53.897">ショー</span><span begin="53.897" end="54.446">ウィン</span><span begin="54.446" end="54.890">ドウ</span><span begin="54.890" end="55.438">に</span><span begin="55.522" end="56.368">二人</span><span begin="56.368" end="56.925">映</span><span begin="56.925" end="57.166">れ</span><span begin="57.166" end="1:00.038">ば</span></p></div><div begin="1:00.969" end="1:40.824" itunes:songPart="Chorus"><p begin="1:00.969" end="1:03.547" itunes:key="L9" ttm:agent="v1"><span begin="1:00.969" end="1:01.609">Stay with</span> <span begin="1:01.609" end="1:03.547">me</span></p><p begin="1:03.557" end="1:07.907" itunes:key="L10" ttm:agent="v1"><span begin="1:03.557" end="1:04.868">真夜中の</span><span begin="1:04.868" end="1:05.457">ドアを</span><span begin="1:05.457" end="1:05.930">たた</span><span begin="1:05.930" end="1:07.907">き</span></p><p begin="1:08.016" end="1:17.232" itunes:key="L11" ttm:agent="v1"><span begin="1:08.016" end="1:09.804">帰らないで</span><span begin="1:09.804" end="1:10.142">と</span><span begin="1:10.142" end="1:10.653">泣い</span><span begin="1:10.653" end="1:14.370">た</span><span begin="1:14.370" end="1:14.972">あの</span><span begin="1:14.972" end="1:16.509">季節が</span> <span begin="1:16.509" end="1:17.232">今</span></p><p begin="1:17.232" end="1:18.727" itunes:key="L12" ttm:agent="v1"><span begin="1:17.232" end="1:17.732">目の</span><span begin="1:17.732" end="1:18.727">前</span></p><p begin="1:18.737" end="1:21.315" itunes:key="L13" ttm:agent="v1"><span begin="1:18.737" end="1:19.377">Stay with</span> <span begin="1:19.377" end="1:21.315">me</span></p><p begin="1:21.335" end="1:25.749" itunes:key="L14" ttm:agent="v1"><span begin="1:21.335" end="1:22.658">口ぐせを</span><span begin="1:22.658" end="1:23.736">言いなが</span><span begin="1:23.736" end="1:25.749">ら</span></p><p begin="1:25.758" end="1:34.299" itunes:key="L15" ttm:agent="v1"><span begin="1:25.758" end="1:26.815">二人の</span><span begin="1:26.815" end="1:27.477">瞬間</span><span begin="1:27.477" end="1:27.974">を</span><span begin="1:27.974" end="1:28.447">抱い</span><span begin="1:28.447" end="1:31.584">て</span><span begin="1:32.118" end="1:32.649">まだ</span><span begin="1:32.649" end="1:33.520">忘れ</span><span begin="1:33.520" end="1:34.299">ず</span></p><p begin="1:34.308" end="1:40.824" itunes:key="L16" ttm:agent="v1"><span begin="1:34.308" end="1:35.386">大事に</span><span begin="1:35.386" end="1:35.725">し</span><span begin="1:35.725" end="1:36.452">て</span><span begin="1:36.452" end="1:37.048">い</span><span begin="1:37.048" end="1:40.824">た</span></p></div><div begin="1:46.243" end="2:01.288" itunes:songPart="Verse"><p begin="1:46.243" end="1:51.863" itunes:key="L17" ttm:agent="v1"><span begin="1:46.243" end="1:47.056">恋と</span><span begin="1:47.056" end="1:48.238">愛とは</span><span begin="1:48.453" end="1:50.347">違うものだよ</span><span begin="1:50.347" end="1:51.863">と</span></p><p begin="1:55.173" end="2:01.288" itunes:key="L18" ttm:agent="v1"><span begin="1:55.173" end="1:55.914">昨夜</span><span begin="1:55.914" end="1:56.715">言われ</span><span begin="1:56.715" end="1:57.287">た</span><span begin="1:57.287" end="1:58.070">そんな</span><span begin="1:58.070" end="1:59.235">気もす