<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Brent Kutzle</songwriter><songwriter>Ryan Tedder</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">你会来拯救我吗</text><text for="L2">做我坚强的后盾</text><text for="L3">你会不会接受分崩离析的我</text><text for="L4">你会来拯救我吗</text><text for="L5">你会来拯救我吗</text><text for="L6">当我独自一人</text><text for="L7">需要你的爱与帮助</text><text for="L8">你会来拯救我吗</text><text for="L9">你会来拯救我吗</text><text for="L10">我们不再沟通</text><text for="L11">摔碎酒瓶 夺门而出</text><text for="L12">但我们心里还有彼此</text><text for="L13">我们依然想着对方</text><text for="L14">当欢声笑语不再</text><text for="L15">我依旧怀念那些过往</text><text for="L16">我们相互扶持</text><text for="L17">是彼此的希望</text><text for="L18">如今我不禁开始怀疑</text><text for="L19">如果我正渐渐沉沦，沉沦</text><text for="L20">你会来拯救我吗</text><text for="L21">做我坚强的后盾</text><text for="L22">接受分崩离析的我</text><text for="L23">你会来拯救我吗</text><text for="L24">你会来拯救我吗</text><text for="L25">当我独自一人</text><text for="L26">需要你的爱和帮助</text><text for="L27">你会来拯救我吗</text><text for="L28">你会来拯救我吗</text><text for="L29">你会来拯救我吗</text><text for="L30">做我坚强的后盾</text><text for="L31">接受分崩离析的我</text><text for="L32">你会来拯救我吗</text><text for="L33">你会来拯救我吗</text><text for="L34">当我独自一人</text><text for="L35">需要你的爱和帮助</text><text for="L36">你会来拯救我吗</text><text for="L37">你会来拯救我吗</text><text for="L38">我怀念那美好的过去</text><text for="L39">忘不掉那逝去的曾经</text><text for="L40">那份回忆 无可代替</text><text for="L41">而那些时光 不会像我那样爱你</text><text for="L42">不知你过去心里所想</text><text for="L43">我会永远在你身旁</text><text for="L44">所以不必寻他人作伴</text><text for="L45">有我就好</text><text for="L46">如今我不禁怀疑</text><text for="L47">如果我正渐渐沉沦，沉沦</text><text for="L48">你会来拯救我吗</text><text for="L49">做我坚强的后盾</text><text for="L50">接受分崩离析的我</text><text for="L51">你会来拯救我吗</text><text for="L52">你会来拯救我吗</text><text for="L53">当我独自一人</text><text for="L54">需要你的爱和帮助</text><text for="L55">你会来拯救我吗</text><text for="L56">你会来拯救我吗</text><text for="L57">你会来拯救我吗</text><text for="L58">还是让我独自承受一切</text><text for="L59">你会来拯救我吗</text><text for="L60">还是让我独自承受一切</text><text for="L61">你会来拯救我吗</text><text for="L62">做我坚强的后盾</text><text for="L63">接受分崩离析的我</text><text for="L64">你会来拯救我吗</text><text for="L65">你会来拯救我吗</text><text for="L66">当我独自一人</text><text for="L67">需要你的爱和帮助</text><text for="L68">你会来拯救我吗</text><text for="L69">你会来拯救我吗</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Rescue Me"/><amll:meta key="artists" value="OneRepublic"/><amll:meta key="album" value="Rescue Me - Single"/><amll:meta key="isrc" value="USUM71907507"/><amll:meta key="appleMusicId" value="1463236498"/></metadata></head><body><div begin="0:00.240" end="2:39.650"><p begin="0:00.240" end="0:01.260" itunes:key="L1" ttm:agent="v1"><span begin="0:00.240" end="0:00.420">Would</span> <span begin="0:00.420" end="0:00.510">you</span> <span begin="0:00.510" end="0:00.960">rescue</span> <span begin="0:00.960" end="0:01.260">me?</span></p><p begin="0:01.260" end="0:02.310" itunes:key="L2" ttm:agent="v1"><span begin="0:01.260" end="0:01.410">Would</span> <span begin="0:01.410" end="0:01.500">you</span> <span begin="0:01.500" end="0:01.680">get</span> <span begin="0:01.680" end="0:01.950">my</span> <span begin="0:01.950" end="0:02.310">back?</span></p><p begin="0:02.310" end="0:04.290" itunes:key="L3" ttm:agent="v1"><span begin="0:02.310" end="0:02.400">Would</span> <span begin="0:02.400" end="0:02.490">you</span> <span begin="0:02.490" end="0:02.730">take</span> <span begin="0:02.730" end="0:02.940">my</span> <span begin="0:02.940" end="0:03.240">call</span> <span begin="0:03.240" end="0:03.390">when</span> <span begin