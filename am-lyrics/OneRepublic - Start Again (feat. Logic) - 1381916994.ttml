<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">OneRepublic</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">能否倒转时钟</text><text for="L2">原谅我的罪过</text><text for="L3">我只想重整自我</text><text for="L4">重新来过</text><text for="L5">我知道我搞砸一切</text><text for="L6">一次次屡错不鲜</text><text for="L7">我只想重整自我</text><text for="L8">重新来过</text><text for="L9">我曾误入歧路</text><text for="L10">自毁声名前途</text><text for="L11">我曾执掌风云 厌恶那所有的一成不变</text><text for="L12">我曾自寻灾难  将自我毁于酒中</text><text for="L13">只因我知我终会步上归途</text><text for="L14">但我知道你不会为我引路</text><text for="L15">你看到我的世界地转天旋 似是无用无解</text><text for="L16">你眼中我的世界总像是随时会毁灭</text><text for="L17">诚然 我知道很难再从我脑海中倒转那一切</text><text for="L18">我渴望乘风远走 渴望得见光芒照进我的世界中</text><text for="L19">能否倒转时钟</text><text for="L20">原谅我的罪过</text><text for="L21">我只想重整自我</text><text for="L22">重新来过</text><text for="L23">我知道我搞砸一切</text><text for="L24">一次次屡错不鲜</text><text for="L25">我只想重整自我</text><text for="L26">重新来过</text><text for="L27">或许我并不为人所喜爱</text><text for="L28">似乎我已渐渐从你生活中淡去</text><text for="L29">我过去所做的一切如今意义已全然不同</text><text for="L30">但如今我却能比过去看得更明更清</text><text for="L31">每一天我都在重复承受那一切</text><text for="L32">但你却从未发觉 我也从未让你看见</text><text for="L33">你给了我整个世界 如今我心中满是亏欠</text><text for="L34">我透过镜子看见那从前的你</text><text for="L35">我要让一切重回正轨 虽然不知何解</text><text for="L36">但我们总会做到的 总有一天</text><text for="L37">我赌上一切 再次由衷的果决</text><text for="L38">敞开你心扉 我们或许就能重新开始一切</text><text for="L39">能否倒转时钟</text><text for="L40">原谅我的罪过</text><text for="L41">我只想重整自我</text><text for="L42">重新来过</text><text for="L43">我知道我搞砸一切</text><text for="L44">一次次屡错不鲜</text><text for="L45">我只想重整自我</text><text for="L46">重新来过</text><text for="L47">Oh-oh-ohhh, oh-oh-oh</text><text for="L48">Oh-oh-ohhh, oh-oh-oh</text><text for="L49">诚然 我知道很难再从我脑海中倒转那一切</text><text for="L50">我渴望乘风远走 渴望得见光芒照进我的世界中</text><text for="L51">能否倒转时钟</text><text for="L52">原谅我的罪过</text><text for="L53">我只想重整自我</text><text for="L54">重新来过</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Chorus"><p begin="0:04.620" end="0:07.620" itunes:key="L1" ttm:agent="v1"><span begin="0:04.620" end="0:04.950">Can't</span> <span begin="0:04.950" end="0:05.040">I</span> <span begin="0:05.040" end="0:05.370">just</span> <span begin="0:05.370" end="0:05.640">turn</span> <span begin="0:05.640" end="0:05.940">back</span> <span begin="0:05.940" end="0:06.090">the</span> <span begin="0:06.090" end="0:07.590">clock</span><span begin="0:07.590" end="0:07.620">?</span></p><p begin="0:07.620" end="0:09.570" itunes:key="L2" ttm:agent="v1"><span begin="0:07.620" end="0:08.280">Forgive</span> <span begin="0:08.280" end="0:08.640">my</span> <span begin="0:08.640" end="0:09.570">sins</span></p><p begin="0:09.570" end="0:12.000" itunes:key="L3" ttm:agent="v1"><span begin="0:09.570" end="0:09.660">I</span> <span begin="0:09.660" end="0:09.870">just</span> <span begin="0:09.870" end="0:10.170">wanna</span> <span begin="0:10.170" end="0:10.380">roll</span> <span begin="0:10.380" end="0:10.680">my</span> <span begin="0:10.680" end="0:11.190">sleeves</span> <span begin="0:11.190" end="0:12.000">up</span></p><p begin="0:12.270" end="0:14.310" itunes:key="L4" ttm:agent="v1"><span begin="0:12.270" end="0:12.480">And</span> <span begin="0:12.480" end="0:13.290">start</span> <span begin="0:13.290" end="0:14.310">again</span></p><p begin="0:14.400" end="0:16.980" itunes:key="L5" ttm:agent="v1"><span begin="0:14.400" end="0:14.580">I</span> <span begin="0:14.580" end="0:14.670">know</span> <span begin="0:14.670" end="0:15.120">that</span> <span begin="0:15.120" end="0:15.240">I</span> <span begin="0:15.240" end="0:15.720">messed</span> <span begin="0:15.720" end="0:16.050">it</span> <span begin="0:16.050" end="0:16.980">up</span></p><p begin="0:17.310" end="0:19.350" itunes:key="L6" ttm:agent="v1"><span begin="0:17.310" end="0:17.760">Time</span> <span begin="0:17.760" end="0:17.850">and</span> <span begin="0:17.850" end="0:18.270">time</span> <span begin="0:18.270" end="0:19.350">again</span></p><p begin="0:19.350" end="0:21.720" itunes:key="L7" ttm:agent="v1"><span begin="0:19.350" end="0:19.470">I</span> <span begin="0:19.470" end="0:19.620">just</span> <span begin="0:19.620" end="0:19.860">wanna</span> <span begin="0:19.860" end="0:20.130">roll</span> <span begin="0:20.130" end="0:20.400">my</span> <span begin="0:20.400" end="0:20.910">sleeves</span> <span begin="0:20.910" end="0:21.720">up</span></p><p begin="0:21.900" end="0:24.270" itunes:key="L8" ttm:agent="v1"><span begin="0:21.900" end="0:22.110">And</span> <span begin="0:22.110" end="0:22.920">start</span> <span begin="0:22.920" end="0:24.270">again</span></p></div><div itunes:song-part="Verse"><p begin="0:24.330" end="0:27.060" itunes:key="L9" ttm:agent="v1"><span begin="0:24.330" end="0:24.660">I</span> <span begin="0:24.660" end="0:25.830">was</span><span begin="0:25.830" end="0:25.830">,</span> <span begin="0:25.830" end="0:26.250">switchin'</span> <span begin="0:26.250" end="0:26.370">up</span> <span begin="0:26.370" end="0:26.460">the</span> <span begin="0:26.460" end="0:27.060">lanes</span></p><p begin="0:27.060" end="0:28.680" itunes:key="L10" ttm:agent="v1"><span begin="0:27.060" end="0:27.450">Steppin'</span> <span begin="0:27.450" end="0:27.600">out</span> <span begin="0:27.600" end="0:27.690">the</span> <span begin="0:27.690" end="0:28.080">fame</span> <span begin="0:28.080" end="0:28.380">I'm</span> <span begin="0:28.380" end="0:28.680">in</span></p><p begin="0:29.190" end="0:33.510" itunes:key="L11" ttm:agent="v1"><span begin="0:29.190" end="0:29.490">I</span> <span begin="0:29.490" end="0:30.690">was</span> <span begin="0:30.690" end="0:31.110">pullin'</span> <span begin="0:31.110" end="0:31.230">on</span> <span begin="0:31.230" end="0:31.350">the</span> <span begin="0:31.350" end="0:31.890">reigns</span><span begin="0:31.890" end="0:31.890">,</span> <span begin="0:31.890" end="0:32.190">sick</span> <span begin="0:32.190" end="0:32.310">off</span> <span begin="0:32.310" end="0:32.430">all</span> <span begin="0:32.430" end="0:32.520">the</span> <span begin="0:32.520" end="0:32.880">same</span> <span begin="0:32.880" end="0:33.510">happenin'</span></p><p begin="0:33.510" end="0:38.580" itunes:key="L12" ttm:agent="v1"><span begin="0:33.510" end="0:33.630">I</span> <span begin="0:33.630" end="0:34.170">swear</span> <span begin="0:34.170" end="0:34.380">I</span> <span begin="0:34.380" end="0:35.550">was</span> <span begin="0:35.550" end="0:35.910">lookin'</span> <span begin="0:35.910" end="0:36.090">for</span> <span begin="0:36.090" end="0:36.720">disaster</span><span begin="0:36.720" end="0:36.720">,</span> <span begin="0:36.720" end="0:37.170">mixed</span> <span begin="0:37.170" end="0:37.320">with</span> <span begin="0:37.320" end="0:37.410">a</span> <span begin="0:37.410" end="0:37.830">bottle</span> <span begin="0:37.830" end="0:37.980">of</span> <span begin="0:37.980" end="0:38.580">gin</span></p><p begin="0:38.580" end="0:41.700" itunes:key="L13" ttm:agent="v1"><span begin="0:38.580" end="0:38.880">Just</span> <span begin="0:38.880" end="0:40.260">because</span> <span begin="0:40.260" end="0:40.380">I</span> <span begin="0:40.380" end="0:40.770">come</span> <span begin="0:40.770" end="0:41.100">home</span> <span begin="0:41.100" end="0:41.700">after</span></p><p begin="0:41.700" end="0:43.170" itunes:key="L14" ttm:agent="v1"><span begin="0:41.700" end="0:41.970">Doesn't</span> <span begin="0:41.970" end="0:42.150">mean</span> <span begin="0:42.150" end="0:42.240">you'll</span> <span begin="0:42.240" end="0:42.570">take</span> <span begin="0:42.570" end="0:42.900">me</span> <span begin="0:42.900" end="0:43.170">in</span></p></div><div itunes:song-part="PreChorus"><p begin="0:43.170" end="0:47.820" itunes:key="L15" ttm:agent="v1"><span begin="0:43.170" end="0:43.320">You</span> <span begin="0:43.320" end="0:43.650">see</span> <span begin="0:43.650" end="0:43.980">my</span> <span begin="0:43.980" end="0:44.790">world</span> <span begin="0:44.790" end="0:45.090">is</span> <span begin="0:45.090" end="0:45.840">spinning</span> <span begin="0:45.840" end="0:46.170">like</span> <span begin="0:46.170" end="0:46.500">there's</span> <span begin="0:46.500" end="0:47.130">nothing</span> <span begin="0:47.130" end="0:47.370">to</span> <span begin="0:47.370" end="0:47.820">know</span></p><p begin="0:47.970" end="0:52.920" itunes:key="L16" ttm:agent="v1"><span begin="0:47.970" end="0:48.150">You</span> <span begin="0:48.150" end="0:48.510">see</span> <span begin="0:48.510" end="0:48.810">my</span> <span begin="0:48.810" end="0:49.620">world</span> <span begin="0:49.620" end="0:49.920">is</span> <span begin="0:49.920" end="0:50.640">feeling</span> <span begin="0:50.640" end="0:51.120">like</span> <span begin="0:51.120" end="0:51.300">it</span> <span begin="0:51.300" end="0:51.660">just</span> <span begin="0:51.660" end="0:52.020">might</span> <span begin="0:52.020" end="0:52.920">explode</span></p><p begin="0:52.920" end="0:59.310" itunes:key="L17" ttm:agent="v1"><span begin="0:52.920" end="0:53.190">And</span> <span begin="0:53.190" end="0:53.520">yes</span> <span begin="0:53.520" end="0:53.640">I</span> <span begin="0:53.640" end="0:54.420">know</span> <span begin="0:54.420" end="0:54.780">it's</span> <span begin="0:54.780" end="0:55.350">hard</span> <span begin="0:55.350" end="0:55.500">to</span> <span begin="0:55.500" end="0:55.950">take</span> <span begin="0:55.950" end="0:56.190">it</span> <span begin="0:56.190" end="0:57.990">backwards</span> <span begin="0:57.990" end="0:58.260">from</span> <span begin="0:58.260" end="0:58.530">my</span> <span begin="0:58.530" end="0:59.310">mind</span></p><p begin="0:59.790" end="1:02.820" itunes:key="L18" ttm:agent="v1"><span begin="0:59.790" end="0:59.880">I</span> <span begin="0:59.880" end="1:00.060">need</span> <span begin="1:00.060" end="1:00.150">to</span> <span begin="1:00.150" end="1:00.390">get</span> <span begin="1:00.390" end="1:00.420">a</span> <span begin="1:00.420" end="1:00.870">ride</span><span begin="1:00.870" end="1:01.050">,</span> <span begin="1:01.050" end="1:01.290">need</span> <span begin="1:01.290" end="1:01.350">to</span> <span begin="1:01.350" end="1:01.530">see</span> <span begin="1:01.530" end="1:01.680">some</span> <span begin="1:01.680" end="1:01.980">light</span> <span begin="1:01.980" end="1:02.310">come</span> <span begin="1:02.310" end="1:02.820">in</span></p></div><div itunes:song-part="Chorus"><p begin="1:02.820" end="1:05.820" itunes:key="L19" ttm:agent="v1"><span begin="1:02.820" end="1:03.090">Can't</span> <span begin="1:03.090" end="1:03.180">I</span> <span begin="1:03.180" end="1:03.540">just</span> <span begin="1:03.540" end="1:03.840">turn</span> <span begin="1:03.840" end="1:04.140">back</span> <span begin="1:04.140" end="1:04.290">the</span> <span begin="1:04.290" end="1:05.640">clock</span><span begin="1:05.640" end="1:05.820">?</span></p><p begin="1:05.820" end="1:07.830" itunes:key="L20" ttm:agent="v1"><span begin="1:05.820" end="1:06.450">Forgive</span> <span begin="1:06.450" end="1:06.780">my</span> <span begin="1:06.780" end="1:07.830">sins</span></p><p begin="1:07.830" end="1:10.350" itunes:key="L21" ttm:agent="v1"><span begin="1:07.830" end="1:07.920">I</span> <span begin="1:07.920" end="1:08.130">just</span> <span begin="1:08.130" end="1:08.400">wanna</span> <span begin="1:08.400" end="1:08.610">roll</span> <span begin="1:08.610" end="1:08.880">my</span> <span begin="1:08.880" end="1:09.420">sleeves</span> <span begin="1:09.420" end="1:10.