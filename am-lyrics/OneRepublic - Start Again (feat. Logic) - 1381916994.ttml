<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Start Again (feat. Logic)"/><amll:meta key="artists" value="one republic"/><amll:meta key="appleMusicId" value="1381916994"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">能不能倒转时间</text><text for="L2">宽恕我的罪过</text><text for="L3">我只想挽起袖子</text><text for="L4">重新来过</text><text for="L5">我知道我搞砸了一切</text><text for="L6">一错再错</text><text for="L7">我只想挽起袖子</text><text for="L8">重新来过</text><text for="L9">我曾试着改换方向</text><text for="L10">从束缚我的框架中跳脱</text><text for="L11">我也曾掌控大局</text><text for="L12">厌倦了一切都一成不变</text><text for="L13">我发誓我当时是在自找麻烦</text><text for="L14">就着干了那一瓶的劲儿</text><text for="L15">只因我即使在事后归来</text><text for="L16">你也不一定会接纳我</text><text for="L17">你看 我的世界天旋地转 仿佛无物支撑</text><text for="L18">你看 我的世界似乎马上就要爆炸</text><text for="L19">是的 我懂 很难在我脑海中逆转那一切</text><text for="L20">我需要做对做好 需要看到些光明洒进来</text><text for="L21">能不能倒转时间</text><text for="L22">宽恕我的罪过</text><text for="L23">我只想挽起袖子</text><text for="L24">重新来过</text><text for="L25">我知道我搞砸了一切</text><text for="L26">一错再错</text><text for="L27">我只想挽起袖子</text><text for="L28">重新来过</text><text for="L29">感觉自己好像不受重视</text><text for="L30">好像我在你的生活中不再重要</text><text for="L31">我觉得过去所做的一切都跟现在不同</text><text for="L32">但隔着这段距离 我能看得比以往更清晰</text><text for="L33">我天天如此 一直在承受</text><text for="L34">而你毫不知情 因为我从未表露</text><text for="L35">你曾给我整个世界 所以我感到亏欠</text><text for="L36">我望进镜子里 看到过去的你</text><text for="L37">现在我要做对做好 尽管方法还没想到</text><text for="L38">但我保证 我们会找到办法搞定的</text><text for="L39">我再次投入全部 完全发自内心</text><text for="L40">若你敞开心扉 或许我们能重新来过</text><text for="L41">能不能倒转时间</text><text for="L42">宽恕我的罪过</text><text for="L43">我只想挽起袖子</text><text for="L44">重新来过</text><text for="L45">我知道我搞砸了一切</text><text for="L46">一错再错</text><text for="L47">我只想挽起袖子</text><text for="L48">重新来过</text><text for="L49">Oh</text><text for="L50">Oh</text><text for="L51">是的 我懂 很难在我脑海中逆转那一切</text><text for="L52">我需要做对做好 需要看到些光明洒进来</text><text for="L53">能不能倒转时间</text><text for="L54">宽恕我的罪过</text><text for="L55">我只想挽起袖子</text><text for="L56">重新来过</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:39.852"><div begin="0:04.714" end="2:39.852"><p begin="0:04.714" end="0:06.994" itunes:key="L1" ttm:agent="v1"><span begin="0:04.714" end="0:04.944">Can</span> <span begin="0:04.944" end="0:05.094">I</span> <span begin="0:05.094" end="0:05.374">just</span> <span begin="0:05.374" end="0:05.694">turn</span> <span begin="0:05.694" end="0:05.974">back</span> <span begin="0:05.974" end="0:06.094">the</span> <span begin="0:06.094" end="0:06.994">clock?</span></p><p begin="0:07.704" end="0:09.574" itunes:key="L2" ttm:agent="v1"><span begin="0:07.704" end="0:08.094">For</span><span begin="0:08.094" end="0:08.304">give</span> <span begin="0:08.304" end="0:08.674">my</span> <span begin="0:08.674" end="0:09.574">sins</span></p><p begin="0:09.569" end="0:11.869" itunes:key="L3" ttm:agent="v1"><span begin="0:09.569" end="0:09.699">I</span> <span begin="0:09.699" end="0:09.899">just</span> <span begin="0:09.899" end="0:10.029">wan</span><span begin="0:10.029" end="0:10.229">na</span> <span begin="0:10.229" end="0:10.469">roll</span> <span begin="0:10.469" end="0:10.709">my</span> <span begin="0:10.709" end="0:11.199">sleeves</span> <span begin="0:11.199" end="0:11.869">up</span></p><p begin="0:12.320" end="0:14.100" itunes:key="L4" ttm:agent="v1"><span begin="0:12.320" end="0:12.510">And</span> <span begin="0:12.510" end="0:13.290">start</span> <span begin="0:13.290" end="0:14.100">again</span></p><p begin="0:13.996" end="0:16.686" itunes:key="L5" ttm:agent="v