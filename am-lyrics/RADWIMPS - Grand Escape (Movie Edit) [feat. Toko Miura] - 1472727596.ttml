<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Grand Escape (Movie Edit) [feat. Toko Miura]"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Weathering with You"/><amll:meta key="isrc" value="JPV971900038"/><amll:meta key="appleMusicId" value="1472727596"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Yojiro Noda</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">舍弃翱翔天际的羽翼</text><text for="L2">我们选择了十指紧扣的相伴</text><text for="L3">即便如此仍为苍穹所倾倒</text><text for="L4">难道层叠幻梦也是一种罪过吗</text><text for="L5">夏日凝望着秋天的背影</text><text for="L6">在心底描摹起那副面容</text><text for="L7">那是向往 还是爱恋</text><text for="L8">明知终究无法实现</text><text for="L9">重力悄然沉眠</text><text for="L10">千年一遇的今天</text><text for="L11">伫立在太阳的死角</text><text for="L12">让我们逃离这颗星球吧</text><text for="L13">待他从梦中醒转</text><text for="L14">我们早已远走高飞</text><text for="L15">齐声倒数 奋力蹬离大地</text><text for="L16">奔向未知的彼方星辰</text><text for="L17">启程吧</text><text for="L18">只差一步便能冲破命运</text><text for="L19">只差一步便能越过文明</text><text for="L20">走吧</text><text for="L21">命运的边界近在咫尺</text><text for="L22">就要触及</text><text for="L23">我们为梦想扬起风帆</text><text for="L24">为了那一天的到来 熬过漫漫长夜</text><text for="L25">满怀着期待 奔赴前路</text><text for="L26">坚信船到桥头自然直</text><text for="L27">我们并肩挽手</text><text for="L28">怎么可能不怕 可脚步绝不停歇</text><text for="L29">就算预先防备危机</text><text for="L30">凭我们也无济于事</text><text for="L31">我们的爱意在呼唤 心声在回响</text><text for="L32">呼唤着「向前冲」</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:01.629"><div begin="0:48.311" end="3:01.629"><p begin="0:48.311" end="0:53.381" itunes:key="L1" ttm:agent="v1"><span begin="0:48.311" end="0:49.221">空</span><span begin="0:49.221" end="0:49.551">飛</span><span begin="0:49.551" end="0:49.841">ぶ</span><span begin="0:50.131" end="0:50.291">羽</span><span begin="0:50.291" end="0:50.821">根</span><span begin="0:50.821" end="0:51.131">と</span><span begin="0:51.131" end="0:51.681">引</span><span begin="0:51.681" end="0:51.951">き</span><span begin="0:51.951" end="0:52.631">換</span><span begin="0:52.631" end="0:52.821">え</span><span begin="0:52.821" end="0:53.381">に</span></p><p begin="0:54.951" end="0:59.971" itunes:key="L2" ttm:agent="v1"><span begin="0:54.951" end="0:55.771">繋</span><span begin="0:55.771" end="0:56.171">ぎ</span><span begin="0:56.171" end="0:56.491">合</span><span begin="0:56.491" end="0:56.641">う</span><span begin="0:56.641" end="0:56.961">手</span><span begin="0:56.961" end="0:57.211">を</span><span begin="0:57.611" end="0:58.351">選ん</span><span begin="0:58.351" end="0:58.601">だ</span><span begin="0:58.601" end="0:59.361">僕</span><span begin="0:59.361" end="0:59.971">ら</span></p><p begin="1:01.504" end="1:06.564" itunes:key="L3" ttm:agent="v1"><span begin="1:01.504" end="1:01.854">そ</span><span begin="1:01.854" end="1:02.374">れ</span><span begin="1:02.374" end="1:02.644">で</span><span begin="1:02.644" end="1:02.964">も</span><span begin="1:03.204" end="1:03.954">空</span><span begin="1:03.954" end="1:04.284">に</span><span begin="1:04.284" end="1:04.754">魅</span><span begin="1:04.754" end="1:05.134">せ</span><span begin="1:05.134" end="1:05.704">ら</span><span begin="1:05.704" end="1:05.884">れ</span><span begin="1:05.884" end="1:06.564">て</span></p><p begin="1:08.138" end="1:13.008" itunes:key="L4" ttm:agent="v1"><span begin="1:08.138" end="1:08.978">夢</span><span begin="1:08.978" end="1:09.188">を</span><span begin="1:09.188" end="1:10.078">重</span><span begin="1:10.078" end="1:10.628">ね</span><span begin="1:10.628" end="1:10.888">る</span><span begin=