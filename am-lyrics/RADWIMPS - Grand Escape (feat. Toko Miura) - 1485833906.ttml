<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Grand Escape (feat. Toko Miura)"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Weathering With You (Complete Version) - EP"/><amll:meta key="isrc" value="JPV971900063"/><amll:meta key="appleMusicId" value="1485833906"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Yojiro Noda</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">以飞翔的羽翼作为代价</text><text for="L2">我们选择紧紧牵起彼此的手</text><text for="L3">即便如此依然为天空所倾倒</text><text for="L4">反复编织着梦境难道也是罪过吗</text><text for="L5">夏日望着秋日的背影</text><text for="L6">在心底描摹着那张脸庞</text><text for="L7">那是憧憬还是爱恋</text><text for="L8">分明早已知晓无法实现</text><text for="L9">在阵雨被唤作阵雨之前</text><text for="L10">在碎光被称作树影斑驳之前</text><text for="L11">早在很久很久很久以前</text><text for="L12">你就早已是那个无可替代的你了吧</text><text for="L13">当重力渐渐陷入沉睡</text><text for="L14">千年一遇的今天就在眼前</text><text for="L15">伫立在太阳照不到的死角</text><text for="L16">让我们一同离开这颗星球</text><text for="L17">赶在他睁开双眼之前</text><text for="L18">奔向谁也无法带我们回头的远方</text><text for="L19">齐声喊着口号用力蹬离大地</text><text for="L20">飞向另一颗不属于这里的星球</text><text for="L21">出发吧</text><text for="L22">启程吧</text><text for="L23">走吧</text><text for="L24">被夏日感冒扰得焦躁的心</text><text for="L25">让整个夏天快进得更加仓促</text><text for="L26">在飞速变换的万千风景中</text><text for="L27">唯有你仿佛静止在我的眼中</text><text for="L28">自从与你相遇的那天起</text><text for="L29">长夜里的梦便骤然止息</text><text for="L30">在泥土深处苦苦守候的心愿</text><text for="L31">如今正是让它绽放的时刻</text><text for="L32">当重力悄然隐没沉眠</text><text for="L33">正是千年一遇的今天</text><text for="L34">乘着烟火绽放的轰鸣</text><text for="L35">我们一同逃离这颗星球</text><text for="L36">待到他从沉睡中苏醒</text><text for="L37">我们早已到达谁也追不回的远方</text><text for="L38">伴着倒数默契蹬开大地</text><text for="L39">奔向那颗崭新的星辰</text><text for="L40">出发吧</text><text for="L41">差一点就能越过命运的彼岸</text><text for="L42">差一点就能穿透文明的藩篱</text><text for="L43">启程吧</text><text for="L44">差一点就能挣脱命运的束缚</text><text for="L45">只差那么一点点</text><text for="L46">走吧</text><text for="L47">差一点就能越过命运的彼岸</text><text for="L48">差一点就能穿透文明的藩篱</text><text for="L49">奔赴吧</text><text for="L50">差一点就能抵达命运的彼岸</text><text for="L51">就差最后一步</text><text for="L52">用我们的双手为梦想扬起风帆</text><text for="L53">为了那注定降临的一天跨越漫漫长夜</text><text for="L54">胸中盛满了无限的期待与憧憬</text><text for="L55">心想之后总会有办法的吧</text><text for="L56">彼此搭住了肩膀</text><text for="L57">怎么可能不害怕 可步履绝不停歇</text><text for="L58">就算未雨绸缪地去提防危险</text><text for="L59">凭我们这般渺小也是无济于事</text><text for="L60">我们的爱恋在呼唤 心底的声音在呐喊</text><text for="L61">催促着我们勇往直前</text></translation></translations></iTunesMetadata></metadata></head><body dur="5:16.038"><div begin="0:26.656" end="5:16.038"><p begin="0:26.656" end="0:31.696" itunes:key="L1" ttm:agent="v1"><span begin="0:26.656" end="0:27.516">空</span><span begin="0:27.516" end="0:27.856">飛</span><span begin="0:27.856" end="0:28.236">ぶ</span><span begin="0:28.356" end="0:28.596">羽</span><span begin="0:28.596" end="0:29.116">根</span><span begin="0:29.116" end="0:29.426">と</span><span begin="0:29.426" end="0:29.956">引</span><span begin="0:29.956" end="0:30.236">き</span><span begin="0:30.236" end="0:30.886">換</span><span begin="0:30.886" end="0:31.086">え</span><span begin="0:31.086" end="0:31.696">に</span></p><p begin="0:33.236" end="0:38.536" itunes:key="L2" ttm:agent="v1"><span begin="0:33.236" end="0:34.076">繋</span><span begin="0:34.076" end="0:34.466">ぎ</span><span begin="0:34.466" end="0:34.766">合</span><span begin="0:34.766" end="0:34.946">う</span><span begin="0:34.946" end="0:35.256">手</span><span begin="0:35.256" end="0:35.506">を</span><span begin="0:35.876" end="0:36.626">選ん</span><span begin="0:36.626" end="0:36.866">だ</span><span begin="0:36.866" end="0:37.666">僕</span><span begin="0:37.666" end="0:38.536">ら</span></p><p begin="0:39.791" end="0:44.951" itunes:key="L3" ttm:agent="v1"><span begin="0:39.791" end="0:40.151">そ</span><span begin="0:40.151" end="0:40.651">れ</span><span begin="0:40.651" end="0:40.941">で</span><span begin="0:40.941" end="0:41.281">も</span><span begin="0:41.491" end="0:42.341">空</span><span begin="0:42.341" end="0:42.561">に</span><span begin="0:42.561" end="0:43.061">魅</span><span begin="0:43.061" end="0:43.431">せ</span><span begin="0:43.431" end="0:44.011">ら</span><span begin="0:44.011" end="0:44.161">れ</span><span begin="0:44.161" end="0:44.951">て</span></p><p begin="0:46.420" end="0:51.440" itunes:key="L4" ttm:agent="v1"><span begin="0:46.420" end="0:47.320">夢</span><span begin="0:47.320" end="0:47.500">を</span><span begin="0:47.500" end="0:48.360">重</span><span begin="0:48.360" end="0:48.860">ね</span><span begin="0:48.860" end="0:49.200">る</span><span begin="0:49.200" end="0:49.720">の</span><span begin="0:49.720" end="0:50.000">は</span><span begin="0:50.000" end="0:50.780">罪</span><span begin="0:50.780" end="0:51.440">か</span></p><p begin="0:57.977" end="1:03.207" itunes:key="L5" ttm:agent="v1"><span begin="0:57.977" end="0:58.777">夏</span><span begin="0:58.777" end="0:59.087">は</span><span begin="0:59.087" end="0:59.837">秋</span><span begin="0:59.837" end="1:00.147">の</span><span begin="1:00.287" end="1:00.617">背</span><span begin="1:00.617" end="1:01.587">中</span><span begin="1:01.587" end="1:02.067">を</span><span begin="1:02.067" end="1:02.267">見</span><span begin="1:02.267" end="1:03.207">て</span></p><p begin="1:04.436" end="1:09.806" itunes:key="L6" ttm:agent="v1"><span begin="1:04.436" end="1:04.816">そ</span><span begin="1:04.816" end="1:05.276">の</span><span begin="1:05.276" end="1:06.046">顔</span><span begin="1:06.046" end="1:06.476">を</span><span begin="1:06.476" end="1:07.296">思</span><span begin="1:07.296" end="1:07.796">い</span><span begin="1:07.796" end="1:08.016">浮</span><span begin="1:08.016" end="1:08.666">か</span><span begin="1:08.666" end="1:08.896">べ</span><span begin="1:08.896" end="1:09.806">る</span></p><p begin="1:11.198" end="1:16.228" itunes:key="L7" ttm:agent="v1"><span begin="1:11.198" end="1:12.208">憧</span><span begin="1:12.208" end="1:12.648">れ</span><span begin="1:12.648" end="1:13.008">な</span><span begin="1:13.008" end="1:13.448">の</span><span begin="1:13.538" end="1:13.798">か、</span><span begin="1:13.798" end="1:14.658">恋</span><span begin="1:14.658" end="1:15.278">な</span><span begin="1:15.278" end="1:15.458">の</span><span begin="1:15.458" end="1:16.228">か</span></p><p begin="1:17.620" end="1:22.970" itunes:key="L8" ttm:agent="v1"><span begin="1:17.620" end="1:18.510">叶</span><span begin="1:18.510" end="1:18.750">わ</span><span begin="1:18.750" end="1:19.270">ぬ</span><span begin="1:19.270" end="1:19.530">と</span><span begin="1:19.530" end="1:20.320">知っ</span><span begin="1:20.320" end="1:20.960">て</span><span begin="1:21.040" end="1:21.200">い</span><span begin="1:21.200" end="1:21.810">な</span><span begin="1:21.810" end="1:22.060">が</span><span begin="1:22.060" end="1:22.970">ら</span></p><p begin="1:29.181" end="1:34.391" itunes:key="L9" ttm:agent="v1"><span begin="1:29.181" end="1:29.961">通</span><span begin="1:29.961" end="1:30.311">り</span><span begin="1:30.311" end="1:31.081">雨</span><span begin="1:31.081" end="1:31.391">が</span><span begin="1:31.621" end="1:32.551">通</span><span begin="1:32.551" end="1:32.831">り</span><span begin="1:32.831" end="1:33.531">雨</span><span begin="1:33.531" end="1:34.391">と</span></p><p begin="1:35.728" end="1:41.018" itunes:key="L10" ttm:agent="v1"><span begin="1:35.728" end="1:35.978">木</span><span begin="1:35.978" end="1:36.528">漏</span><span begin="1:36.528" end="1:36.848">れ</span><span begin="1:36.848" end="1:37.178">日</span><span begin="1:37.418" end="1:37.618">た</span><span begin="1:37.618" end="1:38.198">ち</span><s