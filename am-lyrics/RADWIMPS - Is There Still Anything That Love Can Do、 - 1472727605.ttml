<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Is There Still Anything That Love Can Do?"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Weathering with You"/><amll:meta key="isrc" value="JPV971900041"/><amll:meta key="appleMusicId" value="1472727605"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>野田洋次郎</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">爱还能做些什么吗</text><text for="L2">一无所有 降生于世的我</text><text for="L3">在永恒的间隙中 挣扎彷徨</text><text for="L4">唯有弃绝之人与通达之士</text><text for="L5">方能称胜的时代 何处得以容身喘息</text><text for="L6">统治者与神明 宛若事不关己</text><text for="L7">但心底深处 理应早有明晰</text><text for="L8">名为勇气 希望与羁绊的魔法</text><text for="L9">无处施展 大人们纷纷别开目光</text><text for="L10">即便如此 那一天的你至今依然</text><text for="L11">伫立在我心中正义的正中央</text><text for="L12">哪怕世界已然背过身去</text><text for="L13">毅然挺身抗争的你 如今依然在此</text><text for="L14">爱还能做些什么吗</text><text for="L15">我还能为你做些什么吗</text><text for="L16">这是你赠予我的勇气 我想全为你倾尽付出</text><text for="L17">这是与你一同分担的爱 若不是你便毫无意义</text><text for="L18">爱是否还有能做的事呢</text><text for="L19">我是否还有能做的事呢</text><text for="L20">所谓命运 莫非只是掷下的骰子点数？</text><text for="L21">亦或是神明 一如既往的心血来潮</text><text for="L22">辗转抉择 卸不下的沉重铠甲</text><text for="L23">抑或是来自远方 从不动摇的坚定意志</text><text for="L24">未竟的心愿 无法实现的重逢</text><text for="L25">难以化解的误解 积聚难消的怨憎</text><text for="L26">彼此宽恕的话语 紧紧相牵的双手</text><text for="L27">这颗星球在今天 也背负着这一切前行</text><text for="L28">爱还有什么能做到的吗？</text><text for="L29">我还有什么能做到的吗</text><text for="L30">这是你赋予我的勇气 我想毫无保留全用在你身上</text><text for="L31">这是与你一同培育的爱 若不是与你便失去意义</text><text for="L32">爱当真还能再做些什么吗</text><text for="L33">我当真还能再做些什么吗</text><text for="L34">为何要让一无所有的我们 怀揣梦想</text><text for="L35">为何要让终有一尽的生命 抱有希望</text><text for="L36">为何赐予我们的 尽是指缝间流逝的事物</text><text for="L37">即便如此依然死死抓住不放的我们 究竟是丑陋不堪</text><text for="L38">还是美丽耀眼</text><text for="L39">请回答我</text><text for="L40">爱的歌谣早已被唱尽 无数电影也已将它述尽</text><text for="L41">在这一片荒野上 降生的我与你 纵然如此</text><text for="L42">爱一定还有能做的事啊</text><text for="L43">我也一定还有能做的事啊</text></translation></translations></iTunesMetadata></metadata></head><body dur="6:36.101"><div begin="0:01.323" end="6:36.101"><p begin="0:01.323" end="0:08.381" itunes:key="L1" ttm:agent="v1"><span begin="0:01.323" end="0:02.376">愛に</span><span begin="0:02.376" end="0:03.018">で</span><span begin="0:03.018" end="0:03.646">きる</span><span begin="0:03.819" end="0:04.902">ことは</span><span begin="0:04.902" end="0:05.764">まだ</span><span begin="0:05.764" end="0:06.662">ある</span><span begin="0:06.662" end="0:08.381">かい</span></p><p begin="0:11.824" end="0:17.419" itunes:key="L2" ttm:agent="v1"><span begin="0:11.824" end="0:12.552">何も</span><span begin="0:12.552" end="0:13.376">持たず</span><span begin="0:13.376" end="0:14.239">に</span> <span begin="0:15.046" end="0:15.832">生まれ</span><span begin="0:15.832" end="0:16.530">堕ちた</span><span begin="0:16.530" end="0:17.419">僕</span></p><p begin="0:18.623" end="0:24.160" itunes:key="L3" ttm:agent="v1"><span begin="0:18.623" end="0:19.427">永遠の</span><span begin="0:19.427" end="0:20.052">隙間</span><span begin="0:20.052" end="0:20.724">で</span> <span begin="0:21.619" end="0:22.656">のたうち</span><span begin="0:22.656" end="0:24.160">回ってる</span></p><p begin="0:25.202" end="0:31.116" itunes:key="L4" ttm:agent="v1"><span begin="0:25.202" end="0:26.292">諦めた</span><span begin="0:26.292" end="0:27.594">者と</span> <span begin="0:28.543" end="0:29.964">賢い者</span><span begin="0:29.964" end="0:31.116">だけが</span></p><p begin="0:31.921" end="0:37.968" itunes:key="L5" ttm:agent="v1"><span begin="0:31.921" end="0:32.802">勝者の</span><span begin="0:32.802" end="0:33.763">時代</span><span begin="0:33.763" end="0:34.537">に</span> <span begin="0:35.504" end="0:36.405">どこで</span><span begin="0:36.405" end="0:37.159">息を</span><span begin="0:37.159" end="0:37.968">吸う</span></p><p begin="0:52.226" end="0:57.915" itunes:key="L6" ttm:agent="v1"><span begin="0:52.226" end="0:53.292">支配者も</span><span begin="0:53.292" end="0:54.650">神も</span> <span begin="0:55.633" end="0:56.461">どこか</span><span begin="0:56.461" end="0:57.915">他人顔</span></p><p begin="0:59.128" end="1:04.768" itunes:key="L7" ttm:agent="v1"><span begin="0:59.128" end="0:59.879">だけど</span><span begin="0:59.879" end="1:01.455">本当は</span> <span begin="1:02.460" end="1:03.446">分かって</span><span begin="1:03.446" end="1:03.931">いる</span><span begin="1:03.931" end="1:04.768">はず</span></p><p begin="1:05.720" end="1:11.624" itunes:key="L8" ttm:agent="v1"><span begin="1:05.720" end="1:06.675">勇気や</span><span begin="1:06.675" end="1:08.250">希望や</span> <span begin="1:09.203" end="1:10.614">絆とかの</span><span begin="1:10.614" end="1:11.624">魔法</span></p><p begin="1:12.456" end="1:18.376" itunes:key="L9" ttm:agent="v1"><span begin="1:12.456" end="1:14.048">使い道も</span><span begin="1:14.048" end="1:14.928">なく</span> <span begin="1:15.485" end="1:16.362">オトナは</span><span begin="1:16.362" end="1:16.920">眼を</span><span begin="1:16.935" end="1:18.376">背ける</span></p><p begin="1:19.226" end="1:25.109" itunes:key="L10" ttm:agent="v1"><span begin="1:19.226" end="1:20.309">それでも</span><span begin="1:20.309" end="1:21.061">あの日</span><span begin="1:21.061" end="1:21.650">の</span> <span begin="1:22.654" end="1:23.390">君が</span><span begin="1:23.390" end="1:24.164">今も</span><span begin="1:24.164" end="1:25.109">まだ</span></p><p begin="1:26.002" end="1:31.878" itunes:key="L11" ttm:agent="v1"><span begin="1:26.002" end="1:26.689">僕の</span><span begin="1:26.689" end="1:27.849">全正義</span><span begin="1:27.849" end="1:28.424">の</span> <span begin="1:29.506" end="1:30.955">ど真ん中に</span><span begin="1:30.955" end="1:31.878">いる</span></p><p begin="1:32.773" end="1:38.538" itunes:key="L12" ttm:agent="v1"><span begin="1:32.773" end="1:33.651">世界が</span><span begin="1:33.651" end="1:34.574">背中</span><span begin="1:34.574" end="1:35.191">を</span> <span begin="1:36.228" end="1:37.042">向けても</span><span begin="1:37.042" end="1:37.629">まだ</span><span begin="1:37.629" end="1:38.538">なお</span></p><p begin="1:39.648" end="1:45.304" itunes:key="L13" ttm:agent="v1"><span begin="1:39.648" end="1:40.734">立ち向かう</span><span begin="1:40.734" end="1:41.331">君</span><span begin="1:41.331" end="1:42.210">が</span> <span begin="1:42.879" end="1:43.568">今も</span><span begin="1:43.568" end="1:44.466">ここに</span><span begin="1:44.466" end="1:45.304">いる</span></p><p begin="1:46.026" end="1:52.482" itunes:key="L14" ttm:agent="v1"><span begin="1:46.026" end="1:47.202">愛に</span><span begin="1:47.202" end="1:48.467">できる</span><span begin="1:48.651" end="1:49.734">ことは</span><span begin="1:49.734" end="1:50.670">まだ</span><span begin="1:50.670" end="1:51.453">ある</span><span begin="1:51.453" end="1:52.482">かい</span></p><p begin="1:52.872" end="2:00.482" itunes:key="L15" ttm:agent="v1"><span begin="1:52.872" end="1:53.970">僕に</span><span begin="1:53.970" end="1:55.093">できる</span><span begin="1:55.368" end="1:56.483">ことは</span><span begin="1:56.483" end="1:57.495">まだ</span><span begin="1:57.495" end="1:58.188">ある</span><span begin="1:58.188" end="2:00.482">かい</span></p><p begin="2:05.550" end="2:17.789" itunes:key="L16" ttm:agent="v1"><span begin="2:05.550" end="2:06.675">君が</span><span begin="2:06.675" end="2:07.821">くれた</span><span begin="2:08.106" end="2:09.168">勇気</span><span begin="2:09.168" end="2:09.975">だか</span><span begin="2:09.975" end="2:11.295">ら</span> <span begin="2:12.342" end="2:13.368">君の</span><span begin="2:13.368" end="2:14.511">ために</span><span begin="2:14.818" end="2:15.953">使い</span><span begin="2:15.953" end="2:16.762">たいん</span><span begin="2:16.762" end="2:17.789">だ</span></p><p begin="2:19.008" end="2:31.239" itunes:key="L17" ttm:agent="v1"><span begin="2:19.008" end="2:20.235">君と</span><span begin="2:20.235" end="2:21.840">分け合った</span><span begin="2:21.840" end="2:22.720">愛</span><span begin="2:22.720" end="2:23.509">だか</span><span begin="2:23.509" end="2:24.627">ら</span> <span begin="2:25.876" end="2:26.938">君と</span><span begin="2:26.938" end="2:28.111">じゃなきゃ</span><span begin="2:28.405" end="2:29.543">意味が</span><span begin="2:29.543" end="2:30.259">ないん</span><span begin="2:30.259" end="2:31.239">だ</span></p><p begin="2:31.719" end="2:38.105" itunes:key="L18" ttm:agent="v1"><span begin="2:31.719" end="2:32.895">愛に</span><span begin="2:32.895" end="2:34.160">できる</span><span begin="2:34.344" end="2:35.427">ことは</span><span begin="2:35.427" end="2:36.363">まだ</span><span begin="2:36.363" end="2:37.146">ある</span><span begin="2:37.146" end="2:38.105">かい</span></p><p begin="2:38.471" end="2:45.501" itunes:key="L19" ttm:agent="v1"><span begin="2:38.471" end="2:39.679">僕に</span><span begin="2:39.679" end="2:40.692">できる</span><span begin="2:40.967" end="2:42.082">ことは</span><span begin="2:42.082" end="2:42.998">まだ</span><span begin="2:42.998" end="2:43.787">ある</span><span begin="2:43.787" end="2:45.501">かい</span></p><p begin="3:04.021" end="3:09.848" itunes:key="L20" ttm:agent="v1"><span begin="3:04.021" end="3:05.117">運命とは</span><span begin="3:05.117" end="3:06.493">つまり</span> <span begin="3:07.322" end="3:08.564">サイコロの</span><span begin="3:08.564" end="3:09.115">出た</span><span begin="3:09.115" end="3:09.848">目？</span></p><p begin="3:10.763" end="3:16.644" itunes:key="L21" ttm:agent="v1"><span begin="3:10.763" end="3:11.914">はたまた</span><span begin="3:11.914" end="3:13.143">神の</span> <span begin="3:14.279" end="3:15.270">いつもの</span><span begin="3:15.270" end="3:16.644">気まぐれ</span></p><p begin="3:17.622" end="3:23.221" itunes:key="L22" ttm:agent="v1"><span begin="3:17.622" end="3:18.208">選び</span><span begin="3:18.208" end="3:19.235">選ばれ</span><span begin="3:19.235" end="3:20.080">た</span> <span begin="3:20.995" end="3:22.022">脱げられぬ</span><span begin="3:22.022" end="3:23.221">鎧</span></p><p begin="3:24.275" end="3:30.107" itunes:key="L23" ttm:agent="v1"><span begin="3:24.275" end="3:25.316">もしくは</span><span begin="3:25.316" end="3:26.580">遥かな</span> <span begin="3:27.756" end="3:28.378">揺らぐ</span><span begin="3:28.378" end="3:29.223">ことない</span><span begin="3:29.223" end="3:30.107">意志</span></p><p begin="3:31.078" end="3:37.011" itunes:key="L24" ttm:agent="v1"><span begin="3:31.078" end="3:32.004">果たさぬ</span><span begin="3:32.004" end="3:32.682">願い</span><span begin="3:32.682" end="3:33.562">と</span> <span begin="3:34.509" end="3:35.358">叶わぬ</span><span begin="3:35.358" end="3:36.520">再会</span><span begin="3:36.520" end="3:37.011">と</span></p><p begin="3:37.822" end="3:43.702" itunes:key="L25" ttm:agent="v1"><span begin="3:37.822" end="3:38.782">ほどけぬ</span><span begin="3:38.782" end="3:39.553">誤解</span><span begin="3:39.553" end="3:40.282">と</span> <span begin="3:41.291" end="3:42.338">降り積もる</span><span begin="3:42.338" end="3:42.904">憎悪</span><span begin="3:42.904" end="3:43.702">と</span></p><p begin="3:44.625" end="3:50.393" itunes:key="L26" ttm:agent="v1"><span begin="3:44.625" end="3:46.312">許し合う声</span><span begin="3:46.312" end="3:47.028">と</span> <span begin="3:48.020" end="3:49.577">握りしめ合う</span><span begin="3:49.577" end="3:50.393">手を</span></p><p begin="3:51.372" end="3:57.073" itunes:key="L27" ttm:agent="v1"><span begin="3:51.372" end="3:52.475">この星は</span><span begin="3:52.475" end="3:53.648">今日も</span> <span begin="3:54.701" end="3:55.932">抱えて</span><span begin="3:55.932" end="3:57.073">生きてる</span></p><p begin="3:57.878" end="4:04.292" itunes:key="L28" ttm:agent="v1"><span begin="3:57.878" end="3:58.943">愛に</span><span begin="3:58.943" end="4:00.114">できる</span><span begin="4:00.462" end="4:01.565">ことは</span><span begin="4:01.565" end="4:02.463">まだ</span><span begin="4:02.463" end="4:03.196">ある</span><span begin="4:03.19