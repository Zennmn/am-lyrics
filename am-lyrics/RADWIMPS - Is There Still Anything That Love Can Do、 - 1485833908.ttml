<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Is There Still Anything That Love Can Do?"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Weathering With You (Complete Version) - EP"/><amll:meta key="isrc" value="JPV971900041"/><amll:meta key="appleMusicId" value="1485833908"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>野田洋次郎</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">爱在这世上 还能做些什么吗</text><text for="L2">赤手空拳坠入尘世的我</text><text for="L3">在永恒的狭缝间辗转挣扎</text><text for="L4">唯有甘于妥协与精明世故之人</text><text for="L5">方为赢家的时代里 该在何处喘息</text><text for="L6">无论掌权者还是神明 尽是一副冷眼旁观的神情</text><text for="L7">然而在他们心底 本该心知肚明</text><text for="L8">那名为勇气 希望与羁绊的魔法</text><text for="L9">已无处施展 大人们便纷纷别过脸去</text><text for="L10">可即便如此 那一天的你直到如今</text><text for="L11">依然牢牢伫立在我所有正义的正中心</text><text for="L12">哪怕全世界都冷眼背过身去</text><text for="L13">毅然迎战的你 此刻依然伫立在此</text><text for="L14">爱可还能为我们做些什么</text><text for="L15">我又还能为你做些什么</text><text for="L16">正因为是你给予我的勇气 我才想全心为你倾尽</text><text for="L17">正因为是与你分担同享的爱 若不是你便毫无意义</text><text for="L18">爱是否还有所能为</text><text for="L19">而我又还能挽回些什么</text><text for="L20">所谓命运 难道只是掷出的骰子点数？</text><text for="L21">抑或是神明一如既往的心血来潮</text><text for="L22">是在相互抉择中 无法褪下的沉重铠甲</text><text for="L23">还是来自遥远彼方 决不动摇的意志</text><text for="L24">未竟的夙愿 难圆的重逢</text><text for="L25">难解的心结 堆叠郁积的仇恨</text><text for="L26">彼此宽恕的话语 紧密交握的双手</text><text for="L27">这颗星球在今天 也依然拥入怀中继续运转</text><text for="L28">爱是否还能改变这世间？</text><text for="L29">我又能为这一切做些什么</text><text for="L30">正是你赋予我的勇气 我要全都用在你的身上</text><text for="L31">正因为是与你一同孕育的爱 若没有你便毫无意义</text><text for="L32">爱还能再创造什么奇迹吗</text><text for="L33">我还能做些什么吗</text><text for="L34">为何让一无所有的我们 怀揣梦想</text><text for="L35">为何给终有尽头的人生 赋予希望</text><text for="L36">为何给予我们的 尽是些从指间溜走的事物</text><text for="L37">即便如此仍死死抓住不放的我们 难道很丑陋吗</text><text for="L38">抑或是 依然美丽？</text><text for="L39">回答我啊</text><text for="L40">世间情歌早已被唱绝 无数电影也已把爱道尽</text><text for="L41">降生在如此荒野中的你与我 纵然这般</text><text for="L42">爱所能做到的 依然还有啊</text><text for="L43">我能为你做的 也绝非止步于此</text></translation></translations></iTunesMetadata></metadata></head><body dur="6:35.801"><div begin="0:01.023" end="6:35.801"><p begin="0:01.023" end="0:08.081" itunes:key="L1" ttm:agent="v1"><span begin="0:01.023" end="0:02.076">愛に</span><span begin="0:02.076" end="0:02.718">で</span><span begin="0:02.718" end="0:03.346">きる</span><span begin="0:03.519" end="0:04.602">ことは</span><span begin="0:04.602" end="0:05.464">まだ</span><span begin="0:05.464" end="0:06.362">ある</span><span begin="0:06.362" end="0:08.081">かい</span></p><p begin="0:11.524" end="0:17.119" itunes:key="L2" ttm:agent="v1"><span begin="0:11.524" end="0:12.252">何も</span><span begin="0:12.252" end="0:13.076">持たず</span><span begin="0:13.076" end="0:13.939">に</span> <span begin="0:14.746" end="0:15.532">生まれ</span><span begin="0:15.532" end="0:16.230">堕ちた</span><span begin="0:16.230" end="0:17.119">僕</span></p><p begin="0:18.323" end="0:23.860" itunes:key="L3" ttm:agent="v1"><span begin="0:18.323" end="0:19.127">永遠の</span><span begin="0:19.127" end="0:19.752">隙間</span><span begin="0:19.752" end="0:20.424">で</span> <span begin="0:21.319" end="0:22.356">のたうち</span><span begin="0:22.356" end="0:23.860">回ってる</span></p><p begin="0:24.902" end="0:30.816" itunes:key="L4" ttm:agent="v1"><span begin="0:24.902" end="0:25.992">諦めた</span><span begin="0:25.992" end="0:27.294">者と</span> <span begin="0:28.243" end="0:29.664">賢い者</span><span begin="0:29.664" end="0:30.816">だけが</span></p><p begin="0:31.621" end="0:37.668" itunes:key="L5" ttm:agent="v1"><span begin="0:31.621" end="0:32.502">勝者の</span><span begin="0:32.502" end="0:33.463">時代</span><span begin="0:33.463" end="0:34.237">に</span> <span begin="0:35.204" end="0:36.105">どこで</span><span begin="0:36.105" end="0:36.859">息を</span><span begin="0:36.859" end="0:37.668">吸う</span></p><p begin="0:51.926" end="0:57.615" itunes:key="L6" ttm:agent="v1"><span begin="0:51.926" end="0:52.992">支配者も</span><span begin="0:52.992" end="0:54.350">神も</span> <span begin="0:55.333" end="0:56.161">どこか</span><span begin="0:56.161" end="0:57.615">他人顔</span></p><p begin="0:58.828" end="1:04.468" itunes:key="L7" ttm:agent="v1"><span begin="0:58.828" end="0:59.579">だけど</span><span begin="0:59.579" end="1:01.155">本当は</span> <span begin="1:02.160" end="1:03.146">分かって</span><span begin="1:03.146" end="1:03.631">いる</span><span begin="1:03.631" end="1:04.468">はず</span></p><p begin="1:05.420" end="1:11.324" itunes:key="L8" ttm:agent="v1"><span begin="1:05.420" end="1:06.375">勇気や</span><span begin="1:06.375" end="1:07.950">希望や</span> <span begin="1:08.903" end="1:10.314">絆とかの</span><span begin="1:10.314" end="1:11.324">魔法</span></p><p begin="1:12.156" end="1:18.076" itunes:key="L9" ttm:agent="v1"><span begin="1:12.156" end="1:13.748">使い道も</span><span begin="1:13.748" end="1:14.628">なく</span> <span begin="1:15.185" end="1:16.062">オトナは</span><span begin="1:16.062" end="1:16.620">眼を</span><span begin="1:16.635" end="1:18.076">背ける</span></p><p begin="1:18.926" end="1:24.809" itunes:key="L10" ttm:agent="v1"><span begin="1:18.926" end="1:20.009">それでも</span><span begin="1:20.009" end="1:20.761">あの日</span><span begin="1:20.761" end="1:21.350">の</span> <span begin="1:22.354" end="1:23.090">君が</span><span begin="1:23.090" end="1:23.864">今も</span><span begin="1:23.864" end="1:24.809">まだ</span></p><p begin="1:25.702" end="1:31.578" itunes:key="L11" ttm:agent="v1"><span begin="1:25.702" end="1:26.389">僕の</span><span begin="1:26.389" end="1:27.549">全正義</span><span begin="1:27.549" end="1:28.124">の</span> <span begin="1:29.206" end="1:30.655">ど真ん中に</span><span begin="1:30.655" end="1:31.578">いる</span></p><p begin="1:32.473" end="1:38.238" itunes:key="L12" ttm:agent="v1"><span begin="1:32.473" end="1:33.351">世界が</span><span begin="1:33.351" end="1:34.274">背中</span><span begin="1:34.274" end="1:34.891">を</span> <span begin="1:35.928" end="1:36.742">向けても</span><span begin="1:36.742" end="1:37.329">まだ</span><span begin="1:37.329" end="1:38.238">なお</span></p><p begin="1:39.348" end="1:45.004" itunes:key="L13" ttm:agent="v1"><span begin="1:39.348" end="1:40.434">立ち向かう</span><span begin="1:40.434" end="1:41.031">君</span><span begin="1:41.031" end="1:41.910">が</span> <span begin="1:42.579" end="1:43.268">今も</span><span begin="1:43.268" end="1:44.166">ここに</span><span begin="1:44.166" end="1:45.004">いる</span></p><p begin="1:45.726" end="1:52.182" itunes:key="L14" ttm:agent="v1"><span begin="1:45.726" end="1:46.902">愛に</span><span begin="1:46.902" end="1:48.167">できる</span><span begin="1:48.351" end="1:49.434">ことは</span><span begin="1:49.434" end="1:50.370">まだ</span><span begin="1:50.370" end="1:51.153">ある</span><span begin="1:51.153" end="1:52.182">かい</span></p><p begin="1:52.572" end="2:00.182" itunes:key="L15" ttm:agent="v1"><span begin="1:52.572" end="1:53.670">僕に</span><span begin="1:53.670" end="1:54.793">できる</span><span begin="1:55.068" end="1:56.183">ことは</span><span begin="1:56.183" end="1:57.195">まだ</span><span begin="1:57.195" end="1:57.888">ある</span><span begin="1:57.888" end="2:00.182">かい</span></p><p begin="2:05.250" end="2:17.489" itunes:key="L16" ttm:agent="v1"><span begin="2:05.250" end="2:06.375">君が</span><span begin="2:06.375" end="2:07.521">くれた</span><span begin="2:07.806" end="2:08.868">勇気</span><span begin="2:08.868" end="2:09.675">だか</span><span begin="2:09.675" end="2:10.995">ら</span> <span begin="2:12.042" end="2:13.068">君の</span><span begin="2:13.068" end="2:14.211">ために</span><span begin="2:14.518" end="2:15.653">使い</span><span begin="2:15.653" end="2:16.462">たいん</span><span begin="2:16.462" end="2:17.489">だ</span></p><p begin="2:18.708" end="2:30.939" itunes:key="L17" ttm:agent="v1"><span begin="2:18.708" end="2:19.935">君と</span><span begin="2:19.935" end="2:21.540">分け合った</span><span begin="2:21.540" end="2:22.420">愛</span><span begin="2:22.420" end="2:23.209">だか</span><span begin="2:23.209" end="2:24.327">ら</span> <span begin="2:25.576" end="2:26.638">君と</span><span begin="2:26.638" end="2:27.811">じゃなきゃ</span><span begin="2:28.105" end="2:29.243">意味が</span><span begin="2:29.243" end="2:29.959">ないん</span><span begin="2:29.959" end="2:30.939">だ</span></p><p begin="2:31.419" end="2:37.805" itunes:key="L18" ttm:agent="v1"><span begin="2:31.419" end="2:32.595">愛に</span><span begin="2:32.595" end="2:33.860">できる</span><span begin="2:34.044" end="2:35.127">ことは</span><span begin="2:35.127" end="2:36.063">まだ</span><span begin="2:36.063" end="2:36.846">ある</span><span begin="2:36.846" end="2:37.805">かい</span></p><p begin="2:38.171" end="2:45.201" itunes:key="L19" ttm:agent="v1"><span begin="2:38.171" end="2:39.379">僕に</span><span begin="2:39.379" end="2:40.392">できる</span><span begin="2:40.667" end="2:41.782">ことは</span><span begin="2:41.782" end="2:42.698">まだ</span><span begin="2:42.698" end="2:43.487">ある</span><span begin="2:43.487" end="2:45.201">かい</span></p><p begin="3:03.721" end="3:09.548" itunes:key="L20" ttm:agent="v1"><span begin="3:03.721" end="3:04.817">運命とは</span><span begin="3:04.817" end="3:06.193">つまり</span> <span begin="3:07.022" end="3:08.264">サイコロの</span><span begin="3:08.264" end="3:08.815">出た</span><span begin="3:08.815" end="3:09.548">目？</span></p><p begin="3:10.463" end="3:16.344" itunes:key="L21" ttm:agent="v1"><span begin="3:10.463" end="3:11.614">はたまた</span><span begin="3:11.614" end="3:12.843">神の</span> <span begin="3:13.979" end="3:14.970">いつもの</span><span begin="3:14.970" end="3:16.344">気まぐれ</span></p><p begin="3:17.322" end="3:22.921" itunes:key="L22" ttm:agent="v1"><span begin="3:17.322" end="3:17.908">選び</span><span begin="3:17.908" end="3:18.935">選ばれ</span><span begin="3:18.935" end="3:19.780">た</span> <span begin="3:20.695" end="3:21.722">脱げられぬ</span><span begin="3:21.722" end="3:22.921">鎧</span></p><p begin="3:23.975" end="3:29.807" itunes:key="L23" ttm:agent="v1"><span begin="3:23.975" end="3:25.016">もしくは</span><span begin="3:25.016" end="3:26.280">遥かな</span> <span begin="3:27.456" end="3:28.078">揺らぐ</span><span begin="3:28.078" end="3:28.923">ことない</span><span begin="3:28.923" end="3:29.807">意志</span></p><p begin="3:30.778" end="3:36.711" itunes:key="L24" ttm:agent="v1"><span begin="3:30.778" end="3:31.704">果たさぬ</span><span begin="3:31.704" end="3:32.382">願い</span><span begin="3:32.382" end="3:33.262">と</span> <span begin="3:34.209" end="3:35.058">叶わぬ</span><span begin="3:35.058" end="3:36.220">再会</span><span begin="3:36.220" end="3:36.711">と</span></p><p begin="3:37.522" end="3:43.402" itunes:key="L25" ttm:agent="v1"><span begin="3:37.522" end="3:38.482">ほどけぬ</span><span begin="3:38.482" end="3:39.253">誤解</span><span begin="3:39.253" end="3:39.982">と</span> <span begin="3:40.991" end="3:42.038">降り積もる</span><span begin="3:42.038" end="3:42.604">憎悪</span><span begin="3:42.604" end="3:43.402">と</span></p><p begin="3:44.325" end="3:50.093" itunes:key="L26" ttm:agent="v1"><span begin="3:44.325" end="3:46.012">許し合う声</span><span begin="3:46.012" end="3:46.728">と</span> <span begin="3:47.720" end="3:49.277">握りしめ合う</span><span begin="3:49.277" end="3:50.093">手を</span></p><p begin="3:51.072" end="3:56.773" itunes:key="L27" ttm:agent="v1"><span begin="3:51.072" end="3:52.175">この星は</span><span begin="3:52.175" end="3:53.348">今日も</span> <span begin="3:54.401" end="3:55.632">抱えて</span><span begin="3:55.632" end="3:56.773">生きてる</span></p><p begin="3:57.578" end="4:03.992" itunes:key="L28" ttm:agent="v1"><span begin="3:57.578" end="3:58.643">愛に</span><span begin="3:58.643" end="3:59.814">できる</span><span begin="4:00.162" end="4:01.265">ことは</span><span begin="4:01.265" end="4:02.163">まだ</span><span begin="4