<?xml version='1.0' encoding='UTF-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Suzume (feat. Toaka)"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Suzume (feat. Toaka) - Single"/><amll:meta key="isrc" value="JPV972200075"/><amll:meta key="appleMusicId" value="1647112151"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">流淌在你体内的 红色与蓝色的脉络</text><text for="L2">它们交织相系之处 正是那颗心脏</text><text for="L3">想要用哪怕置身狂风中也不致被淹没的声音</text><text for="L4">将那句欲传达给你的话语 悄悄在心底温存</text><text for="L5">光阴如枕木 风如温软肌肤 星辰是故土 人生如浮萍幻影</text><text for="L6">若问因何而泣 仅凭那一滴能道明缘由的泪水</text><text for="L7">根本无力承载 你我相遇这宿命的深意</text><text for="L8">仅凭这孤身一具 无论如何呼喊也难以倾尽</text><text for="L9">只在触碰到你指尖的瞬间 这颗心才真正颤动起来</text><text for="L10">还要跨过多少重意义的阻隔 我们才终能抵达彼此身边</text><text for="L11">任它愚昧痴傻也好 丑陋不堪也罢</text><text for="L12">在那所谓的正确彼方 我只想执起你的手</text><text for="L13">无从忆起 那些至为珍贵的回忆</text><text for="L14">难以成言 盘踞于此的万千情愫</text><text for="L15">抑或许 抑或许</text><text for="L16">仅仅靠着这些 便筑成了此刻的心房</text><text for="L17">又或者 又或者</text><text for="L18">只想让你听到那句呼唤 至今仍在你的胸膛</text><text for="L19">不住叩击震响</text><text for="L20">若被问及因何落泪 仅仅一句能说清缘由的呜咽</text><text for="L21">又怎能比拟 你我得以相逢的漫长羁绊</text><text for="L22">只凭我孑然一身 远不足以宣泄胸中的呐喊</text><text for="L23">唯有在轻触你掌心的一瞬 悸动的心才真正苏醒</text><text for="L24">究竟还要穿过多少重宿命的诘问 我们才能迎来归途</text><text for="L25">即便被看作荒唐也好 即便沦为狼狈也罢</text><text for="L26">在那道义的尽头 我愿与你携手共度余生</text></translation></translations><songwriters><songwriter>Nodayouzirou</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:48.418"><div begin="0:37.733" end="3:48.418"><p begin="0:37.733" end="0:42.912" itunes:key="L1" ttm:agent="v1"><span begin="0:37.733" end="0:39.220">君</span><span begin="0:39.220" end="0:39.439">の</span><span begin="0:39.439" end="0:39.729">中</span><span begin="0:39.729" end="0:40.173">に</span><span begin="0:40.173" end="0:40.791">ある</span> <span begin="0:40.791" end="0:41.214">赤</span><span begin="0:41.214" end="0:41.481">と</span><span begin="0:41.481" end="0:41.980">青</span><span begin="0:41.980" end="0:42.230">き</span><span begin="0:42.230" end="0:42.912">線</span></p><p begin="0:43.900" end="0:49.167" itunes:key="L2" ttm:agent="v1"><span begin="0:43.900" end="0:45.332">それ</span><span begin="0:45.332" end="0:45.709">らが</span><span begin="0:45.709" end="0:46.321">結</span><span begin="0:46.321" end="0:47.078">ばれる</span><span begin="0:47.078" end="0:47.596">のは</span> <span begin="0:47.596" end="0:48.129">心</span><span begin="0:48.129" end="0:48.412">の</span><span begin="0:48.412" end="0:49.167">臓</span></p><p begin="0:50.100" end="0:55.365" itunes:key="L3" ttm:agent="v1"><span begin="0:50.100" end="0:51.421">風</span><span begin="0:51.421" end="0:51.719">の</span><span begin="0:51.719" end="0:52.051">中</span><span begin="0:52.051" end="0:52.831">でも</span><span begin="0:52.831" end="0:53.221">負け</span><span begin="0:53.221" end="0:53.840">ない</span><span begin="0:53.840" end="0:54.302">ような</span><span begin="0:54.354" end="0:54.703">声</span><span begin="0:54.703" end="0:55.365">で</span></p><p begin="0:56.289" end="1:01.392" itunes:key="L4" ttm:agent="v1"><span begin="0:56.289" end="0:57.535">届</span><span begin="0:57.535" end="0:58.033">ける</span><span begin="0:58.033" end="0:58.977">言葉</span><span begin="0:58.977" end="0:59.185">を</span><span begin="0:59.185" end="0:59.668">今</span><span begin="0:59.668" end="0:59.951">は</span><span begin="0:59.951" end="1:00.468">育</span><span begin="1:00.468" end="1:00.977">てて</span><span begin="1:00.977" end="1:01.392">る</span></p><p begin="1:02.013" end="1:14.531" itunes:key="L5" ttm:agent="v1"><span begin="1:02.013" end="1:02.520">時</span><span begin="1:02.520" end="1:03.067">は</span><span begin="1:03.067" end="1:03.552">まくら</span><span begin="1:03.552" end="1:04.435">ぎ</span> <span begin="1:04.784" end="1:05.552">風</span><span begin="1:05.552" end="1:06.152">は</span><span begin="1:06.152" end="1:06.619">にきは</span><span begin="1:06.619" end="1:07.486">だ</span> <span begin="1:07.886" end="1:08.619">星</span><span begin="1:08.619" end="1:09.171">は</span><span begin="1:09.171" end="1:09.622">うぶす</span><span begin="1:09.622" end="1:10.555">な</span> <span begin="1:10.904" end="1:11.704">人</span><span begin="1:11.704" end="1:12.286">は</span><span begin="1:12.286" end="1:12.720">かげろ</span><span begin="1:12.720" end="1:14.531">う</span></p><p begin="1:14.663" end="1:20.873" itunes:key="L6" ttm:agent="v1"><span begin="1:14.663" end="1:15.372">なんで</span><span begin="1:15.372" end="1:16.563">泣いてるのと</span><span begin="1:16.563" end="1:17.019">聞かれ</span><span begin="1:17.019" end="1:17.427">答</span><span begin="1:17.427" end="1:17.735">え</span><span begin="1:17.735" end="1:18.943">れる</span> <span begin="1:19.324" end="1:19.940">涙</span><span begin="1:19.940" end="1:20.426">なんか</span><span begin="1:20.426" end="1:20.873">じゃ</span></p><p begin="1:20.891" end="1:26.852" itunes:key="L7" ttm:agent="v1"><span begin="1:20.891" end="1:21.289">僕</span><span begin="1:21.289" end="1:21.515">ら</span><span begin="1:21.515" end="1:22.946">出逢えたことの</span><span begin="1:22.946" end="1:23.550">意味には</span><span begin="1:23.550" end="1:23.847">ま</span><span begin="1:23.847" end="1:24.959">るで</span> <span begin="1:25.448" end="1:26.118">追いつ</span><span begin="1:26.118" end="1:26.499">か</span><span begin="1:26.499" end="1:26.852">ない</span></p><p begin="1:26.869" end="1:32.790" itunes:key="L8" ttm:agent="v1"><span begin="1:26.869" end="1:27.819">この身</span><span begin="1:27.819" end="1:28.371">ひと</span><span begin="1:28.371" end="1:29.437">つ</span><span begin="1:29.530" end="1:29.771">じゃ</span> <span begin="1:29.771" end="1:30.923">足りない</span><span begin="1:30.923" end="1:31.473">叫</span><span begin="1:31.473" end="1:32.790">び</span></p><p begin="1:33.187" end="1:39.226" itunes:key="L9" ttm:agent="v1"><span begin="1:33.187" end="1:34.119">君の手に</span><span begin="1:34.119" end="1:34.719">触れた</span><span begin="1:34.719" end="1:35.669">時にだけ</span><span begin="1:35.669" end="1:36.135">震</span><span begin="1:36.135" end="1:37.302">えた</span> <span begin="1:37.545" end="1:38.221">心</span><span begin="1:38.221" end="1:38.437">が</span><span begin="1:38.437" end="1:38.887">あった</span><span begin="1:38.887" end="1:39.226">よ</span></p><p begin="1:39.405" end="1:45.336" itunes:key="L10" ttm:agent="v1"><span begin="1:39.405" end="1:40.537">意味をいくつ</span><span begin="1:40.537" end="1:41.257">越えれば</span><span begin="1:41.257" end="1:41.678">僕</span><span begin="1:41.678" end="1:42.133">らは</span><span begin="1:42.133" end="1:42.947">辿</span><span begin="1:42.947" end="1:43.507">り</span> <span begin="1:43.918" end="1:44.545">つける</span><span begin="1:44.545" end="1:44.990">の</span><span begin="1:44.990" end="1:45.336">かな</span></p><p begin="1:45.372" end="1:51.254" itunes:key="L11" ttm:agent="v1"><span begin="1:45.372" end="1:45.915">愚</span><span begin="1:45.915" end="1:46.800">かさで</span><span begin="1:46.800" end="1:47.948">いい</span> <span begin="1:48.350" end="1:49.349">醜</span><span begin="1:49.349" end="1:49.924">さで</span><span begin="1:49.924" end="1:51.254">いい</span></p><p begin="1:51.550" end="1:59.110" itunes:key="L12" ttm:agent="v1"><span begin="1:51.550" end="1:52.038">正</span><span begin="1:52.038" end="1:53.032">しさの</span><span begin="1:53.032" end="1:53.924">その</span><span begin="1:53.924" end="1:54.540">先</span><span begin="1:54.540" end="1:55.441">で</span> <span begin="1:55.652" end="1:56.057">君</span><span begin="1:56.057" end="1:56.324">と</span><span begin="1:56.324" end="1:57.057">手を</span><span begin="1:57.057" end="1:57.809">取り</span><span begin="1:57.809" end="1:59.110">たい</span></p><p begin="2:09.754" end="2:15.007" itunes:key="L13" ttm:agent="v1"><span begin="2:09.754" end="2:10.148">思</span><span begin="2:10.148" end="2:10.548">い</span><span begin="2:10.548" end="2:11.281">出せな</span><span begin="2:11.281" end="2:11.916">い</span> <span begin="2:12.799" end="2:13.599">大切</span><span begin="2:13.599" end="2:13.833">な</span><span begin="2:13.833" end="2:14.260">記</span><span begin="2:14.260" end="2:15.007">憶</span></p><p begin="2:15.904" end="2:21.221" itunes:key="L14" ttm:agent="v1"><span begin="2:15.904" end="2:16.667">言葉</span><span begin="2:16.667" end="2:16.895">に</span><span begin="2:16.895" end="2:17.400">なら</span><span begin="2:17.400" end="2:18.099">ない</span> <span begin="2:18.917" end="2:19.835">ここにある</span><span begin="2:19.835" end="2:20.435">想</span><span begin="2:20.435" end="2:21.221">い</span></p><p begin="2:21.993" end="2:27.491" itunes:key="L15" ttm:agent="v1"><span begin="2:21.993" end="2:22.439">もし</span><span begin="2:22.439" end="2:23.004">か</span><span begin="2:23.004" end="2:23.540">した</span><span begin="2:23.540" end="2:24.255">ら</span> <span begin="2:25.094" end="2:25.572">もし</span><span begin="2:25.572" end="2:26.056">か</span><span begin="2:26.056" end="2:26.639">した</span><span begin="2:26.639" end="2:27.491">ら</span></p><p begin="2:28.175" end="2:33.495" itunes:key="L16" ttm:agent="v1"><span begin="2:28.175" end="2:28.619">それ</span><span begin="2:28.619" end="2:29.145">だ</span><span begin="2:29.145" end="2:29.548">けで</span><span begin="2:29.548" end="2:30.129">この</span><span begin="2:30.435" end="2:31.284">心</span><span begin="2:31.284" end="2:31.536">は</span><span begin="2:31.536" end="2:32.238">で</span><span begin="2:32.238" end="2:32.955">きて</span><span begin="2:32.955" end="2:33.495">る</span></p><p begin="2:34.368" end="2:39.624" itunes:key="L17" ttm:agent="v1"><span begin="2:34.368" end="2:34.792">もし</span><span begin="2:34.792" end="2:35.358">か</span><span begin="2:35.358" end="2:35.907">した</span><span begin="2:35.907" end="2:36.6