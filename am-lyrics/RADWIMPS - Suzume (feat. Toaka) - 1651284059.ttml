<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Suzume (feat. Toaka)"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Suzume (Motion Picture Soundtrack)"/><amll:meta key="isrc" value="JPV972200075"/><amll:meta key="appleMusicId" value="1651284059"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>野田洋次郎</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">流淌在你体内的 红色与蓝色的脉络</text><text for="L2">它们交织相系之处 正是那颗心脏</text><text for="L3">想要用哪怕置身狂风中也不致被淹没的声音</text><text for="L4">将那句欲传达给你的话语 悄悄在心底温存</text><text for="L5">光阴如枕木 风如温软肌肤 星辰是故土 人生如浮萍幻影</text><text for="L6">若问因何而泣 仅凭那一滴能道明缘由的泪水</text><text for="L7">根本无力承载 你我相遇这宿命的深意</text><text for="L8">仅凭这孤身一具 无论如何呼喊也难以倾尽</text><text for="L9">只在触碰到你指尖的瞬间 这颗心才真正颤动起来</text><text for="L10">还要跨过多少重意义的阻隔 我们才终能抵达彼此身边</text><text for="L11">任它愚昧痴傻也好 丑陋不堪也罢</text><text for="L12">在那所谓的正确彼方 我只想执起你的手</text><text for="L13">无从忆起 那些至为珍贵的回忆</text><text for="L14">难以成言 盘踞于此的万千情愫</text><text for="L15">抑或许 抑或许</text><text for="L16">仅仅靠着这些 便筑成了此刻的心房</text><text for="L17">又或者 又或者</text><text for="L18">只想让你听到那句呼唤 至今仍在你的胸膛</text><text for="L19">不住叩击震响</text><text for="L20">若被问及因何落泪 仅仅一句能说清缘由的呜咽</text><text for="L21">又怎能比拟 你我得以相逢的漫长羁绊</text><text for="L22">只凭我孑然一身 远不足以宣泄胸中的呐喊</text><text for="L23">唯有在轻触你掌心的一瞬 悸动的心才真正苏醒</text><text for="L24">究竟还要穿过多少重宿命的诘问 我们才能迎来归途</text><text for="L25">即便被看作荒唐也好 即便沦为狼狈也罢</text><text for="L26">在那道义的尽头 我愿与你携手共度余生</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:48.718"><div begin="0:38.033" end="3:48.718"><p begin="0:38.033" end="0:43.212" itunes:key="L1" ttm:agent="v1"><span begin="0:38.033" end="0:39.520">君</span><span begin="0:39.520" end="0:39.739">の</span><span begin="0:39.739" end="0:40.029">中</span><span begin="0:40.029" end="0:40.473">に</span><span begin="0:40.473" end="0:41.091">ある</span> <span begin="0:41.091" end="0:41.514">赤</span><span begin="0:41.514" end="0:41.781">と</span><span begin="0:41.781" end="0:42.280">青</span><span begin="0:42.280" end="0:42.530">き</span><span begin="0:42.530" end="0:43.212">線</span></p><p begin="0:44.200" end="0:49.467" itunes:key="L2" ttm:agent="v1"><span begin="0:44.200" end="0:45.632">それ</span><span begin="0:45.632" end="0:46.009">らが</span><span begin="0:46.009" end="0:46.621">結</span><span begin="0:46.621" end="0:47.378">ばれる</span><span begin="0:47.378" end="0:47.896">のは</span> <span begin="0:47.896" end="0:48.429">心</span><span begin="0:48.429" end="0:48.712">の</span><span begin="0:48.712" end="0:49.467">臓</span></p><p begin="0:50.400" end="0:55.665" itunes:key="L3" ttm:agent="v1"><span begin="0:50.400" end="0:51.721">風</span><span begin="0:51.721" end="0:52.019">の</span><span begin="0:52.019" end="0:52.351">中</span><span begin="0:52.351" end="0:53.131">でも</span><span begin="0:53.131" end="0:53.521">負け</span><span begin="0:53.521" end="0:54.140">ない</span><span begin="0:54.140" end="0:54.602">ような</span><span begin="0:54.654" end="0:55.003">声</span><span begin="0:55.003" end="0:55.665">で</span></p><p begin="0:56.589" end="1:01.692" itunes:key="L4" ttm:agent="v1"><span begin="0:56.589" end="0:57.835">届</span><span begin="0:57.835" end="0:58.333">ける</span><span begin="0:58.333" end="0:59.277">言葉</span><span begin="0:59.277" end="0:59.485">を</span><span begin="0:59.485" end="0:59.968">今</span><span begin="0:59.968" end="1:00.251">は</span><span begin="1:00.251" end="1:00.768">育</span><span begin="1:00.768" end="1:01.277">てて</span><span begin="1:01.277" end="1:01.692">る</span></p><p begin="1:02.313" end="1:14.831" itunes:key="L5" ttm:agent="v1"><span begin="1:02.313" end="1:02.820">時</span><span begin="1:02.820" end="1:03.367">は</span><span begin="1:03.367" end="1:03.852">まくら</span><span begin="1:03.852" end="1:04.735">ぎ</span> <span begin="1:05.084" end="1:05.852">風</span><span begin="1:05.852" end="1:06.452">は</span><span begin="1:06.452" end="1:06.919">にきは</span><span begin="1:06.919" end="1:07.786">だ</span> <span begin="1:08.186" end="1:08.919">星</span><span begin="1:08.919" end="1:09.471">は</span><span begin="1:09.471" end="1:09.922">うぶす</span><span begin="1:09.922" end="1:10.855">な</span> <span begin="1:11.204" end="1:12.004">人</span><span begin="1:12.004" end="1:12.586">は</span><span begin="1:12.586" end="1:13.020">かげろ</span><span begin="1:13.020" end="1:14.831">う</span></p><p begin="1:14.963" end="1:21.173" itunes:key="L6" ttm:agent="v1"><span begin="1:14.963" end="1:15.672">なんで</span><span begin="1:15.672" end="1:16.863">泣いてるのと</span><span begin="1:16.863" end="1:17.319">聞かれ</span><span begin="1:17.319" end="1:17.727">答</span><span begin="1:17.727" end="1:18.035">え</span><span begin="1:18.035" end="1:19.243">れる</span> <span begin="1:19.624" end="1:20.240">涙</span><span begin="1:20.240" end="1:20.726">なんか</span><span begin="1:20.726" end="1:21.173">じゃ</span></p><p begin="1:21.191" end="1:27.152" itunes:key="L7" ttm:agent="v1"><span begin="1:21.191" end="1:21.589">僕</span><span begin="1:21.589" end="1:21.815">ら</span><span begin="1:21.815" end="1:23.246">出逢えたことの</span><span begin="1:23.246" end="1:23.850">意味には</span><span begin="1:23.850" end="1:24.147">ま</span><span begin="1:24.147" end="1:25.259">るで</span> <span begin="1:25.748" end="1:26.418">追いつ</span><span begin="1:26.418" end="1:26.799">か</span><span begin="1:26.799" end="1:27.152">ない</span></p><p begin="1:27.169" end="1:33.090" itunes:key="L8" ttm:agent="v1"><span begin="1:27.169" end="1:28.119">この身</span><span begin="1:28.119" end="1:28.671">ひと</span><span begin="1:28.671" end="1:29.737">つ</span><span begin="1:29.830" end="1:30.071">じゃ</span> <span begin="1:30.071" end="1:31.223">足りない</span><span begin="1:31.223" end="1:31.773">叫</span><span begin="1:31.773" end="1:33.090">び</span></p><p begin="1:33.487" end="1:39.526" itunes:key="L9" ttm:agent="v1"><span begin="1:33.487" end="1:34.419">君の手に</span><span begin="1:34.419" end="1:35.019">触れた</span><span begin="1:35.019" end="1:35.969">時にだけ</span><span begin="1:35.969" end="1:36.435">震</span><span begin="1:36.435" end="1:37.602">えた</span> <span begin="1:37.845" end="1:38.521">心</span><span begin="1:38.521" end="1:38.737">が</span><span begin="1:38.737" end="1:39.187">あった</span><span begin="1:39.187" end="1:39.526">よ</span></p><p begin="1:39.705" end="1:45.636" itunes:key="L10" ttm:agent="v1"><span begin="1:39.705" end="1:40.837">意味をいくつ</span><span begin="1:40.837" end="1:41.557">越えれば</span><span begin="1:41.557" end="1:41.978">僕</span><span begin="1:41.978" end="1:42.433">らは</span><span begin="1:42.433" end="1:43.247">辿</span><span begin="1:43.247" end="1:43.807">り</span> <span begin="1:44.218" end="1:44.845">つける</span><span begin="1:44.845" end="1:45.290">の</span><span begin="1:45.290" end="1:45.636">かな</span></p><p begin="1:45.672" end="1:51.554" itunes:key="L11" ttm:agent="v1"><span begin="1:45.672" end="1:46.215">愚</span><span begin="1:46.215" end="1:47.100">かさで</span><span begin="1:47.100" end="1:48.248">いい</span> <span begin="1:48.650" end="1:49.649">醜</span><span begin="1:49.649" end="1:50.224">さで</span><span begin="1:50.224" end="1:51.554">いい</span></p><p begin="1:51.850" end="1:59.410" itunes:key="L12" ttm:agent="v1"><span begin="1:51.850" end="1:52.338">正</span><span begin="1:52.338" end="1:53.332">しさの</span><span begin="1:53.332" end="1:54.224">その</span><span begin="1:54.224" end="1:54.840">先</span><span begin="1:54.840" end="1:55.741">で</span> <span begin="1:55.952" end="1:56.357">君</span><span begin="1:56.357" end="1:56.624">と</span><span begin="1:56.624" end="1:57.357">手を</span><span begin="1:57.357" end="1:58.109">取り</span><span begin="1:58.109" end="1:59.410">たい</span></p><p begin="2:10.054" end="2:15.307" itunes:key="L13" ttm:agent="v1"><span begin="2:10.054" end="2:10.448">思</span><span begin="2:10.448" end="2:10.848">い</span><span begin="2:10.848" end="2:11.581">出せな</span><span begin="2:11.581" end="2:12.216">い</span> <span begin="2:13.099" end="2:13.899">大切</span><span begin="2:13.899" end="2:14.133">な</span><span begin="2:14.133" end="2:14.560">記</span><span begin="2:14.560" end="2:15.307">憶</span></p><p begin="2:16.204" end="2:21.521" itunes:key="L14" ttm:agent="v1"><span begin="2:16.204" end="2:16.967">言葉</span><span begin="2:16.967" end="2:17.195">に</span><span begin="2:17.195" end="2:17.700">なら</span><span begin="2:17.700" end="2:18.399">ない</span> <span begin="2:19.217" end="2:20.135">ここにある</span><span begin="2:20.135" end="2:20.735">想</span><span begin="2:20.735" end="2:21.521">い</span></p><p begin="2:22.293" end="2:27.791" itunes:key="L15" ttm:agent="v1"><span begin="2:22.293" end="2:22.739">もし</span><span begin="2:22.739" end="2:23.304">か</span><span begin="2:23.304" end="2:23.840">した</span><span begin="2:23.840" end="2:24.555">ら</span> <span begin="2:25.394" end="2:25.872">もし</span><span begin="2:25.872" end="2:26.356">か</span><span begin="2:26.356" end="2:26.939">した</span><span begin="2:26.939" end="2:27.791">ら</span></p><p begin="2:28.475" end="2:33.795" itunes:key="L16" ttm:agent="v1"><span begin="2:28.475" end="2:28.919">それ</span><span begin="2:28.919" end="2:29.445">だ</span><span begin="2:29.445" end="2:29.848">けで</span><span begin="2:29.848" end="2:30.429">この</span><span begin="2:30.735" end="2:31.584">心</span><span begin="2:31.584" end="2:31.836">は</span><span begin="2:31.836" end="2:32.538">で</span><span begin="2:32.538" end="2:33.255">きて</span><span begin="2:33.255" end="2:33.795">る</span></p><p begin="2:34.668" end="2:39.924" itunes:key="L17" ttm:agent="v1"><span begin="2:34.668" end="2:35.092">もし</span><span begin="2:35.092" end="2:35.658">か</span><span begin="2:35.658" end="2:36.207">した</span><span begin="2:36.207" end="2:36.943">ら</span> <span begin="2:37.711" end="2:38.143">もし</span><span begin="2:38.143" end="2:38.727">か</span><span begin="2:38.727" end="2:39.244">した</span><span begin="2:39.244" end="2:39.924">ら</span></p><p begin="2:40.742" end="2:46.252" itunes:key="L18" ttm:agent="v1"><span begin="2:40.742" end="2:41.310">君</span><span begin="2:41.310" end="2:41.547">に</span><span begin="2:41.716" end="2:42.314">「気づい</span><span begin="2:42.314" end="2:42.926">て」</span><span begin="2:43.094" end="2:43.494">と</span><span begin="2:43.494" end="2:43.878">今</span><span begin="2:43.878" end="2:44.160">も</span><span begin="2:44.199" end="2:44.887">その</span><span begin="2:44.887" end="2:45.428">胸</span><span begin="2:45.428" end="2:46.252">を</span></p><p begin="2:46.953" end="2:49.342" itunes:key="L19" ttm:agent="v1"><span begin="2:46.953" end="2:47.404">打</span><span begin="2:47.404" end="2:47.964">ち</span><span begin="2:47.964" end="2:48.450">鳴ら</span><span begin="2:48.450" end="2:49.342">す</span></p><p begin="3:04.197" end="3:10.407" itunes:key="L20" ttm:agent="v1"><span begin="3:04.197" end="3:04.906">なんで</span><span begin="3:04.906" end="3:06.097">泣いてるのと</span><span begin="3:06.097" end="3:06.553">聞かれ</span><span begin="3:06.553" end="3:06.961">答</span><span begin="3:06.961" end="3:07.269">え</span><span begin="3:07.269" end="3:08.477">れる</span> <span begin="3:08.858" end="3:09.474">涙</span><span begin="3:09.474" end="3:09.960">なんか</span><span begin="3:09.960" end="3:10.407">じゃ</span></p><p begin="3:10.401" end="3:16.362" itunes:key="L21" ttm:agent="v1"><span begin="3:10.401" end="3:10.799">僕</span><span begin="3:10.799" end="3:11.025">ら</span><span begin="3:11.025" end="3:12.456">出逢えたことの</span><span begin="3:12.456" end="3:13.060">意味には</span><span begin="3:13.060" end="3:13.357">ま</span><span begin="3:13.357" end="3:14.469">るで</span> <span begin="3:14.958" end="3:15.628">追いつ</span><span begin="3:15.628" end="3:16.009">か</span><span begin="3:16.009" end="3:16.362">ない</span></p><p begin="3:16.426" end="3:22.347" itunes:key="L22" ttm:agent="v1"><span begin="3:16.426" end="3:17.376">この身</span><span begin="3:17.376" end="3:17.928">ひと</span><span begin="3:17.928" end="3:18.994">つ</span><span begin="3:19.062" end="3:19.328">じゃ</span> <span begin="3:19.328" end="3:20.480">足りない</span><span begin="3:20.480" end="3:21.030">叫</span><span begin="3:21.030" end="3:22.347">び</span></p><p begin="3:22.736" end="3:28.775" itunes:key="L23" ttm:agent="v1"><span begin="3:22.736" end="3:23.668">君の手に</span><span begin="3:23.668" end="3:24.268">触れた</span><span begin="3:24.268" end="3:25.218">時にだけ</span><span begin="3:25.218" end="3:25.684">震</span><span begin="3:25.684" end="3:26.851">えた</span> <span begin="3:27.094" end="3:27.770">心</span><span begin="3:27.770" end="3:27.986">が</span><span begin="3:27.986" end="3:28.436">あった</span><span begin="3:28.436" end="3:28.775">よ</span></p><p begin="3:28.875" end="3:34.806" itunes:key="L24" ttm:agent="v1"><span begin="3:28.875" end="3:30.007">意味をいくつ</span><span begin="3:30.007" end="3:30.727">越えれば</span><span begin="3:30.727" end="3:31.148">僕</span><span begin="3:31.148" end="3:31.603">らは</span><span begin="3:31.603" end="3:32.417">辿</span><span begin="3:32.417" end="3:32.977">り</span> <span begin="3:33.388" end="3:34.015">つける</span><span begin="3:34.015" end="3:34.460">の</span><span begin="3:34.460" end="3:34.806">かな</span></p><p begin="3:34.961" end="3:40.843" itunes:key="L25" ttm:agent="v1"><span begin="3:34.961" end="3:35.504">愚</span><span begin="3:35.504" end="3:36.389">かさで</span><span begin="3:36.389" end="3:37.537">いい</span> <span begin="3:37.939" end="3:38.807">醜</span><span begin="3:38.807" end="3:39.513">さで</span><span begin="3:39.513" end="3:40.843">いい</span></p><p begin="3:41.042" end="3:48.718" itunes:key="L26" ttm:agent="v1"><span begin="3:41.042" end="3:41.516">正</span><span begin="3:41.516" end="3:42.500">しさの</span><span begin="3:42.500" end="3:43.433">その</span><