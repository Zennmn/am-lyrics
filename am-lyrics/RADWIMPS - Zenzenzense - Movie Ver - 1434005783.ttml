<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Zenzenzense - Movie Ver."/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="Your Name."/><amll:meta key="isrc" value="JPPO01617097"/><amll:meta key="appleMusicId" value="1434005783"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Yojiro Noda</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">你终于醒过来了吗</text><text for="L2">可为何连目光都不愿与我相交呢？</text><text for="L3">你嗔怪着说「太慢了」</text><text for="L4">我分明已经倾尽全力飞奔而来了啊</text><text for="L5">是心跳早已超越了奔跑的身躯啊</text><text for="L6">仅仅是望见你的发丝与眼眸 便教我隐隐心痛</text><text for="L7">想要与你呼吸同一瞬的光阴 永不分离</text><text for="L8">面对那自遥远过去便熟稔于心的声音</text><text for="L9">生平第一次 不知该如何启齿？</text><text for="L10">早在你的前前前世</text><text for="L11">我便已踏上寻你的旅程</text><text for="L12">循着你那笨拙又可爱的笑容</text><text for="L13">一路奔赴至此</text><text for="L14">纵然关于你的一切彻底消逝</text><text for="L15">零落成漫天尘埃</text><text for="L16">我也绝不再迷茫</text><text for="L17">依然会从头开始将你追寻</text><text for="L18">不如索性归零</text><text for="L19">重开一片属于我们的宇宙吧</text><text for="L20">该从何处说起呢</text><text for="L21">你在沉睡时所经历的那些故事</text><text for="L22">我跨越了亿万光年的浩瀚岁月 只为讲给你听</text><text for="L23">可当我真正将你的身影映入眼帘</text><text for="L24">只想同连你都未曾相识的你嬉笑打闹 依偎相伴</text><text for="L25">只想试着去深爱连同你抹不去的伤痛</text><text for="L26">跨越不知多少个银河的彼方 终于得以重逢</text><text for="L27">该怎样紧扣这双手 才不至于将它碰碎？</text><text for="L28">早在你的前前前世</text><text for="L29">我便已开始了对你的追寻</text><text for="L30">迎着你喧闹的话音与夺眶的泪水</text><text for="L31">一路奔赴而来</text><text for="L32">在这革命前夕的时刻 还有谁能将我们阻挡</text><text for="L33">绝不再动摇 誓要在你的心尖插上属于我的旗帜</text><text for="L34">是你彻底夺走了我轻言放弃的退路</text><text for="L35">早在前前前世</text><text for="L36">我便已将你苦苦找寻</text><text for="L37">循着你那略显笨拙的笑靥</text><text for="L38">义无反顾来到你身边</text><text for="L39">纵使你的一切全然化为乌有</text><text for="L40">碎落飘散在天地之间</text><text for="L41">我也不会再彷徨</text><text for="L42">依然会从最初重新寻觅你的踪迹</text><text for="L43">哪怕漫漫光年 也要一路轻哼着这支歌走下去</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:17.799"><div begin="0:19.788" end="4:17.799"><p begin="0:19.788" end="0:23.588" itunes:key="L1" ttm:agent="v1"><span begin="0:19.788" end="0:20.228">やっ</span><span begin="0:20.228" end="0:20.708">と</span><span begin="0:20.708" end="0:20.968">眼</span><span begin="0:20.968" end="0:21.458">を</span><span begin="0:21.908" end="0:22.148">覚</span><span begin="0:22.148" end="0:22.408">ま</span><span begin="0:22.408" end="0:22.638">し</span><span begin="0:22.638" end="0:22.828">た</span><span begin="0:22.828" end="0:23.588">かい</span></p><p begin="0:24.508" end="0:28.308" itunes:key="L2" ttm:agent="v1"><span begin="0:24.508" end="0:25.028">そ</span><span begin="0:25.028" end="0:25.338">れ</span><span begin="0:25.338" end="0:25.508">な</span><span begin="0:25.508" end="0:25.668">の</span><span begin="0:25.668" end="0:25.798">に</span><span begin="0:25.798" end="0:25.948">な</span><span begin="0:25.948" end="0:26.118">ぜ</span><span begin="0:26.118" end="0:26.268">眼</span><span begin="0:26.268" end="0:26.438">も</span><span begin="0:26.438" end="0:26.588">合</span><span begin="0:26.588" end="0:26.698">わ</span><span begin="0:26.698" end="0:26.898">せ</span><span begin="0:26.898" end="0:27.008">や</span><span begin="0:27.008" end="0:27.248">し</span><span begin="0:27.248" end="0:27.468">な</span><span begin="0:27.468" end="0:27.708">いん</span><span begin="0:27.708" end="0:28.308">だい？</span></p><p begin="0:30.245" end="0:33.505" itunes:key="L3" ttm:agent="v1"><span begin="0:30.245" end="0:30.785">「遅</span><span begin="0:30.785" end="0:31.015">いよ」</span><span begin="0:31.015" end="0:31.525">と</span><span begin="0:32.135" end="0:32.565">怒</span><span begin="0:32.565" end="0:32.735">る</span><span begin="0:32.735" end="0:33.505">君</span></p><p begin="0:34.717" end="0:38.557" itunes:key="L4" ttm:agent="v1"><span begin="0:34.717" end="0:35.127">こ</span><span begin="0:35.127" end="0:35.427">れ</span><span begin="0:35.427" end="0:35.607">で</span><span begin="0:35.607" end="0:35.757">も</span><span begin="0:35.757" end="0:35.947">や</span><span begin="0:35.947" end="0:36.087">れ</span><span begin="0:36.087" end="0:36.227">る</span><span begin="0:36.227" end="0:36.377">だ</span><span begin="0:36.377" end="0:36.537">け</span><span begin="0:36.537" end="0:36.687">飛</span><span begin="0:36.687" end="0:36.897">ば</span><span begin="0:36.897" end="0:37.017">し</span><span begin="0:37.017" end="0:37.137">て</span><span begin="0:37.137" end="0:37.307">き</span><span begin="0:37.307" end="0:37.637">たん</span><span begin="0:37.637" end="0:37.847">だ</span><span begin="0:37.847" end="0:38.557">よ</span></p><p begin="0:39.789" end="0:44.039" itunes:key="L5" ttm:agent="v1"><span begin="0:39.789" end="0:40.649">心</span><span begin="0:40.649" end="0:40.779">が</span><span begin="0:40.779" end="0:41.119">身</span><span begin="0:41.119" end="0:41.339">体</span><span begin="0:41.339" end="0:41.509">を</span><span begin="0:41.509" end="0:41.739">追い</span><span begin="0:41.739" end="0:41.969">越</span><span begin="0:41.969" end="0:42.089">し</span><span begin="0:42.089" end="0:42.199">て</span><span begin="0:42.199" end="0:42.369">き</span><span begin="0:42.369" end="0:42.719">たん</span><span begin="0:42.719" end="0:42.909">だ</span><span begin="0:42.909" end="0:44.039">よ</span></p><p begin="0:45.468" end="0:49.898" itunes:key="L6" ttm:agent="v1"><span begin="0:45.468" end="0:45.858">君</span><span begin="0:45.858" end="0:45.988">の</span><span begin="0:45.988" end="0:46.318">髪</span><span begin="0:46.318" end="0:46.468">や</span><span begin="0:46.468" end="0:46.968">瞳</span><span begin="0:46.968" end="0:47.108">だ</span><span begin="0:47.108" end="0:47.288">け</span><span begin="0:47.288" end="0:47.438">で</span><span begin="0:47.438" end="0:47.748">胸</span><span begin="0:47.748" end="0:47.968">が</span><span begin="0:47.968" end="0:49.008">痛</span><span begin="0:49.008" end="0:49.128">い</span><span begin="0:49.128" end="0:49.898">よ</span></p><p begin="0:50.610" end="0:54.800" itunes:key="L7" ttm:agent="v1"><span begin="0:50.610" end="0:50.890">同</span><span begin="0:50.890" end="0:51.030">じ</span><span begin="0:51.030" end="0:51.380">時</span><span begin="0:51.380" end="0:51.490">を</span><span begin="0:51.490" end="0:51.700">吸</span><span begin="0:51.700" end="0:51.820">い</span><span begin="0:51.820" end="0:52.190">込ん</span><span begin="0:52.190" end="0:52.350">で</span><span begin="0:52.350" end="0:52.620">離</span><span begin="0:52.620" end="0:52.790">し</span><span begin="0:52.790" end="0:52.960">た</span><span begin="0:52.960" end="0:53.130">く</span><span begin="0:53.130" end="0:54.070">な</span><span begin="0:54.070" end="0:54.220">い</span><span begin="0:54.220" end="0:54.800">よ</span></p><p begin="0:55.302" end="0:59.882" itunes:key="L8" ttm:agent="v1"><span begin="0:55.302" end="0:55.612">遥</span><span begin="0:55.612" end="0:55.982">か</span><span begin="0:55.982" end="0:56.612">昔</span><span begin="0:56.612" end="0:57.532">か</span><span begin="0:57.532" end="0:57.752">ら</span><span begin="0:57.982" end="0:58.202">知</span><span begin="0:58.202" end="0:58.392">る</span> <span begin="0:58.392" end="0:58.672">そ</span><span begin="0:58.672" end="0:58.902">の</span><span begin="0:58.902" end="0:59.452">声</span><span begin="0:59.452" end="0:59.882">に</span></p><p begin="1:00.565" end="1:07.565" itunes:key="L9" ttm:agent="v1"><span begin="1:00.565" end="1:01.025">生ま</span><span begin="1:01.025" end="1:01.155">れ</span><span begin="1:01.155" end="1:01.475">て</span><span begin="1:01.475" end="1:01.625">は</span><span begin="1:01.625" end="1:02.265">じ</span><span begin="1:02.265" end="1:02.535">め</span><span begin="1:02.535" end="1:02.905">て</span> <span begin="1:03.195" end="1:04.535">何</span><span begin="1:04.535" end="1:05.585">を</span><span begin="1:05.585" end="1:05.825">言</span><span begin="1:05.825" end="1:06.825">え</span><span begin="1:06.825" end="1:07.085">ば</span><span begin="1:07.085" end="1:07.565">いい？</span></p><p begin="1:07.772" end="1:10.292" itunes:key="L10" ttm:agent="v1"><span begin="1:07.772" end="1:08.122">君</span><span begin="1:08.122" end="1:08.242">の</span><span begin="1:08.242" end="1:08.572">前</span><span begin="1:08.572" end="1:08.902">前</span><span begin="1:08.902" end="1:09.172">前</span><span begin="1:09.172" end="1:09.352">世</span><span begin="1:09.352" end="1:09.542">か</span><span begin="1:09.542" end="1:09.692">ら</span><span begin="1:09.692" end="1:10.062">僕</span><span begin="1:10.062" end="1:10.292">は</span></p><p begin="1:10.293" end="1:12.233" itunes:key="L11" ttm:agent="v1"><span begin="1:10.293" end="1:10.723">君を</span><span begin="1:10.723" end="1:11.163">探</span><span begin="1:11.163" end="1:11.303">し</span><span begin="1:11.303" end="1:11.423">は</span><span begin="1:11.423" end="1:11.573">じ</span><span begin="1:11.573" end="1:11.713">め</span><span begin="1:11.713" end="1:11.893">た</span><span begin="1:11.893" end="1:12.233">よ</span></p><p begin="1:12.475" end="1:15.525" itunes:key="L12" ttm:agent="v1"><span begin="1:12.475" end="1:12.715">そ</span><span begin="1:12.715" end="1:12.845">の</span><span begin="1:12.845" end="1:12.965">ぶ</span><span begin="1:12.965" end="1:13.395">きっ</span><span begin="1:13.395" end="1:13.645">ちょ</span><span begin="1:13.645" end="1:13.785">な</span><span begin="1:13.785" end="1:14.235">笑い</span><span begin="1:14.235" end="1:14.775">方</span><span begin="1:14.775" end="1:14.915">を</span><span begin="1:14.915" end="1:15.085">め</span><span begin="1:15.085" end="1:15.205">が</span><span begin="1:15.205" end="1:15.365">け</span><span begin="1:15.365" end="1:15.525">て</span></p><p begin="1:15.533"