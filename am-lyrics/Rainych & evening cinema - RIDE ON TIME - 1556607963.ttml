<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">湛蓝的海平线</text><text for="L2">此刻正一路飞驰而去</text><text for="L3">感受着愈发澄明的</text><text for="L4">时光流转</text><text for="L5">啊 朝着悸动</text><text for="L6">世界开始转动</text><text for="L7">那是我几乎忘却的</text><text for="L8">遥远梦想再度来临</text><text for="L9">乘着时光</text><text for="L10">若心绪仍在漂泊</text><text for="L11">便温柔地将它接住</text><text for="L12">再轻轻拥入怀中</text><text for="L13">啊 乘着时光</text><text for="L14">点燃心中的火</text><text for="L15">让满溢的喜悦</text><text for="L16">向四方铺展开来 乘着时光</text><text for="L17">我那闪耀的未来</text><text for="L18">来吧 开始转动吧</text><text for="L19">连那些空洞的日子</text><text for="L20">也全都融进爱里</text><text for="L21">啊 多么美好的清晨</text><text for="L22">此刻就奔向你身边</text><text for="L23">把这颗炽热的心送去</text><text for="L24">再没有一丝迟疑</text><text for="L25">乘着时光</text><text for="L26">时光啊 从此奔涌向前</text><text for="L27">爱啊 从此绽放光芒</text><text for="L28">直到耀眼得令人目眩</text><text for="L29">啊 乘着时光</text><text for="L30">点燃心中的火</text><text for="L31">送给那振翅高飞的灵魂</text><text for="L32">一句 乘着时光</text><text for="L33">啊 把这颗炽热的心送去</text><text for="L34">就是此刻</text><text for="L35">啊 乘着时光</text><text for="L36">时光啊 从此奔涌向前</text><text for="L37">爱啊 从此绽放光芒</text><text for="L38">直到耀眼得令人目眩</text><text for="L39">啊 乘着时光</text><text for="L40">点燃心中的火</text><text for="L41">送给那振翅高飞的灵魂</text><text for="L42">一句 乘着时光</text><text for="L43">啊 啊 啊 乘着时光</text><text for="L44">若心绪仍在漂泊</text><text for="L45">便温柔地将它接住</text><text for="L46">再轻轻拥入怀中</text><text for="L47">啊 乘着时光</text><text for="L48">点燃心中的火</text><text for="L49">让满溢的喜悦</text><text for="L50">向四方铺展开来 乘着时光</text><text for="L51">乘着时光</text><text for="L52">时光啊 从此奔涌向前</text><text for="L53">爱啊 从此绽放光芒</text><text for="L54">直到耀眼得令人目眩</text><text for="L55">啊 乘着时光</text><text for="L56">点燃心中的火</text><text for="L57">送给那振翅高飞的灵魂</text></translation></translations></iTunesMetadata></metadata></head><body><div begin="0:01.368" end="4:26.757"><p begin="0:01.368" end="0:06.302" itunes:key="L1" ttm:agent="v1"><span begin="0:01.368" end="0:02.733">青い</span><span begin="0:03.855" end="0:05.599">水平線</span><span begin="0:05.599" end="0:06.302">を</span></p><p begin="0:07.368" end="0:10.143" itunes:key="L2" ttm:agent="v1"><span begin="0:07.368" end="0:07.600">い</span><span begin="0:07.600" end="0:07.861">ま</span><span begin="0:07.861" end="0:08.373">駆</span><span begin="0:08.373" end="0:08.654">け</span><span begin="0:08.654" end="0:09.082">抜</span><span begin="0:09.082" end="0:09.355">け</span><span begin="0:09.355" end="0:09.843">て</span><span begin="0:09.843" end="0:10.143">く</span></p><p begin="0:11.325" end="0:14.149" itunes:key="L3" ttm:agent="v1"><span begin="0:11.325" end="0:11.586">研</span><span begin="0:11.586" end="0:11.826">ぎ</span><span begin="0:11.826" end="0:12.426">澄</span><span begin="0:12.567" end="0:12.807">ま</span><span begin="0:12.807" end="0:13.348">さ</span><span begin="0:13.348" end="0:13.849">れ</span><span begin="0:13.849" end="0:14.149">た</span></p><p begin="0:15.072" end="0:21.340" itunes:key="L4" ttm:agent="v1"><span begin="0:15.072" end="0:15.672">時</span><span begin="0:15.853" end="0:16.453">の</span><span begin="0:17.034" end="0:17.634">流</span><span begin="0:17.855" end="0:18.455">れ</span><span begin="0:19.017" end="0:19.617">感</span><span begin="0:19.778" end="0:20.378">じ</span><span begin="0:21.040" end="0:21.340">て</span></p><p begin="0:21.821" end="0:26.066" itunes:key="L5" ttm:agent="v1"><span begin="0:21.821" end="0:21.851">Ah</span><span begin="0:21.851" end="0:21.861">-</span><span begin="0:21.861" end="0:22.101">ah</span><span begin="0:22.101" end="0:22.321">-</span><s