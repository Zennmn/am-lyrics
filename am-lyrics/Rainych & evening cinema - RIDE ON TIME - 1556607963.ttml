<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="ride on time"/><amll:meta key="artists" value="Rainych"/><amll:meta key="artists" value="evening cinema"/><amll:meta key="album" value="RIDE ON TIME - Single"/><amll:meta key="isrc" value="JPP302100182"/><amll:meta key="appleMusicId" value="1556607963"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Tatsuro Yamashita</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">迎着蔚蓝水平线</text><text for="L2">此刻正飞驰掠过</text><text for="L3">感受那愈发澄澈的</text><text for="L4">时光清澈流淌</text><text for="L5">Ah 向着怦然心动</text><text for="L6">开始运转的世界</text><text for="L7">宛如几近淡忘的</text><text for="L8">遥远梦想再度降临</text><text for="L9">Ride on time</text><text for="L10">若是彷徨迷惘的思绪</text><text for="L11">就温柔地悉数接纳</text><text for="L12">轻轻拥入怀中</text><text for="L13">Oh ride on time</text><text for="L14">点燃心中的火焰</text><text for="L15">在满溢的喜悦中</text><text for="L16">尽情绽放吧 Ride on time</text><text for="L17">我那光芒闪耀的未来</text><text for="L18">来吧 开始转动吧</text><text for="L19">纵是往昔空虚的日子</text><text for="L20">也都尽数融化在爱意中</text><text for="L21">Ah 多么灿烂的清晨</text><text for="L22">此刻奔赴你的身旁</text><text for="L23">前去送上</text><text for="L24">那颗炽热坚定的真心</text><text for="L25">Ride on time</text><text for="L26">时光啊 疾驰前行吧</text><text for="L27">爱啊 绽放光芒吧</text><text for="L28">耀眼得令人目眩</text><text for="L29">Oh ride on time</text><text for="L30">点燃心中的火焰</text><text for="L31">为展翅高飞的灵魂</text><text for="L32">送上一声 Ride on time</text><text for="L33">Ride on time</text><text for="L34">Oh 送去那颗炽热的心</text><text for="L35">正是此刻</text><text for="L36">Oh ride on time</text><text for="L37">时光啊 疾驰奔跑吧</text><text for="L38">爱啊 闪耀光芒吧</text><text for="L39">直至令人目眩神迷</text><text for="L40">Oh ride on time</text><text for="L41">点燃内心的火焰</text><text for="L42">为高飞远扬的灵魂</text><text for="L43">献上一声 Ride on time</text><text for="L44">Oh oh oh ride on time</text><text for="L45">若是游移彷徨的思绪</text><text for="L46">便温柔地予以包容</text><text for="L47">悄悄拥入怀中</text><text for="L48">Oh ride on time</text><text for="L49">点燃心中的火热</text><text for="L50">融入四溢的欢欣里</text><text for="L51">尽情盛放吧 Ride on time</text><text for="L52">Ride on time</text><text for="L53">时光啊 尽情飞驰吧</text><text for="L54">爱啊 璀璨闪耀吧</text><text for="L55">炫目得令人沉醉</text><text for="L56">Oh ride on time</text><text for="L57">点燃心底的火焰</text><text for="L58">为翱翔天际的灵魂</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:26.540"><div begin="0:01.519" end="4:26.540"><p begin="0:01.519" end="0:06.509" itunes:key="L1" ttm:agent="v1"><span begin="0:01.519" end="0:02.019">青</span><span begin="0:02.019" end="0:02.679">い</span><span begin="0:03.869" end="0:04.689">水</span><span begin="0:04.689" end="0:05.079">平</span><span begin="0:05.079" end="0:05.989">線</span><span begin="0:05.989" end="0:06.509">を</span></p><p begin="0:07.519" end="0:10.499" itunes:key="L2" ttm:agent="v1"><span begin="0:07.519" end="0:07.839">いま</span><span begin="0:07.909" end="0:08.339">駆</span><span begin="0:08.359" end="0:08.739">け</span><span begin="0:08.739" end="0:09.059">抜</span><span begin="0:09.059" end="0:09.369">け</span><span begin="0:09.369" end="0:09.769">て</span><span begin="0:09.799" end="0:10.499">く</span></p><p begin="0:11.403" end="0:14.313" itunes:key="L3" ttm:agent="v1"><span begin="0:11.403" end="0:11.673">研</span><span begin="0:11.673" end="0:11.813">ぎ</span><span begin="0:11.813" end="0:12.653">澄</span><span begin="0:12.653" end="0:12.803">ま</span><span begin="0:12.803" end="0:13.453">さ</span><span begin="0:13.453" end="0:13.753">れ</span><span begin="0:13.873" end="0:14.313">た</span></p><p begin="0:1