<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="I Really Want to Stay At Your House"/><amll:meta key="artists" value="Rosa Walton"/><amll:meta key="artists" value="Hallie Coggins"/><amll:meta key="album" value="Cyberpunk 2077: Radio, Vol. 2 (Original Soundtrack)"/><amll:meta key="album" value="Cyberpunk : Edgerunners Soundtrack Vol.1 (Ep1+2)"/><amll:meta key="appleMusicId" value="1540793097"/><amll:meta key="appleMusicId" value="1541001553"/><amll:meta key="ttmlAuthorGithub" value="72502111"/><amll:meta key="ttmlAuthorGithubLogin" value="Havenmab"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">我等不及你来清理这橱柜</text><text for="L2">但如今你离去 只留下一处标记</text><text for="L3">又一个夜晚 我静坐品味你言外之意</text><text for="L4">因为我却时刻思念着你</text><text for="L5">所以 那就离开吧</text><text for="L6">只为让自己不愿了解真相</text><text for="L7">放任你自己走吧</text><text for="L8">你深知你并未失去自制力</text><text for="L9">让我们于彩虹之上开始</text><text for="L10">拒绝内心纷扰</text><text for="L11">另一种方式前往你不愿涉足半步的天地</text><text for="L12">放任你自己走吧</text><text for="L13">这是否等于妥协了呢</text><text for="L14">所以你想做什么呢 说出你的观点</text><text for="L15">这里有场狂欢派对 你是否想去呢</text><text for="L16">同你握手 询问你的看法</text><text for="L17">我全心倾覆于你 不愿离去</text><text for="L18">因为我真的想要呆在你家里</text><text for="L19">多希望能一直呆着</text><text for="L20">但你知道 你令我内心多么分崩离析</text><text for="L21">我已经受够你了 我要将你忽视</text><text for="L22">我不想再了解了</text><text for="L23">我意识到 你深陷于恶劣环境中</text><text for="L24">因为我已竭尽全力 只为陪伴你身旁</text><text for="L25">所以当你告诉我 我就是其中的原因时 对于这些谎言 我简直难以置信</text><text for="L26">为何我这么想给你打电话</text><text for="L27">所以你想做什么呢 说出你的观点</text><text for="L28">这里有场狂欢派对 你是否想去呢</text><text for="L29">同你握手 询问你的看法</text><text for="L30">我全心倾覆于你 不愿离去</text><text for="L31">因为我真的想要呆在你家里</text><text for="L32">我希望这一切都会成功</text><text for="L33">但你知道 你令我内心多么分崩离析</text><text for="L34">我已经受够你了 我要将你忽视</text><text for="L35">我不想再了解了</text><text for="L36">You-</text><text for="L37">Oh-oh oh-oh-oh</text><text for="L38">我不知为何 自己的内心犹如沉溺水下</text><text for="L39">所以 那就离开吧</text><text for="L40">只为让自己不愿了解真相</text><text for="L41">放任你自己走吧</text><text for="L42">你深知 你并未失去自制力</text><text for="L43">让我们于彩虹之上开始</text><text for="L44">拒绝内心纷扰</text><text for="L45">只为让自己不愿继续前行</text><text for="L46">放任你自己走吧</text><text for="L47">这是否等于妥协了呢</text><text for="L48">所以你想做什么呢 说出你的观点</text><text for="L49">这里有场狂欢派对 你是否想去呢</text><text for="L50">同你握手 询问你的看法</text><text for="L51">我全心倾覆于你 不愿离去</text><text for="L52">因为我真的想要呆在你家里</text><text for="L53">我希望这一切都会成功</text><text for="L54">但你知道 你令我内心多么分崩离析</text><text for="L55">我已经受够你了 我要将你忽视</text><text for="L56">我不想再了解了</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:00.834"><div begin="0:01.176" end="4:00.834"><p begin="0:01.176" end="0:04.753" itunes:key="L1" ttm:agent="v1"><span begin="0:01.176" end="0:01.408">I</span> <span begin="0:01.408" end="0:01.649">coul</span><span begin="0:01.649" end="0:01.883">dn't</span> <span begin="0:01.883" end="0:02.158">wait</span> <span begin="0:02.158" end="0:02.384">for</span> <span begin="0:02.384" end="0:02.654">you</span> <span begin="0:02.654" end="0:02.901">to</span> <span begin="0:02.901" end="0:03.279">come</span> <span begin="0:03.279" end="0:03.508">clear</span> <span begin="0:03.508" end="0:03.749">the</span> <span begin="0:03.749" end="0:03.961">cup</span><span begin="0:03.961" end="0:04.753">boards</span></p><p begin="0:08.861" end="0:12.176" itunes:key="L2" ttm:agent="v1"><span begin="0:08.861" end="0:09.101">But</span> <span begin="0:09.101" end="0:09.313">now</span> <span begin="0:09.313" end="0:09.461">you're</span> <span begin="0:09.461" end="0:09.