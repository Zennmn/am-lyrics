a </span><span begin="0:31.093" end="0:31.323">nat</span><span begin="0:31.323" end="0:31.573">toku </span><span begin="0:31.573" end="0:31.703">de</span><span begin="0:31.703" end="0:31.813">ki</span><span begin="0:31.813" end="0:31.983">na</span><span begin="0:31.983" end="0:32.293">in</span><span begin="0:32.293" end="0:32.703">da</span></text><text for="L8"><span begin="0:32.960" end="0:33.180">mot</span><span begin="0:33.180" end="0:33.330">to </span><span begin="0:33.330" end="0:33.550">mot</span><span begin="0:33.550" end="0:33.670">to </span><span begin="0:33.670" end="0:33.830">ya</span><span begin="0:33.830" end="0:33.940">re</span><span begin="0:33.940" end="0:34.170">run</span><span begin="0:34.170" end="0:34.400">da</span></text><text for="L9"><span begin="0:34.551" end="0:34.991">sei</span><span begin="0:34.991" end="0:35.571">kai </span><span begin="0:35.571" end="0:35.731">wa </span><span begin="0:35.731" end="0:36.201">na</span><span begin="0:36.201" end="0:36.511">i no</span><span begin="0:36.511" end="0:36.641">ni </span><span begin="0:36.641" end="0:37.181">moto</span><span begin="0:37.181" end="0:37.391">me</span><span begin="0:37.391" end="0:37.671">te</span><span begin="0:37.671" end="0:38.171">ru</span></text><text for="L10"><span begin="0:38.636" end="0:39.276">ona</span><span begin="0:39.276" end="0:39.466">ji </span><span begin="0:39.466" end="0:39.896">kyou </span><span begin="0:39.896" end="0:40.246">wa </span><span begin="0:40.246" end="0:40.416">ni</span><span begin="0:40.416" end="0:40.786">do </span><span begin="0:40.786" end="0:41.146">to </span><span begin="0:41.146" end="0:41.336">ko</span><span begin="0:41.336" end="0:41.586">na</span><span begin="0:41.586" end="0:41.776">in </span><span begin="0:41.776" end="0:42.116">da</span></text><text for="L11"><span begin="0:42.356" end="0:42.656">wa</span><span begin="0:42.656" end="0:42.986">kat</span><span begin="0:42.986" end="0:43.296">ten </span><span begin="0:43.296" end="0:43.666">