<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Play with Fire (feat. Yacht Money)"/><amll:meta key="artists" value="Sam Tinnesz"/><amll:meta key="album" value="Play with Fire (feat. Yacht Money) - Single"/><amll:meta key="isrc" value="TCADC1794515"/><amll:meta key="appleMusicId" value="1892123257"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">心底潜藏着疯狂</text><text for="L2">危险令我如痴如狂</text><text for="L3">我早已身不由己</text><text for="L4">藏着不能言说的秘密</text><text for="L5">我迷恋汽油的气息</text><text for="L6">划亮火柴去品尝灼热</text><text for="L7">我向来喜欢玩火</text><text for="L8">纵情玩火</text><text for="L9">我向来喜欢玩火</text><text for="L10">我游走在危险边缘</text><text for="L11">我游走在危险边缘</text><text for="L12">速度直逼仪表的红线</text><text for="L13">热血在血管中奔涌</text><text for="L14">热血在血管中奔涌</text><text for="L15">我的欢愉是他们的痛</text><text for="L16">我爱看城堡付之一炬</text><text for="L17">金色的余烬化作尘泥</text><text for="L18">我向来喜欢玩火</text><text for="L19">我向来喜欢玩火</text><text for="L20">纵情玩火</text><text for="L21">尽情玩火</text><text for="L22">火焰 熊熊火焰</text><text for="L23">我向来喜欢玩火</text><text for="L24">看那火舌越蹿越高</text><text for="L25">我向来喜欢玩……</text><text for="L26">Mmm</text><text for="L27">拥有通行之权 典型的独行者</text><text for="L28">油箱里的一根火柴</text><text for="L29">喔 真是邪门</text><text for="L30">势不可挡的传奇野兽 嗯</text><text for="L31">数字正义 现在就让你们见识我们</text><text for="L32">向掀起喧嚣的国王与王后致敬</text><text for="L33">Yacht Money 兴奋难抑 无可否认<span ttm:role="x-bg">(我向来喜欢玩火)</span></text><text for="L34">纵情玩火</text><text for="L35">向来喜欢玩火</text><text for="L36">尽情玩火</text><text for="L37">我向来喜欢玩火</text><text for="L38">火焰 熊熊火焰</text><text for="L39">我向来喜欢玩火</text><text for="L40">向来喜欢玩火</text><text for="L41">我向来喜欢玩——</text></translation></translations><songwriters><songwriter>Samuel Anton Tinnesz, Rebecca Lauren Olds &amp; Solomon Jerome Olds</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="2:48.803"><div begin="0:06.837" end="2:48.803"><p begin="0:06.837" end="0:09.627" itunes:key="L1" ttm:agent="v1"><span begin="0:06.837" end="0:07.107">In</span><span begin="0:07.107" end="0:08.037">sane</span> <span begin="0:08.487" end="0:08.687">in</span><span begin="0:08.687" end="0:09.627">side</span></p><p begin="0:09.977" end="0:12.727" itunes:key="L2" ttm:agent="v1"><span begin="0:09.977" end="0:10.267">The</span> <span begin="0:10.267" end="0:10.827">dan</span><span begin="0:10.827" end="0:11.127">ger</span> <span begin="0:11.127" end="0:11.627">gets</span> <span begin="0:11.627" end="0:11.977">me</span> <span begin="0:11.977" end="0:12.727">high</span></p><p begin="0:13.174" end="0:16.034" itunes:key="L3" ttm:agent="v1"><span begin="0:13.174" end="0:13.664">Can't</span> <span begin="0:13.664" end="0:14.264">help</span> <span begin="0:14.774" end="0:15.094">my</span><span begin="0:15.094" end="0:16.034">self</span></p><p begin="0:16.386" end="0:19.116" itunes:key="L4" ttm:agent="v1"><span begin="0:16.386" end="0:16.726">Got</span> <span begin="0:16.726" end="0:17.096">se</span><span begin="0:17.096" end="0:17.666">crets</span> <span begin="0:17.666" end="0:17.926">I</span> <span begin="0:17.926" end="0:18.356">can't</span> <span begin="0:18.356" end="0:19.116">tell</span></p><p begin="0:19.666" end="0:23.226" itunes:key="L5" ttm:agent="v1"><span begin="0:19.666" end="0:19.966">I</span> <span begin="0:19.966" end="0:20.436">love</span> <span begin="0:20.436" end="0:20.626">the</span> <span begin="0:20.626" end="0:21.306">smell</span> <span begin="0:21.306" end="0:21.576">of</span> <span begin