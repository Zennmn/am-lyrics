<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><!--桜島麻衣 (CV:瀬戸麻沙美)--><ttm:agent type="person" xml:id="v2"/><!--古賀朋絵 (CV:東山奈央)--><ttm:agent type="person" xml:id="v3"/><!--双葉理央 (CV:種﨑敦美)--><ttm:agent type="person" xml:id="v4"/><!--豊浜のどか (CV:内田真礼)--><ttm:agent type="person" xml:id="v5"/><!--梓川かえで (CV:久保ユリカ)--><ttm:agent type="person" xml:id="v6"/><!--牧之原翔子 (CV:水瀬いのり)--><amll:meta key="musicName" value="Fukashigi no KARTE"/><amll:meta key="artists" value="Mai Sakurajima(CV:Asami Seto)"/><amll:meta key="artists" value="Tomoe Koga(CV:Nao Toyama)"/><amll:meta key="artists" value="Rio Futaba(CV:Atsumi Tanezaki)"/><amll:meta key="artists" value="Nodoka Toyohama(CV:Maaya Uchida)"/><amll:meta key="artists" value="Kaede Azusagawa(CV:Yurika Kubo) "/><amll:meta key="artists" value="Shoko Makinohara(CV:Inori Minase)"/><amll:meta key="album" value="Seishunbutayarouhabunnygirlsenpainoyumewominai Fukashigi no KARTE"/><amll:meta key="isrc" value="JPE301800963"/><amll:meta key="appleMusicId" value="1537806863"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Hidehiro Kawai</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">难以言说 辗转难眠的梦曲</text><text for="L2">你眼中所见的真相</text><text for="L3">无人能读懂的病历</text><text for="L4">不可思议 只想探寻究竟</text><text for="L5">谎言也好 现实也罢</text><text for="L6">原来二者都曾是真实</text><text for="L7">千真万确</text><text for="L8">今日也独自低语</text><text for="L9">什么都不要勉强</text><text for="L10">我渴望被爱</text><text for="L11">含混不清的告别 微微的眩晕</text><text for="L12">没有你的现象世界</text><text for="L13">那无人读懂的病历</text><text for="L14">自我意识满溢而出</text><text for="L15">心跳 与世界的模样</text><text for="L16">始终无法彼此契合</text><text for="L17">隐隐作痛</text><text for="L18">每一夜许下心愿</text><text for="L19">什么都不要怀疑</text><text for="L20">只愿与你交融无间</text><text for="L21">琐碎难解的缘由与存在</text><text for="L22">与你一同留下的遗憾</text><text for="L23">无人能读懂的病历</text><text for="L24">不快一再重演</text><text for="L25">正确的梦</text><text for="L26">悲伤的声音</text><text for="L27">美丽吗？</text><text for="L28">可疑吗？</text><text for="L29">令人羡慕吗？</text><text for="L30">呐</text><text for="L31">是哪一个？</text><text for="L32">无法诉说 无法入眠的梦曲</text><text for="L33">你所看见的真实面貌</text><text for="L34">无人能读懂的病历</text><text for="L35">不可思议 只想弄明白</text><text for="L36">没有什么是永不结束的 梦曲</text><text for="L37">与你一同跨越的界限</text><text for="L38">那无人读懂的病历</text><text for="L39">青春期 伤口 心底的隐秘</text><text for="L40">不可思议 只想探寻究竟</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.198" end="0:00.630">kata</span><span begin="0:00.630" end="0:00.839">re</span><span begin="0:00.839" end="0:01.373">nai</span> <span begin="0:01.473" end="0:01.890">nemu</span><span begin="0:01.890" end="0:02.070">re</span><span begin="0:02.070" end="0:02.623">nai</span> <span begin="0:02.712" end="0:02.910">to</span><span begin="0:02.910" end="0:03.140">ro</span><span begin="0:03.140" end="0:03.300">i</span><span begin="0:03.300" end="0:03.963">me</span><span begin="0:03.963" end="0:04.780">rai</span></text><text for="L2"><span begin="0:05.197" end="0:05.350">a</span><span begin="0:05.350" end="0:05.579">na</span><span begin="0:05.579" end="0:05.803">ta</span> <span begin="0:05.803" end="0:06.230">no</span> <span begin="0:06.440" end="0:06.606">mi</span><span begin="0:06.606" end="0:06.860">te</span><span begin="0:06.860" end="0:06.980">ru</span> <span begin="0