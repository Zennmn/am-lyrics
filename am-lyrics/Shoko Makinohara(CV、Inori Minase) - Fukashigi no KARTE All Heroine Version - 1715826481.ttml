<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name>桜島麻衣(CV:瀬戸麻沙美)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name>古賀朋絵(CV:東山奈央)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v3"><ttm:name>双葉理央(CV:種﨑敦美)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v4"><ttm:name>豊浜のどか(CV:内田真礼)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v5"><ttm:name>梓川かえで(CV:久保ユリカ)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v6"><ttm:name>梓川花楓(CV:久保ユリカ)</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v7"><ttm:name>牧之原翔子(CV:水瀬いのり)</ttm:name></ttm:agent><amll:meta key="musicName" value="不可思議のカルテ (All Heroine Ver.)"/><amll:meta key="artists" value="桜島麻衣(CV:瀬戸麻沙美)"/><amll:meta key="artists" value="古賀朋絵(CV:東山奈央)"/><amll:meta key="artists" value="双葉理央(CV:種﨑敦美)"/><amll:meta key="artists" value="豊浜のどか(CV:内田真礼)"/><amll:meta key="artists" value="梓川かえで(CV:久保ユリカ)"/><amll:meta key="artists" value="梓川花楓(CV:久保ユリカ)"/><amll:meta key="artists" value="牧之原翔子(CV:水瀬いのり)"/><amll:meta key="album" value="不可思議のカルテ (All Heroine Ver.) - Single"/><amll:meta key="isrc" value="JPE302301033"/><amll:meta key="appleMusicId" value="1715826481"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">难以言说 辗转难眠</text><text for="L2">梦幻曲</text><text for="L3">你眼中所见的真容</text><text for="L4">无人能解的病历</text><text for="L5">这份不可思议 我只想去知晓</text><text for="L6">谎言也好 现实也罢</text><text for="L7">两者皆曾是真实</text><text for="L8">是真的呀</text><text for="L9">今日亦是喃喃独语</text><text for="L10">什么都不必勉强自己</text><text for="L11">我渴望被爱</text><text for="L12">含糊不清 道声再见</text><text for="L13">微微的眩晕</text><text for="L14">没有你的现象界</text><text for="L15">谁也无法读懂的病历</text><text for="L16">自我意识 漫溢而出</text><text for="L17">心跳 与世界图景</text><text for="L18">总是难以契合</text><text for="L19">隐隐作痛</text><text for="L20">每夜都在轻声许愿</text><text for="L21">什么都不必再怀疑</text><text for="L22">渴望交融为一体</text><text for="L23">微不足道 茫然无解</text><text for="L24">缘由 存在</text><text for="L25">与你留下的悔恨</text><text for="L26">无人能读透的病历</text><text for="L27">烦闷不快 反复重演</text><text for="L28">正确的梦境</text><text for="L29">哀伤的声音</text><text for="L30">是美丽吗</text><text for="L31">还是可疑</text><text for="L32">抑或令人艳羡</text><text for="L33">呐</text><text for="L34">究竟是哪一个</text><text for="L35">无从倾诉 彻夜难眠</text><text for="L36">迷离幻梦</text><text for="L37">你眼中映出的真身</text><text for="L38">谁也无法解读的病历</text><text for="L39">如此不可思议 只是渴望知晓</text><text for="L40">没有什么不会落幕</text><text for="L41">这一场幻梦</text><text for="L42">与你跨过的边界</text><text for="L43">任谁都无从解读的病历</text><text for="L44">青春期 伤痕深藏心底</text><text for="L45">这不可思议 只愿能去了解</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.199" end="0:00.629">kata</span><span begin="0:00.629" end="0:00.809">re</span><span begin="0:00.809" end="0:01.457">nai</span> <span begin="0:01.457" end="0:01.899">nemu</span><span begin="0:01.899" end="0:02.118">re</span><span begin="0:02.118" end="0:02.679">nai</span></text><text for="L2"><span begin="0:02.689" end="0:02.919">to</span><span begin="0:02.919" end="0:03.149">ro</span><span begin="0:03.149" end="0:03.309">i</span><span begin="0:03.309" end="0:03.949">me</span><span begin="0:03.949" end="0:04.799">rai</span></text><text for="L3"><span begin="0:05.225" end="0:05.355">a</span><span begin="0:05.355" end="0:05.555">na</span><span begi