<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Doushite (feat. Emi Noda)"/><amll:meta key="artists" value="Toya Takase"/><amll:meta key="album" value="The 1st of the 13th Month - EP"/><amll:meta key="isrc" value="TCJPQ2286232"/><amll:meta key="appleMusicId" value="1605552326"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Toya Takase</songwriter><songwriter>RINZO</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">为何偏偏是你</text><text for="L2">总在伤感的夜里萦绕心间</text><text for="L3">曾那样不顾一切地喜欢你</text><text for="L4">正因太过喜欢 反而没能好好爱你</text><text for="L5">你和我</text><text for="L6">今夜 今夜 你已不在</text><text for="L7">至今还无法向任何人诉说</text><text for="L8">即使想要放手 却终究放不下</text><text for="L9">除了想见你 再说不出别的话</text><text for="L10">事到如今已没有两全之法 天也快亮了</text><text for="L11">能与你共度的今天 真好</text><text for="L12">可若一直这样下去 结局一定还是一样</text><text for="L13">为何偏偏是你</text><text for="L14">总在这样的夜里浮现心头？</text><text for="L15">就连散落满屋的爱</text><text for="L16">如今也成了凌乱的爱情呓语</text><text for="L17">你和我</text><text for="L18">今夜 今夜 你已不在</text><text for="L19">至今仍不愿向任何人诉说</text><text for="L20">就算想要放手 还是没法放下啊</text><text for="L21">除了想见你 再说不出别的话</text><text for="L22">事到如今已没有两全之法 天也快亮了</text><text for="L23">能与你共度的今天多么美好</text><text for="L24">可若还是这样下去 结局一定不会改变</text><text for="L25">就算有比你更加出色的人</text><text for="L26">在我心里也终究无法胜过你啊</text><text for="L27">可今夜 今夜 你不在身边</text><text for="L28">直到现在还未曾对谁说起</text><text for="L29">即使想要放手 却始终无法放下 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(即使想要放手)</span></text><text for="L30">除了想见你 再说不出别的话</text><text for="L31">事到如今已没有两全之法 天也快亮了</text><text for="L32">今天也能与你相伴 真好</text><text for="L33">梦醒时分 今天却已然结束</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal"><text for="L1"><span begin="0:19.455" end="0:19.935">dou</span><span begin="0:19.935" end="0:20.065">shi</span><span begin="0:20.065" end="0:20.845">te</span> <span begin="0:21.045" end="0:22.245">kimi</span> <span begin="0:22.245" end="0:22.415">no</span> <span begin="0:22.415" end="0:22.945">ko</span><span begin="0:22.945" end="0:24.185">to</span></text><text for="L2"><span begin="0:25.685" end="0:26.425">setsu</span><span begin="0:26.425" end="0:27.155">nai</span> <span begin="0:27.495" end="0:28.085">yoru</span> <span begin="0:28.085" end="0:28.355">ni</span> <span begin="0:28.725" end="0:29.385">omot</span><span begin="0:29.385" end="0:29.965">te</span> <span begin="0:30.175" end="0:30.453">shi</span><span begin="0:30.453" end="0:30.985">mau</span> <span begin="0:30.985" end="0:32.059">no</span></text><text for="L3"><span begin="0:32.440" end="0:32.670">ga</span><span begin="0:32.670" end="0:32.810">mu</span><span begin="0:32.810" end="0:33.080">sha</span><span begin="0:33.080" end="0:33.270">ra</span> <span begin="0:33.270" end="0:33.400">ni</span> <span begin="0:33.400" end="0:33.630">su</span><span begin="0:33.630" end="0:33.840">ki</span> <span begin="0:33.840" end="0:34.210">dat</span><span begin="0:34.210" end="0:35.130">ta</span></text><text for="L4"><span begin="0:35.610" end="0:35.840">su</span><span begin="0:35.840" end="0:36.010">ki</span> <span begin="0:36.010" end="0:36.250">su</span><span begin="0:36.250" end="0:36.420">gi</span><span begin="0:36.420" end="0:36.65