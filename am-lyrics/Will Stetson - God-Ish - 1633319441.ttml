40">tu-</span><span begin="0:31.540" end="0:31.710">tu-</span><span begin="0:31.710" end="0:31.940">ru,</span> <span begin="0:31.940" end="0:32.030">a</span> <span begin="0:32.030" end="0:32.480">God-</span><span begin="0:32.480" end="0:32.770">ish</span> <span begin="0:32.770" end="0:33.500">like</span></p><p begin="0:33.780" end="0:36.580" itunes:key="L13" ttm:agent="v1"><span begin="0:33.780" end="0:33.930">Now,</span> <span begin="0:33.930" end="0:34.260">stop</span> <span begin="0:34.260" end="0:34.410">it,</span> <span begin="0:34.410" end="0:34.580">just</span> <span begin="0:34.580" end="0:34.900">stop</span> <span begin="0:34.900" end="0:35.050">it,</span> <span begin="0:35.050" end="0:35.210">come</span> <span begin="0:35.210" end="0:35.310">on</span> <span begin="0:35.310" end="0:35.420">and</span> <span begin="0:35.420" end="0:35.740">stop</span> <span begin="0:35.740" end="0:35.890">it,</span> <span begin="0:35.890" end="0:36.040">just</span> <span begin="0:36.040" end="0:36.390">stop</span> <span begin="0:36.390" end="0:36.580">it</span></p><p begin="0:36.580" end="0:40.220" itunes:key="L14" ttm:agent="v1"><span begin="0:36.580" end="0:36.770">I'm</span> <span begin="0:36.770" end="0:36.980">get</span><span begin="0:36.980" end="0:37.140">ting</span> <span begin="0:37.140" end="0:37.650">worked</span> <span begin="0:37.650" end="0:38.040">up,</span> <span begin="0:38.040" end="0:38.430">body</span> <span begin="0:38.430" end="0:38.680">burn</span><span begin="0:38.680" end="0:38.850">ing</span> <span begin="0:38.850" end="0:40.220">hot</span></p><p begin="0:40.473" end="0:43.270" itunes:key="L15" ttm:agent="v1"><span begin="0:40.473" end="0:40.700">Too</span> <span begin="0:40.700" end="0:40.950">mas</span><span begin="0:40.950" end="0:41.150">sive,</span> <span begin="0:41.150" end="0:41.320">so</span> <span begin="0:41.320" end="0:41.590">mas</span><span begin="0:41.590" end="0:41.790">sive,</span> <span begin="0:41.790" end="0:41.920">dream</span><s