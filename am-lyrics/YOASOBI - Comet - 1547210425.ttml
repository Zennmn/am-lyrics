<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Comet"/><amll:meta key="artists" value="YOASOBI"/><amll:meta key="album" value="Comet - Single"/><amll:meta key="appleMusicId" value="1547210425"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">今夜在这静谧的夜色之中</text><text for="L2">漫无目的地驱车向前</text><text for="L3">坐在左侧身旁 你的</text><text for="L4">侧颜正被月色温柔映亮</text><text for="L5">宛如在细细探寻往昔的回忆</text><text for="L6">循着旧日踪迹将字句拼缀相连</text><text for="L7">便情难自禁地翻涌而出</text><text for="L8">那些朝夕相伴的点滴记忆</text><text for="L9">从决意陪伴在你身旁的那一天起</text><text for="L10">眼前的世界便已开始悄然改变</text><text for="L11">为了强作坚强 为了掩藏脆弱</text><text for="L12">在一直勉力扮演强者的岁月里</text><text for="L13">某天突然出现的那道目光</text><text for="L14">教会了我从未明晓的一切</text><text for="L15">只要心中有了想要守护的存在</text><text for="L16">原来竟能变得如此强大</text><text for="L17">在那幽深沉寂的无尽黑暗之中</text><text for="L18">我们彼此相逢 携手相伴走过</text><text for="L19">绝无仅有的珍贵岁月</text><text for="L20">曾是那样令人心安</text><text for="L21">不 那本就是真正的幸福</text><text for="L22">确实如此 你看啊</text><text for="L23">我的灵魂早已得到了救赎</text><text for="L24">正是被你所拯救</text><text for="L25">捕捉着微弱光芒闪耀生辉的</text><text for="L26">正是宛如流星划落般的泪滴</text><text for="L27">自那笨拙的生命中潸然滚落</text><text for="L28">那无比美丽的泪水</text><text for="L29">高大强健的身躯里深藏的温柔</text><text for="L30">那神情中隐隐透着痛楚的脸庞</text><text for="L31">都让我感到如此深切的眷恋</text><text for="L32">重要的从来都无关外表形貌</text><text for="L33">事到如今我才终于幡然醒悟</text><text for="L34">无情响彻的枪声残忍撕裂长夜</text><text for="L35">诀别的气息猝然席卷而来</text><text for="L36">刹那间闪烁的无情流星</text><text for="L37">心中的祈愿未能传达便消逝无踪</text><text for="L38">在这一双掌心之中彻底燃尽</text><text for="L39">那颗散发金芒的温柔彗星</text><text for="L40">那一缕华美耀眼的鬃毛</text><text for="L41">我在这无尽黑暗之中紧紧握住</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:33.129"><div begin="0:01.295" end="3:33.129"><p begin="0:01.295" end="0:05.779" itunes:key="L1" ttm:agent="v1"><span begin="0:01.295" end="0:02.181">今</span><span begin="0:02.308" end="0:03.591">静かな</span><span begin="0:03.591" end="0:04.460">夜の</span><span begin="0:04.460" end="0:04.979">中</span><span begin="0:04.979" end="0:05.779">で</span></p><p begin="0:05.789" end="0:12.965" itunes:key="L2" ttm:agent="v1"><span begin="0:05.789" end="0:07.210">無計画</span><span begin="0:07.210" end="0:07.824">に</span><span begin="0:08.220" end="0:09.532">車を</span><span begin="0:09.532" end="0:10.488">走</span><span begin="0:10.488" end="0:11.722">らせ</span><span begin="0:11.722" end="0:12.965">た</span></p><p begin="0:12.972" end="0:16.220" itunes:key="L3" ttm:agent="v1"><span begin="0:12.972" end="0:13.917">左</span><span begin="0:13.917" end="0:14.828">隣、</span><span begin="0:14.828" end="0:15.619">あなた</span><span begin="0:15.619" end="0:16.220">の</span></p><p begin="0:16.231" end="0:20.999" itunes:key="L4" ttm:agent="v1"><span begin="0:16.231" end="0:17.495">横顔</span><span begin="0:17.495" end="0:18.208">を</span><span begin="0:18.208" end="0:19.278">月が</span><span begin="0:19.278" end="0:20.142">照らし</span><span begin="0:20.142" end="0:20.999">た</span></p><p begin="0:22.589" end="0:27.004" itunes:key="L5" ttm:agent="v1"><span begin="0:22.589" end="0:23.281">ただ</span><span begin="0:23.567" end="0:25.080">思い出を</span><span begin="0:25.080" end="0:26.054">探る</span><span begin="0:26.054" end="0:26.264">様</span><span begin="0:26.264" end="0:27.004">に</span></p><p begin="0:27.015" end="0:34.755" itunes:key="L6" ttm:agent="v1"><span begin="0:27.015" end="0:28.439">辿る様</span><span begin="0:28.439" end="0:29.218">に</span><span begin="0:29.662" end="0:30.885">言葉を</span><span begin="0:30.885" end="0:32.568">繋ぎ</span><span begin="0:32.568" end="0:34.168">合わせ</span><span begin="0:34.168" end="0:34.755">れば</span></p><p begin="0:34.767" end="0:40.283" itunes:key="L7" ttm:agent="v1"><span begin="0:34.767" end="0:36.309">どうしようも</span><span begin="0:36.309" end="0:36.427">な</span><span begin="0:36.427" end="0:37.111">く</span><span begin="0:37.111" end="0:38.254">溢</span><span begin="0:38.254" end="0:38.504">れ</span><span begin="0:38.504" end="0:38.941">て</span><span begin="0:38.941" end="0:39.159">く</span><span begin="0:39.159" end="0:40.283">る</span></p><p begin="0:40.293" end="0:42.373" itunes:key="L8" ttm:agent="v1"><span begin="0:40.293" end="0:41.115">日々の</span><span begin="0:41.115" end="0:42.373">記憶</span></p><p begin="0:43.224" end="0:49.777" itunes:key="L9" ttm:agent="v1"><span begin="0:43.224" end="0:44.493">あなたの</span><span begin="0:44.493" end="0:45.479">そばで</span><span begin="0:45.479" end="0:46.740">生きると</span><span begin="0:46.740" end="0:48.052">決めたそ</span><span begin="0:48.052" end="0:48.393">の</span><span begin="0:48.393" end="0:48.897">日</span><span begin="0:48.897" end="0:49.117">か</span><span begin="0:49.117" end="0:49.777">ら</span></p><p begin="0:49.784" end="0:54.529" itunes:key="L10" ttm:agent="v1"><span begin="0:49.784" end="0:50.995">少しずつ</span><span begin="0:50.995" end="0:51.728">変わり</span><span begin="0:51.728" end="0:53.611">始めた</span><span begin="0:53.611" end="0:53.960">世</span><span begin="0:53.960" end="0:54.529">界</span></p><p begin="0:54.541" end="0:59.836" itunes:key="L11" ttm:agent="v1"><span begin="0:54.541" end="0:55.205">強く</span><span begin="0:55.205" end="0:57.231">在るように</span><span begin="0:57.231" end="0:57.741">弱さを</span><span begin="0:57.741" end="0:59.304">隠すよう</span><span begin="0:59.304" end="0:59.836">に</span></p><p begin="0:59.844" end="1:04.261" itunes:key="L12" ttm:agent="v1"><span begin="0:59.844" end="1:00.528">演</span><span begin="1:00.528" end="1:01.182">じ</span><span begin="1:01.182" end="1:01.546">て</span><span begin="1:01.546" end="1:02.201">き</span><span begin="1:02.201" end="1:02.455">た</span><span begin="1:02.455" end="1:03.238">日々</span><span begin="1:03.238" end="1:04.261">に</span></p><p begin="1:04.478" end="1:11.053" itunes:key="L13" ttm:agent="v1"><span begin="1:04.478" end="1:05.502">ある日</span><span begin="1:05.502" end="1:06.824">突然</span><span begin="1:06.824" end="1:08.444">現れた</span><span begin="1:08.444" end="1:10.399">その眼差し</span><span begin="1:10.399" end="1:11.053">が</span></p><p begin="1:11.064" end="1:15.825" itunes:key="L14" ttm:agent="v1"><span begin="1:11.064" end="1:12.272">知らなかっ</span><span begin="1:12.272" end="1:12.609">た</span><span begin="1:12.609" end="1:13.172">こと</span><span begin="1:13.172" end="1:13.855">教</span><span begin="1:13.855" end="1:14.477">えて</span><span begin="1:14.477" end="1:15.136">くれ</span><span begin="1:15.136" end="1:15.825">た</span></p><p begin="1:15.834" end="1:21.159" itunes:key="L15" ttm:agent="v1"><span begin="1:15.834" end="1:18.519">守るべきものが</span><span begin="1:18.519" end="1:20.414">あればそれだけ</span><span begin="1:20.414" end="1:21.159">で</span></p><p begin="1:21.169" end="1:27.530" itunes:key="L16" ttm:agent="v1"><span begin="1:21.169" end="1:22.803">こんなにも</span><span begin="1:22.803" end="1:24.118">強くなれるん</span><span begin="1:24.118" end="1:27.530">だ</span></p><p begin="1:42.463" end="1:47.509" itunes:key="L17" ttm:agent="v1"><span begin="1:42.463" end="1:44.510">深い深い</span><span begin="1:44.510" end="1:46.825">暗闇の中</span><span begin="1:46.825" end="1:47.509">で</span></p><p begin="1:47.519" end="1:51.791" itunes:key="L18" ttm:agent="v1"><span begin="1:47.519" end="1:48.624">出会い</span><span begin="1:48.925" end="1:49.891">共に</span><span begin="1:49.891" end="1:51.791">過ごしてきた</span></p><p begin="1:51.800" end="1:54.494" itunes:key="L19" ttm:agent="v1"><span begin="1:51.800" end="1:52.858">類の</span><span begin="1:52.858" end="1:53.509">無い</span><span begin="1:53.509" end="1:54.494">日々</span></p><p begin="1:54.503" end="1:56.211" itunes:key="L20" ttm:agent="v1"><span begin="1:54.503" end="1:55.150">心地</span><span begin="1:55.150" end="1:56.211">よかった</span></p><p begin="1:56.221" end="1:58.849" itunes:key="L21" ttm:agent="v1"><span begin="1:56.221" end="1:56.833">いや、</span><span begin="1:57.313" end="1:58.124">幸せだっ</span><span begin="1:58.124" end="1:58.849">た</span></p><p begin="1:58.859" end="2:00.535" itunes:key="L22" ttm:agent="v1"><span begin="1:58.859" end="1:59.927">確かに</span><span begin="1:59.927" end="2:00.535">ほら</span></p><p begin="2:00.545" end="2:03.149" itunes:key="L23" ttm:agent="v1"><span begin="2:00.545" end="2:01.934">救われたんだ</span><span begin="2:01.934" end="2:03.149">よ</span></p><p begin="2:03.224" end="2:05.656" itunes:key="L24" ttm:agent="v1"><span begin="2:03.224" end="2:04.224">あなた</span><span begin="2:04.224" end="2:05.656">に</span></p><p begin="2:05.666" end="2:12.452" itunes:key="L25" ttm:agent="v1"><span begin="2:05.666" end="2:07.230">わずかな</span><span begin="2:07.230" end="2:08.075">光</span><span begin="2:08.075" end="2:08.597">を</span><span begin="2:08.597" end="2:09.816">捉えて</span><span begin="2:09.816" end="2:11.291">輝い</span><span begin="2:11.291" end="2:11.754">たの</span><span begin="2:11.754" end="2:12.452">は</span></p><p begin="2:12.464" end="2:17.199" itunes:key="L26" ttm:agent="v1"><span begin="2:12.464" end="2:13.667">まるで</span><span begin="2:13.667" end="2:14.271">流れ</span><span begin="2:14.271" end="2:15.213">星の</span><span begin="2:15.213" end="2:16.221">ような</span><span begin="2:16.221" end="2:17.199">涙</span></p><p begin="2:17.209" end="2:22.488" itunes:key="L27" ttm:agent="v1"><span begin="2:17.209" end="2:18.786">不器用な命</span><span begin="2:18.786" end="2:19.279">か</span><span begin="2:19.279" end="2:19.801">ら</span><span begin="2:19.859" end="2:21.579">流れて零れ落ち</span><span begin="2:21.579" end="2:22.488">た</span></p><p begin="2:22.496" end="2:27.164" itunes:key="L28" ttm:agent="v1"><span begin="2:22.496" end="2:24.213">美</span><span begin="2:24.213" end="2:24.825">し</span><span begin="2:24.825" end="2:25.235">い</span><span begin="2:25.235" end="2:27.164">涙</span></p><p begin="2:29.892" end="2:36.474" itunes:key="L29" ttm:agent="v1"><span begin="2:29.892" end="2:30.747">強く</span><span begin="2:30.747" end="2:32.114">大きな</span><span begin="2:32.114" end="2:33.375">体に</span><span begin="2:33.375" end="2:34.472">秘めた</span><span begin="2:34.472" end="2:35.583">優し</span><span begin="2:35.583" end="2:35.712">さ</span><span begin="2:35.712" end="2:36.474">も</span></p><p begin="2:36.486" end="2:41.194" itunes:key="L30" ttm:agent="v1"><span begin="2:36.486" end="2:37.434">どこか</span><span begin="2:37.434" end="2:39.095">苦しげな</span><span begin="2:39.095" end="2:40.088">その</span><span begin="2:40.088" end="2:41.194">顔も</span></p><p begin="2:41.202" end="2:43.815" itunes:key="L31" ttm:agent="v1"><span begin="2:41.202" end="2:41.986">愛しく</span><span begin="2:41.986" end="2:43.043">思うん</span><span begin="2:43.043" end="2:43.815">だ</span></p><p begin="2:43.826" end="2:46.462" itunes:key="L32" ttm:agent="v1"><span begin="2:43.826" end="2:45.697">姿形じゃないん</span><span begin="2:45.697" end="2:46.462">だ</span></p><p begin="2:46.471" end="2:50.911" itunes:key="L33" ttm:agent="v1"><span begin="2:46.471" end="2:47.855">やっと</span><span begin="2:47.855" end="2:49.767">気付いたん</span><span begin="2:49.767" end="2:50.911">だ</span></p><p begin="2:51.088" end="2:57.780" itunes:key="L34" ttm:agent="v1"><span begin="2:51.088" end="2:52.522">無情に</span><span begin="2:52.522" end="2:53.428">響く</span><span begin="2:53.428" end="2:55.152">銃声が</span><span begin="2:55.152" end="2:57.780">夜を引き裂く</span></p><p begin="2:57.789" end="3:02.449" itunes:key="L35" ttm:agent="v1"><span begin="2:57.789" end="2:58.758">別れの</span><span begin="2:58.758" end="3:00.129">息吹が</span><span begin="3:00.129" end="3:01.205">襲い</span><span begin="3:01.205" end="3:01.883">かか</span><span begin="3:01.883" end="3:02.449">る</span></p><p begin="3:02.457" end="3:07.757" itunes:key="L36" ttm:agent="v1"><span begin="3:02.457" end="3:03.299">刹那に</span><span begin="3:03.299" end="3:05.093">輝いた</span><span begin="3:05.093" end="3:05.895">無慈悲な</span><span begin="3:05.895" end="3:06.743">流れ</span><span begin="3:06.743" end="3:07.757">星</span></p><p begin="3:07.768" end="3:12.800" itunes:key="L37" ttm:agent="v1"><span begin="3:07.768" end="3:08.923">祈りは</span><span begin="3:08.923" end="3:09.490">ただ</span><span begin="3:09.490" end="3:11.042">届かずに消え</span><span begin="3:11.042" end="3:12.800">た</span></p><p begin="3:13.222" end="3:17.562" itunes:key="L38" ttm:agent="v1"><span begin="3:13.222" end="3:13.866">この</span><span begin="3:14.354" end="3:15.856">手の中で</span><span begin="3:15.856" end="3:16.820">燃え尽き</span><span begin="3:16.820" end="3:17.562">た</span></p><p begin="3:17.775" end="3:24.525" itunes:key="L39" ttm:agent="v1"><span begin="3:17.775" end="3:19.154">金色</span><span begin="3:19.154" end="3:20.132">の</span><span begin="3:20.132" end="3:21.548">優しい</span><span begin="3:21.548" end="3:23.744">彗星</span><span begin="3:23.744" end="3:24.525">を</span></p><p begin="3:24.849" end="3:28.116" itunes:key="L40" ttm:agent="v1"><span begin="3:24.849" end="3:25.924">美</span><span begin="3:25.924" end="3:26.620">しい</span><span begin="3:26.620" end="3:27.624">たてがみ</span><span begin="3:27.624" end="3:28.116">を</span></p><p begin="3:28.125" end="3:33.129" itunes:key="L41" ttm:agent="v1"><span begin="3:28.125" end="3:29.841">暗闇の</span><span begin="3:30.204" end="3:30.892">中</span><span begin="3:30.892" end="3:31.820">握り</span><span begin="3:31.820" end="3:32.348">締め</span><span begin="3:32.348" end="3:33.129">た</span></p></div></body></tt>