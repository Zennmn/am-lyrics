<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Gunjou"/><amll:meta key="artists" value="YOASOBI"/><amll:meta key="album" value="Gunjou - Single"/><amll:meta key="appleMusicId" value="1528119630"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">唉 宛如往常那般</text><text for="L2">漫漫流逝的日常教人呵欠连连</text><text for="L3">穿过喧嚣欢腾的长夜 这一天</text><text for="L4">晨曦又悄然洒落在涩谷街头</text><text for="L5">心底莫名泛起一丝空虚</text><text for="L6">这般怅惘的心绪</text><text for="L7">委实索然无味啊</text><text for="L8">但如此倒也无妨</text><text for="L9">世事大抵皆是如此</text><text for="L10">这样便好</text><text for="L11">曾在不知不觉中深掩心底</text><text for="L12">快让真实的心声放声回响 瞧啊</text><text for="L13">就算故作视而不见</text><text for="L14">它也确凿存在于那里</text><text for="L15">随心之所向信笔描摹</text><text for="L16">用自己亲手择定的那一抹色彩</text><text for="L17">在笼罩着困倦睡意的清晨</text><text for="L18">翩然而至的那片湛蓝世界</text><text for="L19">直抒胸臆坦陈心之所爱</text><text for="L20">纵使心怀忐忑惶惑难安</text><text for="L21">那真实的自己</text><text for="L22">仿佛终于在此刻得以相逢</text><text for="L23">啊 愈是竭尽全力伸长双手</text><text for="L24">所求之物愈发渐行渐远</text><text for="L25">万事皆不如人愿 这一天</text><text for="L26">又在惶惶奔忙中苦苦挣扎</text><text for="L27">满腹的不甘与悔恨</text><text for="L28">只化作自惭形秽的难堪</text><text for="L29">教人止不住滚落泪水</text><text for="L30">涉足陷落得越深</text><text for="L31">便越是煎熬难捱</text><text for="L32">亦越发隐隐作痛</text><text for="L33">循心之所感毅然前行</text><text for="L34">奔赴自己抉择的这条道路</text><text for="L35">在揉着沉重眼帘的深夜</text><text for="L36">紧紧依凭着那一抹青涩誓言</text><text for="L37">将挚爱之事执着坚持下去</text><text for="L38">从非仅仅只有欢愉而已</text><text for="L39">我当真能做到吗</text><text for="L40">虽然心头满是惴惴难安</text><text for="L41">画下一张又一张</text><text for="L42">瞧 无论叠上多少张画纸</text><text for="L43">正因毫无底气 才一路执笔画到如今啊</text><text for="L44">哪怕跌倒千百次</text><text for="L45">听 无论试炼重复多少回</text><text for="L46">经年累月的沉淀终会化为披荆斩棘的利刃</text><text for="L47">纵然环顾四周众人</text><text for="L48">纵然与身旁之人百般较量</text><text for="L49">究竟何事唯独我不可替代</text><text for="L50">直至此刻仍全无半点把握</text><text for="L51">即便如此</text><text for="L52">往昔未曾品味的心绪</text><text for="L53">此前未解其中的憬悟</text><text for="L54">自那一天毅然启程</text><text for="L55">初次体会到的这缕阵痛与苦楚</text><text for="L56">尽皆源于正视心中挚爱</text><text for="L57">从而有幸触及微弱摇曳的星光</text><text for="L58">无须担忧 迈步向前吧 剩下唯有尽情去享受</text><text for="L59">倾尽所有去挥洒描摹</text><text for="L60">调和出独属于我的色彩</text><text for="L61">披星戴月地奔跑不息</text><text for="L62">终于寻得那道青蓝的光芒</text><text for="L63">去直面自己所热爱的一切</text><text for="L64">即便事到如今依然令人生畏</text><text for="L65">可如今的我早已不再是昔日那透明虚无的影子</text><text for="L66">本真无饰</text><text for="L67">是世间独一无二的自己</text><text for="L68">岁月里悄然藏匿的真情</text><text for="L69">快让真实的心声尽情回荡 瞧啊</text><text for="L70">纵使习惯了故作漠然</text><text for="L71">它真切地留在那里 至今依然守候在那里啊</text><text for="L72">哪怕不知不觉又将它深锁</text><text for="L73">扬起你本真的心声去共鸣吧 来吧</text><text for="L74">纵使你仍想移开视线</text><text for="L75">它确凿就在那里 就跳动在你的胸膛之中</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:04.212"><div begin="0:01.106" end="4:04.212"><p begin="0:01.106" end="0:03.663" itunes:key="L1" ttm:agent="v1"><span begin="0:01.106" end="0:01.552">嗚呼</span><span begin="0:01.552" end="0:01.652">、</span><span begin="0:01.855" end="0:02.672">いつもの</span><span begin="0:02.672" end="0:02.981">様</span><span begin="0:02.981" end="0:03.663">に</span></p><p begin="0:03.663" end="0:07.459" itunes:key="L2" ttm:agent="v1"><span begin="0:03.663" end="0:04.291">過ぎる</span><span begin="0:04.291" end="0:04.773">日々</span><span begin="0:04.773" end="0:05.524">に</span><span begin="0:05.524" end="0:06.081">あくび</span><span begin="0:06.081" end="0:06.358">が</span><span begin="0:06.358" end="0:07.459">出る</span></p><p begin="0:07.459" end="0:11.189" itunes:key="L3" ttm:agent="v1"><span begin="0:07.459" end="0:08.686">さんざめく</span><span begin="0:08.847" end="0:09.301">夜</span><span begin="0:09.301" end="0:09.401">、</span><span begin="0:09.543" end="0:10.060">越え</span><span begin="0:10.060" end="0:10.235">、</span><span begin="0:10.235" end="0:10.795">今日</span><span begin="0:10.795" end="0:11.189">も</span></p><p begin="0:11.189" end="0:14.629" itunes:key="L4" ttm:agent="v1"><span begin="0:11.189" end="0:12.154">渋谷の</span><span begin="0:12.154" end="0:12.872">街に</span><span begin="0:13.021" end="0:13.902">朝が</span><span begin="0:13.902" end="0:14.629">降る</span></p><p begin="0:14.990" end="0:17.658" itunes:key="L5" ttm:agent="v1"><span begin="0:14.990" end="0:15.490">どこ</span><span begin="0:15.490" end="0:16.087">か</span><span begin="0:16.087" end="0:16.920">虚しい</span><span begin="0:16.920" end="0:17.194">よう</span><span begin="0:17.194" end="0:17.658">な</span></p><p begin="0:17.911" end="0:19.534" itunes:key="L6" ttm:agent="v1"><span begin="0:17.911" end="0:18.503">そんな</span><span begin="0:18.503" end="0:18.929">気持</span><span begin="0:18.929" end="0:19.534">ち</span></p><p begin="0:19.543" end="0:21.403" itunes:key="L7" ttm:agent="v1"><span begin="0:19.543" end="0:20.343">つまら</span><span begin="0:20.343" end="0:20.765">ない</span><span begin="0:20.765" end="0:21.403">な</span></p><p begin="0:21.413" end="0:23.150" itunes:key="L8" ttm:agent="v1"><span begin="0:21.413" end="0:21.851">でも</span><span begin="0:21.851" end="0:22.483">それで</span><span begin="0:22.483" end="0:23.150">いい</span></p><p begin="0:23.160" end="0:24.897" itunes:key="L9" ttm:agent="v1"><span begin="0:23.160" end="0:23.899">そんな</span><span begin="0:23.899" end="0:24.287">もん</span><span begin="0:24.287" end="0:24.897">さ</span></p><p begin="0:24.907" end="0:26.074" itunes:key="L10" ttm:agent="v1"><span begin="0:24.907" end="0:25.642">これで</span><span begin="0:25.642" end="0:26.074">いい</span></p><p begin="0:26.085" end="0:28.683" itunes:key="L11" ttm:agent="v2"><span begin="0:26.085" end="0:26.514">知ら</span><span begin="0:26.514" end="0:26.803">ず</span><span begin="0:26.803" end="0:27.257">知ら</span><span begin="0:27.257" end="0:27.470">ず</span><span begin="0:27.470" end="0:28.317">隠して</span><span begin="0:28.317" end="0:28.683">た</span></p><p begin="0:28.683" end="0:33.176" itunes:key="L12" ttm:agent="v2"><span begin="0:28.683" end="0:29.387">本当</span><span begin="0:29.387" end="0:29.600">の</span><span begin="0:29.600" end="0:30.291">声</span><span begin="0:30.291" end="0:30.730">を</span><span begin="0:30.823" end="0:31.405">響か</span><span begin="0:31.405" end="0:32.440">せてよ</span><span begin="0:32.440" end="0:32.605">、</span><span begin="0:32.605" end="0:33.176">ほら</span></p><p begin="0:33.176" end="0:35.796" itunes:key="L13" ttm:agent="v2"><span begin="0:33.176" end="0:33.858">見ない</span><span begin="0:33.858" end="0:34.280">フリ</span><span begin="0:34.302" end="0:34.943">して</span><span begin="0:34.943" end="0:35.796">いても</span></p><p begin="0:35.805" end="0:38.746" itunes:key="L14" ttm:agent="v2"><span begin="0:35.805" end="0:36.755">確かに</span><span begin="0:36.755" end="0:37.473">そこ</span><span begin="0:37.473" end="0:37.862">に</span><span begin="0:37.862" end="0:38.149">あ</span><span begin="0:38.149" end="0:38.746">る</span></p><p begin="0:40.311" end="0:43.139" itunes:key="L15" ttm:agent="v1"><span begin="0:40.311" end="0:41.415">感じた</span><span begin="0:41.415" end="0:42.363">ままに</span><span begin="0:42.363" end="0:42.733">描</span><span begin="0:42.733" end="0:43.139">く</span></p><p begin="0:43.147" end="0:46.757" itunes:key="L16" ttm:agent="v1"><span begin="0:43.147" end="0:44.080">自分</span><span begin="0:44.080" end="0:44.362">で</span><span begin="0:44.362" end="0:45.201">選んだ</span><span begin="0:45.201" end="0:45.508">そ</span><span begin="0:45.508" end="0:46.014">の</span><span begin="0:46.014" end="0:46.303">色</span><span begin="0:46.303" end="0:46.757">で</span></p><p begin="0:46.766" end="0:50.341" itunes:key="L17" ttm:agent="v1"><span begin="0:46.766" end="0:47.737">眠い</span><span begin="0:47.737" end="0:48.558">空気</span><span begin="0:48.637" end="0:49.427">纏う</span><span begin="0:49.561" end="0:49.896">朝</span><span begin="0:49.896" end="0:50.341">に</span></p><p begin="0:50.351" end="0:53.939" itunes:key="L18" ttm:agent="v1"><span begin="0:50.351" end="0:51.016">訪</span><span begin="0:51.016" end="0:51.367">れ</span><span begin="0:51.367" end="0:51.616">た</span><span begin="0:51.616" end="0:52.590">青い</span><span begin="0:52.590" end="0:53.069">世</span><span begin="0:53.069" end="0:53.939">界</span></p><p begin="0:53.947" end="0:57.417" itunes:key="L19" ttm:agent="v1"><span begin="0:53.947" end="0:54.697">好きな</span><span begin="0:54.778" end="0:55.557">ものを</span><span begin="0:55.737" end="0:56.163">好き</span><span begin="0:56.163" end="0:56.470">だ</span><span begin="0:56.610" end="0:56.983">と言</span><span begin="0:56.983" end="0:57.417">う</span></p><p begin="0:57.425" end="1:00.509" itunes:key="L20" ttm:agent="v1"><span begin="0:57.425" end="0:58.535">怖くて</span><span begin="0:58.535" end="0:59.452">仕方</span><span begin="0:59.452" end="0:59.844">ない</span><span begin="0:59.844" end="1:00.509">けど</span></p><p begin="1:00.518" end="1:02.756" itunes:key="L21" ttm:agent="v1"><span begin="1:00.518" end="1:00.867">本</span><span begin="1:00.867" end="1:01.349">当</span><span begin="1:01.349" end="1:01.694">の</span><span begin="1:01.943" end="1:02.188">自</span><span begin="1:02.188" end="1:02.756">分</span></p><p begin="1:02.765" end="1:05.249" itunes:key="L22" ttm:agent="v1"><span begin="1:02.765" end="1:03.627">出会えた</span><span begin="1:03.627" end="1:04.095">気が</span><span begin="1:04.095" end="1:04.525">した</span><span begin="1:04.525" end="1:04.755">ん</span><span begin="1:04.755" end="1:05.249">だ</span></p><p begin="1:15.708" end="1:20.075" itunes:key="L23" ttm:agent="v1"><span begin="1:15