<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Probably"/><amll:meta key="artists" value="YOASOBI"/><amll:meta key="album" value="Probably - Single"/><amll:meta key="isrc" value="JPP302000323"/><amll:meta key="appleMusicId" value="1520198760"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">连一滴眼泪都未曾落下</text><text for="L2">相伴岁月的痕迹也未留半分</text><text for="L3">就这样道别了</text><text for="L4">独自迎来的清晨里</text><text for="L5">回荡着不知是谁的声响</text><text for="L6">在这间两人曾共处的房间</text><text for="L7">闭着双眼默默思量</text><text for="L8">错的人究竟是谁</text><text for="L9">实在想不明白啊</text><text for="L10">其实谁都没有错</text><text for="L11">大概吧</text><text for="L12">无论重来多少次我们终究</text><text for="L13">是啊无论多少年想来也只是</text><text for="L14">伴着一声道别就此落幕</text><text for="L15">想必也是无可奈何吧</text><text for="L16">“欢迎回来”</text><text for="L17">不觉脱口而出的话语</text><text for="L18">其实不对呢</text><text for="L19">一个人迎来的清晨里</text><text for="L20">心头忽而念起某人</text><text for="L21">两人共度的往日时光</text><text for="L22">那些习以为常依然留存着</text><text for="L23">错的人是你</text><text for="L24">真是那样吗</text><text for="L25">错的人是我</text><text for="L26">大概吧</text><text for="L27">这也不过是世间寻常的恋情吧</text><text for="L28">这便是最终的答案了</text><text for="L29">我们渐渐错开了步调呢</text><text for="L30">那也只是听惯了的平凡故事罢了</text><text for="L31">就连曾那样熠熠生辉的日子</text><text for="L32">也会悄然蒙上尘埃啊</text><text for="L33">无论多少次我们想必都会</text><text for="L34">是啊无论多少年亦然</text><text for="L35">走上通往别离的那条路</text><text for="L36">想来也是无可奈何吧</text><text for="L37">“欢迎回来”</text><text for="L38">一如往常那般</text><text for="L39">悄然滑落唇边</text><text for="L40">彼此无法理解的事情啊</text><text for="L41">想来定是数不胜数</text><text for="L42">毕竟不是一切都能互相包容</text><text for="L43">只是若将满怀温柔的岁月</text><text for="L44">竟感受成了苦痛与煎熬</text><text for="L45">便再也回不去了</text><text for="L46">无论多少次我们想来都</text><text for="L47">无论重来多少回我们终究</text><text for="L48">是啊无论多少年想必也只会</text><text for="L49">伴着一声告别迎来终局</text><text for="L50">想来也是无可奈何啊</text><text for="L51">“欢迎回来”</text><text for="L52">脱口而出的那句话</text><text for="L53">终究不对啊</text><text for="L54">可即便如此无论多少回</text><text for="L55">是啊无论再过多少年也定会</text><text for="L56">若是还能重回最初的起点</text><text for="L57">还是会忍不住这样想啊</text><text for="L58">“欢迎回来”</text><text for="L59">对着未能送达而滑落的话语</text><text for="L60">轻笑了一声</text><text for="L61">是个微凉的清晨啊</text></translation></translations><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="0:02.308" end="0:02.905">namida</span><span begin="0:02.905" end="0:03.542">naga</span><span begin="0:03.542" end="0:03.923">su</span><span begin="0:03.923" end="0:04.578">koto</span><span begin="0:04.578" end="0:05.220">sura</span><span begin="0:05.220" end="0:05.982">nai ma</span><span begin="0:05.982" end="0:07.060">ma</span></text><text for="L2"><span begin="0:07.507" end="0:08.469">sugoshita</span><span begin="0:08.469" end="0:09.486">hibi no</span><span begin="0:09.486" end="0:10.216">ato</span><span begin="0:10.216" end="0:11.012">hito</span><span begin="0:11.012" end="0:11.796">tsu mo</span><span begin="0:11.796" end="0:12.919">nokosazu</span><span begin="0:12.919" end="0:16.003">ni</span></text><text for="L3"><span begin="0:16.904" end="0:17.523">sayo</span><span begin="0:17.523" end="0:18.203">nara</span><span begin="0:18.203" end="0:18.745">da</span></text><text for="L4"><span begin="0:23.794" end="0:24.328">hitori</span><span begin="0:24.328" end="0:24.562">de</span><span begin="0:24.562" end="0:25.172">mukaeta</span><span begin="0:25.172" end="0:25.917">asa ni</span></text><text for="L5"><span begin="0:26