<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="The Blessing"/><amll:meta key="artists" value="YOASOBI"/><amll:meta key="album" value="The Blessing - Single"/><amll:meta key="appleMusicId" value="1645308331"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">遥想着悬浮在天际的远星</text><text for="L2">怀抱遐思悄然入梦的你</text><text for="L3">所择之未来所期盼的前路</text><text for="L4">无论延展向何方</text><text for="L5">我定与你相伴同行</text><text for="L6">追忆久远前的往事</text><text for="L7">辗转来到这颗荒星的你</text><text for="L8">曾无数次默默祈愿</text><text for="L9">远方那片璀璨绚丽的景致</text><text for="L10">若能纵身跃入其中</text><text for="L11">孤身置于这冷寂的世界</text><text for="L12">虔诚祈愿</text><text for="L13">描摹梦想</text><text for="L14">凝望未来</text><text for="L15">比起转身逃避</text><text for="L16">若你选择昂首前行</text><text for="L17">并非旁人描摹的既定模样</text><text for="L18">亦非他人选定的纷扰舞台</text><text for="L19">而是由你我携手谱写的篇章</text><text for="L20">我绝不会让你孤身一人</text><text for="L21">直到深藏在你心底的</text><text for="L22">锋刃将重重锁链彻底斩断</text><text for="L23">我定会与你并肩奋战到底</text><text for="L24">强加于身的既定宿命</text><text for="L25">统统亲手去击碎</text><text for="L26">我们绝非任人摆布的提线木偶</text><text for="L27">这是属于你的世界属于你的未来</text><text for="L28">你尽可将它书写成任何模样</text><text for="L29">昔日宛如逃离般宛如藏匿般</text><text for="L30">曾经屡次躲入的驾驶舱中</text><text for="L31">那个爱哭的你早已不见踪影</text><text for="L32">不知不觉间你已如此坚强</text><text for="L33">这本就是属于你的人生 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(绝不属于任何旁人)</span></text><text for="L34">从来就没有所谓的既定答案 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(道路唯有由自己去抉择)</span></text><text for="L35">彻底解开纠缠心头的咒缚吧</text><text for="L36">从那早已注定的虚构剧本中此刻</text><text for="L37">奋力冲脱而出</text><text for="L38">振翅翱翔天际 Ah</text><text for="L39">以无人能够企及的疾速</text><text for="L40">踏跃大地在苍穹自在翱翔</text><text for="L41">那深陷重重诅咒的未来</text><text for="L42">终将由你亲手彻底改写</text><text for="L43">只要不曾退缩勇往直前</text><text for="L44">定能紧紧握住无数珍贵收获</text><text for="L45">你定会变得更加坚强</text><text for="L46">诞生在这颗星辰之上</text><text for="L47">在这方天地间坚强地生活下去</text><text for="L48">愿你能由衷珍爱这所有一切</text><text for="L49">谨将倾尽所有的祝福尽数赠予你</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:01.097"><div begin="0:00.858" end="3:01.097"><p begin="0:00.858" end="0:03.556" itunes:key="L1" ttm:agent="v1"><span begin="0:00.858" end="0:01.421">遥か</span><span begin="0:01.421" end="0:01.800">遠く</span><span begin="0:01.800" end="0:02.035">に</span><span begin="0:02.264" end="0:02.525">浮か</span><span begin="0:02.525" end="0:02.806">ぶ</span><span begin="0:02.939" end="0:03.196">星</span><span begin="0:03.196" end="0:03.556">を</span></p><p begin="0:03.657" end="0:06.408" itunes:key="L2" ttm:agent="v1"><span begin="0:03.657" end="0:04.180">想い</span><span begin="0:04.394" end="0:04.842">眠り</span><span begin="0:05.005" end="0:05.194">に</span><span begin="0:05.194" end="0:05.601">つく</span><span begin="0:05.739" end="0:05.988">君</span><span begin="0:05.988" end="0:06.408">の</span></p><p begin="0:06.484" end="0:09.296" itunes:key="L3" ttm:agent="v1"><span begin="0:06.484" end="0:06.953">選ぶ</span><span begin="0:06.953" end="0:07.562">未来</span><span begin="0:07.562" end="0:07.730">が</span><span begin="0:07.904" end="0:08.398">望む</span><span begin="0:08.592" end="0:08.915">道</span><span begin="0:08.915" end="0:09.296">が</span></p><p begin="0:09.306" end="0:11.367" itunes:key="L4" ttm:agent="v1"><span begin="0:09.306" end="0:09.725">何処へ</span><span begin="0:09.757" end="0:10.116">続</span><span begin="0:10.116" end="0:10.505">いて</span><span begin="0:10.583" end="0:11.005">いて</span><span begin="0:11.005" end="0:11.367">も</span></p><p begin="0:11.468" end="0:12.997" itunes:key="L5" ttm:agent="v1"><span begin="0:11.468" end="0:11.744">共</span><span begin="0:11.744" end="0:11.967">に</span><span begin="0:11.967" end="0:12.448">生きる</span><span begin="0:12.448" end="0:12.609">か</span><span begin="0:12.609" end="0:12.997">ら</span></p><p begin="0:23.900" end="0:28.219" itunes:key="L6" ttm:agent="v1"><span begin="0:23.900" end="0:24.498">ずっ</span><span begin="0:24.498" end="0:24.936">と</span><span begin="0:25.294" end="0:25.925">昔</span><span begin="0:26.042" end="0:26.292">の</span><span begin="0:26.405" end="0:26.800">記</span><span begin="0:26.800" end="0:28.219">憶</span></p><p begin="0:28.624" end="0:33.486" itunes:key="L7" ttm:agent="v1"><span begin="0:28.624" end="0:28.979">連れ</span><span begin="0:28.979" end="0:29.729">られて</span><span begin="0:29.953" end="0:30.466">来た</span><span begin="0:30.466" end="0:31.209">この</span><span begin="0:31.209" end="0:31.916">星</span><span begin="0:31.916" end="0:32.188">で</span><span begin="0:32.188" end="0:33.076">君</span><span begin="0:33.076" end="0:33.486">は</span></p><p begin="0:33.496" end="0:35.231" itunes:key="L8" ttm:agent="v1"><span begin="0:33.496" end="0:34.043">願い</span><span begin="0:34.043" end="0:34.638">続け</span><span begin="0:34.638" end="0:34.878">て</span><span begin="0:34.878" end="0:35.231">た</span></p><p begin="0:35.241" end="0:39.547" itunes:key="L9" ttm:agent="v1"><span begin="0:35.241" end="0:35.608">遠</span><span begin="0:35.608" end="0:36.070">くで</span><span begin="0:36.495" end="0:36.883">煌</span><span begin="0:36.883" end="0:37.474">めく</span><span begin="0:37.647" end="0:37.905">景</span><span begin="0:37.905" end="0:38.695">色</span><span begin="0:38.695" end="0:39.547">に</span></p><p begin="0:40.072" end="0:45.259" itunes:key="L10" ttm:agent="v1"><span begin="0:40.072" end="0:40.730">飛び</span><span begin="0:40.730" end="0:41.330">込む</span><span begin="0:41.330" end="0:42.087">こと</span><span begin="0:42.087" end="0:42.643">が</span><span begin="0:42.643" end="0:43.283">出来</span><span begin="0:43.483" end="0:43.702">た</span><span begin="0:43.702" end="0:44.188">の</span><span begin="0:44.188" end="0:44.411">な</span><span begin="0:44.411" end="0:45.259">ら</span></p><p begin="0:45.310" end="0:47.334" itunes:key="L11" ttm:agent="v1"><span begin="0:45.310" end="0:45.701">一人</span><span begin="0:45.701" end="0:46.285">孤独</span><span begin="0:46.285" end="0:46.469">な</span><span begin="0:46.469" end="0:46.986">世界</span><span begin="0:46.986" end="0:47.334">で</span></p><p begin="0:47.473" end="0:48.698" itunes:key="L12" ttm:agent="v1"><span begin="0:47.473" end="0:48.040">祈り</span><span begin="0:48.221" end="0:48.698">願う</span></p><p begin="0:48.866" end="0:50.115" itunes:key="L13" ttm:agent="v1"><span begin="0:48.866" end="0:49.158">夢</span><span begin="0:49.158" end="0:49.372">を</span><span begin="0:49.521" end="0:49.874">描</span><span begin="0:49.874" end="0:50.115">き</span></p><p begin="0:50.274" end="0:51.548" itunes:key="L14" ttm:agent="v1"><span begin="0:50.274" end="0:50.723">未来</span><span begin="0:50.915" end="0:51.056">を</span><span begin="0:51.056" end="0:51.175">見</span><span begin="0:51.175" end="0:51.548">る</span></p><p begin="0:51.558" end="0:54.380" itunes:key="L15" ttm:agent="v1"><span begin="0:51.558" end="0:51.978">逃げ</span><span begin="0:51.978" end="0:52.302">出す</span><span begin="0:52.302" end="0:52.925">よりも</span><span begin="0:53.013" end="0:53.611">進む</span><span begin="0:53.719" end="0:54.071">こと</span><span begin="0:54.071" end="0:54.380">を</span></p><p begin="0:54.450" end="0:56.606" itunes:key="L16" ttm:agent="v1"><span begin="0:54.450" end="0:55.040">君が</span><span begin="0:55.183" end="0:55.571">選ん</span><span begin="0:55.571" end="0:56.021">だの</span><span begin="0:56.021" end="0:56.606">なら</span></p><p begin="0:56.968" end="0:59.756" itunes:key="L17" ttm:agent="v1"><span begin="0:56.968" end="0:57.262">誰</span><span begin="0:57.262" end="0:57.557">かが</span><span begin="0:57.557" end="0:58.251">描いた</span><span begin="0:58.251" end="0:58.750">イメージ</span><span begin="0:58.750" end="0:59.022">じゃ</span><span begin="0:59.022" end="0:59.237">なく</span><span begin="0:59.237" end="0:59.756">て</span></p><p begin="0:59.766" end="1:02.606" itunes:key="L18" ttm:agent="v1"><span begin="0:59.766" end="1:00.097">誰</span><span begin="1:00.097" end="1:00.393">かが</span><span begin="1:00.393" end="1:00.823">選ん</span><span begin="1:00.823" end="1:01.082">だ</span><span begin="1:01.159" end="1:01.533">ステー</span><span begin="1:01.533" end="1:01.642">ジ</span><span begin="1:01.691" end="1:01.900">じゃ</span><span begin="1:01.900" end="1:02.224">なく</span><span begin="1:02.224" end="1:02.606">て</span></p><p begin="1:02.676" end="1:05.334" itunes:key="L19" ttm:agent="v1"><span begin="1:02.676" end="1:03.040">僕</span><span begin="1:03.040" end="1:03.572">たちが</span><span begin="1:03.665" end="1:04.339">作っ</span><span begin="1:04.339" end="1:04.515">て</span><span begin="1:04.515" end="1:04.689">いく</span><span begin="1:04.689" end="1:04.984">ストー</span><span begin="1:04.984" end="1:05.334">リー</span></p><p begin="1:05.436" end="1:08.335" itunes:key="L20" ttm:agent="v1"><span begin="1:05.436" end="1:05.908">決して</span><span begin="1:05.908" end="1:06.170">一</span><span begin="1:06.170" end="1:06.610">人</span><span begin="1:06.610" end="1:06.981">には</span><span begin="1:07.212" end="1:07.450">させ</span><span begin="1:07.450" end="1:07.782">ない</span><span begin="1:07.782" end="1:08.335">から</span></p><p begin="1:08.388" end="1:11.007" itunes:key="L21" ttm:agent="v1"><span begin="1:08.388" end="1:08.884">いつか</span><span begin="1:08.884" end="1:09.256">その</span><span begin="1:09.375" end="1:09.996">胸</span><span begin="1:09.996" end="1:10.108">に</span><span begin="1:10.108" end="1:10.622">秘め</span><span begin="1:10.622" end="1:11.007">た</span></p><p begin="1:11.017" end="1:15.100" itunes:key="L22" ttm:agent="v1"><span begin="1:11.017" end="1:11.547">刃</span><span begin="1:11.547" end="1:11.774">が</span><span begin="1:11.774" end="1:12.507">鎖</span><span begin="1:12.507" end="1:12.815">を</span><span begin="1:12.968" end="1:13.574">断ち</span><span begin="1:13.574" end="1:14.334">切る</span><span begin="1:14.334" end="1:14.634">ま</span><span begin="1:14.634" end="1:15.100">で</span></p><p begin="1:15.138" end="1:17.944" itunes:key="L23" ttm:agent="v1"><span begin="1:15.138" end="1:15.583">ずっと</span><span begin="1:16.347" end="1:16.798">共に</span><span begin="1:16.798" end="1:17.456">闘う</span><span begin="1:17.456" end="1:17.944">よ</span></p><p begin="1:27.670" end="1:29.343" itunes:key="L24" ttm:agent="v1"><span begin="1:27.670" end="1:27.941">決め</span><span begin="1:27.941" end="1:28.279">付け</span><span begin="1:28.279" end="1:28.841">られた</span><span begin="1:28.841" end="1:29.343">運命</span></p><p begin="1:29.438" end="1:30.799" itunes:key="L25" ttm:agent="v1"><span begin="1:29.438" end="1:29.694">そん</span><span begin="1:29.694" end="1:30.036">なの</span><span begin="1:30.036" end="1:30.303">壊し</span><span begin="1:30.303" end="1:30.799">て</span></p><p begin="1:30.809" end="1:33.607" itunes:key="L26" ttm:agent="v1"><span begin="1:30.809" end="1:31.319">僕達</span><span begin="1:31.319" end="1:31.709">は</span><span begin="1:31.709" end="1:32.326">操り</span><span begin="1:32.326" end="1:32.787">人形</span><span begin="1:32.787" end="1:33.031">じゃ</span><span begin="1:33.031" end="1:33.607">ない</span></p><p begin="1:33.617" end="1:36.492" itunes:key="L27" ttm:agent="v1"><span begin="1:33.617" end="1:34.294">君の</span><span begin="1:34.294" end="1:34.716">世界</span><span begin="1:34.716" end="1:34.962">だ</span> <span begin="1:35.157" end="1:35.734">君の</span><span begin="1:35.734" end="1:36.089">未来</span><span begin="1:36.089" end="1:36.492">だ</span></p><p begin="1:36.502" end="1:39.115" itunes:key="L28" ttm:agent="v1"><span begin="1:36.502" e