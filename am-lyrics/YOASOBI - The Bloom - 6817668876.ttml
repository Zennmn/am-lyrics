<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="The Bloom"/><amll:meta key="artists" value="YOASOBI"/><amll:meta key="album" value="The Bloom - Single"/><amll:meta key="appleMusicId" value="6817668876"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">倾尽全力生活</text><text for="L2">蓦然之间就在那里</text><text for="L3">盛开出繁花</text><text for="L4">甚至无暇惋惜流逝的季节</text><text for="L5">身处周而复始的相聚与离别之中</text><text for="L6">连整理行囊的余暇都没有</text><text for="L7">今日朝阳依然冉冉升起</text><text for="L8">重重叠叠许下的心愿也好</text><text for="L9">惹人怜惜的动人爱恋也罢</text><text for="L10">终局的走向谁又能够预知呢</text><text for="L11">唯有坚定地向前走去</text><text for="L12">在那路途的前方</text><text for="L13">无论怎样的明日在前方等候</text><text for="L14">就在那前方啊</text><text for="L15">那里正是属于我的答案所在</text><text for="L16">啊 那里就是未来的方向</text><text for="L17">命中注定那就是属于我的未来</text><text for="L18">这本就没有任何荒唐可笑之处啊</text><text for="L19">纵然是濒临凋零的枯木</text><text for="L20">枝头亦能盛开出繁花</text><text for="L21">我啊 更加傲然盛放吧</text><text for="L22">春风吹拂的那一日</text><text for="L23">比起静静等待</text><text for="L24">还要走在更前头</text><text for="L25">哪怕是备受冷落的离别 终有一日</text><text for="L26">也会牵引出令人欣喜雀跃的相逢</text><text for="L27">所以啊 我并不会感到寂寞</text><text for="L28">就这样</text><text for="L29">一步步顽强地活下去</text><text for="L30">就连泪水涟涟之中</text><text for="L31">我也定要找寻出来</text><text for="L32">那份属于我的幸福 一定可以</text><text for="L33">一丝一毫我都不想轻易错过</text><text for="L34">一直 是啊 一直如此</text><text for="L35">全心全意活在当下</text><text for="L36">就在那彼方守候</text><text for="L37">在那里有属于我人生的答卷</text><text for="L38">啊 那里便是未来所在</text><text for="L39">一定那就是属于我的未来</text><text for="L40">我要奔向那里</text><text for="L41">我必须跨步前往那片天地</text><text for="L42">啊 就在此时此刻</text><text for="L43">刻不容缓</text><text for="L44">遵从内心所想</text><text for="L45">毅然大步向前</text><text for="L46">打湿了双颊的</text><text for="L47">仅仅是因为这几点雨滴</text><text for="L48">便叹息自己身处不幸</text><text for="L49">可切莫在心头这般认定</text><text for="L50">林荫道旁繁花盛放的光景</text><text for="L51">都是因为你直至今天</text><text for="L52">始终步履不停地一路跋涉</text><text for="L53">才能在这一刻蓦然发觉啊</text><text for="L54">我啊 还有眼前的你啊</text><text for="L55">更加热烈地傲然盛放吧</text><text for="L56">迎着漫天的风吹雨打</text><text for="L57">比起过往任何一刻</text><text for="L58">更加凛然绝俗地盛放</text><text for="L59">哪怕是足尖传来的丝丝阵痛</text><text for="L60">也是切实行走在这世间的明证</text><text for="L61">坚信着这一切在这条路上继续迈进</text><text for="L62">这是属于我的岁月</text><text for="L63">这是属于我的泪水</text><text for="L64">都是由我自己做出的抉择</text><text for="L65">属于我的那份幸福 也必定如此</text><text for="L66">世间任何一缕光彩我都决不错过</text><text for="L67">漫漫前路 是啊 始终不渝</text><text for="L68">去全心全意活出自己的人生</text><text for="L69">就在那远方召唤</text><text for="L70">那里正铭刻着属于我的答案</text><text for="L71">啊 遥望之处便是未来</text><text for="L72">那里必定就是我心之所向的未来</text><text for="L73">我定要奔赴那里</text><text for="L74">我不得不前往那个地方</text><text for="L75">啊 分秒不待</text><text for="L76">此时此刻即刻启程</text><text for="L77">随心意驰骋</text><text for="L78">径直笔直向前</text><text for="L79">奋力活着啊</text><text for="L80">我正拼尽全力活在当下的每一秒</text><text for="L81">来吧 接下来该去往何方</text><text for="L82">只要迈步 无论何处都定能抵达</text><text for="L83">仰望着辽阔天际</text><text for="L84">如同朗朗晴空下盛放的繁花一般</text><text for="L85">无论多少次</text><text for="L86">历经千百回</text><text for="L87">傲然盛放吧</text><text for="L88">尽情绽放吧</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:02.123"><div begin="0:05.470" end="4:02.123"><p begin="0:05.470" end="0:07.559" itunes:key="L1" ttm:agent="v1"><span begin="0:05.470" end="0:06.275">夢中</span><span begin="0:06.275" end="0:06.971">で生</span><span begin="0:06.971" end="0:07.559">きる</span></p><p begin="0:07.559" end="0:09.656" itunes:key="L2" ttm:agent="v1"><span begin="0:07.559" end="0:07.866">其</span><span begin="0:07.866" end="0:07.990">処</span><span begin="0:07.990" end="0:08.435">に</span><span begin="0:08.514" end="0:09.656">忽ち</span></p><p begin="0:09.656" end="0:12.719" itunes:key="L3" ttm:agent="v1"><span begin="0:09.656" end="0:10.456">花が</span><span begin="0:10.456" end="0:10.805">咲</span><span begin="0:10.805" end="0:12.719">く</span></p><p begin="0:13.190" end="0:18.960" itunes:key="L4" ttm:agent="v1"><span begin="0:13.190" end="0:14.075">過ぎた</span><span begin="0:14.075" end="0:15.262">季節を</span><span begin="0:15.262" end="0:16.230">惜しむ</span><span begin="0:16.554" end="0:17.037">こ</span><span begin="0:17.037" end="0:18.515">とさえもな</span><span begin="0:18.515" end="0:18.960">く</span></p><p begin="0:18.960" end="0:23.900" itunes:key="L5" ttm:agent="v1"><span begin="0:18.960" end="0:19.523">繰</span><span begin="0:19.523" end="0:19.789">り</span><span begin="0:19.789" end="0:20.675">返す</span><span begin="0:20.675" end="0:21.648">出会い</span><span begin="0:21.648" end="0:22.237">と</span><span begin="0:22.237" end="0:22.802">別</span><span begin="0:22.802" end="0:23.106">れ</span><span begin="0:23.106" end="0:23.900">に</span></p><p begin="0:23.929" end="0:29.133" itunes:key="L6" ttm:agent="v1"><span begin="0:23.929" end="0:24.327">身支</span><span begin="0:24.327" end="0:24.627">度</span><span begin="0:24.627" end="0:25.456">をしてい</span><span begin="0:25.456" end="0:26.011">る</span><span begin="0:26.381" end="0:27.132">ような</span><span begin="0:27.652" end="0:28.825">暇もな</span><span begin="0:28.825" end="0:29.133">く</span></p><p begin="0:29.133" end="0:32.753" itunes:key="L7" ttm:agent="v1"><span begin="0:29.133" end="0:29.957">今日も</span><span begin="0:29.957" end="0:30.816">朝</span><span begin="0:30.816" end="0:31.205">日は</span><span begin="0:31.315" end="0:32.192">昇</span><span begin="0:32.192" end="0:32.753">る</span></p><p begin="0:32.826" end="0:36.246" itunes:key="L8" ttm:agent="v1"><span begin="0:32.826" end="0:33.880">幾重に</span><span begin="0:33.880" end="0:35.075">重ねた</span><span begin="0:35.075" end="0:35.659">願</span><span begin="0:35.659" end="0:36.246">いも</span></p><p begin="0:36.246" end="0:38.619" itunes:key="L9" ttm:agent="v1"><span begin="0:36.246" end="0:36.679">いじ</span><span begin="0:36.679" end="0:37.524">らしい</span><span begin="0:37.524" end="0:38.619">恋も</span></p><p begin="0:38.619" end="0:43.078" itunes:key="L10" ttm:agent="v1"><span begin="0:38.619" end="0:39.926">行く末は</span><span begin="0:39.926" end="0:40.902">誰も知</span><span begin="0:40.902" end="0:41.454">ら</span><span begin="0:41.454" end="0:42.016">ない</span><span begin="0:42.016" end="0:42.320">で</span><span begin="0:42.320" end="0:42.666">しょう</span><span begin="0:42.666" end="0:43.078">？</span></p><p begin="0:43.207" end="0:45.407" itunes:key="L11" ttm:agent="v1"><span begin="0:43.207" end="0:43.536">ただ</span><span begin="0:43.536" end="0:43.904">歩</span><span begin="0:43.904" end="0:44.752">いて行く</span><span begin="0:44.752" end="0:45.407">の</span></p><p begin="0:45.572" end="0:47.153" itunes:key="L12" ttm:agent="v1"><span begin="0:45.572" end="0:46.244">その</span><span begin="0:46.244" end="0:46.785">先</span><span begin="0:46.785" end="0:47.153">に</span></p><p begin="0:47.162" end="0:52.474" itunes:key="L13" ttm:agent="v1"><span begin="0:47.162" end="0:48.989">どんな明日が</span><span begin="0:48.989" end="0:50.488">待ち受けて</span><span begin="0:50.488" end="0:50.755">い</span><span begin="0:51.007" end="0:51.938">ようと</span><span begin="0:51.938" end="0:52.474">も</span></p><p begin="0:52.482" end="0:54.096" itunes:key="L14" ttm:agent="v1"><span begin="0:52.482" end="0:53.082">あそこに</span><span begin="0:53.082" end="0:53.248">あ</span><span begin="0:53.248" end="0:53.549">るん</span><span begin="0:53.549" end="0:54.096">だ</span></p><p begin="0:54.096" end="0:57.056" itunes:key="L15" ttm:agent="v1"><span begin="0:54.096" end="0:54.360">あ</span><span begin="0:54.360" end="0:54.885">そこに</span><span begin="0:54.885" end="0:55.392">私の</span><span begin="0:55.392" end="0:56.069">答えが</span><span begin="0:56.069" end="0:56.466">あるん</span><span begin="0:56.466" end="0:57.056">だ</span></p><p begin="0:57.067" end="0:58.754" itunes:key="L16" ttm:agent="v1"><span begin="0:57.067" end="0:57.342">鳴呼</span> <span begin="0:57.342" end="0:57.867">其処が</span><span begin="0:57.867" end="0:58.251">未来</span><span begin="0:58.251" end="0:58.754">だ</span></p><p begin="0:58.754" end="1:01.731" itunes:key="L17" ttm:agent="v1"><span begin="0:58.754" end="0:59.205">きっと</span><span begin="0:59.205" end="0:59.647">其処が</span><span begin="0:59.647" end="1:00.258">私の</span><span begin="1:00.258" end="1:00.429">未</span><span begin="1:00.429" end="1:00.914">来</span><span begin="1:00.914" end="1:01.285">なん</span><span begin="1:01.285" end="1:01.731">だ</span></p><p begin="1:01.843" end="1:06.034" itunes:key="L18" ttm:agent="v1"><span begin="1:01.843" end="1:02.150">お</span><span begin="1:02.150" end="1:02.480">かし</span><span begin="1:02.480" end="1:02.803">な</span><span begin="1:02.803" end="1:03.368">こと</span><span begin="1:03.368" end="1:03.910">なんて</span><span begin="1:03.910" end="1:04.883">一つも</span><span begin="1:04.883" end="1:05.204">ない</span><span begin="1:05.461" end="1:06.034">わ</span></p><p begin="1:06.034" end="1:09.649" itunes:key="L19" ttm:agent="v1"><span begin="1:06.034" end="1:06.348">枯</span><span begin="1:06.348" end="1:06.828">れ</span><span begin="1:06.828" end="1:07.279">か</span><span begin="1:07.279" end="1:08.212">けた</span><span begin="1:08.212" end="1:08.823">木に</span><span begin="1:08.823" end="1:09.649">も</span></p><p begin="1:09.649" end="1:11.336" itunes:key="L20" ttm:agent="v1"><span begin="1:09.649" end="1:10.493">花は</span><span begin="1:10.493" end="1:10.803">咲</span><span begin="1:10.803" end="1:11.336">く</span></p><p begin="1:11.996" end="1:15.566" itunes:key="L21" ttm:agent="v1"><span begin="1:11.996" end="1:13.199">私よ</span> <span begin="1:13.199" end="1:13.828">咲き</span><span begi