<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="CUT (CLOSET version)"/><amll:meta key="artists" value="YOH KAMIYAMA"/><amll:meta key="album" value="CLOSET"/><amll:meta key="isrc" value="JPU902201006"/><amll:meta key="appleMusicId" value="1618070133"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>YOH KAMIYAMA</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">你一定无法明白吧</text><text for="L2">这样的话也传不到你心里吧</text><text for="L3">仿佛连那将人层层束缚的否定</text><text for="L4">也始终将我紧紧拥住</text><text for="L5">你一定无法明白吧</text><text for="L6">这样的话也传不到你心里吧</text><text for="L7">那便是信号 亮起危险的红灯</text><text for="L8">脆弱又错愕 依旧无言</text><text for="L9">接连剥去一切 终于厌倦了所有</text><text for="L10">原来连扮演都已成了习惯</text><text for="L11">满溢而出 又戛然而止</text><text for="L12">这是第几个春天</text><text for="L13">对于重获新生的我</text><text for="L14">别再带来那些煞风景的事</text><text for="L15">什么意料之中的幸福</text><text for="L16">都太无趣 我已无法回头</text><text for="L17">你一定已经不明白了吧</text><text for="L18">如今才说早知如此 已经太迟了</text><text for="L19">这如暗示般延续的生活</text><text for="L20">也仍被人强加上意义吧</text><text for="L21">眼皮渐渐沉重</text><text for="L22">摇曳的身影渐渐远去</text><text for="L23">我们两人终被撕开</text><text for="L24">这是第几个夜晚</text><text for="L25">仿佛浸入黑暗之中</text><text for="L26">别再想那些傻事了</text><text for="L27">就连后悔也是从悲伤里</text><text for="L28">一点点寻到的</text><text for="L29">喂 是这样吧</text><text for="L30">宝贝 我要让你快乐</text><text for="L31">切断吧 没关系！</text><text for="L32">宝贝 我会让你快乐</text><text for="L33">Ooo</text><text for="L34">宝贝 我要让你快乐</text><text for="L35">切断吧 没关系！</text><text for="L36">宝贝 我会让你快乐</text><text for="L37">Ooo</text><text for="L38">无需担心</text><text for="L39">言语本就不可靠</text><text for="L40">你可以成为任何人</text><text for="L41">今夜 再一次</text><text for="L42">想要从头活过</text><text for="L43">又是第几个春天</text><text for="L44">对于重获新生的我</text><text for="L45">别再带来那些煞风景的事</text><text for="L46">什么意料之中的幸福</text><text for="L47">都太无趣 我已无法回头</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.766" end="0:01.216">kit</span><span begin="0:01.216" end="0:01.476">to</span> <span begin="0:01.606" end="0:02.026">an</span><span begin="0:02.026" end="0:02.356">ta</span> <span begin="0:02.356" end="0:02.506">ni</span> <span begin="0:02.506" end="0:02.826">wa</span> <span begin="0:02.826" end="0:02.936">wa</span><span begin="0:02.936" end="0:03.366">ka</span><span begin="0:03.366" end="0:03.476">ra</span><span begin="0:03.476" end="0:04.006">na</span><span begin="0:04.006" end="0:04.316">i de</span><span begin="0:04.316" end="0:04.636">shou</span></text><text for="L2"><span begin="0:04.856" end="0:05.376">kon</span><span begin="0:05.376" end="0:05.536">na</span> <span begin="0:05.536" end="0:06.076">ko</span><span begin="0:06.076" end="0:06.406">toba</span> <span begin="0:06.406" end="0:06.646">wa</span> <span begin="0:06.896" end="0:07.296">todo</span><span begin="0:07.296" end="0:07.556">ka</span><span begin="0:07.556" end="0:07.996">na</span><span begin="0:07.996" end="0:08.156">i</span> <span begin="0:08.156" end="0:08.346">de</span><span begin="0:08.346" end="0:08.706">shou</span></text><text for="L3"><span begin="0:08.938" end="0:09.198">ma</span><span begin="0:09.198" end="0:09.378">ru</span><span begin="0:09.378" end="0:09.568">de</span> <span begin="0:09.568" end="0:10.158">gan</span><span begin="0:10.158" 