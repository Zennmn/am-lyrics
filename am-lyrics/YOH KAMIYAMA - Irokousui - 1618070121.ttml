<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Irokousui"/><amll:meta key="artists" value="YOH KAMIYAMA"/><amll:meta key="album" value="CLOSET"/><amll:meta key="isrc" value="JPU902100005"/><amll:meta key="appleMusicId" value="1618070121"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>YOH KAMIYAMA</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">一定不会消散 今天却说不出口</text><text for="L2">再也无法回到从前</text><text for="L3">就这样把你留在那段时光里</text><text for="L4">记忆中的房间 洒满一片晴光</text><text for="L5">才刚互相吸引便要道别</text><text for="L6">我不愿知晓</text><text for="L7">每当想起 那气息如今仍轻轻浮现</text><text for="L8">你与我 有着同样的色香水</text><text for="L9">曾稍稍踮起脚尖走过的路</text><text for="L10">玻璃鞋 四季更迭的光景</text><text for="L11">一定不会消散 今天却说不出口</text><text for="L12">再也无法回到从前</text><text for="L13">当年藏起的那份真实 如今在哪里</text><text for="L14">你不肯为我生气 也不肯理解我</text><text for="L15">再怎么思念 也只是愈积愈深</text><text for="L16">只余那令人怀念的气息和这首歌</text><text for="L17">记忆中的房间 属于你我两人</text><text for="L18">若彼此相吸 我们就这样</text><text for="L19">每当想起 那气息依然轻轻浮现</text><text for="L20">你与我 有着同样的色香水</text><text for="L21">失去得越多</text><text for="L22">就连温柔也变得令人厌倦</text><text for="L23">在玻璃弹珠里</text><text for="L24">宛如滚落的泪滴</text><text for="L25">一定不会消散 今天却说不出口</text><text for="L26">再也无法回到从前</text><text for="L27">藏在那年夏天 其实早已</text><text for="L28">你不肯为我生气 也不肯理解我</text><text for="L29">再怎么思念 也只是愈积愈深</text><text for="L30">与崭新的气息一起 留在这座城</text><text for="L31">总有一天 总有一天</text><text for="L32">这些脱口而出的谎言</text><text for="L33">都会一一变成真的</text><text for="L34">但愿如此 但愿如此</text><text for="L35">我曾一遍遍地默念</text><text for="L36">你就那样化作透明</text><text for="L37">一定不会消散 今天却说不出口</text><text for="L38">再也无法回到从前</text><text for="L39">当年藏起的那份真实 如今在哪里</text><text for="L40">你不肯为我生气 也不肯理解我</text><text for="L41">再怎么思念 也只是愈积愈深</text><text for="L42">只余那令人怀念的气息和这首歌</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.410" end="0:00.770">kit</span><span begin="0:00.770" end="0:01.000">to</span> <span begin="0:01.000" end="0:01.260">ki</span><span begin="0:01.260" end="0:01.410">e</span><span begin="0:01.410" end="0:01.870">nai</span> <span begin="0:02.020" end="0:02.480">kyou</span> <span begin="0:02.480" end="0:02.750">wa</span> <span begin="0:02.750" end="0:02.900">i</span><span begin="0:02.900" end="0:03.030">e</span><span begin="0:03.030" end="0:03.580">nai</span></text><text for="L2"><span begin="0:03.890" end="0:04.310">moto</span><span begin="0:04.310" end="0:04.900">doo</span><span begin="0:04.900" end="0:05.110">ri</span> <span begin="0:05.110" end="0:05.300">ni</span> <span begin="0:05.300" end="0:05.680">wa</span> <span begin="0:05.680" end="0:06.100">mou</span> <span begin="0:06.100" end="0:06.280">de</span><span begin="0:06.280" end="0:06.520">ki</span><span begin="0:06.520" end="0:06.780">na</span><span begin="0:06.780" end="0:06.980">i</span></text><text for="L3"><span begin="0:07.172" end="0:07.342">a</span><span begin="0:07.342" end="0:07.482">no</span> <span begin="0:07.482" end="0:07.972">koro</span> <span begin="0:07.972" end="0:08.362">ni</span> <span begin="0:08.672" end="0:09.192">kimi</span> <span begin="0:09.192" end="0:09.692">o</span> <span begin="0:09.942" end="0:10.482">noko</span><span begin="0:10.482" end="0:10.802">shita</span> <span begin="0:10.802" end="0:11.002">m