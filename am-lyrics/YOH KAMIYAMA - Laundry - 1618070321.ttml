<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Laundry"/><amll:meta key="artists" value="YOH KAMIYAMA"/><amll:meta key="album" value="CLOSET"/><amll:meta key="isrc" value="JPU902001978"/><amll:meta key="appleMusicId" value="1618070321"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>YOH KAMIYAMA</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">摇啊摇啊 轻轻摇晃</text><text for="L2">摇啊摇啊 轻轻摇晃</text><text for="L3">跳吧 一直跳吧</text><text for="L4">直到天明</text><text for="L5">若是跳得累了</text><text for="L6">就安心睡去</text><text for="L7">只是这样</text><text for="L8">随波漂荡 心绪浮沉</text><text for="L9">直至纠缠成团</text><text for="L10">那深深浸染的污渍</text><text for="L11">请替我洗去</text><text for="L12">洗涤</text><text for="L13">与我出生的街道</text><text for="L14">真是截然不同啊</text><text for="L15">拨开熙攘人群</text><text for="L16">一只猫走过</text><text for="L17">远处的水声</text><text for="L18">隐约传来</text><text for="L19">今天就沉默着</text><text for="L20">为你合掌祈愿</text><text for="L21">无论如何</text><text for="L22">总会继续下去</text><text for="L23">至少这份感情</text><text for="L24">仍然属于我自己</text><text for="L25">为什么</text><text for="L26">为什么</text><text for="L27">一遍遍追问</text><text for="L28">心跳的声音</text><text for="L29">彼此相连</text><text for="L30">映亮侧脸</text><text for="L31">轻轻摇晃</text><text for="L32">跳吧 一直跳吧</text><text for="L33">直到天明</text><text for="L34">若是跳得累了</text><text for="L35">就安心睡去</text><text for="L36">只是随波漂荡</text><text for="L37">心绪浮沉</text><text for="L38">直至纠缠成团</text><text for="L39">那深深浸染的污渍</text><text for="L40">能否替我洗去</text><text for="L41">倘若能重生</text><text for="L42">又会变成什么呢</text><text for="L43">仿佛事不关己</text><text for="L44">轻声低语</text><text for="L45">只是</text><text for="L46">在脑海之中</text><text for="L47">还能继续活下去</text><text for="L48">和我不一样</text><text for="L49">想起此时此刻</text><text for="L50">轻抚过喉咙</text><text for="L51">明明虚假</text><text for="L52">却又平淡的</text><text for="L53">温柔旋律</text><text for="L54">总在渴望未曾拥有的</text><text for="L55">依旧无可奈何</text><text for="L56">身体渐渐消融</text><text for="L57">无人知晓</text><text for="L58">我也不想再知道</text><text for="L59">在身旁打盹的</text><text for="L60">霓虹</text><text for="L61">跳吧 一直跳吧</text><text for="L62">直到天明</text><text for="L63">若是风儿吹来</text><text for="L64">摇曳也无妨</text><text for="L65">只是随波漂荡</text><text for="L66">心绪浮沉</text><text for="L67">直至纠缠成团</text><text for="L68">被那浸透心底的痛楚</text><text for="L69">吞没在漩涡里</text><text for="L70">摇啊摇啊 轻轻摇晃</text><text for="L71">跳吧 一直跳吧</text><text for="L72">直到天明</text><text for="L73">若是跳得累了</text><text for="L74">就安心睡去</text><text for="L75">只是这样</text><text for="L76">随波漂荡 心绪浮沉</text><text for="L77">直至纠缠成团</text><text for="L78">那深深浸染的污渍</text><text for="L79">请替我洗去</text><text for="L80">洗涤</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:01.072" end="0:01.446">yura</span><span begin="0:01.446" end="0:01.796">yura</span><span begin="0:01.796" end="0:02.116">yura</span><span begin="0:02.116" end="0:02.476">yura</span></text><text for="L2"><span begin="0:02.476" end="0:02.826">yura</span><span begin="0:02.826" end="0:03.186">yura</span><span begin="0:03.186" end="0:03.516">yura</span><span begin="0:03.516" end="0:03.912">yura</span></text><text for="L3"><span begin="0:03.948" end="0:04.428">odot</span><span begin="0:04.428" end="0:04.728">te</span> <span begin="0:04.978" end="0:05.448">odot</s