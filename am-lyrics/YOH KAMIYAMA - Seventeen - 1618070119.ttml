<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Seventeen"/><amll:meta key="artists" value="YOH KAMIYAMA"/><amll:meta key="album" value="CLOSET"/><amll:meta key="isrc" value="JPU902200370"/><amll:meta key="appleMusicId" value="1618070119"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>YOH KAMIYAMA</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">十七岁</text><text for="L2">某一天发出的求救信号</text><text for="L3">向着掌声响起的地方聚拢</text><text for="L4">喂？</text><text for="L5">冲吵闹的家伙们咂舌</text><text for="L6">咬破舌尖尝到了血腥味</text><text for="L7">又不知不觉地寻觅着你</text><text for="L8">在阴影里长出的价值观</text><text for="L9">从中作梗让我怎么也发不出声</text><text for="L10">明明连乘法口诀都还记不牢</text><text for="L11">不知为何却觉得自己不会输</text><text for="L12">十七岁 某一天发出的求救信号</text><text for="L13">只想为些无聊的小事开怀大笑</text><text for="L14">即使今天就是地球终结之日</text><text for="L15">这份心意依然不变</text><text for="L16">十七岁 在某一天的绝望</text><text for="L17">将一切搅得支离破碎之前</text><text for="L18">请让我听见吧</text><text for="L19">回过神来窗外已是夏天</text><text for="L20">一遍遍攒下那些“等着瞧吧”</text><text for="L21">浑身使不上劲 转眼又到了夜晚</text><text for="L22">钻进被窝打开Safari</text><text for="L23">在深层意识的三游间盘旋</text><text for="L24">穿过间隙的子弹被缓缓弹回</text><text for="L25">越过狂奔的心脏向前追逐</text><text for="L26">为自己夺下那第一名</text><text for="L27">十七岁 某一天发出的求救信号</text><text for="L28">还想为些无聊的小事放声大笑</text><text for="L29">全都是谎言 我不想再听</text><text for="L30">已经停不下来了</text><text for="L31">十七岁 往后的日子</text><text for="L32">究竟该怎么活下去</text><text for="L33">我茫然不知 只顾喘着气</text><text for="L34">十七岁 某一天发出的求救信号</text><text for="L35">十七岁 某一天发出的求救信号</text><text for="L36">十七岁 某一天发出的求救信号</text><text for="L37">只想为些无聊的小事开怀大笑</text><text for="L38">即使今天就是地球终结之日</text><text for="L39">这份心意依然不变</text><text for="L40">十七岁 在某一天的绝望</text><text for="L41">将一切搅得支离破碎之前</text><text for="L42">请让我听见吧</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:00.671" end="0:00.911">se</span><span begin="0:00.911" end="0:01.311">bun</span><span begin="0:01.311" end="0:01.741">tiin</span></text><text for="L2"><span begin="0:01.741" end="0:02.021">itsu</span><span begin="0:02.021" end="0:02.231">ka</span> <span begin="0:02.231" end="0:02.401">no</span> <span begin="0:02.401" end="0:02.821">S</span><span begin="0:02.821" end="0:03.131">O</span><span begin="0:03.131" end="0:03.551">S</span></text><text for="L3"><span begin="0:15.094" end="0:15.394">te</span> <span begin="0:15.394" end="0:15.534">no</span> <span begin="0:15.534" end="0:15.754">na</span><span begin="0:15.754" end="0:15.864">ru</span> <span begin="0:15.864" end="0:16.294">hou</span> <span begin="0:16.294" end="0:16.424">e</span> <span begin="0:16.424" end="0:16.544">a</span><span begin="0:16.544" end="0:16.784">tsu</span><span begin="0:16.784" end="0:17.064">mat</span><span begin="0:17.064" end="0:17.384">te</span></text><text for="L4"><span begin="0:17.396" end="0:17.626">He</span><span begin="0:17.626" end="0:17.976">llo?</span></text><text for="L5"><span begin="0:17.969" end="0:18.269">uru</span><span begin="0:18.269" end="0:18.699">sai</span> <span begin="0:18.699" end="0:19.069">yatsu</span><span begin="0:19.069" end="0:19.279">ra</span> <span begin="0:19.279" end="0:19.389">ni</span> <span begin="0:19.389" end="0:19.839">shita</span><span begin="0:19.839" end="0:19.939">u</span><span begin="0:19.939" en