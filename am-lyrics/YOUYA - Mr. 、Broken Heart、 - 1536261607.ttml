<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Mr. &quot;Broken Heart&quot;"/><amll:meta key="artists" value="YOUYA"/><amll:meta key="album" value="I AM ME"/><amll:meta key="isrc" value="JPES00801782"/><amll:meta key="appleMusicId" value="1536261607"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Jin Nakamura</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">今天也在寻觅你的幻影</text><text for="L2">独自在十字路口追逐你的身影</text><text for="L3">我说不出再见</text><text for="L4">今夜我无法入眠</text><text for="L5">好想与你相见 我的心已破碎</text><text for="L6">如今已不被允许触碰你</text><text for="L7">连悔意也无法传达的泪水</text><text for="L8">那声再见是仍无法填补的拼图碎片</text><text for="L9">在我心中至今仍无法拼成完整的图画</text><text for="L10">你不经意间流露的悲伤笑容</text><text for="L11">横亘在你我之间的宇宙</text><text for="L12">我只能说没有理由</text><text for="L13">四季流转 我始终爱你</text><text for="L14">却无法向你诉说 我的心已破碎</text><text for="L15">请让我知晓你甜美的心灵</text><text for="L16">请让我知晓你甜蜜的爱</text><text for="L17">褪色的温暖仿佛就要消散</text><text for="L18">仿佛听见你的声音 那是回忆的玩笑</text><text for="L19">回首望去 那声音温柔地穿过人潮消逝</text><text for="L20">我只能说没有理由</text><text for="L21">春去秋来 我依然爱你</text><text for="L22">却始终说不出口 我的心已破碎</text><text for="L23">你只说没有理由</text><text for="L24">你说你听不进去</text><text for="L25">千言未尽 只是凝望着</text><text for="L26">我无法说出再见</text><text for="L27">今夜又辗转难眠</text><text for="L28">好想再见你一面 我的心已破碎</text><text for="L29">如今已不能再触碰你</text><text for="L30">连一句谢谢也无法传达的泪水</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:20.545" end="0:21.105">kyou </span><span begin="0:21.105" end="0:21.945">mo </span><span begin="0:22.115" end="0:22.815">saga</span><span begin="0:22.815" end="0:22.995">shi</span><span begin="0:22.995" end="0:23.305">te</span><span begin="0:23.305" end="0:23.475">i</span><span begin="0:23.475" end="0:24.975">ta </span><span begin="0:25.545" end="0:26.055">kimi </span><span begin="0:26.055" end="0:26.295">no </span><span begin="0:26.295" end="0:26.595">ma</span><span begin="0:26.595" end="0:26.945">bo</span><span begin="0:26.945" end="0:27.185">ro</span><span begin="0:27.185" end="0:29.315">shi</span></text><text for="L2"><span begin="0:30.535" end="0:30.845">hi</span><span begin="0:30.845" end="0:31.065">to</span><span begin="0:31.065" end="0:31.835">ri </span><span begin="0:32.065" end="0:32.665">kou</span><span begin="0:32.665" end="0:32.835">sa</span><span begin="0:32.835" end="0:33.405">ten </span><span begin="0:33.405" end="0:34.795">de </span><span begin="0:35.175" end="0:35.635">kage </span><span begin="0:35.705" end="0:36.015">o </span><span begin="0:36.015" end="0:36.315">o</span><span begin="0:36.315" end="0:36.485">i</span><span begin="0:36.485" end="0:36.825">ka</span><span begin="0:36.825" end="0:37.185">ke</span><span begin="0:37.185" end="0:38.275">ru</span></text><text for="L3"><span begin="0:38.604" end="0:38.824">I</span> <span begin="0:38.824" end="0:39.084">can</span><span begin="0:39.084" end="0:39.404">not</span> <span begin="0:39.404" end="0:39.774">say</span> <span begin="0:39.774" end="0:40.384">"Good</span><span begin="0:40.384" end="0:40.924">bye"</span></text><text for="L4"><span begin="0:41.122" end="0:41.332">I</span> <span begin="0:41.332" end="0:41.572">can</span><span begin="0:41.572" end="0:41.902">not</span> <span begin="0:41.902" end="0:42.272">sleep<