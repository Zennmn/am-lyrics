><span begin="3:46.281" end="3:46.664">te i</span><span begin="3:46.664" end="3:47.201">ranai </span><span begin="3:47.201" end="3:48.206">yo</span></text><text for="L71"><span begin="3:59.491" end="4:00.119">rei ra </span><span begin="4:00.119" end="4:00.711">sai da</span></text><text for="L72"><span begin="4:00.711" end="4:01.080">sa</span><span begin="4:01.080" end="4:01.594">bu at</span><span begin="4:01.594" end="4:01.801">ta</span><span begin="4:01.801" end="4:02.233">ssha ru</span></text><text for="L73"><span begin="4:02.534" end="4:03.332">ma ra ha ba </span><span begin="4:03.332" end="4:03.910">mas sa</span><span begin="4:03.910" end="4:04.620">raa ma </span><span begin="4:04.620" end="4:04.801">ma</span><span begin="4:04.801" end="4:05.269">da</span></text><text for="L74"><span begin="4:05.538" end="4:06.158">rei ra </span><span begin="4:06.158" end="4:06.772">sai da</span></text><text for="L75"><span begin="4:06.772" end="4:07.240">sa</span><span begin="4:07.240" end="4:07.636">bu at</span><span begin="4:07.636" end="4:07.833">ta</span><span begin="4:07.833" end="4:08.459">ssha ru</span></text><text for="L76"><span begin="4:08.575" end="4:09.323">ma ra ha ba </span><span begin="4:09.323" end="4:10.070">mas sa</span><span begin="4:10.070" end="4:10.427">raa ma </span><span begin="4:10.427" end="4:11.486">ma ra ha</span><span begin="4:11.486" end="4:12.373">ba</span></text></transliteration></transliterations><songwriters><songwriter>ACAne</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">晚安</text><text for="L2">十七</text><text for="L3">你好 再见 什么</text><text for="L4">晚安</text><text for="L5">十七</text><text for="L6">你好 再见 什么</text><text for="L7">挡在眼前的头目尚未</text><text for="L8">被唤醒</text><text for="L9">望着摩天楼渐次崩塌</text><text for="L10">飞扬的沙尘今天也沾染了你的脸颊</text><text for="L11">毫不迟疑地 啊</text><text for="L12">若要写下想陪在你身边的缘由</text><text for="L13">我会给它安一个顺口的名字</text><text for="L14">却不必归属于什么</text><text for="L15">因为本就没有那样的前提</text><text for="L16">连眼也不眨</text><text for="L17">捻碎青色的种子送入口中</text><text for="L18">直到日暮 永恒也不存在</text><text for="L19">我会让你明白这一点</text><text for="L20">如果连水与这份热度</text><text for="L21">也一定无法感知的话</text><text for="L22">那就竭尽全力诉诸声音吧</text><text for="L23">那些无法彼此相通的记忆</text><text for="L24">即使全部冰封 也依然留有形迹</text><text for="L25">不过是这份心情有个名字</text><text for="L26">每一次握住手时</text><text for="L27">也不过是程序使然吗？</text><text for="L28">那谁也无法适用的</text><text for="L29">标准什么的 我才不需要</text><text for="L30">只是漂浮着的</text><text for="L31">那一枚泡沫也有名字</text><text for="L32">在这个世界上</text><text for="L33">难以重现的神情自有其意义</text><text for="L34">甚至无需言语</text><text for="L35">如果人从出生到死亡</text><text for="L36">只能走过一回</text><text for="L37">那就一次次拆毁 再重新拼凑</text><text for="L38">只想亲手确认那是否就是奇迹</text><text for="L39">两人潜入蜜桃味的汽水里</text><text for="L40">即使微微落泪也无从察觉</text><text for="L41">我们就这样相互掩藏</text><text for="L42">如果连这份颤抖 这份沉重</text><text for="L43">也无法传达给你</text><text for="L44">那就按下按钮将它抹去吧</text><text for="L45">那些无法契合的记忆</text><text for="L46">即使一一解答 也只会徒增不安</text><text for="L47">不过是那样的记忆有个名字</text><text for="L48">尽管一旦移开视线</text><text for="L49">便会渐渐生锈</text><text for="L50">那些横亘在前徒劳的思绪回路</text><text for="L51">即使化作伤痕 也想触碰</text><text for="L52">能够说出口吗</text><text for="L53">我不需要任何斩钉截铁的答案</text><text for="L54">就连真伪 连那些见解</text><text for="L55">也都不该由任何人裁定</text><text for="L56">输赢 黑白 人类</text><text for="L57">或是否为人 这一切</text><text for="L58">早已没有绝对的正确</text><text for="L59">就连转瞬即逝的伤痕也拥入怀中 闭上双眼吧</text><text for="L60">为了让今天落幕</text><text for="L61">倘若连水与这份热度</text><text for="L62">都已经无法感知</text><text for="L63">就竭尽全力说出声吧</text><text for="L64">那些无法彼此相通的记忆</text><text for="L65">即使尽数冰封 也依然留有形迹</text><text for="L66">不过是这份心情有个名字</text><text for="L67">每当握住你的手</text><text for="L68">也只是程序使然吗？</text><text for="L69">那谁也无法适用的</text><text for="L70">标准什么的 我不需要</text><text for="L71">晚安</text><text for="L72">十七</text><text for="L73">你好 再见 什么</text><text for="L74">晚安</text><text for="L75">十七</text><text for="L76">你好 再见 你好</text></translation></translations></iTunesMetadata></metadata></head><body dur="4:12.373"><div begin="0:01.114" end="4:12.373"><p begin="0:01.114" end="0:02.376" itunes:key="L1" ttm:agent="v1"><span begin="0:01.114" end="0:01.458">レイ</span><span begin="0:01.458" end="0:01.786">ラ</span><span begin="0:01.786" end="0:02.177">サイ</span><span begin="0:02.177" end="0:02.376">ダ</span></p><p begin="0:02.376" end="0:03.925" itunes:key="L2" ttm:agent="v1"><span begin="0:02.376" end="0:02.616">サ</span><span begin="0:02.722" end="0:03.028">ブアッ</span><span begin="0:03.112" end="0:03.311">タ</span><span begin="0:03.311" end="0:03.925">ッシャル</span></p><p begin="0:03.857" end="0:06.514" itunes:key="L3" ttm:agent="v1"><span begin="0:03.857" end="0:04.889">マラハバ</span> <span begin="0:04.889" end="0:05.198">マッサ</span><span begin="0:05.198" end="0:06.093">ラーマ</span> <span begin="0:06.093" end="0:06.296">マ</span><span begin="0:06.296" end="0:06.514">ダ</span></p><p begin="0:07.025" end="0:08.266" itunes:key="L4" ttm:agent="v1"><span begin="0:07.025" end="0:07.428">レイ</span><span begin="0:07.428" end="0:07.629">ラ</span><span begin="0:07.629" end="0:08.067">サイ</span><span begin="0:08.067" end="0:08.266">ダ</span></p><p begin="0:08.266" end="0:09.961" itunes:key="L5" ttm:agent="v1"><span begin="0:08.266" end="0:08.624">サ</span><span begin="0:08.780" end="0:09.157">ブアッ</span><span begin="0:09.157" end="0:09.373">タ</span><span begin="0:09.373" end="0:09.961">ッシャル</span></p><p begin="0:10.040" end="0:13.090" itunes:key="L6" ttm:agent="v1"><span begin="0:10.040" end="0:10.816">マラハバ</span> <span begin="0:10.816" end="0:11.503">マッサ</span><span begin="0:11.503" end="0:12.181">ラーマ</span> <span begin="0:12.181" end="0:12.330">マ</span><span begin="0:12.330" end="0:13.090">ダ</span></p><p begin="0:24.965" end="0:26.235" itunes:key="L7" ttm:agent="v1"><span begin="0:24.965" end="0:25.185">立ち</span><span begin="0:25.185" end="0:25.325">はだ</span><span begin="0:25.325" end="0:25.435">か</span>