<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">ずっと真夜中でいいのに。 (永远是深夜有多好｡)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">天边溢出的淡淡藏青色</text><text for="L2">始终未能让我们好好利用时间</text><text for="L3">任砂砾随意流逝</text><text for="L4">不知该如何捕捉思考</text><text for="L5">在清晨细品着忧郁</text><text for="L6">想要让记忆沉眠</text><text for="L7">滞留的勇气</text><text for="L8">去哪里了呢</text><text for="L9">我在被试探着吗</text><text for="L10">因为怀疑所以想要信任</text><text for="L11">如果没有了音乐</text><text for="L12">我便不会起舞</text><text for="L13">放手转让 借出便不再归还的</text><text for="L14">夜空弦月亦是如此</text><text for="L15">只需气息便可跨越</text><text for="L16">跨越围栏与秩序的天真</text><text for="L17">有你在即可化成水</text><text for="L18">一味追逐着无色的光辉</text><text for="L19">愿这令我在意的距离</text><text for="L20">只存在于你我之间</text><text for="L21">小船顺流而下</text><text for="L22">放松身心 去往明亮的方向</text><text for="L23">在鲜艳的水果上涂满毒液</text><text for="L24">夹杂着刚学到的谎言</text><text for="L25">将它们全部吃掉</text><text for="L26">才能勉强站立着</text><text for="L27">身陷在一群 如果我不使用</text><text for="L28">奇怪的语言 就不会有交集的人中</text><text for="L29">避开你的目光 剜着自己的伤口</text><text for="L30">怀着一颗磨损的心 独自唱着歌</text><text for="L31">如果你笑起来的话 我也会试着笑起来</text><text for="L32">只需气息便可跨越</text><text for="L33">跨越围栏与秩序的天真</text><text for="L34">有你在即可化成水</text><text for="L35">一味追逐着无色的光辉</text><text for="L36">愿这令我在意的距离</text><text for="L37">只存在于你我之间</text><text for="L38">小船顺流而下</text><text for="L39">放松身心 去往明亮的方向</text><text for="L40">黑加仑色的发丝摇曳着</text><text for="L41">嚎哭到喉干舌燥 再次</text><text for="L42">请让我再次</text><text for="L43">与你继续上次中断的谈话</text><text for="L44">我在寻求着谁的什么许可</text><text for="L45">而生活着呢</text><text for="L46">有必要给每个心情</text><text for="L47">都取一个名字吗</text><text for="L48">啊 无法断言</text><text for="L49">如今依旧无法断言</text><text for="L50">用开玩笑的话说出来就好</text><text for="L51">稍微能与你相触的瞬间</text><text for="L52">希望这不只是个美好的憧憬</text><text for="L53">一味追逐着无色的光辉</text><text for="L54">希望这首试探的歌</text><text for="L55">你不会听到</text><text for="L56">小船顺流而下</text><text for="L57">放松身心 去往明亮的方向</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:29.432" end="0:33.592" itunes:key="L1" ttm:agent="v1"><span begin="0:29.432" end="0:29.640">は</span><span begin="0:29.640" end="0:29.840">み</span><span begin="0:29.840" end="0:30.096">出</span><span begin="0:30.096" end="0:30.296">し</span><span begin="0:30.296" end="0:30.584">て</span><span begin="0:30.584" end="0:31.000">た</span> <span begin="0:31.000" end="0:31.424">淡</span><span begin="0:31.424" end="0:31.632">い</span><span begin="0:31.632" end="0:31.992">紺</span><span begin="0:31.992" end="0:32.491">色</span><span begin="0:32.491" end="0:32.808">が</span><span begin="0:32.808" end="0:33.000">ず</span><span begin="0:33.000" end="0:33.192">っ</span><span begin="0:33.193" end="0:33.592">と</span></p><p begin="0:34.304" end="0:38.283" itunes:key="L2" ttm:agent="v1"><span begin="0:34.304" end="0:34.738">僕</span><span begin="0:34.738" end="0:34.936">ら</span><span begin="0:34.936" end="0:35.147">の</span><span begin="0:35.147" end="0:35.376">時</span><span begin="0:35.376" end="0:35.682">間</span><span begin="0:35.682" end="0:35.985">を</span><span begin="0:35.985" end="0:36.426">解</span><span begin="0:36.426" end="0:37.425">決</span><span begin="0:37.425" end="0:37.665">さ</span><span begin="0:37.665" end="0:37.897">せ</span><span begin="0:37.897" end="0:38.086">ず</span><span begin="0:38.086" end="0:38.283">に</span></p><p begin="0:38.283" end="0:41.316" itunes:key="L3" ttm:agent="v1"><span begin="0:38.283" end="0:38.705">砂</span><span begin="0:38.705" end="0:38.921">を</span><span begin="0:38.921" end="0:39.332">払</span><span begin="0:39.332" end="0:39.700">っ</span><span begin="0:39.700" end="0:40.428">た</span><span begin="0:40.428" end="0:40.644">り</span><span begin="0:40.644" end="0:40.876">し</span><span begin="0:40.876" end="0:41.316">た</span></p><p begin="0:42.529" end="0:46.630" itunes:key="L4" ttm:agent="v1"><span begin="0:42.529" end="0:42.990">考</span><span begin="0:42.990" end="0:43.190">え</span><span begin="0:43.190" end="0:43.479">と</span><span begin="0:43.479" end="0:43.966">か</span><span begin="0:43.966" end="0:44.362">捉</span><span begin="0:44.362" end="0:44.592">え</span><span begin="0:44.592" end="0:44.999">方</span><span begin="0:44.999" end="0:45.246">も</span><span begin="0:45.246" end="0:45.448">知</span><span begin="0:45.448" end="0:45.638">ら</span><span begin="0:45.638" end="0:45.839">な</span><span begin="0:45.839" end="0:46.102">い</span><span begin="0:46.102" end="0:46.630">や</span></p><p begin="0:47.254" end="0:49.790" itunes:key="L5" ttm:agent="v1"><span begin="0:47.254" end="0:47.719">朝</span><span begin="0:47.719" end="0:47.902">に</span><span begin="0:47.902" end="0:48.304">齧</span><span begin="0:48.305" end="0:48.478">っ</span><span begin="0:48.478" end="0:48.694">た</span><span begin="0:48.694" end="0:49.159">憂</span><span begin="0:49.159" end="0:49.376">い</span><span begin="0:49.376" end="0:49.790">で</span></p><p begin="0:50.414" end="0:52.926" itunes:key="L6" ttm:agent="v1"><span begin="0:50.414" end="0:50.654">記</span><span begin="0:50.654" end="0:51.038">憶</span><span begin="0:51.038" end="0:51.238">を</span><span begin="0:51.238" end="0:51.638">眠</span><span begin="0:51.638" end="0:51.830">ら</span><span begin="0:51.830" end="0:52.023">せ</span><span begin="0:52.023" end="0:52.297">た</span><span begin="0:52.297" end="0:52.534">く</span><span begin="0:52.534" end="0:52.926">て</span></p></div><div itunes:song-part="PreChorus"><p begin="0:54.571" end="0:57.364" itunes:key="L7" ttm:agent="v1"><span begin="0:54.571" end="0:54.779">ど</span><span begin="0:54.779" end="0:55.030">こ</span><span begin="0:55.030" end="0:55.268">か</span><span begin="0:55.268" end="0:55.515">に</span><span begin="0:55.515" end="0:55.784">ゆ</span><span begin="0:55.784" end="0:56.060">く</span><span begin="0:56.060" end="0:56.427">の</span><span begin="0:56.427" end="0:57.364">か</span></p><p begin="0:57.719" end="1:00.367" itunes:key="L8" ttm:agent="v1"><span begin="0:57.719" end="0:58.219">留</span><span begin="0:58.219" end="0:58.478">ま</span><span begin="0:58.478" end="0:58.715">る</span><span begin="0:58.715" end="0:59.259">勇</span><span begin="0:59.259" end="0:59.594">気</span><span begin="0:59.594" end="1:00.367">が</span></p><p begin="1:00.979" end="1:03.259" itunes:key="L9" ttm:agent="v1"><span begin="1:00.979" end="1:01.427">試</span><span begin="1:01.427" end="1:01.691">さ</span><span begin="1:01.691" end="1:01.963">れ</span><span begin="1:01.963" end="1:02.221">て</span><span begin="1:02.221" end="1:02.504">る</span><span begin="1:02.504" end="1:02.811">の</span><span begin="1:02.811" end="1:03.259">か</span></p><p begin="1:03.531" end="1:07.246" itunes:key="L10" ttm:agent="v1"><span begin="1:03.531" end="1:04.080">疑</span><span begin="1:04.080" end="1:04.278">う</span><span begin="1:04.278" end="1:04.478">こ</span><span begin="1:04.478" end="1:04.742">と</span><span begin="1:04.742" end="1:05.022">で</span><span begin="1:05.022" end="1:05.425">信</span><span begin="1:05.425" end="1:05.646">じ</span><span begin="1:05.646" end="1:06.702">た</span><span begin="1:06.702" end="1:07.246">い</span></p><p begin="1:07.580" end="1:10.077" itunes:key="L11" ttm:agent="v1"><span begin="1:07.580" end="1:08.130">踊</span><span begin="1:08.130" end="1:08.379">り</span><span begin="1:08.379" end="1:08.658">は</span><span begin="1:08.658" end="1:08.925">し</span><span begin="1:08.925" end="1:09.109">な</span><span begin="1:09.109" end="1:09.442">い</span><span begin="1:09.442" end="1:10.077">さ</span></p><p begin="1:10.682" end="1:13.373" itunes:key="L12" ttm:agent="v1"><span begin="1:10.682" end="1:11.179">音</span><span begin="1:11.179" end="1:11.458">も</span><span begin="1:11.458" end="1:11.739">無</span><span begin="1:11.739" end="1:12.003">く</span><span begin="1:12.003" end="1:12.260">な</span><span begin="1:12.260" end="1:12.604">れ</span><span begin="1:12.604" end="1:13.373">ば</span></p><p begin="1:14.003" end="1:16.779" itunes:key="L13" ttm:agent="v1"><span begin="1:14.003" end="1:14.218">手</span><span begin="1:14.218" end="1:14.602">放</span><span begin="1:14.602" end="1:14.827">せ</span><span begin="1:14.827" end="1:15.258">た</span> <span begin="1:15.258" end="1:15.451">借</span><span begin="1:15.451" end="1:15.647">り</span><span begin="1:15.647" end="1:15.850">パ</span><span begin="1:15.850" end="1:16.038">ク</span><span begin="1:16.038" end="1:16.219">し</span><span begin="1:16.219" end="1:16.498">て</span><span begin="1:16.498" end="1:16.779">た</span></p><p begin="1:16.920" end="1:19.262" itunes:key="L14" ttm:agent="v1"><span begin="1:16.920" end="1:17.110">夜</span><span begin="1:17.110" end="1:17.390">弦</span><span begin="1:17.390" end="1:17.606">の</span><span begin="1:17.606" end="1:18.166">月</span><span begin="1:18.166" end="1:19.262">も</span></p></div><div itunes:song-part="Chorus"><p begin="1:19.587" end="1:22.827" itunes:key="L15" ttm:agent="v1"><span begin="1:19.587" end="1:19.779">気</span><span begin="1:19.779" end="1:20.123">配</span><span begin="1:20.123" end="1:20.292">だ</span><span begin="1:20.292" end="1:20.467">け</span><span begin="1:20.467" end="1:20.631">で</span><span begin="1:20.631" end="1:20.789">超</span><span begin="1:20.789" end="1:20.971">え</span><span begin="1:20.971" end="1:21.147">ら</span><span begin="1:21.147" end="1:21.323">れ</span><span begin="1:21.323" end="1:21.509">る</span><span begin="1:21.509" end="1:21.827">か</span><span begin="1:21.827" end="1:22.827">ら</span></p><p begin="1:23.598" end="1:26.731" itunes:key="L16" ttm:agent="v1"><span begin="1:23.598" end="1:24.372">柵</span><span begin="1:24.372" end="1:24.619">や</span><span begin="1:24.619" end="1:24.995">秩</span><span begin="1:24.995" end="1:25.268">序</span><span begin="1:25.268" end="1:25.459">の</span><span begin="1:25.459" end="1:25.851">甘</span><span begin="1:25.851" end="1:26.148">え</span><span begin="1:26.148" end="1:26.731">は</span></p><p begin="1:26.731" end="1:29.643" itunes:key="L17" ttm:agent="v1"><span begin="1:26.731" end="1:27.189">君</span><span begin="1:27.189" end="1:27.379">が</span><span begin="1:27.379" end="1:27.579">い</span><span begin="1:27.579" end="1:27.787">て</span><span begin="1:27.787" end="1:28.267">水</span><span begin="1:28.267" end="1:28.524">に</span><span begin="1:28.524" end="1:29.339">な</span><span begin="1:29.339" end="1:29.643">る</span></p><p begin="1:30.139" end="1:33.107" itunes:key="L18" ttm:agent="v1"><span begin="1:30.139" end="1:30.579">色</span><span begin="1:30.579" end="1:30.747">の</span><span begin="1:30.747" end="1:30.931">な</span><span begin="1:30.931" end="1:31.123">い</span><span begin="1:31.123" end="1:31.651">輝</span><span begin="1:31.651" end="1:31.843">き</span><span begin="1:31.843" end="1:32.021">を</span><span begin="1:32.021" end="1:32.124">追</span><span begin="1:32.124" end="1:32.227">う</span><span begin="1:32.227" end="1:32.411">ば</span><span begin="1:32.411" end="1:32.699">か</span><span begin="1:32.699" end="1:33.107">り</span></p><p begin="1:33.107" end="1:35.995" itunes:key="L19" ttm:agent="v1"><span begin="1:33.107" end="1:33.331">気</span><span begin="1:33.331" end="1:33.491">に</span><span begin="1:33.491" end="1:33.675">し</span><span begin="1:33.675" end="1:33.844">て</span><span begin="1:33.844" end="1:34.022">し</span><span begin="1:34.022" end="1:34.203">ま</span><span begin="1:34.203" end="1:34.412">う</span><span begin="1:34.412" end="1:34.603">距</span><span begin="1:34.603" end="1:34.867">離</span><span begin="1:34.867" end="1:35.995">が</span></p><p begin="1:36.684" end="1:39.539" itunes:key="L20" ttm:ag