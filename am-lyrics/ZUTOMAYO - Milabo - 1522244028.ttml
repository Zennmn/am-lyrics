<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">鞠躬致意</text><text for="L2">不想被人看穿 因而未曾放声歌唱</text><text for="L3">可绝非心中毫无波澜</text><text for="L4">这动辄就思忖着诀别的人生</text><text for="L5">我也甘之如饴欣然接纳</text><text for="L6">若是相见 必然意犹未尽</text><text for="L7">连片语碎语 都要谱成词句铭记</text><text for="L8">迎面投来</text><text for="L9">那些黏着不放的狭长目光 虽惹人生厌</text><text for="L10">可我早已疲于四处逃避</text><text for="L11">纵使千百次触碰到你</text><text for="L12">略施几分机巧黠慧</text><text for="L13">便能将徒劳打转的真心掩藏如初</text><text for="L14">别妄自将我探究</text><text for="L15">莫把因果自受归咎于我</text><text for="L16">别轻易说你懂我</text><text for="L17">莫将世事宿命苛责于我</text><text for="L18">不要来勘破我的模样</text><text for="L19">不要为因果循环横加斥责</text><text for="L20">只求你别对我心生厌弃</text><text for="L21">任由举手投足愈发摇曳</text><text for="L22">直到心绪再难按捺</text><text for="L23">若无节拍跃动 闲谈也索然寡味</text><text for="L24">心怯于璀璨炫目的镜球</text><text for="L25">重又抱紧木吉他</text><text for="L26">便尚能在羞涩中起舞</text><text for="L27">终究是这般浅薄轻率</text><text for="L28">虽满心不舍归去</text><text for="L29">别说了 我还不习惯这副身体</text><text for="L30">我还会不断改变 成为更好的自己</text><text for="L31">呐 哪怕我如此贪求 也请见证到最后</text><text for="L32">心中作何感想</text><text for="L33">若说难以言表</text><text for="L34">倒并非出于怯懦娇羞</text><text for="L35">只因那首颂咏永恒幸福的赞歌</text><text for="L36">仿佛脱口便要唱响</text><text for="L37">才容我暂且按捺 仅此而已</text><text for="L38">虽然转眼又陷入消极</text><text for="L39">自我怀疑再度涌上</text><text for="L40">纵使写尽尘世间所有歌谣</text><text for="L41">依然渴求你回眸眷顾</text><text for="L42">写下这最后的绝唱</text><text for="L43">看着某人的眼睫 一再改期令人疲倦</text><text for="L44">长夜漫漫 只好拼命借醉消愁</text><text for="L45">且在举止间尽情摇曳</text><text for="L46">翻涌至难以平息</text><text for="L47">失去律动共振 谈吐便味同嚼蜡</text><text for="L48">即便畏惧流光溢彩的舞球</text><text for="L49">只要重新抱起木吉他</text><text for="L50">呐 纵然我任性贪婪 也请凝眸顾盼</text><text for="L51">休要自以为看透了我</text><text for="L52">莫将自业自得视作罪责</text><text for="L53">切莫探听我的底细</text><text for="L54">莫因世情流转对我指责</text><text for="L55">更莫妄想真正读懂我</text><text for="L56">莫为前因后果出言训诫</text><text for="L57">纵然如此 也请不要厌弃我</text><text for="L58">躬身作揖</text><text for="L59">任神采随姿态放肆摇曳</text><text for="L60">激荡得汹涌难抑</text><text for="L61">若律动哀泣沉寂 对话亦干瘪无趣</text><text for="L62">依然畏惧耀眼的镜面光球</text><text for="L63">重拾手中的原声木吉他</text><text for="L64">我便仍可怀揣羞怯起舞婆娑</text><text for="L65">从始至终都这般稚嫩短浅</text><text for="L66">虽千般不愿转身归去</text><text for="L67">别说了 这副身体我仍无法习惯</text><text for="L68">我会继续改变 让自己一步步向前</text><text for="L69">呐 且酣睡吧 哪怕我贪心不足 也请守候至明</text><text for="L70">鞠躬谢幕</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="Milabo"/><amll:meta key="artists" value="ZUTOMAYO"/><amll:meta key="album" value="Hogarakana Hifutote Fufuku - EP"/><amll:meta key="appleMusicId" value="1522244028"/><amll:meta key="isrc" value="JPPO02001854"/></metadata></head><body><div begin="0:16.412" end="4:11.303"><p begin="0:16.412" end="0:16.798" itunes:key="L1" ttm:agent="v1"><span begin="0:16.412" end="0:16.798">Bow</span></p><p begin="0:31.732" end="0:35.712" itunes:key="L2" ttm:agent="v1"><span begin="0:31.732" end="0:32.982">バレたく</span><span begin="0:32.982" end="0:33.992">はないから</span> <span begin="0:34.192" end="0:35.312">歌わないけ</span><span begin="0:35.312" end="0:35.712">ど</span></p><p begin="0:36.082" end="0:38.672" itunes:key="L3" ttm:agent="v1"><span begin="0:36.082" end="0:36.952">想ってない</span><span begin="0:36.952" end="0:37.392">とか</span><span begin="0:37.392" end="0:38.162">じゃない</span><span begin="0:38.162" end="0:38.672">の</span></p><p begin="0:39.145" end="0:43.275" itunes:key="L4" ttm:agent="v1"><span begin="0:39.145" end="0:40.745">いつも御別れ</span><span begin="0:40.745" end="0:41.485">ばかり</span> <span begin="0:41.655" end="0:42.865">考える人生</span><span begin="0:42.865" end="0:43.275">も</span></p><p begin="0:43.539" end="0:46.439" itunes:key="L5" ttm:agent="v1"><span begin="0:43.539" end="0:44.889">積極的に</span><span begin="0:44.889" end="0:46.199">嬉しいか</span><span begin="0:46.199" end="0:46.439">ら</span></p><p begin="0:46.704" end="0:49.054" itunes:key="L6" ttm:agent="v1"><span begin="0:46.704" end="0:47.504">会えば</span><span begin="0:47.504" end="0:47.924">きっと</span><span begin="0:47.924" end="0:48.764">足りなく</span><span begin="0:48.764" end="0:49.054">て</span></p><p begin="0:49.218" end="0:52.578" itunes:key="L7" ttm:agent="v1"><span begin="0:49.218" end="0:49.858">会話の</span><span begin="0:49.858" end="0:50.858">切れ端まで</span> <span begin="0:50.858" end="0:51.758">歌詞で</span><span begin="0:51.758" end="0:52.348">覚える</span><span begin="0:52.348" end="0:52.578">の</span></p><p begin="0:52.781" end="0:53.911" itunes:key="L8" ttm:agent="v1"><span begin="0:52.781" end="0:53.451">向いて</span><span begin="0:53.451" end="0:53.571">く</span><span begin="0:53.571" end="0:53.911">る</span></p><p begin="0:54.177" end="0:58.357" itunes:key="L9" ttm:agent="v1"><span begin="0:54.177" end="0:55.127">引っ付く</span><span begin="0:55.127" end="0:56.247">横長の</span><span begin="0:56.247" end="0:56.617">目</span> <span begin="0:56.807" end="0:57.417">鬱陶</span><span begin="0:57.417" end="0:57.647">し</span><span begin="0:57.647" end="0:57.727">い</span><span begin="0:57.727" end="0:57.987">け</span><span begin="0:57.987" end="0:58.357">ど</span></p><p begin="0:58.668" end="1:01.588" itunes:key="L10" ttm:agent="v1"><span begin="0:58.668" end="0:59.298">逃げる</span><span begin="0:59.298" end="1:00.068">準備に</span><span begin="1:00.068" end="1:00.578">疲</span><span begin="1:00.578" end="1:00.778">れ</span><span begin="1:00.778" end="1:01.078">た</span><span begin="1:01.078" end="1:01.588">わ</span></p><p begin="1:02.323" end="1:06.943" itunes:key="L11" ttm:agent="v1"><span begin="1:02.323" end="1:04.203">あなたに</span><span begin="1:04.203" end="1:05.323">幾度も</span> <span begin="1:05.543" end="1:05.983">触れ</span><span begin="1:05.983" end="1:06.363">た</span><span begin="1:06.363" end="1:06.943">って</span></p><p begin="1:06.939" end="1:09.739" itunes:key="L12" ttm:agent="v1"><span begin="1:06.939" end="1:07.879">大体</span><span begin="1:07.879" end="1:08.369">ちょっと</span><span begin="1:08.369" end="1:08.829">だけ</span> <span begin="1:08.829" end="1:09.279">頓</span><span begin="1:09.279" end="1:09.739">知</span></p><p begin="1:10.027" end="1:14.617" itunes:key="L13" ttm:agent="v1"><span begin="1:10.027" end="1:12.187">空回りの</span><span begin="1:12.397" end="1:13.247">本心</span> <span begin="1:13.337" end="1:13.767">隠</span><span begin="1:13.767" end="1:14.007">せ</span><span begin="1:14.007" end="1:14.427">ちゃ</span><span begin="1:14.427" end="1:14.617">う</span></p><p begin="1:15.395" end="1:17.395" itunes:key="L14" ttm:agent="v1"><span begin="1:15.395" end="1:15.875">あたしの</span><span begin="1:15.875" end="1:16.325">こと</span><span begin="1:16.325" end="1:16.645">知</span><span begin="1:16.645" end="1:16.755">ら</span><span begin="1:16.755" end="1:17.135">ない</span><span begin="1:17.135" end="1:17.395">で</span></p><p begin="1:17.390" end="1:19.180" itunes:key="L15" ttm:agent="v1"><span begin="1:17.390" end="1:18.210">因果応報</span><span begin="1:18.210" end="1:18.340">叱</span><span begin="1:18.340" end="1:18.560">ら</span><span begin="1:18.560" end="1:19.010">ない</span><span begin="1:19.010" end="1:19.180">で</span></p><p begin="1:19.186" end="1:21.176" itunes:key="L16" ttm:agent="v1"><span begin="1:19.186" end="1:19.666">あたしの</span><span begin="1:19.666" end="1:20.106">こと</span><span begin="1:20.106" end="1:20.426">知</span><span begin="1:20.426" end="1:20.556">ら</span><span begin="1:20.556" end="1:20.906">ない</span><span begin="1:20.906" end="1:21.176">で</span></p><p begin="1:21.178" end="1:22.958" itunes:key="L17" ttm:agent="v1"><span begin="1:21.178" end="1:21.598">因果</span><span begin="1:21.678" end="1:21.998">応報</span><span begin="1:21.998" end="1:22.418">叱ら</span><span begin="1:22.418" end="1:22.798">ない</span><span begin="1:22.798" end="1:22.958">で</span></p><p begin="1:22.957" end="1:24.957" itunes:key="L18" ttm:agent="v1"><span begin="1:22.957" end="1:23.297">あたし</span><span begin="1:23.297" end="1:23.437">の</span><span begin="1:23.437" end="1:23.867">こと</span><span begin="1:23.867" end="1:24.317">知ら</span><span begin="1:24.317" end="1:24.677">ない</span><span begin="1:24.677" end="1:24.957">で</span></p><p begin="1:24.960" end="1:26.730" itunes:key="L19" ttm:agent="v1"><span begin="1:24.960" end="1:25.440">因果</span><span begin="1:25.440" end="1:25.770">応報</span><span begin="1:25.770" end="1:26.200">叱ら</span><span begin="1:26.200" end="1:26.570">ない</span><span begin="1:26.570" end="1:26.730">で</span></p><p begin="1:26.725" end="1:28.905" itunes:key="L20" ttm:agent="v1"><span begin="1:26.725" end="1:27.085">あたし</span><span begin="1:27.085" end="1:27.225">の</span><span begin="1:27.225" end="1:27.625">こと</span><span begin="1:27.625" end="1:28.085">嫌わ</span><span begin="1:28.085" end="1:28.475">ない</span><span begin="1:28.475" end="1:28.905">で</span></p><p begin="1:29.852" end="1:32.192" itunes:key="L21" ttm:agent="v1"><span begin="1:29.852" end="1:30.502">もっと</span> <span begin="1:30.502" end="1:31.552">仕草に</span><span begin="1:31.552" end="1:31.872">揺れ</span><span begin="1:31.872" end="1:32.192">て</span></p><p begin="1:32.277" end="1:34.567" itunes:key="L22" ttm:agent="v1"><span begin="1:32.277" end="1:33.177">抑え</span><span begin="1:33.177" end="1:33.767">きれない</span><span begin="1:33.767" end="1:34.347">ほど</span><span begin="1:34.347" end="1:34.567">に</span></p><p begin="1:34.707" end="1:37.857" itunes:key="L23" ttm:agent="v1"><span begin="1:34.707" end="1:35.487">リズムが</span><span begin="1:35.487" end="1:35.977">なきゃ</span> <span begin="1:35.977" end="1:37.087">話も</span><span begin="1:37.087" end="1:37.787">味っけな</span><span begin="1:37.787" end="1:37.857">い</span></p><p beg