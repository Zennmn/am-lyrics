<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Time Machine (feat. Aren Park)"/><amll:meta key="artists" value="mj apanay"/><amll:meta key="album" value="Seen 11:23 Pm - EP"/><amll:meta key="isrc" value="GBSMU6594279"/><amll:meta key="appleMusicId" value="1733110516"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">凝望群星与明月</text><text for="L2">盼有一天它们能引我走向你</text><text for="L3">每夜守候 若有流星划落</text><text for="L4">我会许愿重返那些珍爱的时光</text><text for="L5">为何星辰在夜空如此明亮</text><text for="L6">当大多数人都已沉入梦乡？</text><text for="L7">为何我们只能活这一回？</text><text for="L8">多希望时光能够倒流</text><text for="L9">照片唤醒我遗忘的往事</text><text for="L10">也让我想起失去的一切</text><text for="L11">它们再也回不来 也不会从天而降</text><text for="L12">于是我试着忘掉那些珍爱的时光</text><text for="L13">为何我们总记得美丽的谎言？</text><text for="L14">却要为它们悔恨大半生</text><text for="L15">为何我们只有一次尝试的机会？</text><text for="L16">多希望能回到从前</text><text for="L17">每当我沉沉睡去</text><text for="L18">总能在梦里与你相见</text><text for="L19">仿佛乘着时光机回到过去</text><text for="L20">我知道梦醒时 你与我相伴的时光便会终结</text><text for="L21">所以别让我睡去</text><text for="L22">我不愿在梦中与你相逢</text><text for="L23">我知道我们永远造不出时光机</text><text for="L24">是时候试着再次醒来了</text><text for="L25">我沉入梦乡 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(沉入梦乡)</span></text><text for="L26">可说真的 <span xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg">(说真的)</span></text><text for="L27">我还是想在梦里见到你</text><text for="L28">我正试着再次醒来</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:13.790"><div begin="0:12.250" end="3:13.790"><p begin="0:12.250" end="0:17.940" itunes:key="L1" ttm:agent="v1"><span begin="0:12.250" end="0:12.890">Sta</span><span begin="0:12.890" end="0:13.550">ring</span> <span begin="0:13.550" end="0:13.800">at</span> <span begin="0:13.800" end="0:15.060">stars,</span> <span begin="0:15.450" end="0:15.740">wa</span><span begin="0:15.740" end="0:16.470">tching</span> <span begin="0:16.470" end="0:16.780">the</span> <span begin="0:16.780" end="0:17.940">moon</span></p><p begin="0:18.440" end="0:23.890" itunes:key="L2" ttm:agent="v1"><span begin="0:18.440" end="0:18.887">Ho</span><span begin="0:18.887" end="0:19.500">ping</span> <span begin="0:19.500" end="0:20.020">that</span> <span begin="0:20.020" end="0:20.550">one</span> <span begin="0:20.550" end="0:21.040">day</span> <span begin="0:21.040" end="0:21.470">they'll</span> <span begin="0:21.470" end="0:21.980">lead</span> <span begin="0:21.980" end="0:22.220">me</span> <span begin="0:22.450" end="0:23.000">to</span> <span begin="0:23.000" end="0:23.890">you</span></p><p begin="0:24.510" end="0:29.700" itunes:key="L3" ttm:agent="v1"><span begin="0:24.510" end="0:25.060">Wait</span> <span begin="0:25.060" end="0:25.452">ev</span><span begin="0:25.452" end="0:25.800">ery</span> <span begin="0:26.011" end="0:26.700">night</span> <span begin="0:27.000" end="0:27.580">'cause</span> <span begin="0:27.580" end="0:28.050">if</span> <span begin="0:28.050" end="0:28.230">a</span> <span begin="0:28.230" end="0:28.830">star</span> <span begin="0:28.830" end="0:29.700">falls</span></p><p begin="0:30.030" end="0:35.860" itunes:key="L4" ttm:agent="v1"><span begin="0:30.030" end="0:30.500">I'll</span> <span begin="0:30.500" end="0:30.950">wish</span> <span begin="0:30.950" end="0:31.430">to</span> <span begin="0:31.430" end="0:31.890">go</span> <span begin