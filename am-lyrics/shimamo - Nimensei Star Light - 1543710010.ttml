<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Nimensei Star Light"/><amll:meta key="artists" value="shimamo"/><amll:meta key="album" value="Nimensei Star Light - Single"/><amll:meta key="isrc" value="JPWP02000879"/><amll:meta key="appleMusicId" value="1543710010"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Yasutaka Kume</songwriter><songwriter>shimamo</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">星光啊 耳机里的世界</text><text for="L2">曾赠予我光亮</text><text for="L3">将这无法平复的心绪</text><text for="L4">在今夜紧紧拥入怀中</text><text for="L5">这世间万物无常</text><text for="L6">灵魂也随之摇晃</text><text for="L7">一遍遍自问自答</text><text for="L8">终究只是胆怯罢了</text><text for="L9">就让小小的身躯</text><text for="L10">用尽全力呼喊吧</text><text for="L11">在社交网络上渐渐晕开</text><text for="L12">不曾知晓何为恶</text><text for="L13">我们就这样</text><text for="L14">寻觅着那一抹纯白</text><text for="L15">星光啊 耳机里的世界</text><text for="L16">曾赠予我光亮</text><text for="L17">将这无法平复的心绪</text><text for="L18">在今夜紧紧拥入怀中</text><text for="L19">即使明天生命走到尽头</text><text for="L20">我也不会后悔</text><text for="L21">相信那就是我的人生</text><text for="L22">此刻我正活在当下</text><text for="L23">用小小的眼眸怒视这世界</text><text for="L24">真正的爱究竟在哪里</text><text for="L25">因为在这个世界上</text><text for="L26">值得珍惜的事物</text><text for="L27">实在太多了 对吧</text><text for="L28">星光啊 耳机里的世界</text><text for="L29">曾悄悄赠予我爱</text><text for="L30">将这无法平息的爱意</text><text for="L31">在今夜紧紧揽入怀中</text><text for="L32">Oh</text><text for="L33">Oh</text><text for="L34">Oh</text><text for="L35">Oh</text><text for="L36">独自用耳机围起的世界</text><text for="L37">曾赠予我光亮</text><text for="L38">那无法平复的心绪</text><text for="L39">是一个又一个蓝紫色的夜</text><text for="L40">诸行无常... 自问自答...</text><text for="L41">诸行无常... 自问自答...</text><text for="L42">星光啊 耳机里的世界</text><text for="L43">曾赠予我光亮</text><text for="L44">那无法平复的心绪</text><text for="L45">有表亦有里</text><text for="L46">就笑笑这样的我吧</text></translation></translations><transliterations xmlns="http://music.apple.com/lyric-ttml-internal"><transliteration xml:lang="ja-Latn" xmlns="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><text for="L1"><span begin="0:15.350" end="0:15.630">su</span><span begin="0:15.630" end="0:16.170">taa</span><span begin="0:16.170" end="0:16.510">rai</span><span begin="0:16.510" end="0:16.710">to</span> <span begin="0:16.710" end="0:17.060">i</span><span begin="0:17.060" end="0:17.290">ya</span><span begin="0:17.290" end="0:18.130">fon</span> <span begin="0:18.130" end="0:18.310">no</span> <span begin="0:18.310" end="0:18.530">se</span><span begin="0:18.530" end="0:19.130">kai</span> <span begin="0:19.130" end="0:19.400">ga</span></text><text for="L2"><span begin="0:19.580" end="0:20.880">hikari</span> <span begin="0:20.880" end="0:21.020">o</span> <span begin="0:21.020" end="0:21.340">ku</span><span begin="0:21.340" end="0:22.230">re</span><span begin="0:22.230" end="0:23.010">ta</span></text><text for="L3"><span begin="0:23.270" end="0:23.480">fu</span><span begin="0:23.480" end="0:23.950">rat</span><span begin="0:23.950" end="0:24.400">to</span> <span begin="0:24.400" end="0:24.840">de</span><span begin="0:24.840" end="0:25.120">ki</span><span begin="0:25.120" end="0:25.720">na</span><span begin="0:25.720" end="0:25.860">i</span> <span begin="0:25.860" end="0:26.390">kan</span><span begin="0:26.390" end="0:26.710">jou</span> <span begin="0:26.710" end="0:27.180">o</span></text><text for="L4"><span begin="0:27.380" end="0:27.810">gyut</span><span begin="0:27.810" end="0