pan><span begin="3:42.647" end="3:43.167">kon</span><span begin="3:43.167" end="3:43.287">da</span> <span begin="3:43.287" end="3:43.607">so</span><span begin="3:43.607" end="3:44.007">yo</span><span begin="3:44.007" end="3:44.527">kaze</span> <span begin="3:44.527" end="3:44.977">ga</span></text><text for="L42"><span begin="3:45.223" end="3:45.693">mado</span><span begin="3:45.693" end="3:45.913">be</span> <span begin="3:45.913" end="3:46.103">no</span> <span begin="3:46.103" end="3:46.893">hana</span> <span begin="3:46.893" end="3:47.093">o</span> <span begin="3:47.293" end="3:47.783">yu</span><span begin="3:47.783" end="3:47.933">ra</span><span begin="3:47.933" end="3:48.163">shi</span><span begin="3:48.163" end="3:48.813">te</span></text><text for="L43"><span begin="3:49.607" end="3:50.069">ao</span><span begin="3:50.069" end="3:50.489">gu</span> <span begin="3:50.489" end="3:51.009">kyou</span> <span begin="3:51.009" end="3:51.369">no</span> <span begin="3:51.369" end="3:51.939">sora</span> <span begin="3:51.939" end="3:52.379">wa</span></text><text for="L44"><span begin="3:52.636" end="3:52.873">a</span><span begin="3:52.873" end="3:53.078">no</span> <span begin="3:53.078" end="3:53.583">toki</span> <span begin="3:53.583" end="3:54.212">ega i</span><span begin="3:54.212" end="3:54.483">ta</span> <span begin="3:54.709" end="3:55.163">ao</span> <span begin="3:55.163" end="3:55.583">dat</span><span begin="3:55.583" end="3:56.522">ta</span></text></transliteration></transliterations><songwriters><songwriter>tazuneru</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">吹拂而入的微风</text><text for="L2">轻摇着窗畔的花枝</text><text for="L3">浮上心头的身影</text><text for="L4">与那段贪恋春光的岁月</text><text for="L5">读到一半的书页间</text><text for="L6">曾忘我沉醉地追寻</text><text for="L7">却不知何时已然淡忘</text><text for="L8">明明书签仍夹在原处</text><text for="L9">与你共度的朝夕 漫无归处的梦</text><text for="L10">皆未曾褪色</text><text for="L11">在记忆深处散发着温热</text><text for="L12">纵使曾描绘的未来遥不可及</text><text for="L13">与你相伴的光芒仍照亮明日</text><text for="L14">托清风捎去 连这般话语</text><text for="L15">若都能如愿传达给你</text><text for="L16">仅此而已 我便已然</text><text for="L17">足以继续活下去</text><text for="L18">那数也数不尽的</text><text for="L19">喜怒哀乐层层交叠</text><text for="L20">就连轻轻阖上的眼睑间</text><text for="L21">也满溢着令人眷恋的时光</text><text for="L22">已不再畏惧 也不再迷茫</text><text for="L23">将这份回忆</text><text for="L24">轻轻拾起 我便能再次启程</text><text for="L25">纵是千般祈愿 苦苦挽留也难遂的命运</text><text for="L26">我们就在那前方约定相见吧</text><text for="L27">无论怎样的长夜定能跨越</text><text for="L28">只要是与你同行的旅途</text><text for="L29">请相信彼此重逢的奇迹</text><text for="L30">哪怕屡屡跌撞 哪怕曾走过错路</text><text for="L31">我们也一路走到了这里</text><text for="L32">沿途铭刻的足迹</text><text for="L33">是只属于我们的印记</text><text for="L34">彼此许下的誓言 共同度过的往昔</text><text for="L35">纵然当初描绘的未来相隔千里</text><text for="L36">与你同在的光芒定会照亮明天</text><text for="L37">昔日共同直面的梦想彼端</text><text for="L38">即便是擦肩而过的岔路</text><text for="L39">依凭这份温热继续前行吧</text><text for="L40">因为在那前方我们定会重逢</text><text for="L41">轻拂而入的微风</text><text for="L42">摇曳着窗边的花影</text><text for="L43">抬首仰望的今日天空</text><text for="L44">正是彼时描绘的那抹蔚蓝</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:56.522"><div begin="0:04.343" end="3:56.522"><p begin="0:04.343" end="0:07.123" itunes:key="L1" ttm:agent="v1"><span begin="0:04.343" end="0:04.593">吹</span><span begin="0:04.593" end="0:04.813">き</span><span begin="0:04.813" end="0:05.323">込ん</span><span begin="0:05.323" end="0:05.473">だ</span><span begin="0:05.473" end="0:05.743">そ</span><span begin="0:05.743" end="0:06.183">よ</span><span begin="0:06.183" end="0:06.673">風</span><span begin="0:06.673" end="0:07.123">が</span></p><p begin="0:07.383" end="0:10.973" itunes:key="L2" ttm:agent="v1"><span begin="0:07.383" end="0:07.833">窓</span><span begin="0:07.833" end="0:08.073">辺</span><span begin="0:08.073" end="0:08.253">の</span><span begin="0:08.253" end="0:08.953">花</span><span begin="0:09.043" end="0:09.233">を</span><span begin="0:09.433" end="0:09.943">揺</span><span begin="0:09.943" end="0:10.103">ら</span><span begin="0:10.103" end="0:10.333">し</span><span begin="0:10.333" end="0:10.973">て</span></p><p begin="0:11.824" end="0:14.484" itunes:key="L3" ttm:agent="v1"><span begin="0:11.824" end="0:11.944">浮</span><span begin="0:11.944" end="0:12.704">かん</span><span begin="0:12.704" end="0:13.004">だ</span><span begin="0:13.004" end="0:13.564">面</span><span begin="0:13.564" end="0:14.034">影</span><span begin="0:14.034" end="0:14.484">と</span></p><p begin="0:14.753" end="0:18.263" itunes:key="L4" ttm:agent="v1"><span begin="0:14.753" end="0:15.323">春</span><span begin="0:15.323" end="0:15.443">を</span><span begin="0:15.443" end="0:16.333">貪っ</span><span begin="0:16.333" end="0:16.623">た</span><span begin="0:16.793" end="0:17.073">日</span><span begin="0:17.073" end="0:17.313">々</span><span begin="0:17.313" end="0:17.473">の</span><span begin="0:17.473" end="0:17.683">こ</span><span begin="0:17.683" end="0:18.263">と</span></p><p begin="0:26.504" end="0:29.277" itunes:key="L5" ttm:agent="v1"><span begin="0:26.504" end="0:26.767">読</span><span begin="0:26.767" end="0:26.957">み</span><span begin="0:26.957" end="0:27.417">か</span><span begin="0:27.417" end="0:27.667">け</span><span begin="0:27.667" end="0:27.907">た</span><span begin="0:27.907" end="0:28.387">本</span><span begin="0:28.387" end="0:28.607">の</span><span begin="0:28.607" end="0:29.277">中</span></p><p begin="0:29.540" end="0:33.110" itunes:key="L6" ttm:agent="v1"><span begin="0:29.540" end="0:29.710">夢</span><span begin="0:29.710" end="0:30.220">中</span><span begin="0:30.220" end="0:30.420">に</span><span begin="0:30.420" end="0:31.060">なっ</span><span begin="0:31.060" end="0:31.390">て</span><span begin="0:31.640" end="0:31.940">追</span><span begin="0:31.940" end="0:32.280">いか</span><span begin="0:32.280" end="0:32.480">け</span><span begin="0:32.480" end="0:33.110">て</span></p><p begin="0:33.903" end="0:36.577" itunes:key="L7" ttm:agent="v1"><span be