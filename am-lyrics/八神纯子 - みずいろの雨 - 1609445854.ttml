<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Mizuiro No Ame"/><amll:meta key="artists" value="JUNKO YAGAMI"/><amll:meta key="album" value="Sugao No Watashi"/><amll:meta key="isrc" value="JPAP09819305"/><amll:meta key="appleMusicId" value="74877644"/><amll:meta key="ttmlAuthorGithub" value="176552149"/><amll:meta key="ttmlAuthorGithubLogin" value="Zennmn"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">啊 那水蓝色的雨</text><text for="L2">拥住我的双肩 将我笼罩 绵绵落个不停</text><text for="L3">啊 就让它崩塌吧</text><text for="L4">爱的形状被冲刷得无影无踪</text><text for="L5">你呀 是多么温柔的人</text><text for="L6">对我的过错 假装没有看见</text><text for="L7">直到那一时的任性悄然过去</text><text for="L8">忘了吧 忘了吧 忘了曾经爱过我</text><text for="L9">啊 那水蓝色的雨</text><text for="L10">拥着我的肩 将我包围 雨依然下个不停</text><text for="L11">啊 就此忘却吧</text><text for="L12">爱的模样随雨水流逝 不留一点痕迹</text><text for="L13">若是责备的话 我本可以坦然听下</text><text for="L14">那些只是相视微笑的日子 多么令人怀念</text><text for="L15">你受了多少伤 眼底便有多少寂寞</text><text for="L16">回不去了 再也回不去了 回不到那一天的我们</text><text for="L17">啊 那水蓝色的雨</text><text for="L18">轻拥我的肩 将我包围 落雨依旧不停</text><text for="L19">啊 就让它崩塌吧</text><text for="L20">爱的形状随雨流去 再不留一丝痕迹</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:55.483"><div begin="0:14.033" end="2:55.483"><p begin="0:14.033" end="0:19.713" itunes:key="L1" ttm:agent="v1"><span begin="0:14.033" end="0:16.153">ああ</span> <span begin="0:16.153" end="0:16.363">み</span><span begin="0:16.363" end="0:16.683">ず</span><span begin="0:16.683" end="0:16.913">い</span><span begin="0:16.913" end="0:17.173">ろ</span><span begin="0:17.173" end="0:17.573">の</span><span begin="0:17.643" end="0:19.713">雨</span></p><p begin="0:20.003" end="0:28.923" itunes:key="L2" ttm:agent="v1"><span begin="0:20.003" end="0:20.713">私</span><span begin="0:20.713" end="0:20.853">の</span><span begin="0:20.853" end="0:21.423">肩</span><span begin="0:21.423" end="0:21.623">を</span><span begin="0:21.623" end="0:22.073">抱</span><span begin="0:22.073" end="0:22.273">い</span><span begin="0:22.273" end="0:22.753">て</span><span begin="0:22.753" end="0:23.003">つ</span><span begin="0:23.003" end="0:23.573">つん</span><span begin="0:23.573" end="0:24.053">で</span><span begin="0:24.263" end="0:24.533">降</span><span begin="0:24.533" end="0:24.663">り</span><span begin="0:24.663" end="0:25.183">続</span><span begin="0:25.183" end="0:25.393">く</span><span begin="0:25.393" end="0:28.923">の</span></p><p begin="0:29.298" end="0:34.938" itunes:key="L3" ttm:agent="v1"><span begin="0:29.298" end="0:31.338">ああ</span> <span begin="0:31.338" end="0:31.598">く</span><span begin="0:31.598" end="0:31.908">ず</span><span begin="0:31.908" end="0:32.078">れ</span><span begin="0:32.078" end="0:32.348">て</span><span begin="0:32.348" end="0:32.728">し</span><span begin="0:32.728" end="0:32.994">ま</span><span begin="0:32.994" end="0:34.938">え</span></p><p begin="0:35.265" end="0:43.539" itunes:key="L4" ttm:agent="v1"><span begin="0:35.265" end="0:35.385">あ</span><span begin="0:35.385" end="0:35.625">と</span><span begin="0:35.625" end="0:35.875">か</span><span begin="0:35.875" end="0:36.145">た</span><span begin="0:36.145" end="0:36.365">も</span><span begin="0:36.365" end="0:36.595">な</span><span begin="0:36.595" end="0:36.905">く</span><span begin="0:36.905" end="0:37.505">流</span><span begin="0:37.505" end="0:38.075">さ</span><span begin="0:38.075" end="0:38.235">れ</span><span begin="0:38.235" end="0:38.535">て</span><span begin="0:38.535" end="0:38.725">ゆ</span><span begin="0:38.725" end="0:39.305">く</span><span begin="0:39.555" end="0:40.035">愛</span><span begin