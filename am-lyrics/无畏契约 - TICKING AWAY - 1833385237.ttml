<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="TICKING AWAY"/><amll:meta key="artists" value="Grabbitz"/><amll:meta key="artists" value="bbno$"/><amll:meta key="artists" value="无畏契约"/><amll:meta key="album" value="TICKING AWAY (VCT ANTHEM 2023)（流光似箭）"/><amll:meta key="isrc" value="QZH6S1900796"/><amll:meta key="appleMusicId" value="1833385237"/><amll:meta key="kugouMusicId" value="539762638"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Nicholas Chiari</songwriter><songwriter>Alex Gumuchian &amp; Julien Bruce</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我渴望有你伴在身旁</text><text for="L2">即便双足受缚</text><text for="L3">即便双脚被死死锁在大地之上</text><text for="L4">终点依旧遥不可及</text><text for="L5">我不知缘由</text><text for="L6">你却从未任我沉沦溺亡 oh-oh-oh</text><text for="L7">若无你指引 不知该何去何从</text><text for="L8">若无你相伴 不知该如何前行</text><text for="L9">坚信今天终将属于我们</text><text for="L10">胜利终将再次属于我们</text><text for="L11">为何我还要在指针飞逝中同时间竞逐</text><text for="L12">滴答流逝 无休无止 我不禁追问</text><text for="L13">为何我们要拼尽全力奔跑 分秒必争</text><text for="L14">分秒飞逝 不曾停歇</text><text for="L15">开整！</text><text for="L16">赢</text><text for="L17">输</text><text for="L18">横竖我都顶在最前</text><text for="L19">态度拉满</text><text for="L20">掀翻屋顶</text><text for="L21">冲向云霄</text><text for="L22">这一回合绝不虚度</text><text for="L23">没错 就看眼下这把</text><text for="L24">翻盘绝地的主角就是我</text><text for="L25">我可没空在这里耽搁</text><text for="L26">喔！</text><text for="L27">比分直接翻倍</text><text for="L28">二分瞬间变四分</text><text for="L29">你知道我向来战无不胜</text><text for="L30">那就再拿下一把！</text><text for="L31">手感正热</text><text for="L32">百战不厌</text><text for="L33">孤身一人 五杀团灭</text><text for="L34">直接带全队捧起纯金奖杯</text><text for="L35">为何我还要在指针飞逝中同时间竞逐</text><text for="L36">时光飞逝 悄然流走 我不禁追问</text><text for="L37">为何我们要拼尽全力奔跑 分秒必争</text><text for="L38">飞逝而去 永不停留</text><text for="L39">滴答声响 岁月无息</text><text for="L40">悄然流逝 悄然流逝</text><text for="L41">那就再试一次</text><text for="L42">我不知缘何如此</text><text for="L43">却总是一次次重返战场</text><text for="L44">对它的渴求甚至胜过生命</text><text for="L45">我道不明理由</text><text for="L46">但这就是内心笃定的答案</text><text for="L47">为何我还要在指针飞逝中同时间竞逐</text><text for="L48">滴答流逝 无休无止 我不禁追问</text><text for="L49">为何我们要拼尽全力奔跑 分秒必争</text><text for="L50">飞逝而去 永不停留</text><text for="L51">滴答作响 不曾停歇</text><text for="L52">时光飞逝 终无归期</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:19.531"><div begin="0:17.187" end="3:19.531"><p begin="0:17.187" end="0:19.556" itunes:key="L1" ttm:agent="v1"><span begin="0:17.187" end="0:17.452">I</span> <span begin="0:17.452" end="0:17.697">need</span> <span begin="0:17.697" end="0:18.057">to</span> <span begin="0:18.057" end="0:18.393">keep</span> <span begin="0:18.393" end="0:18.660">you</span> <span begin="0:18.660" end="0:19.556">around</span></p><p begin="0:21.091" end="0:23.099" itunes:key="L2" ttm:agent="v1"><span begin="0:21.091" end="0:21.291">With</span> <span begin="0:21.291" end="0:21.638">my</span> <span begin="0:21.638" end="0:22.235">feet</span> <span begin="0:22.235" end="0:23.099">tied</span></p><p begin="0:23.469" end="0:27.171" itunes:key="L3" ttm:agent="v1"><span begin="0:23.469" end="0:23.756">With</span> <span begin="0:23.756" end="0:24.123">my</span> <span begin="0:24.123" end="0:24.659">feet</span> <span begin="0:24.659" end="0:25.355">tied</span> <span begin="0:25.355" end="0:25.989">tight</span> <span begin="0:25.989" end="0:26.307">to</span> <span begin="0:26.307" end="0:26.642">the</span> <span begin="0:26.642" end="0:27.171">ground</span></p><p begin="0:27.380" end="0:29.715" itunes:key="L4" ttm:agent="v1"><span be