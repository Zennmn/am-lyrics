<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Ivory Tower (feat. SennaRin)"/><amll:meta key="artists" value="Hiroyuki Sawano"/><amll:meta key="album" value="Ryuzoku -The Blazing Dawn- (Original Soundtrack Vol.1)"/><amll:meta key="isrc" value="TCJPB2413503"/><amll:meta key="appleMusicId" value="1756859961"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Hiroyuki Sawano</songwriter></songwriters><translations xmlns="http://music.apple.com/lyric-ttml-internal"><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">要放开这执念并不容易</text><text for="L2">那些旧梦在将我唤醒</text><text for="L3">宛如隐者般避世独行</text><text for="L4">总在为退缩寻找借口</text><text for="L5">你向我诉说着先烈昔日的悲歌</text><text for="L6">恍然发觉身边已有了可靠的伙伴</text><text for="L7">只因我曾满怀恐惧</text><text for="L8">如孤身蜷缩在洞穴深处</text><text for="L9">沉寂如顽石一般</text><text for="L10">这一支战舞何其凶险</text><text for="L11">晦涩迷离教我们蜕变重生</text><text for="L12">然而我们悟出的秘密</text><text for="L13">能否将力量赐予众人？</text><text for="L14">这支舞令我震撼又心惊</text><text for="L15">万幸你来到了我们身边</text><text for="L16">学到的教训能否改写前方的视界？</text><text for="L17">你听见了吗？</text><text for="L18">奔向命运的终点</text><text for="L19">我已收到战帖</text><text for="L20">我将彻底颠覆对这世界的认知</text><text for="L21">去颠覆现实</text><text for="L22">来吧 向着我的终局</text><text for="L23">我已洞悉所有真相</text><text for="L24">我将彻底重构对这世界的感知</text><text for="L25">重塑眼前的一切</text><text for="L26">陷落太深</text><text for="L27">我们何时已跨过了不归之途</text><text for="L28">斩落巨兽的全新利刃</text><text for="L29">定能扑灭这蚀骨灼痛</text><text for="L30">莫再迟疑</text><text for="L31">不断轰击高墙直至彻底崩碎</text><text for="L32">力挽狂澜</text><text for="L33">踏上那决定命运的通途</text><text for="L34">只因我曾心怀畏惧</text><text for="L35">如孤身蜷居在幽暗洞穴</text><text for="L36">冷硬如石块一般</text><text for="L37">这一支险象环生的旋舞</text><text for="L38">扑朔难测改变着我们的心性</text><text for="L39">但那些被参透的玄机</text><text for="L40">能否化为所有人的力量？</text><text for="L41">激荡的步履惊心动魄</text><text for="L42">多庆幸你来到我们身旁</text><text for="L43">历经的磨砺能否拓展我们的目光？</text><text for="L44">你听到了吗？</text><text for="L45">奔向终极所在</text><text for="L46">我已接下邀约</text><text for="L47">我将打破对这虚实认知的桎梏</text><text for="L48">颠覆所有定局</text><text for="L49">来吧 奔赴宿命之所</text><text for="L50">我已握紧全部讯息</text><text for="L51">我将击碎旧日认知的樊篱</text><text for="L52">改写所有现实</text><text for="L53">能听见我的呼唤吗？</text><text for="L54">能听见我的呼喊吗？</text><text for="L55">能否听见我在呼唤？</text><text for="L56">你听到了吗？</text><text for="L57">为我们而战！</text><text for="L58">能听见坚信的塔楼上传来的呼唤吗？</text><text for="L59">能感受到这份传承正在延续壮大吗？</text><text for="L60">我们必须挺身而出</text><text for="L61">紧紧依偎并肩同心</text><text for="L62">拨乱反正力挽狂澜</text><text for="L63">赋予你无可匹敌的力量</text><text for="L64">你能听见吗？</text><text for="L65">去往终局之境</text><text for="L66">我已接过命运的邀请</text><text for="L67">我将彻底改变对现实的认知</text><text for="L68">去重塑真实</text><text for="L69">来吧 奔向命定的前路</text><text for="L70">我已参透一切谜底</text><text for="L71">我将彻底重构对所有现实的觉知</text><text for="L72">颠覆整个世界</text></translation></translations></iTunesMetadata></metadata></head><body dur="2:50.030"><div begin="0:08.460" end="2:50.030"><p begin="0:08.460" end="0:10.940" itunes:key="L1" ttm:agent="v1"><span begin="0:08.460" end="0:08.690">It's</span> <span begin="0:08.690" end="0:09.050">not</span> <span begin="0:09.250" end="0:10.000">easy</span> <span begin="0:10.200" end="0:10.420">lose</span> <span begin="0:10.420" end="0:10.650">my</span> <span begin="0:10.650" end="0:10.940">grip</span></p><p begin="0:10.940" end="0:12.200" itunes:key="L2" ttm:agent="v1"><span begin="0:10.940" end="0:11.170">Those</span> <span begin="0:11.170" end="0:11.490">dreams</span> <span begin="0:11.490" end="0:11.550">are</span> <span begin="0:11.550" end="0:11.880">call</span><span begin="0:11.880" end="0:11.960">ing</span> <span begin="0:11.960" end="0:12.200">me</span></p><p begin="0:12.480" end="0:14.170" itunes:key="L3" ttm:agent="v1"><span begin="0:12.480" end="0:12.740">Like</span> <span begin="0:12.740" end="0:13.000">a</span> <span begin="0:13.080" end="0:13.540">her</span><span begin="0:13.540" end="0:14.170">mit</span></p><p begin="0:14.180" end="0:16.210" itunes:key="L4" ttm:agent="v1"><span begin="0:14.180" end="0:14.450">Used</span> <span begin="0:14.450" end="0:14.590">to</span> <span begin="0:14.590" end="0:14.990">find</span> <span begin="0:14.990" end="0:15.160">a</span> <span begin="0:15.160" end="0:15.380">rea</span><span begin="0:15.380" end="0:15.600">son</span> <span begin="0:15.600" end="0:15.850">not</span> <span begin="0:15.850" end="0:15.960">to</span> <span begin="0:15.960" end="0:16.210">be</span></p><p begin="0:16.450" end="0:20.290" itunes:key="L5" ttm:agent="v1"><span begin="0:16.450" end="0:16.630">You</span> <span begin="0:16.630" end="0:17.180">teach</span> <span begin="0:17.180" end="0:17.500">me</span> <span begin="0:17.690" end="0:17.940">about</span> <span begin="0:17.940" end="0:18.120">the</span> <span begin="0:18.120" end="0:18.330">his</span><span begin="0:18.330" end="0:18.660">to</span><span begin="0:18.660" end="0:18.850">ry</span> <span begin="0:18.850" end="0:18.980">of</span> <span begin="0:18.980" end="0:19.170">our</span> <span begin="0:19.170" end="0:19.500">fall</span><span begin="0:19.500" end="0:19.680">en</span> <span begin="0:19.680" end="0:19.980">he</span><span begin="0:19.980" end="0:20.290">roes</span></p><p begin="0:20.450" end="0:23.770" itunes:key="L6" ttm:agent="v1"><span begin="0:20.450" end="0:20.760">Re</span><span begin="0:20.760" end="0:21.130">al</span><span begin="0:21.130" end="0:21.560">ize</span> <span begin="0:21.720" end="0:21.920">I</span> <span begin="0:21.920" end="0:22.150">have</span> <span begin="0:22.150" end="0:22.490">found</span> <span begin="0:22.490" end="0:22.540">a</span> <span begin="0:22.540" end="0:22.870">sol</span><span begin="0:22.870" end="0:22.950">id</span> <span begin="0:22.950" end="0:23.160">com</span><span begin="0:23.160" end="0:23.450">pan</span><span begin="0:23.450" end="0:23.770">ion</span></p><p begin="0:23.770" end="0:25.890" itunes:key="L7" ttm:agent="v1"><span begin="0:23.770" end="0:24.200">'Cause</span> <span begin="0:24.200" end="0:24.910">I</span> <span begin="0:24.910" end="0:25.110">was</span> <span begin="0:25.110" end="0:25.890">afraid</span></p><p begin="0:25.890" end="0:27.710" itunes:key="L8" ttm:agent="v1"><span begin="0:25.890" end="0:26.130">Was</span> <span begin="0:26.130" end="0:26.960">alone</span> <span begin="0:26.960" end="0:27.120">in</span> <span begin="0:27.120" end="0:27.190">a</span> <span begin="0:27.190" end="0:27.710">cave</span></p><p begin="0:27.920" end="0:29.980" itunes:key="L9" ttm:agent="v1"><span begin="0:27.920" end="0:28.140">Like</span> <span begin="0:28.140" end="0:28.180">a</span> <span begin="0:28.180" end="0:29.980">stone</span></p><p begin="0:31.950" end="0:33.900" itunes:key="L10" ttm:agent="v1"><span begin="0:31.950" end="0:32.200">This</span> <span begin="0:32.200" end="0:32.650">dance</span> <span begin="0:32.750" end="0:32.940">is</span> <span begin="0:32.940" end="0:33.110">so</span> <span begin="0:33.110" end="0:33.440">dan</span><span begin="0:33.440" end="0:33.700">ger</span><span begin="0:33.700" end="0:33.900">ous</span></p><p begin="0:33.900" end="0:35.930" itunes:key="L11" ttm:agent="v1"><span begin="0:33.900" end="0:34.280">So</span> <span begin="0:34.280" end="0:34.760">cryp</span><span begin="0:34.760" end="0:35.130">tic</span> <span begin="0:35.130" end="0:35.200">it</span> <span begin="0:35.200" end="0:35.630">changes</span> <span begin="0:35.630" end="0:35.930">us</span></p><p begin="0:35.930" end="0:37.540" itunes:key="L12" ttm:agent="v1"><span begin="0:35.930" end="0:36.070">But</span> <span begin="0:36.070" end="0:36.130">the</span> <span begin="0:36.130" end="0:36.390">se</span><span begin="0:36.390" end="0:36.700">crets</span> <span begin="0:36.700" end="0:36.960">that</span> <span begin="0:36.960" end="0:37.170">we</span> <span begin="0:37.170" end="0:37.540">learn</span></p><p begin="0:37.550" end="0:40.150" itunes:key="L13" ttm:agent="v1"><span begin="0:37.550" end="0:37.900">Can</span> <span begin="0:37.900" end="0:38.420">give</span> <span begin="0:38.420" end="0:38.870">pow</span><span begin="0:38.870" end="0:39.070">er</span> <span begin="0:39.070" end="0:39.250">to</span> <span begin="0:39.250" end="0:39.510">all</span> <span begin="0:39.510" end="0:39.640">of</span> <span begin="0:39.640" end="0:40.150">us?</span></p><p begin="0:40.180" end="0:41.880" itunes:key="L14" ttm:agent="v1"><span begin="0:40.180" end="0:40.550">Dance</span> <span begin="0:40.550" end="0:40.940">shook</span> <span begin="0:40.940" end="0:41.130">me</span> <span begin="0:41.130" end="0:41.460">dan</span><span begin="0:41.460" end="0:41.660">ger</span><span begin="0:41.660" end="0:41.880">ous</span></p><p begin="0:41.900" end="0:43.810" itunes:key="L15" ttm:agent="v1"><span begin="0:41.900" end="0:42.140">So</span> <span begin="0:42.140" end="0:42.580">glad</span> <span begin="0:42.580" end="0:42.920">that</span> <span begin="0:42.920" end="0:43.140">you</span> <span begin="0:43.140" end="0:43.440">came</span> <span begin="0:43.440" end="0:43.640">to</span> <span begin="0:43.640" end="0:43.810">us</span></p><p begin="0:43.830" end="0:47.370" itunes:key="L16" ttm:agent="v1"><span begin="0:43.830" end="0:44.080">Can</span> <span begin="0:44.080" end="0:44.160">a</span> <span begin="0:44.160" end="0:44.480">les</span><span begin="0:44.480" end="0:44.680">son</span> <span begin="0:44.680" end="0:44.990">that</span> <span begin="0:44.990" end="0:45.150">we</span> <span begin="0:45.150" end="0:45.650">learn</span> <span begin="0:45.650" end="0:46.730">transform</span> <span begin="0:46.730" end="0:47.000">our</span> <span begin="0:47.000" end="0:47