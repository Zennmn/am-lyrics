<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">此生有太多不容忘却之事</text><text for="L2">无论病中还是安康之时</text><text for="L3">每逢风起我便想起</text><text for="L4">刻入心底咽下种种继续前行</text><text for="L5">人生毕竟只有一回</text><text for="L6">抱歉我仍未能真切领会</text><text for="L7">只是我仍不甘就此作罢</text><text for="L8">我还能做得更多更多</text><text for="L9">世间本无正确答案却依然执意追寻</text><text for="L10">今日一去便不复返</text><text for="L11">明知如此却仍悔恨落泪何苦</text><text for="L12">若已然眷恋明日便欣然向前</text><text for="L13">有太多事教人难以放手</text><text for="L14">所珍之物理应好好珍惜</text><text for="L15">那日的自己早已教会了我</text><text for="L16">连落下的泪滴也终将替我圆梦</text><text for="L17">此生有太多不容忘却之事</text><text for="L18">无论病中还是安康之时</text><text for="L19">每逢风起我便想起</text><text for="L20">将一切铭记咽下种种继续走下去</text><text for="L21">一直一直一直</text><text for="L22">说到底人人都还是孩子</text><text for="L23">大人与小孩本无分别</text><text for="L24">纷乱莫测的流行风潮</text><text for="L25">岂能向那些风潮认输</text><text for="L26">明明无暇理会却还是疲惫不堪</text><text for="L27">馋得喉间咕噜作响</text><text for="L28">求而不得何苦又要落泪</text><text for="L29">看吧如今已然无碍</text><text for="L30">也该原谅自己了就此作别</text><text for="L31">心绪随性起落如潮</text><text for="L32">忽而高涨忽而低落低落又复高涨</text><text for="L33">这些心绪之中何者才是真我</text><text for="L34">你心里早已明白了吧</text><text for="L35">已无需再问个明白</text><text for="L36">既然注定要与自己相伴一生</text><text for="L37">便要一直温柔疼惜自己</text><text for="L38">明日纵然无望</text><text for="L39">即便如此我仍愿依自己的方式爱着世界</text><text for="L40">还有种种未竟之事</text><text for="L41">至今仍无一件舍得放手</text><text for="L42">有太多事教人难以放手</text><text for="L43">所珍之物理应好好珍惜</text><text for="L44">我会一路唱给那日的自己听</text><text for="L45">曾洒落的泪滴终不会辜负我</text><text for="L46">此生有太多不容忘却之事</text><text for="L47">无论病中还是安康之时</text><text for="L48">每逢风起我便想起</text><text for="L49">将一切铭记咽下种种继续走下去</text><text for="L50">一直一直一直</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="ずっとずっとずっと"/><amll:meta key="artists" value="緑黄色社会"/><amll:meta key="album" value="ずっとずっとずっと - Single"/><amll:meta key="isrc" value="JPU902101238"/><amll:meta key="appleMusicId" value="1600659272"/></metadata></head><body><div begin="0:00.491" end="3:26.125"><p begin="0:00.491" end="0:04.075" itunes:key="L1" ttm:agent="v1"><span begin="0:00.491" end="0:00.951">忘</span><span begin="0:00.951" end="0:01.260">れち</span><span begin="0:01.260" end="0:01.468">ゃ</span><span begin="0:01.468" end="0:02.253">いけない</span><span begin="0:02.253" end="0:03.066">こと</span><span begin="0:03.066" end="0:03.775">ばかり</span><span begin="0:03.775" end="0:04.075">だ</span></p><p begin="0:04.236" end="0:07.800" itunes:key="L2" ttm:agent="v1"><span begin="0:04.236" end="0:04.937">病める</span><span begin="0:04.937" end="0:05.189">日</span><span begin="0:05.189" end="0:05.417">も</span><span begin="0:05.417" end="0:06.339">健や</span><span begin="0:06.339" end="0:06.579">か</span><span begin="0:06.579" end="0:07.020">なる</span><span begin="0:07.020" end="0:07.280">日</span><span begin="0:07.280" end="0:07.800">でも</span></p><p begin="0:07.993" end="0:11.289" itunes:key="L3" ttm:agent="v1"><span begin="0:07.993" end="0:08.361">風</span><span begin="0:08.361" end="0:08.702">が</span><span begin="0:08.702" end="0:09.174">吹く</span><span begin="0:09.174" end="0:09.774">度</span><span begin="0:09.871" end="0:10.224">思い</span><span begin="0:10.224" end="0:10.656">出す</span><span begin="0:10.656" end="0:10.797">の</span><span begin="0:10.797" end="0:11.289">さ</span></p><p begin="0:11.726" end="0:15.164" itunes:key="L4" ttm:agent="v1"><span begin="0:11.726" end="0:12.106">刻ん</span><span begin="0:12.106" end="0:12.459">で</span><span begin="0:12.459" end="0:12.647">飲</span><span begin="0:12.647" end="0:12.927">み</span><span begin="0:12.927" end="0:13.068">込</span><span begin="0:13.068" end="0:13.168">ん</span><span begin="0:13.168" end="0:13.624">で</span><span begin="0:13.624" end="0:14.145">歩</span><span begin="0:14.145" end="0:14.273">い</span><span begin="0:14.273" end="0:14.551">て</span><span begin="0:14.551" end="0:15.164">く</span></p><p begin="0:22.510" end="0:25.621" itunes:key="L5" ttm:agent="v1"><span begin="0:22.510" end="0:22.982">人</span><span begin="0:22.982" end="0:23.511">生</span><span begin="0:23.511" end="0:24.184">一度</span><span begin="0:24.184" end="0:24.644">きり</span><span begin="0:24.644" end="0:25.105">だっ</span><span begin="0:25.105" end="0:25.321">て</span><span begin="0:25.321" end="0:25.621">さ</span></p><p begin="0:26.507" end="0:28.812" itunes:key="L6" ttm:agent="v1"><span begin="0:26.507" end="0:27.100">ごめんね</span><span begin="0:27.100" end="0:27.448">まだ</span><span begin="0:27.448" end="0:27.688">ピン</span><span begin="0:27.688" end="0:27.929">と</span><span begin="0:27.929" end="0:28.371">こない</span><span begin="0:28.371" end="0:28.812">や</span></p><p begin="0:30.245" end="0:31.955" itunes:key="L7" ttm:agent="v1"><span begin="0:30.245" end="0:30.494">ただ</span><span begin="0:30.494" end="0:30.954">納得</span><span begin="0:30.954" end="0:31.555">できない</span><span begin="0:31.555" end="0:31.655">ん</span><span begin="0:31.655" end="0:31.955">だ</span></p><p begin="0:32.356" end="0:33.838" itunes:key="L8" ttm:agent="v1"><span begin="0:32.356" end="0:32.588">もっ</span><span begin="0:32.588" end="0:32.729">と</span><span begin="0:32.729" end="0:33.077">もっと</span><span begin="0:33.077" end="0:33.538">やれるん</span><span begin="0:33.538" end="0:33.838">だ</span></p><p begin="0:33.998" end="0:37.527" itunes:key="L9" ttm:agent="v1"><span begin="0:33.998" end="0:34.479">正</span><span begin="0:34.479" end="0:34.959">解</span><span begin="0:34.959" end="0:35.180">は</span><span begin="0:35.180" end="0:35.660">ない</span><span begin="0:35.660" end="0:36.101">のに</span><span begin="0:36.101" end="0:36.594">求</span><span begin="0:36.594" end="0:36.822">め</span><span begin="0:36.822" end="0:37.042">て</span><span begin="0:37.042" end="0:37.527">る</span></p><p begin="0:38.012" end="0:41.448" itunes:key="L10" ttm:agent="v1"><span begin="0:38.012" end="0:38.612">同</span><span begin="0:38.684" end="0:38.905">じ</span><span begin="0:38.905" end="0:39.285">今日</span><span begin="0:39.285" end="0:39.646">は</span><span begin="0:39.646" end="0:40.227">二度</span><span begin="0:40.227" end="0:40.567">と</span><span begin="0:40.567" end="0:41.148">来ないん</span><span begin="0:41.148" end="0:41.448">だ</span></p><p begin="0:41.769" end="0:45.314" itunes:key="L11" ttm:agent="v1"><span begin="0:41.769" end="0:42.109">分</span><span begin="0:42.109" end="0:42.651">かってん</span><span begin="0:42.651" end="0:43.396">のに</span><span begin="0:43.396" end="0:43.624">悔</span><span begin="0:43.624" end="0:43.945">やん</span><span begin="0:43.945" end="0:44.093">で</span><span begin="0:44.093" end="0:44.433">なん</span><span begin="0:44.433" end="0:44.594">で</span><span begin="0:44.594" end="0:44.910">泣</span><span begin="0:44.910" end="0:45.014">い</span><span begin="0:45.014" end="0:45.314">て</span></p><p begin="0:45.515" end="0:52.678" itunes:key="L12" ttm:agent="v1"><span begin="0:45.515" end="0:46.208">ほら</span><span begin="0:46.208" end="0:46.380">も</span><span begin="0:46.380" end="0:46.905">う</span><span begin="0:46.905" end="0:47.097">明</span><span begin="0:47.097" end="0:47.697">日</span><span begin="0:47.866" end="0:48.327">を</span><span begin="0:48.327" end="0:48.815">愛</span><span begin="0:48.815" end="0:48.980">お</span><span begin="0:48.980" end="0:49.232">し</span><span begin="0:49.232" end="0:49.737">く</span><span begin="0:49.737" end="0:50.433">思う</span><span begin="0:50.433" end="0:50.642">な</span><span begin="0:50.642" end="0:51.134">ら</span><span begin="0:51.134" end="0:51.575">喜</span><span begin="0:51.575" end="0:52.064">ん</span><span begin="0:52.064" end="0:52.678">で</span></p><p begin="0:52.985" end="0:56.589" itunes:key="L13" ttm:agent="v1"><span begin="0:52.985" end="0:53.926">諦め</span><span begin="0:53.926" end="0:54.655">きれな</span><span begin="0:54.655" end="0:54.759">い</span><span begin="0:54.759" end="0:55.580">こと</span><span begin="0:55.580" end="0:56.289">ばかり</span><span begin="0:56.289" end="0:56.589">だ</span></p><p begin="0:56.731" end="1:00.344" itunes:key="L14" ttm:agent="v1"><span begin="0:56.731" end="0:57.192">大</span><span begin="0:57.192" end="0:57.444">事</span><span begin="0:57.444" end="0:57.672">な</span><span begin="0:57.672" end="0:58.145">もの</span><span begin="0:58.145" end="0:58.373">は</span><span begin="0:58.373" end="0:58.834">大</span><span begin="0:58.834" end="0:59.094">事</span><span begin="0:59.094" end="0:59.295">に</span><span begin="0:59.295" end="1:00.044">しなくち</span><span begin="1:00.044" end="1:00.344">ゃ</span></p><p begin="1:00.504" end="1:03.933" itunes:key="L15" ttm:agent="v1"><span begin="1:00.504" end="1:00.837">あの日</span><span begin="1:00.837" end="1:01.197">の</span><span begin="1:01.197" end="1:01.718">自</span><span begin="1:01.718" end="1:01.898">分</span><span begin="1:01.898" end="1:02.367">が</span><span begin="1:02.367" end="1:02.719">教え</span><span begin="1:02.719" end="1:03.160">てく</span><span begin="1:03.160" end="1:03.300">れ</span><span begin="1:03.300" end="1:03.933">た</span></p><p begin="1:04.241" end="1:07.701" itunes:key="L16" ttm:agent="v1"><span begin="1:04.241" end="1:04.602">零し</span><span begin="1:04.602" end="1:04.922">た</span><span begin="1:04.922" end="1:05.522">雫</span><span begin="1:05.663" end="1:06.124">も</span><span begin="1:06.124" end="1:06.620">叶</span><span begin="1:06.620" end="1:07.057">えて</span><span begin="1:07.057" end="1:07.701">く</span></p><p begin="1:08.006" end="1:11.572" itunes:key="L17" ttm:agent="v1"><span begin="1:08.006" end="1:08.467">忘</span><span begin="1:08.467" end="1:08.727">れち</span><span begin="1:08.727" end="1:09.068">ゃ</span><span begin="1:09.068" end="1:09.668">いけな</span><span begin="1:09.668" end="1:09.769">い</span><span begin="1:09.769" end="1:10.571">こと</span><span begin="1:10.571" end="1:11.272">ばかり</span><span begin="1:11.272" end="1:11.572">だ</span></p><p begin="1:11.745" end="1:15.317" itunes:key="L18" ttm:agent="v1"><span begin="1:11.745" end="1:12.453">病める</span><span begin="1:12.453" end="1:12.686">日</span><span begin="1:12.686" end="1:12.914">も</span><span begin="1:12.914" end="1:13.847">健や</span><span begin="1:13.847" end="1:14.096">か</span><span begin="1:14.096" end="1:14.528">なる</span><span begin="1:14.528" end="1:14.789">日</span><span begin="1:14.789" end="1:15.317">でも</span></p><p begin="1:15.469" end="1:18.878" itunes:key="L19" ttm:agent="v1"><span begin="1:15.469" end="1:15.838">風</span><span begin="1:15.838" end="1:16.198">が</span><span begin="1:16.198" end="1:16.671">吹く</span><span begin="1:16.671" end="1:17.271">度</span><span begin="1:17.388" end="1:17.720">思い</span><span begin="1:17.720" end="1:18.041">出</span><span begin="1:18.041" end="1:18.141">す</span><span begin="1:18.141" end="1:18.301">の</span><span begin="1:18.301" end="1:18.878">さ</span></p><p begin="1:19.243" end="1:22.767" itunes:key="L20" ttm:agent="v1"><span begin="1:19.243" end="1:19.595">刻ん</span><span begin="1:19.595" end="1:19.943">で</span><span begin="1:19.943" end="1:20.424">飲み</span><span begin="1:20.424" end="1:20.644">込ん</span><span begin="1:20.644" end="1:21.125">で</span><span begin="1:21.125" end="1:21.622">歩いて</span><span begin="1:21.622" end="1:22.327">いく</span><span begin="1:22.327" end="1:22.767">んだ</span></p><p begin="1:22.767" end="1:25.565" itunes:key="L21" ttm:agent="v1"><span begin="1:22.767" end="1:23.128">ず</span><span begin="1:23.128" end="1:23.488">っと</span><span begin="1:23.488" end="1:23.805">ず</span><span begin="1:23.805" end="1:24.189">っと</span><span begin="1:24.189" end="1:24.631">ずっ</span><span begin="1:24.631" end="1:25.565">と</span></p><p begin="1:29.998" end="1:33.