<?xml version="1.0" encoding="utf-8"?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Zutto Zutto Zutto"/><amll:meta key="artists" value="Ryokuoushoku Shakai"/><amll:meta key="album" value="Actor"/><amll:meta key="isrc" value="JPU902101238"/><amll:meta key="appleMusicId" value="1600659272"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Haruko Nagaya</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">全都是绝不能忘记的事</text><text for="L2">无论是抱恙还是安康</text><text for="L3">每当风吹过总会想起</text><text for="L4">铭记在心 咽下所有 继续前行</text><text for="L5">都说人生只有这么一遭</text><text for="L6">抱歉啊 我其实还没什么实感</text><text for="L7">只是心底怎么也不甘心</text><text for="L8">我明明还能做到更多</text><text for="L9">分明没有标准答案 却总苦苦追寻</text><text for="L10">同样的今天绝不会再次重来</text><text for="L11">明明心里都懂 却为何悔恨 为何落泪？</text><text for="L12">瞧 若你已开始眷恋明天 那就欣然欢喜吧</text><text for="L13">全都是无法彻底割舍的事</text><text for="L14">珍视之物一定要好好珍惜</text><text for="L15">是那一天的自己教会了我</text><text for="L16">就连落下的泪滴 也要一一去兑现</text><text for="L17">尽是些绝不能忘记的事</text><text for="L18">无论身处逆境还是安康</text><text for="L19">每当微风拂过总会忆起</text><text for="L20">铭记在心 咽下所有 坚定走下去</text><text for="L21">一直 一直 走下去</text><text for="L22">全人类都不过是人之子啊</text><text for="L23">无关乎所谓的大人还是小孩</text><text for="L24">面对令人眼花缭乱的浮躁风潮</text><text for="L25">我可不能就此败下阵来</text><text for="L26">分明没那份闲暇 却已疲惫不堪</text><text for="L27">畅快饮下 喉间发出诱人的声响</text><text for="L28">贪求着得不到的东西 又为何在哭泣？</text><text for="L29">好啦 已经全都不要紧了</text><text for="L30">也是时候原谅自己了 挥手告别吧</text><text for="L31">任性起伏波澜不定的情绪</text><text for="L32">起起落落 跌宕沉浮</text><text for="L33">在这之中 究竟哪一个才是真实？</text><text for="L34">你心里其实早就清楚 对吧？</text><text for="L35">甚至根本无需再去追问</text><text for="L36">说着要与这样的自己相伴一生</text><text for="L37">一直一直温柔疼惜下去</text><text for="L38">对明天其实没抱什么希望</text><text for="L39">即便如此 我依然以自己的方式爱着这个世界</text><text for="L40">那些还未完成的桩桩件件</text><text for="L41">我依然一件都不忍心抛下</text><text for="L42">尽是些无法轻言放弃的事</text><text for="L43">重要的东西必须加倍珍惜</text><text for="L44">我要对那一天的自己放声高歌</text><text for="L45">滑落的泪滴绝不会背叛自己</text><text for="L46">尽是些绝不能忘却的事</text><text for="L47">无论身处困顿还是安康</text><text for="L48">每当起风时总会涌上心头</text><text for="L49">铭刻于心 吞下所有 坚定前行</text><text for="L50">一直 一直 直到永远</text></translation></translations></iTunesMetadata></metadata></head><body dur="3:26.365"><div begin="0:00.596" end="3:26.365"><p begin="0:00.596" end="0:04.146" itunes:key="L1" ttm:agent="v1"><span begin="0:00.596" end="0:01.096">忘</span><span begin="0:01.096" end="0:01.296">れ</span><span begin="0:01.296" end="0:01.576">ちゃ</span><span begin="0:01.576" end="0:01.756">い</span><span begin="0:01.756" end="0:01.946">け</span><span begin="0:01.946" end="0:02.286">な</span><span begin="0:02.286" end="0:02.676">いこ</span><span begin="0:02.676" end="0:02.986">と</span><span begin="0:03.186" end="0:03.316">ば</span><span begin="0:03.316" end="0:03.686">か</span><span begin="0:03.686" end="0:03.826">り</span><span begin="0:03.826" end="0:04.146">だ</span></p><p begin="0:04.336" end="0:07.866" itunes:key="L2" ttm:agent="v1"><span begin="0:04.336" end="0:04.596">病</span><span begin="0:04.596" end="0:04.866">め</span><span begin="0:04.866" end="0:05.066">る</span><span begin="0:05.066" end="0:05.236">日</span><span begin="0:05.236" end="0:05.516">も</span><span begin="0:05.516" end="0:05.956">健</span><span begin="0:05.956" end="0:06.416">や</span><span begin="0:06.416" end="0:06.646">か</span><span begin="0:06.646" end="0:06.966">な</span><span begin="0:06.966" end="0:07.106">る</span><span begin="0:07.106" end="0:07.376">日</span><span begin="0:07.376" end="0:07.526">で</span><span begin="0:07.526" end="0:07.866">も</span></p><p begin="0:08.096" end="0:11.416" itunes:key="L3" ttm:agent="v1"><span begin="0:08.096" end="0:08.376">風</span><span begin="0:08.376" end="0:08.806">が</span><span begin="0:08.806" end="0:08.966">吹</span><span begin="0:08.966" end="0:09.276">く</span><span begin="0:09.276" end="0:09.736">度</span><span begin="0:09.996" end="0:10.326">思い</span><span begin="0:10.326" end="0:10.636">出</span><span begin="0:10.636" end="0:10.866">すの</span><span begin="0:10.866" end="0:11.416">さ</span></p><p begin="0:11.822" end="0:15.212" itunes:key="L4" ttm:agent="v1"><span begin="0:11.822" end="0:12.222">刻ん</span><span begin="0:12.222" end="0:12.452">で</span><span begin="0:12.452" end="0:12.692">飲</span><span begin="0:12.692" end="0:12.982">み</span><span begin="0:12.982" end="0:13.272">込ん</span><span begin="0:13.272" end="0:13.512">で</span><span begin="0:13.762" end="0:14.232">歩</span><span begin="0:14.232" end="0:14.422">い</span><span begin="0:14.422" end="0:14.622">て</span><span begin="0:14.622" end="0:15.212">く</span></p><p begin="0:22.597" end="0:25.957" itunes:key="L5" ttm:agent="v1"><span begin="0:22.597" end="0:22.997">人</span><span begin="0:22.997" end="0:23.597">生</span><span begin="0:23.597" end="0:24.047">一</span><span begin="0:24.047" end="0:24.267">度</span><span begin="0:24.267" end="0:24.537">き</span><span begin="0:24.537" end="0:24.697">り</span><span begin="0:24.697" end="0:25.197">だっ</span><span begin="0:25.197" end="0:25.367">て</span><span begin="0:25.367" end="0:25.957">さ</span></p><p begin="0:26.598" end="0:28.798" itunes:key="L6" ttm:agent="v1"><span begin="0:26.598" end="0:26.788">ご</span><span begin="0:26.788" end="0:27.098">めん</span><span begin="0:27.098" end="0:27.198">ね</span><span begin="0:27.198" end="0:27.348">ま</span><span begin="0:27.348" end="0:27.518">だ</span><span begin="0:27.518" end="0:27.768">ピン</span><span begin="0:27.768" end="0:28.008">と</span><span begin="0:28.008" end="0:28.188">こ</span><span begin="0:28.188" end="0:28.488">ない</span><span begin="0:28.488" end="0:28.798">や</span></p><p begin="0:30.343" end="0:32.203" itunes:key="L7" ttm:agent="v1"><span begin="0:30.343" end="0:30.473">た</span><span begin="0:30.473" end="0:30.593">だ</span><span begin="0:30.593" end="0:30.823">納</span><span begin="0:30.823" end="0:31.073">得</span><span begin="0:31.073" end="0:31.203">で</span><span begin="0:31.203" end="0:31.313">き</span><span begin="0:31.313" end="0:31.483">な</span><span begin="0:31.483" end="0:31.793">いん</span><span begin="0:31.793" end="0:32.203">だ</span></p><p begin="0:32.460" end="0:33.900" itunes:key="L8" ttm:agent="v1"><span begin="0:32.460" end="0:32.680">もっ</span><span begin="0:32.680" end="0:32.830">と</span><span begin="0:32.830" end="0:33.050">もっ</span><span begin="0:33.050" end="0:33.170">と</span><span begin="0:33.170" end="0:33.330">や</span><span begin="0:33.330" end="0:33.440">れ</span><span begin="0:33.440" end="0:33.670">るん</span><span begin="0:33.670" end="0:33.900">だ</span></p><p begin="0:34.051" end="0:37.671" itunes:key="L9" ttm:agent="v1"><span begin="0:34.051" end="0:34.491">正</span><span begin="0:34.491" end="0:35.071">解</span><span begin="0:35.071" end="0:35.231">は</span><span begin="0:35.231" end="0:35.701">な</span><span begin="0:35.701" end="0:36.011">いの</span><span begin="0:36.011" end="0:36.141">に</span><span begin="0:36.141" end="0:36.681">求</span><span begin="0:36.681" end="0:36.891">め</span><span begin="0:36.891" end="0:37.171">て</span><span begin="0:37.171" end="0:37.671">る</span></p><p begin="0:38.136" end="0:41.616" itunes:key="L10" ttm:agent="v1"><span begin="0:38.136" end="0:38.776">同</span><span begin="0:38.776" end="0:38.966">じ</span><span begin="0:38.966" end="0:39.396">今日</span><span begin="0:39.396" end="0:39.746">は</span><span begin="0:39.746" end="0:39.916">二</span><span begin="0:39.916" end="0:40.286">度</span><span begin="0:40.286" end="0:40.646">と</span><span begin="0:40.646" end="0:40.836">来</span><span begin="0:40.836" end="0:41.086">な</span><span begin="0:41.086" end="0:41.276">いん</span><span begin="0:41.276" end